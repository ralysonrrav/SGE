    "id": 15,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação de edição de nomes de disciplinas e tópicos, além de pop-ups de confirmação para exclusão de ambos os itens com design aprimorado.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useRef, useEffect } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  Circle, \n  BookOpen, \n  AlertTriangle, \n  X, \n  Edit3, \n  Check,\n  Save\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n}\n\ninterface TopicToDelete {\n  subjectId: string;\n  topicId: string;\n  title: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  \n  // State para Modais de Confirmação\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<TopicToDelete | null>(null);\n\n  // State para Edição\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState('');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: newSubjectName,\n      topics: [],\n      color: colors[subjects.length % colors.length]\n    };\n    setSubjects([...subjects, newSub]);\n    setNewSubjectName('');\n  };\n\n  const confirmRemoveSubject = () => {\n    if (subjectToDelete) {\n      setSubjects(subjects.filter(s => s.id !== subjectToDelete.id));\n      setSubjectToDelete(null);\n    }\n  };\n\n  const confirmRemoveTopic = () => {\n    if (topicToDelete) {\n      setSubjects(subjects.map(s => {\n        if (s.id === topicToDelete.subjectId) {\n          return { ...s, topics: s.topics.filter(t => t.id !== topicToDelete.topicId) };\n        }\n        return s;\n      }));\n      setTopicToDelete(null);\n    }\n  };\n\n  const startEditingSubject = (e: React.MouseEvent, subject: Subject) => {\n    e.stopPropagation();\n    setEditingSubjectId(subject.id);\n    setEditValue(subject.name);\n  };\n\n  const saveSubjectName = (e?: React.MouseEvent | React.KeyboardEvent) => {\n    if (e) e.stopPropagation();\n    if (!editValue.trim() || !editingSubjectId) {\n      setEditingSubjectId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => s.id === editingSubjectId ? { ...s, name: editValue } : s));\n    setEditingSubjectId(null);\n  };\n\n  const startEditingTopic = (e: React.MouseEvent, topic: Topic) => {\n    e.stopPropagation();\n    setEditingTopicId(topic.id);\n    setEditValue(topic.title);\n  };\n\n  const saveTopicTitle = (subjectId: string, topicId: string) => {\n    if (!editValue.trim()) {\n      setEditingTopicId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => t.id === topicId ? { ...t, title: editValue } : t)\n        };\n      }\n      return s;\n    }));\n    setEditingTopicId(null);\n  };\n\n  const addTopic = (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: [...s.topics, { \n            id: Date.now().toString(), \n            title: newTopicTitle, \n            completed: false, \n            importance: 3 \n          }]\n        };\n      }\n      return s;\n    }));\n    setNewTopicTitle('');\n  };\n\n  const toggleTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const now = new Date().toISOString();\n              return { ...t, completed: !t.completed, lastStudiedAt: !t.completed ? now : t.lastStudiedAt };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 font-medium\">Controle total sobre seu conteúdo programático.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Nova disciplina...\"\n            className=\"px-5 py-3 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-72 shadow-sm transition-all\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject}\n            className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all flex items-center justify-center shadow-lg shadow-indigo-100 shrink-0\"\n            title=\"Adicionar Disciplina\"\n          >\n            <Plus size={24} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 && (\n          <div className=\"text-center py-24 bg-white rounded-[2rem] border-2 border-dashed border-slate-200\">\n            <div className=\"w-20 h-20 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-300\">\n              <BookOpen size={40} />\n            </div>\n            <h3 className=\"text-xl font-bold text-slate-400\">Nenhuma disciplina por aqui</h3>\n            <p className=\"text-slate-400 mt-2\">Comece adicionando as matérias do seu edital acima.</p>\n          </div>\n        )}\n\n        {subjects.map(subject => (\n          <div key={subject.id} className=\"bg-white rounded-[1.5rem] border border-slate-100 shadow-sm overflow-hidden transition-all hover:shadow-md group\">\n            <div \n              className=\"p-5 flex items-center justify-between cursor-pointer\"\n              onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n            >\n              <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                <div className=\"w-4 h-12 rounded-full shrink-0\" style={{ backgroundColor: subject.color }} />\n                \n                {editingSubjectId === subject.id ? (\n                  <div className=\"flex items-center gap-2 flex-1 max-w-md\" onClick={(e) => e.stopPropagation()}>\n                    <input\n                      autoFocus\n                      type=\"text\"\n                      className=\"w-full px-4 py-2 border-2 border-indigo-500 rounded-xl outline-none shadow-inner font-bold text-lg\"\n                      value={editValue}\n                      onChange={(e) => setEditValue(e.target.value)}\n                      onKeyDown={(e) => e.key === 'Enter' && saveSubjectName()}\n                      onBlur={() => saveSubjectName()}\n                    />\n                    <button \n                      onClick={() => saveSubjectName()} \n                      className=\"p-2 bg-emerald-500 text-white rounded-xl hover:bg-emerald-600 transition-colors shadow-md\"\n                    >\n                      <Check size={20} />\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"flex flex-col min-w-0\">\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"font-bold text-xl text-slate-800 truncate\">{subject.name}</h3>\n                      <button \n                        onClick={(e) => startEditingSubject(e, subject)}\n                        className=\"p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all\"\n                        title=\"Editar nome da disciplina\"\n                      >\n                        <Edit3 size={16} />\n                      </button>\n                    </div>\n                    <div className=\"flex items-center gap-2 mt-1\">\n                      <div className=\"h-1.5 w-24 bg-slate-100 rounded-full overflow-hidden\">\n                        <div \n                          className=\"h-full transition-all duration-500\" \n                          style={{ \n                            width: `${subject.topics.length > 0 ? (subject.topics.filter(t => t.completed).length / subject.topics.length) * 100 : 0}%`,\n                            backgroundColor: subject.color \n                          }}\n                        />\n                      </div>\n                      <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider\">\n                        {subject.topics.filter(t => t.completed).length}/{subject.topics.length} Concluídos\n                      </span>\n                    </div>\n                  </div>\n                )}\n              </div>\n              \n              <div className=\"flex items-center gap-3\">\n                <button \n                  onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }}\n                  className=\"text-slate-300 hover:text-red-500 hover:bg-red-50 p-2.5 rounded-xl transition-all\"\n                  title=\"Excluir Disciplina\"\n                >\n                  <Trash2 size={20} />\n                </button>\n                <div className={`p-2 rounded-full transition-colors ${expandedSubject === subject.id ? 'bg-indigo-50 text-indigo-600' : 'text-slate-300'}`}>\n                  {expandedSubject === subject.id ? <ChevronUp size={20} /> : <ChevronDown size={20} />}\n                </div>\n              </div>\n            </div>\n\n            {expandedSubject === subject.id && (\n              <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 bg-slate-50/30\">\n                <div className=\"flex gap-2 mb-6\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"O que você precisa estudar hoje?\"\n                    className=\"flex-1 px-4 py-3 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none shadow-sm transition-all\"\n                    value={newTopicTitle}\n                    onChange={(e) => setNewTopicTitle(e.target.value)}\n                    onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                  />\n                  <button \n                    onClick={() => addTopic(subject.id)}\n                    className=\"bg-indigo-600 text-white px-6 py-3 rounded-xl text-sm font-bold hover:bg-indigo-700 transition-all shadow-md shadow-indigo-100\"\n                  >\n                    Adicionar Tópico\n                  </button>\n                </div>\n\n                <div className=\"space-y-2.5\">\n                  {subject.topics.map(topic => (\n                    <div \n                      key={topic.id}\n                      className=\"group/topic flex items-center justify-between p-4 rounded-2xl bg-white border border-slate-100 transition-all hover:border-indigo-200 hover:shadow-sm\"\n                    >\n                      <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                        <button \n                          onClick={() => toggleTopic(subject.id, topic.id)}\n                          className={`transition-all shrink-0 transform hover:scale-110 ${topic.completed ? 'text-emerald-500' : 'text-slate-200 hover:text-indigo-400'}`}\n                        >\n                          {topic.completed ? <CheckCircle size={24} /> : <Circle size={24} />}\n                        </button>\n                        \n                        {editingTopicId === topic.id ? (\n                          <div className=\"flex items-center gap-2 flex-1\" onClick={(e) => e.stopPropagation()}>\n                            <input\n                              autoFocus\n                              type=\"text\"\n                              className=\"w-full px-3 py-1.5 text-sm border-2 border-indigo-400 rounded-lg outline-none\"\n                              value={editValue}\n                              onChange={(e) => setEditValue(e.target.value)}\n                              onKeyDown={(e) => e.key === 'Enter' && saveTopicTitle(subject.id, topic.id)}\n                              onBlur={() => saveTopicTitle(subject.id, topic.id)}\n                            />\n                          </div>\n                        ) : (\n                          <span className={`text-sm font-semibold truncate ${topic.completed ? 'text-slate-300 line-through' : 'text-slate-700'}`}>\n                            {topic.title}\n                          </span>\n                        )}\n                      </div>\n                      \n                      <div className=\"flex items-center gap-2 opacity-0 group-topic/hover:opacity-100 md:group-topic/hover:opacity-100 transition-opacity ml-4 shrink-0\">\n                        {editingTopicId !== topic.id && (\n                          <button \n                            onClick={(e) => startEditingTopic(e, topic)}\n                            className=\"p-1.5 text-slate-300 hover:text-indigo-500 hover:bg-indigo-50 rounded-lg transition-all\"\n                            title=\"Editar Tópico\"\n                          >\n                            <Edit3 size={16} />\n                          </button>\n                        )}\n                        <span className=\"hidden sm:inline-block text-[9px] bg-amber-50 text-amber-600 px-2 py-1 rounded-full font-extrabold uppercase tracking-tighter border border-amber-100\">\n                          PRIO {topic.importance}\n                        </span>\n                        <button \n                          onClick={(e) => { e.stopPropagation(); setTopicToDelete({ subjectId: subject.id, topicId: topic.id, title: topic.title }); }}\n                          className=\"p-1.5 text-slate-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all\"\n                          title=\"Excluir Tópico\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                  {subject.topics.length === 0 && (\n                    <div className=\"text-center py-6\">\n                      <p className=\"text-slate-400 text-sm italic\">Nenhum tópico cadastrado para esta disciplina.</p>\n                    </div>\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n        ))}\n      </div>\n\n      {/* Pop-up de Confirmação: Disciplina */}\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md animate-in fade-in duration-300\">\n          <div className=\"bg-white rounded-[2.5rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in-95 slide-in-from-bottom-8 duration-300 border border-white/20\">\n            <div className=\"p-10 text-center\">\n              <div className=\"w-20 h-20 bg-red-50 text-red-500 rounded-3xl flex items-center justify-center mx-auto mb-6 rotate-3\">\n                <AlertTriangle size={40} />\n              </div>\n              <h3 className=\"text-2xl font-black text-slate-900 mb-4\">Ação Irreversível!</h3>\n              <p className=\"text-slate-500 text-base leading-relaxed mb-8\">\n                Você realmente deseja remover a disciplina <span className=\"font-extrabold text-slate-800\">\"{subjectToDelete.name}\"</span>? \n                <br /><br />\n                Todos os tópicos, estatísticas e o histórico de estudo serão <span className=\"text-red-500 font-bold underline\">apagados para sempre</span>.\n              </p>\n              \n              <div className=\"flex flex-col gap-3\">\n                <button\n                  onClick={confirmRemoveSubject}\n                  className=\"w-full bg-red-500 text-white font-black py-4 rounded-2xl hover:bg-red-600 transition-all shadow-xl shadow-red-200 active:scale-95\"\n                >\n                  SIM, EXCLUIR TUDO\n                </button>\n                <button\n                  onClick={() => setSubjectToDelete(null)}\n                  className=\"w-full bg-slate-100 text-slate-600 font-bold py-4 rounded-2xl hover:bg-slate-200 transition-all active:scale-95\"\n                >\n                  NÃO, MANTER DISCIPLINA\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Pop-up de Confirmação: Tópico */}\n      {topicToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"bg-white rounded-[2rem] shadow-2xl w-full max-w-sm overflow-hidden animate-in zoom-in-95 duration-200\">\n            <div className=\"p-8 text-center\">\n              <div className=\"w-16 h-16 bg-amber-50 text-amber-500 rounded-2xl flex items-center justify-center mx-auto mb-4\">\n                <Trash2 size={32} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900 mb-2\">Remover Tópico?</h3>\n              <p className=\"text-slate-500 text-sm mb-6\">\n                Deseja remover o tópico <span className=\"font-bold text-slate-700\">\"{topicToDelete.title}\"</span>? O progresso individual dele será perdido.\n              </p>\n              \n              <div className=\"flex gap-3\">\n                <button\n                  onClick={() => setTopicToDelete(null)}\n                  className=\"flex-1 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition-all\"\n                >\n                  Manter\n                </button>\n                <button\n                  onClick={confirmRemoveTopic}\n                  className=\"flex-1 bg-red-500 text-white font-bold py-3 rounded-xl hover:bg-red-600 transition-all shadow-lg shadow-red-100\"\n                >\n                  Remover\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
