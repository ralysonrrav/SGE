            {
              "target": "",
              "replacement": "\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n}\n\nexport interface Topic {\n  id: string;\n  title: string;\n  completed: boolean;\n  lastStudiedAt?: string; // ISO date\n  importance: number; // 1-5 (Pareto relevance)\n  studyTimeMinutes?: number;\n  questionsAttempted?: number;\n  questionsCorrect?: number;\n}\n\nexport interface Subject {\n  id: string;\n  name: string;\n  topics: Topic[];\n  color: string;\n}\n\nexport interface MockExam {\n  id: string;\n  title: string;\n  date: string;\n  score: number;\n  totalQuestions: number;\n  subjectPerformance: Record<string, number>; // subjectId -> percentage\n}\n\nexport interface StudyCycle {\n  id: string;\n  board: string;\n  examDate: string;\n  hoursPerDay: number;\n  schedule: Array<{\n    day: string;\n    sessions: Array<{\n      subjectName: string;\n      duration: number; // minutes\n      focus: string;\n    }>;\n  }>;\n}\n\nexport interface ReviewAlert {\n  subjectName: string;\n  topicTitle: string;\n  daysPassed: number;\n  dueDate: string;\n}\n"
            }
          ]
