          "diffs": [
            {
              "target": "",
              "replacement": "\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  password?: string;\n  role: 'administrator' | 'student' | 'visitor';\n  status: 'active' | 'blocked';\n  isOnline: boolean;\n  lastAccess?: string;\n  weeklyGoal?: number;\n  examDate?: string;\n}\n\nexport interface StudySession {\n  id: string;\n  topicId: string;\n  subjectId: string;\n  minutes: number;\n  date: string;\n  type: 'estudo' | 'revisao';\n}\n\nexport interface Topic {\n  id: string;\n  title: string;\n  completed: boolean;\n  lastStudiedAt?: string;\n  concludedAt?: string;\n  importance: number;\n  studyTimeMinutes?: number;\n  questionsAttempted?: number;\n  questionsCorrect?: number;\n  revisionsDone?: number[];\n}\n\nexport interface Subject {\n  id: string;\n  name: string;\n  topics: Topic[];\n  color: string;\n}\n\nexport enum NivelConhecimento {\n  INICIANTE = 'Iniciante',\n  INTERMEDIARIO = 'Intermediário',\n  AVANCADO = 'Avançado'\n}\n\nexport enum PesoDisciplina {\n  BAIXO = 'Baixo',\n  NORMAL = 'Normal',\n  ALTO = 'Alto'\n}\n\nexport interface CycleSubject extends Subject {\n  nivelConhecimento: NivelConhecimento;\n  peso: PesoDisciplina;\n  tempoEstudo: number;\n}\n\nexport interface Ciclo {\n  id: number;\n  materias: Array<Partial<CycleSubject> & { instanceId: string }>;\n  tempoTotal: number;\n}\n\nexport interface PredefinedEdital {\n  id: string;\n  name: string;\n  organization: string;\n  examDate?: string;\n  subjects: Subject[];\n  lastUpdated: string;\n  created_by?: string;\n}\n\nexport interface MockExam {\n  id: string;\n  title: string;\n  date: string;\n  score: number;\n  totalQuestions: number;\n  subjectPerformance: Record<string, number>;\n}\n\nexport interface StudyCycle {\n  id: string;\n  user_id?: string;\n  board: string;\n  examDate: string;\n  hoursPerDay: number;\n  schedule: any[];\n  config_disciplinas: CycleSubject[];\n  disciplinas_por_ciclo: number;\n  meta_atual: number;\n  ciclo_atual: number;\n  metas_concluidas: number;\n  materias_concluidas_ids: string[];\n}\n"
            }
          ]
        },
        {
          "path": "services/cycleLogic.ts",
          "generationType": 1,
          "isDone": true,
          "description": "Criação da lógica de cálculo de tempo e geração de ciclos de estudo.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport { CycleSubject, Ciclo, NivelConhecimento, PesoDisciplina } from '../types';\n\nexport const calcularTempoEstudo = (nivel: NivelConhecimento, peso: PesoDisciplina): number => {\n  let base = 60;\n  \n  switch (nivel) {\n    case NivelConhecimento.INICIANTE: base = 90; break;\n    case NivelConhecimento.INTERMEDIARIO: base = 60; break;\n    case NivelConhecimento.AVANCADO: base = 45; break;\n  }\n  \n  switch (peso) {\n    case PesoDisciplina.ALTO: base += 30; break;\n    case PesoDisciplina.BAIXO: base -= 15; break;\n  }\n  \n  return base;\n};\n\nexport const gerarCiclos = (subjects: CycleSubject[], perCycle: number): Ciclo[] => {\n  if (!subjects.length) return [];\n  \n  const cycles: Ciclo[] = [];\n  \n  for (let i = 1; i <= 4; i++) {\n    const selected: Array<Partial<CycleSubject> & { instanceId: string }> = [];\n    \n    // Lógica de distribuição: seleciona matérias de forma rotativa para cada ciclo\n    for (let j = 0; j < perCycle; j++) {\n      const index = ( (i - 1) * 2 + j ) % subjects.length;\n      const sub = subjects[index];\n      selected.push({\n        ...sub,\n        instanceId: `${sub.id}-c${i}-${j}-${Date.now()}`\n      });\n    }\n\n    cycles.push({\n      id: i,\n      materias: selected,\n      tempoTotal: selected.reduce((acc, s) => acc + (s.tempoEstudo || 0), 0)\n    });\n  }\n  \n  return cycles;\n};\n"
            }
          ]
        },
        {
          "path": "components/Ciclos.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Atualização do componente Ciclos com a nova lógica de gamificação e metas.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useMemo } from 'react';\nimport { \n  BrainCircuit, CheckCircle2, ChevronRight, Settings2, Plus, \n  Trash2, Edit3, Target, Trophy, Clock, AlertCircle, BookOpen\n} from 'lucide-react';\nimport { User, Subject, CycleSubject, Ciclo, StudyCycle, NivelConhecimento, PesoDisciplina } from '../types';\nimport { calcularTempoEstudo, gerarCiclos } from '../services/cycleLogic';\nimport { supabase } from '../lib/supabase';\n\ninterface CiclosProps {\n  user: User;\n  subjects: Subject[];\n  cycle: StudyCycle | null;\n  setCycle: (cycle: StudyCycle | null) => void;\n}\n\nconst Ciclos: React.FC<CiclosProps> = ({ user, subjects, cycle, setCycle }) => {\n  const [configSubjects, setConfigSubjects] = useState<CycleSubject[]>(cycle?.config_disciplinas || []);\n  const [disciplinasPorCiclo, setDisciplinasPorCiclo] = useState(cycle?.disciplinas_por_ciclo || 4);\n  const [editingId, setEditingId] = useState<string | null>(null);\n\n  // Form State\n  const [selectedSubjectId, setSelectedSubjectId] = useState('');\n  const [nivel, setNivel] = useState<NivelConhecimento>(NivelConhecimento.INICIANTE);\n  const [peso, setPeso] = useState<PesoDisciplina>(PesoDisciplina.NORMAL);\n\n  const ciclosGerados = useMemo(() => {\n    return gerarCiclos(configSubjects, disciplinasPorCiclo);\n  }, [configSubjects, disciplinasPorCiclo]);\n\n  const saveCycleState = async (newState: Partial<StudyCycle>) => {\n    if (!supabase) return;\n    \n    const updatedCycle = {\n      ...(cycle || {\n        id: `cycle-${Date.now()}`,\n        user_id: user.id,\n        board: 'Personalizado',\n        examDate: user.examDate || new Date().toISOString(),\n        hoursPerDay: 4,\n        schedule: [],\n        meta_atual: 1,\n        ciclo_atual: 1,\n        metas_concluidas: 0,\n        materias_concluidas_ids: [],\n      }),\n      ...newState,\n      config_disciplinas: configSubjects,\n      disciplinas_por_ciclo: disciplinasPorCiclo\n    } as StudyCycle;\n\n    setCycle(updatedCycle);\n\n    try {\n      if (cycle?.id && !String(cycle.id).startsWith('cycle-')) {\n        await supabase.from('study_cycles').update({\n          meta_atual: updatedCycle.meta_atual,\n          ciclo_atual: updatedCycle.ciclo_atual,\n          metas_concluidas: updatedCycle.metas_concluidas,\n          materias_concluidas_ids: updatedCycle.materias_concluidas_ids,\n          config_disciplinas: updatedCycle.config_disciplinas,\n          disciplinas_por_ciclo: updatedCycle.disciplinas_por_ciclo\n        }).eq('id', cycle.id);\n      } else if (user.role !== 'visitor') {\n        const { data } = await supabase.from('study_cycles').insert([{\n          user_id: user.id,\n          board: updatedCycle.board,\n          exam_date: updatedCycle.examDate,\n          hours_per_day: updatedCycle.hoursPerDay,\n          meta_atual: updatedCycle.meta_atual,\n          ciclo_atual: updatedCycle.ciclo_atual,\n          metas_concluidas: updatedCycle.metas_concluidas,\n          materias_concluidas_ids: updatedCycle.materias_concluidas_ids,\n          config_disciplinas: updatedCycle.config_disciplinas,\n          disciplinas_por_ciclo: updatedCycle.disciplinas_por_ciclo\n        }]).select().single();\n        if (data) setCycle({ ...updatedCycle, id: String(data.id) });\n      }\n    } catch (e) {\n      console.error(\"Erro ao salvar ciclo:\", e);\n    }\n  };\n\n  const handleAddOrUpdateSubject = () => {\n    const baseSubject = subjects.find(s => String(s.id) === String(selectedSubjectId));\n    if (!baseSubject) return;\n\n    const newCycleSubject: CycleSubject = {\n      ...baseSubject,\n      nivelConhecimento: nivel,\n      peso,\n      tempoEstudo: calcularTempoEstudo(nivel, peso)\n    };\n\n    if (editingId) {\n      setConfigSubjects(prev => prev.map(s => s.id === editingId ? newCycleSubject : s));\n      setEditingId(null);\n    } else {\n      if (configSubjects.find(s => String(s.id) === String(selectedSubjectId))) return;\n      setConfigSubjects(prev => [...prev, newCycleSubject]);\n    }\n\n    setSelectedSubjectId('');\n  };\n\n  const handleToggleMateria = (instanceId: string) => {\n    if (!cycle) return;\n    const currentConcluidas = cycle.materias_concluidas_ids || [];\n    const isDone = currentConcluidas.includes(instanceId);\n    \n    saveCycleState({\n      materias_concluidas_ids: isDone \n        ? currentConcluidas.filter(id => id !== instanceId)\n        : [...currentConcluidas, instanceId]\n    });\n  };\n\n  const handleCompleteCycle = () => {\n    if (!cycle) return;\n    if (cycle.ciclo_atual < 4) {\n      saveCycleState({\n        ciclo_atual: cycle.ciclo_atual + 1,\n        materias_concluidas_ids: []\n      });\n    } else {\n      saveCycleState({\n        meta_atual: (cycle.meta_atual || 1) + 1,\n        ciclo_atual: 1,\n        metas_concluidas: (cycle.metas_concluidas || 0) + 1,\n        materias_concluidas_ids: []\n      });\n    }\n  };\n\n  const activeCiclo = ciclosGerados.find(c => c.id === (cycle?.ciclo_atual || 1));\n  const allMateriaDone = activeCiclo?.materias.length && activeCiclo?.materias.every(m => m.instanceId && cycle?.materias_concluidas_ids.includes(m.instanceId));\n\n  const hasAvailableSubjects = subjects && subjects.length > 0;\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700\">\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"glass-card p-6 border-l-4 border-indigo-500 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-indigo-500/20 flex items-center justify-center text-indigo-400\">\n            <Target size={24} />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Meta Atual</p>\n            <p className=\"text-2xl font-black text-white\"># {cycle?.meta_atual || 1}</p>\n          </div>\n        </div>\n        <div className=\"glass-card p-6 border-l-4 border-emerald-500 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-400\">\n            <Trophy size={24} />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Concluídas</p>\n            <p className=\"text-2xl font-black text-white\">{cycle?.metas_concluidas || 0}</p>\n          </div>\n        </div>\n        <div className=\"glass-card p-6 border-l-4 border-amber-500 flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400\">\n            <BrainCircuit size={24} />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Status do Plano</p>\n            <p className=\"text-2xl font-black text-white\">Ciclo {cycle?.ciclo_atual || 1} / 4</p>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"glass-card p-8\">\n            <div className=\"flex items-center justify-between mb-6\">\n              <h3 className=\"text-[11px] font-black uppercase tracking-[0.3em] text-white flex items-center gap-2\">\n                <Settings2 size={14} className=\"text-indigo-400\" /> Configuração\n              </h3>\n            </div>\n\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"text-[9px] font-black uppercase text-slate-500 mb-2 block\">Matérias por Ciclo</label>\n                <input \n                  type=\"number\" \n                  value={disciplinasPorCiclo}\n                  onChange={(e) => setDisciplinasPorCiclo(Math.max(1, parseInt(e.target.value) || 1))}\n                  className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-4 py-2 text-xs text-white focus:border-indigo-500 outline-none transition-all\" \n                />\n              </div>\n\n              <div className=\"pt-4 border-t border-white/5\">\n                <label className=\"text-[9px] font-black uppercase text-slate-500 mb-2 block\">Selecionar Disciplina</label>\n                \n                {!hasAvailableSubjects ? (\n                  <div className=\"bg-amber-500/10 border border-amber-500/20 rounded-lg p-3 text-center\">\n                    <p className=\"text-[9px] font-black text-amber-400 uppercase tracking-widest leading-relaxed\">\n                      Nenhuma disciplina ativa encontrada no terminal. \n                      Adicione primeiro em <span className=\"text-white\">\"QUESTS\"</span>.\n                    </p>\n                  </div>\n                ) : (\n                  <>\n                    <select \n                      value={selectedSubjectId}\n                      onChange={(e) => setSelectedSubjectId(e.target.value)}\n                      className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-4 py-2 text-xs text-white focus:border-indigo-500 outline-none transition-all mb-3\"\n                    >\n                      <option value=\"\">Escolha uma matéria...</option>\n                      {subjects.map(s => (\n                        <option key={s.id} value={s.id}>{s.name}</option>\n                      ))}\n                    </select>\n\n                    <div className=\"grid grid-cols-2 gap-3 mb-4\">\n                      <div>\n                        <label className=\"text-[9px] font-black uppercase text-slate-500 mb-1 block\">Conhecimento</label>\n                        <select value={nivel} onChange={(e) => setNivel(e.target.value as any)} className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-3 py-2 text-[10px] text-white outline-none\">\n                          {Object.values(NivelConhecimento).map(v => <option key={v} value={v}>{v}</option>)}\n                        </select>\n                      </div>\n                      <div>\n                        <label className=\"text-[9px] font-black uppercase text-slate-500 mb-1 block\">Peso</label>\n                        <select value={peso} onChange={(e) => setPeso(e.target.value as any)} className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-3 py-2 text-[10px] text-white outline-none\">\n                          {Object.values(PesoDisciplina).map(v => <option key={v} value={v}>{v}</option>)}\n                        </select>\n                      </div>\n                    </div>\n\n                    <button \n                      onClick={handleAddOrUpdateSubject}\n                      disabled={!selectedSubjectId}\n                      className={`w-full py-3 rounded-lg text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-all ${selectedSubjectId ? 'bg-indigo-600 hover:bg-indigo-700 text-white' : 'bg-slate-800 text-slate-500 cursor-not-allowed'}`}\n                    >\n                      {editingId ? <Edit3 size={14}/> : <Plus size={14}/>} \n                      {editingId ? 'Atualizar' : 'Adicionar'}\n                    </button>\n                  </>\n                )}\n              </div>\n\n              <div className=\"mt-6 space-y-2\">\n                {configSubjects.map(s => (\n                  <div key={s.id} className=\"group flex items-center justify-between p-3 bg-white/5 rounded-lg border border-white/5 hover:border-indigo-500/30 transition-all\">\n                    <div className=\"min-w-0\">\n                      <p className=\"text-[10px] font-bold text-white truncate\">{s.name}</p>\n                      <p className=\"text-[8px] text-slate-500 uppercase\">{s.nivelConhecimento} • {s.tempoEstudo}min</p>\n                    </div>\n                    <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                      <button onClick={() => { setEditingId(s.id); setSelectedSubjectId(String(s.id)); setNivel(s.nivelConhecimento); setPeso(s.peso); }} className=\"p-1.5 hover:bg-white/10 rounded text-amber-500\"><Edit3 size={12}/></button>\n                      <button onClick={() => setConfigSubjects(prev => prev.filter(ps => ps.id !== s.id))} className=\"p-1.5 hover:bg-white/10 rounded text-rose-500\"><Trash2 size={12}/></button>\n                    </div>\n                  </div>\n                ))}\n                {configSubjects.length > 0 && (\n                  <button \n                    onClick={() => saveCycleState({})} \n                    className=\"w-full mt-4 py-2 border border-indigo-500/50 text-indigo-400 rounded-lg text-[9px] font-black uppercase tracking-widest hover:bg-indigo-500/10 transition-all\"\n                  >\n                    Gerar e Salvar Planilha\n                  </button>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"lg:col-span-8\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {ciclosGerados.map((ciclo) => {\n              const isActive = ciclo.id === (cycle?.ciclo_atual || 1);\n              const isCompleted = ciclo.id < (cycle?.ciclo_atual || 1);\n              const isLocked = ciclo.id > (cycle?.ciclo_atual || 1);\n              const progress = ciclo.materias.filter(m => cycle?.materias_concluidas_ids?.includes(m.instanceId || '')).length;\n              const percent = (progress / (ciclo.materias.length || 1)) * 100;\n\n              return (\n                <div key={ciclo.id} className={`glass-card overflow-hidden transition-all duration-500 ${isActive ? 'ring-2 ring-indigo-500 scale-[1.02] shadow-2xl shadow-indigo-500/10' : 'opacity-60 grayscale-[0.8]'}`}>\n                  <div className=\"p-6 border-b border-white/5 bg-white/5 flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-[9px] font-black uppercase text-slate-500 tracking-widest mb-1\">Fase 0{ciclo.id}</p>\n                      <h4 className=\"text-lg font-black text-white\">CICLO {ciclo.id}</h4>\n                    </div>\n                    <div className=\"text-right\">\n                       <Clock size={16} className=\"text-indigo-400 ml-auto mb-1\" />\n                       <p className=\"text-[10px] font-bold text-slate-300\">{Math.floor(ciclo.tempoTotal / 60)}h {ciclo.tempoTotal % 60}m</p>\n                    </div>\n                  </div>\n\n                  <div className=\"h-1 bg-slate-900 w-full overflow-hidden\">\n                    <div \n                      className={`h-full transition-all duration-1000 ${isCompleted ? 'bg-emerald-500' : 'bg-indigo-500'}`} \n                      style={{ width: `${isCompleted ? 100 : percent}%` }}\n                    />\n                  </div>\n\n                  <div className=\"p-6 space-y-3\">\n                    {ciclo.materias.map((m, idx) => {\n                      const isDone = cycle?.materias_concluidas_ids?.includes(m.instanceId || '') || isCompleted;\n                      return (\n                        <div \n                          key={idx} \n                          onClick={() => isActive && m.instanceId && handleToggleMateria(m.instanceId)}\n                          className={`flex items-center justify-between p-3 rounded-lg border transition-all ${isActive ? 'cursor-pointer hover:bg-white/5' : ''} ${isDone ? 'bg-emerald-500/5 border-emerald-500/20' : 'bg-slate-900/50 border-white/5'}`}\n                        >\n                          <div className=\"flex items-center gap-3\">\n                            <div className={`w-5 h-5 rounded flex items-center justify-center border transition-all ${isDone ? 'bg-emerald-500 border-emerald-500 text-slate-950' : 'bg-transparent border-slate-700'}`}>\n                              {isDone && <CheckCircle2 size={12} strokeWidth={3} />}\n                            </div>\n                            <span className={`text-[10px] font-bold uppercase tracking-tight ${isDone ? 'text-slate-500 line-through' : 'text-slate-200'}`}>{m.name}</span>\n                          </div>\n                          <span className={`text-[9px] font-black px-2 py-0.5 rounded ${isDone ? 'bg-emerald-500/20 text-emerald-400' : 'bg-indigo-500/20 text-indigo-400'}`}>{m.tempoEstudo}M</span>\n                        </div>\n                      );\n                    })}\n\n                    {isActive && (\n                      <button \n                        disabled={!allMateriaDone}\n                        onClick={handleCompleteCycle}\n                        className={`w-full mt-4 py-4 rounded-xl font-black text-[10px] uppercase tracking-[0.2em] transition-all flex items-center justify-center gap-2 ${allMateriaDone ? 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-500/30' : 'bg-slate-800 text-slate-500 cursor-not-allowed'}`}\n                      >\n                        {allMateriaDone ? (\n                          <>Finalizar Ciclo <ChevronRight size={14} /></>\n                        ) : (\n                          <>Complete as Quests <AlertCircle size={14} /></>\n                        )}\n                      </button>\n                    )}\n\n                    {isLocked && (\n                      <div className=\"mt-4 py-4 text-center border-t border-white/5\">\n                        <p className=\"text-[9px] font-black text-slate-600 uppercase tracking-widest flex items-center justify-center gap-2\">\n                          <CheckCircle2 size={12} className=\"opacity-20\" /> Bloqueado\n                        </p>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n          {ciclosGerados.length === 0 && (\n            <div className=\"glass-card p-20 flex flex-col items-center justify-center text-center\">\n              <div className=\"w-20 h-20 rounded-full bg-slate-900 flex items-center justify-center mb-6 border border-white/5\">\n                 <BrainCircuit size={40} className=\"text-indigo-500 opacity-20\" />\n              </div>\n              <h3 className=\"text-xl font-black text-white uppercase tracking-widest mb-2\">Protocolo não Inicializado</h3>\n              <p className=\"text-slate-500 text-sm max-w-sm\">\n                Adicione disciplinas e configure seus níveis no terminal lateral para gerar sua planilha de ciclos automatizada.\n              </p>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Ciclos;\n"
            }
          ]
        }
      ]
    },
