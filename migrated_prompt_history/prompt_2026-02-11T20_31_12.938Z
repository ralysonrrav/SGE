            {
              "target": "",
              "replacement": "\n<!DOCTYPE html>\n<html lang=\"pt-br\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Concurseiro Pro AI - Planejamento Inteligente</title>\n    \n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif'],\n                    },\n                }\n            }\n        }\n    </script>\n    \n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { \n            font-family: 'Inter', sans-serif; \n            overflow: hidden; \n            background-color: #020617;\n        }\n        * { transition: background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.4s ease, color 0.2s ease; }\n        \n        .glass-panel {\n            background: rgba(15, 23, 42, 0.7);\n            backdrop-filter: blur(24px) saturate(180%);\n            -webkit-backdrop-filter: blur(24px) saturate(180%);\n            border-right: 1px solid rgba(255, 255, 255, 0.08);\n        }\n\n        .glass-card {\n            background: rgba(30, 41, 59, 0.5);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n        }\n\n        .bg-study-dark {\n            background-image: linear-gradient(rgba(2, 6, 23, 0.85), rgba(2, 6, 23, 0.85)), url('https://images.unsplash.com/photo-1516979187457-637abb4f9353?q=80&w=2070&auto=format&fit=crop');\n            background-size: cover;\n            background-position: center;\n            background-attachment: fixed;\n        }\n\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 4px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: transparent;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: rgba(99, 102, 241, 0.3);\n            border-radius: 10px;\n        }\n\n        .neo-glow {\n            text-shadow: 0 0 15px rgba(99, 102, 241, 0.5);\n        }\n\n        @keyframes pulse-soft {\n            0%, 100% { opacity: 0.8; }\n            50% { opacity: 0.5; }\n        }\n        .animate-pulse-soft { animation: pulse-soft 3s ease-in-out infinite; }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 antialiased\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"index.tsx\"></script>\n</body>\n</html>\n"
            }
