  {
    "id": 11,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação de confirmação para exclusão de tópicos e funcionalidade de edição para nomes de disciplinas e títulos de tópicos.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  Circle, \n  BookOpen, \n  AlertTriangle, \n  X, \n  Edit3, \n  Check \n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n}\n\ninterface TopicToDelete {\n  subjectId: string;\n  topicId: string;\n  title: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  \n  // Modals state\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<TopicToDelete | null>(null);\n\n  // Editing state\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState('');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: newSubjectName,\n      topics: [],\n      color: colors[subjects.length % colors.length]\n    };\n    setSubjects([...subjects, newSub]);\n    setNewSubjectName('');\n  };\n\n  const confirmRemoveSubject = () => {\n    if (subjectToDelete) {\n      setSubjects(subjects.filter(s => s.id !== subjectToDelete.id));\n      setSubjectToDelete(null);\n    }\n  };\n\n  const confirmRemoveTopic = () => {\n    if (topicToDelete) {\n      setSubjects(subjects.map(s => {\n        if (s.id === topicToDelete.subjectId) {\n          return { ...s, topics: s.topics.filter(t => t.id !== topicToDelete.topicId) };\n        }\n        return s;\n      }));\n      setTopicToDelete(null);\n    }\n  };\n\n  const startEditingSubject = (e: React.MouseEvent, subject: Subject) => {\n    e.stopPropagation();\n    setEditingSubjectId(subject.id);\n    setEditValue(subject.name);\n  };\n\n  const saveSubjectName = (e: React.MouseEvent | React.KeyboardEvent) => {\n    e.stopPropagation();\n    if (!editValue.trim() || !editingSubjectId) return;\n    setSubjects(subjects.map(s => s.id === editingSubjectId ? { ...s, name: editValue } : s));\n    setEditingSubjectId(null);\n  };\n\n  const startEditingTopic = (topic: Topic) => {\n    setEditingTopicId(topic.id);\n    setEditValue(topic.title);\n  };\n\n  const saveTopicTitle = (subjectId: string, topicId: string) => {\n    if (!editValue.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => t.id === topicId ? { ...t, title: editValue } : t)\n        };\n      }\n      return s;\n    }));\n    setEditingTopicId(null);\n  };\n\n  const addTopic = (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: [...s.topics, { \n            id: Date.now().toString(), \n            title: newTopicTitle, \n            completed: false, \n            importance: 3 \n          }]\n        };\n      }\n      return s;\n    }));\n    setNewTopicTitle('');\n  };\n\n  const toggleTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const now = new Date().toISOString();\n              return { ...t, completed: !t.completed, lastStudiedAt: !t.completed ? now : t.lastStudiedAt };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 font-medium\">Gerencie suas disciplinas e tópicos de estudo.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Nova disciplina...\"\n            className=\"px-4 py-2 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-64\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject}\n            className=\"bg-indigo-600 text-white p-2 rounded-xl hover:bg-indigo-700 transition-all flex items-center justify-center shadow-lg shadow-indigo-100 shrink-0\"\n          >\n            <Plus size={24} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 && (\n          <div className=\"text-center py-20 bg-white rounded-3xl border border-dashed border-slate-300\">\n            <BookOpen className=\"mx-auto text-slate-300 mb-4\" size={48} />\n            <p className=\"text-slate-500 font-medium\">Nenhuma disciplina cadastrada. Adicione uma acima!</p>\n          </div>\n        )}\n\n        {subjects.map(subject => (\n          <div key={subject.id} className=\"bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n            <div \n              className=\"p-5 flex items-center justify-between cursor-pointer\"\n              onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n            >\n              <div className=\"flex items-center gap-4 flex-1\">\n                <div className=\"w-4 h-12 rounded-full shrink-0\" style={{ backgroundColor: subject.color }} />\n                {editingSubjectId === subject.id ? (\n                  <div className=\"flex items-center gap-2 flex-1\" onClick={(e) => e.stopPropagation()}>\n                    <input\n                      autoFocus\n                      type=\"text\"\n                      className=\"w-full px-3 py-1 border border-indigo-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500\"\n                      value={editValue}\n                      onChange={(e) => setEditValue(e.target.value)}\n                      onKeyDown={(e) => e.key === 'Enter' && saveSubjectName(e as any)}\n                    />\n                    <button onClick={(e) => saveSubjectName(e)} className=\"p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg\">\n                      <Check size={18} />\n                    </button>\n                    <button onClick={(e) => { e.stopPropagation(); setEditingSubjectId(null); }} className=\"p-2 text-slate-400 hover:bg-slate-50 rounded-lg\">\n                      <X size={18} />\n                    </button>\n                  </div>\n                ) : (\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"font-bold text-lg text-slate-800\">{subject.name}</h3>\n                      <button \n                        onClick={(e) => startEditingSubject(e, subject)}\n                        className=\"p-1 text-slate-300 hover:text-indigo-500 opacity-0 group-hover:opacity-100 transition-opacity\"\n                      >\n                        <Edit3 size={14} />\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-400 font-semibold uppercase tracking-widest\">\n                      {subject.topics.filter(t => t.completed).length} / {subject.topics.length} Tópicos\n                    </p>\n                  </div>\n                )}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <button \n                  onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }}\n                  className=\"text-slate-300 hover:text-red-500 transition-colors p-2\"\n                >\n                  <Trash2 size={20} />\n                </button>\n                {expandedSubject === subject.id ? <ChevronUp className=\"text-slate-400\" /> : <ChevronDown className=\"text-slate-400\" />}\n              </div>\n            </div>\n\n            {expandedSubject === subject.id && (\n              <div className=\"px-5 pb-5 pt-2 border-t border-slate-50 bg-slate-50/30\">\n                <div className=\"flex gap-2 mb-6\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Novo tópico para esta disciplina...\"\n                    className=\"flex-1 px-4 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none\"\n                    value={newTopicTitle}\n                    onChange={(e) => setNewTopicTitle(e.target.value)}\n                    onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                  />\n                  <button \n                    onClick={() => addTopic(subject.id)}\n                    className=\"bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-indigo-700 transition-all\"\n                  >\n                    Adicionar\n                  </button>\n                </div>\n\n                <div className=\"space-y-2\">\n                  {subject.topics.map(topic => (\n                    <div \n                      key={topic.id}\n                      className=\"group flex items-center justify-between p-3 rounded-xl bg-white border border-slate-100 transition-all hover:border-indigo-200\"\n                    >\n                      <div className=\"flex items-center gap-3 flex-1\">\n                        <button \n                          onClick={() => toggleTopic(subject.id, topic.id)}\n                          className={`transition-colors shrink-0 ${topic.completed ? 'text-emerald-500' : 'text-slate-300 hover:text-indigo-400'}`}\n                        >\n                          {topic.completed ? <CheckCircle size={22} /> : <Circle size={22} />}\n                        </button>\n                        \n                        {editingTopicId === topic.id ? (\n                          <div className=\"flex items-center gap-2 flex-1\">\n                            <input\n                              autoFocus\n                              type=\"text\"\n                              className=\"w-full px-2 py-1 text-sm border border-indigo-300 rounded outline-none focus:ring-1 focus:ring-indigo-500\"\n                              value={editValue}\n                              onChange={(e) => setEditValue(e.target.value)}\n                              onKeyDown={(e) => e.key === 'Enter' && saveTopicTitle(subject.id, topic.id)}\n                            />\n                            <button onClick={() => saveTopicTitle(subject.id, topic.id)} className=\"text-emerald-600\">\n                              <Check size={16} />\n                            </button>\n                            <button onClick={() => setEditingTopicId(null)} className=\"text-slate-400\">\n                              <X size={16} />\n                            </button>\n                          </div>\n                        ) : (\n                          <span className={`text-sm font-medium ${topic.completed ? 'text-slate-400 line-through' : 'text-slate-700'}`}>\n                            {topic.title}\n                          </span>\n                        )}\n                      </div>\n                      \n                      <div className=\"flex items-center gap-2 md:opacity-0 md:group-hover:opacity-100 transition-opacity ml-2\">\n                        {editingTopicId !== topic.id && (\n                          <button \n                            onClick={() => startEditingTopic(topic)}\n                            className=\"text-slate-300 hover:text-indigo-500 transition-colors\"\n                          >\n                            <Edit3 size={16} />\n                          </button>\n                        )}\n                        <span className=\"hidden sm:inline-block text-[10px] bg-amber-50 text-amber-600 px-2 py-1 rounded-full font-bold uppercase tracking-tighter\">\n                          P {topic.importance}\n                        </span>\n                        <button \n                          onClick={() => setTopicToDelete({ subjectId: subject.id, topicId: topic.id, title: topic.title })}\n                          className=\"text-slate-300 hover:text-red-400 transition-colors\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                  {subject.topics.length === 0 && (\n                    <p className=\"text-center text-slate-400 text-sm py-4\">Nenhum tópico adicionado.</p>\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n        ))}\n      </div>\n\n      {/* Subject Confirmation Modal */}\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"bg-white rounded-3xl shadow-2xl w-full max-w-sm overflow-hidden animate-in zoom-in-95 duration-200\">\n            <div className=\"p-6 text-center\">\n              <div className=\"w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4\">\n                <AlertTriangle size={32} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900 mb-2\">Excluir Disciplina?</h3>\n              <p className=\"text-slate-500 text-sm mb-6\">\n                Você está prestes a remover <span className=\"font-bold text-slate-700\">\"{subjectToDelete.name}\"</span>. Isso apagará todos os tópicos e progressos associados.\n              </p>\n              \n              <div className=\"flex flex-col gap-3\">\n                <button\n                  onClick={confirmRemoveSubject}\n                  className=\"w-full bg-red-500 text-white font-bold py-3 rounded-xl hover:bg-red-600 transition-colors shadow-lg shadow-red-100\"\n                >\n                  Confirmar Exclusão\n                </button>\n                <button\n                  onClick={() => setSubjectToDelete(null)}\n                  className=\"w-full bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition-colors\"\n                >\n                  Cancelar\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Topic Confirmation Modal */}\n      {topicToDelete && (\n        <div className=\"fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"bg-white rounded-3xl shadow-2xl w-full max-w-sm overflow-hidden animate-in zoom-in-95 duration-200\">\n            <div className=\"p-6 text-center\">\n              <div className=\"w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4\">\n                <AlertTriangle size={32} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900 mb-2\">Excluir Tópico?</h3>\n              <p className=\"text-slate-500 text-sm mb-6\">\n                Remover o tópico <span className=\"font-bold text-slate-700\">\"{topicToDelete.title}\"</span>?\n              </p>\n              \n              <div className=\"flex flex-col gap-3\">\n                <button\n                  onClick={confirmRemoveTopic}\n                  className=\"w-full bg-red-500 text-white font-bold py-3 rounded-xl hover:bg-red-600 transition-colors shadow-lg shadow-red-100\"\n                >\n                  Confirmar Exclusão\n                </button>\n                <button\n                  onClick={() => setTopicToDelete(null)}\n                  className=\"w-full bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition-colors\"\n                >\n                  Cancelar\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
    },
