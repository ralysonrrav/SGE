              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { ShieldCheck, Award, Lock, Mail, User as UserIcon, ArrowLeft } from 'lucide-react';\n\ninterface LoginProps {\n  onLogin: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = ({ onLogin }) => {\n  const [isRegistering, setIsRegistering] = useState(false);\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n  const [confirmPassword, setConfirmPassword] = useState('');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !password) return;\n\n    const allUsersStr = localStorage.getItem('global_users');\n    const allUsers: User[] = allUsersStr ? JSON.parse(allUsersStr) : [];\n\n    if (isRegistering) {\n      if (password !== confirmPassword) {\n        alert(\"As senhas não conferem!\");\n        return;\n      }\n      if (allUsers.find(u => u.email === email)) {\n        alert(\"E-mail já cadastrado!\");\n        return;\n      }\n\n      const role = email.toLowerCase() === 'admin@studyflow.com' ? 'admin' : 'student';\n      // Added missing isOnline property to satisfy the User interface.\n      const newUser: User = {\n        id: 'user_' + Date.now(),\n        name,\n        email,\n        password, // Em um app real, isso seria um hash\n        role,\n        status: 'active',\n        isOnline: false,\n        lastAccess: new Date().toISOString()\n      };\n      \n      localStorage.setItem('global_users', JSON.stringify([...allUsers, newUser]));\n      onLogin(newUser);\n    } else {\n      // Login Logic\n      const foundUser = allUsers.find(u => u.email === email && u.password === password);\n      \n      if (foundUser) {\n        onLogin({ ...foundUser, lastAccess: new Date().toISOString(), status: 'active' });\n      } else if (email === 'admin@studyflow.com' && password === 'admin') {\n        // Fallback para admin inicial se a lista estiver vazia\n        // Added missing isOnline property to satisfy the User interface.\n        const admin: User = {\n          id: 'admin_01',\n          name: 'Administrador Master',\n          email: 'admin@studyflow.com',\n          password: 'admin',\n          role: 'admin',\n          status: 'active',\n          isOnline: false,\n          lastAccess: new Date().toISOString()\n        };\n        onLogin(admin);\n      } else {\n        alert(\"E-mail ou senha incorretos!\");\n      }\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-4 transition-colors duration-300\">\n      <div className=\"max-w-md w-full bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl border border-slate-100 dark:border-slate-800 p-10 relative overflow-hidden\">\n        \n        <div className=\"absolute top-0 right-0 w-32 h-32 bg-indigo-50 dark:bg-indigo-900/10 rounded-full blur-3xl -mr-16 -mt-16\" />\n\n        <div className=\"text-center mb-10 relative\">\n          <div className=\"mx-auto w-20 h-20 bg-indigo-600 rounded-3xl flex items-center justify-center text-white shadow-2xl mb-6 transition-transform hover:scale-105 cursor-pointer\">\n            <Award size={40} />\n          </div>\n          <h1 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">\n            {isRegistering ? 'Criar Conta' : 'StudyFlow'}\n          </h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-2 font-medium\">\n            {isRegistering ? 'Junte-se a milhares de aprovados.' : 'Sua jornada para a aprovação começa aqui.'}\n          </p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-5 relative\">\n          {isRegistering && (\n            <div className=\"relative group\">\n              <UserIcon className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n              <input\n                type=\"text\"\n                required\n                className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\"\n                placeholder=\"Seu Nome Completo\"\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n              />\n            </div>\n          )}\n\n          <div className=\"relative group\">\n            <Mail className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n            <input\n              type=\"email\"\n              required\n              className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\"\n              placeholder=\"seu@email.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n            />\n          </div>\n\n          <div className=\"relative group\">\n            <Lock className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n            <input\n              type=\"password\"\n              required\n              className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\"\n              placeholder=\"Sua Senha\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n\n          {isRegistering && (\n            <div className=\"relative group\">\n              <ShieldCheck className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n              <input\n                type=\"password\"\n                required\n                className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\"\n                placeholder=\"Confirmar Senha\"\n                value={confirmPassword}\n                onChange={(e) => setConfirmPassword(e.target.value)}\n              />\n            </div>\n          )}\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-indigo-600 text-white font-black py-5 rounded-2xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 dark:shadow-none flex items-center justify-center gap-3\"\n          >\n            <ShieldCheck size={22} />\n            {isRegistering ? 'CRIAR MINHA CONTA' : 'ACESSAR PLATAFORMA'}\n          </button>\n        </form>\n\n        <div className=\"mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center\">\n          <button \n            onClick={() => setIsRegistering(!isRegistering)}\n            className=\"text-indigo-600 dark:text-indigo-400 text-sm font-bold hover:underline\"\n          >\n            {isRegistering ? 'Já tenho uma conta. Fazer Login' : 'Não tem conta? Cadastre-se agora'}\n          </button>\n          {!isRegistering && (\n             <p className=\"text-slate-400 dark:text-slate-600 text-[10px] font-black uppercase tracking-tighter mt-4\">\n              Dica: Use <span className=\"text-indigo-600\">admin@studyflow.com</span> para gestão.\n            </p>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
            }
          ]
        }
      ]
    },
