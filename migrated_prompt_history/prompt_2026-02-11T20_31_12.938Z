          "path": "components/Revisao.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Suporte para dark mode no painel de revisões espaçadas.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  RefreshCcw, \n  Bell, \n  CheckCircle, \n  Calendar, \n  Clock, \n  Target, \n  Check, \n  Activity,\n  ArrowRight,\n  AlertCircle,\n  History,\n  X,\n  CheckCircle2\n} from 'lucide-react';\n\ninterface RevisaoProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\nconst Revisao: React.FC<RevisaoProps> = ({ subjects, setSubjects, onAddLog }) => {\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editMinutes, setEditMinutes] = useState(0);\n  const [editAttempted, setEditAttempted] = useState(0);\n  const [editCorrect, setEditCorrect] = useState(0);\n  const [selectedMilestone, setSelectedMilestone] = useState<number | null>(null);\n\n  const topics = subjects.flatMap(s => s.topics.filter(t => t.completed && t.lastStudiedAt).map(t => ({ subject: s, topic: t })))\n    .sort((a, b) => new Date(b.topic.lastStudiedAt!).getTime() - new Date(a.topic.lastStudiedAt!).getTime());\n\n  const saveStats = (subjectId: string, topicId: string) => {\n    if (!selectedMilestone) return alert(\"Selecione o marco.\");\n    setSubjects(subjects.map(s => s.id === subjectId ? { ...s, topics: s.topics.map(t => t.id === topicId ? { ...t, studyTimeMinutes: (t.studyTimeMinutes || 0) + editMinutes, questionsAttempted: (t.questionsAttempted || 0) + editAttempted, questionsCorrect: (t.questionsCorrect || 0) + editCorrect, revisionsDone: [...(t.revisionsDone || []), selectedMilestone] } : t) } : s));\n    if (editMinutes > 0) onAddLog(editMinutes, topicId, subjectId);\n    setEditingTopicId(null);\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">Painel de Revisões</h2>\n        <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Ciclo fixo de 7, 15 e 30 dias baseado na conclusão original.</p>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-4\">\n          {topics.length === 0 ? (\n            <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-dashed border-slate-300 dark:border-slate-800 p-20 text-center\">\n              <RefreshCcw size={40} className=\"mx-auto mb-6 text-slate-200 dark:text-slate-800\" />\n              <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-200\">Nada para revisar</h3>\n            </div>\n          ) : topics.map(({ subject, topic }) => {\n            const done = topic.revisionsDone || [];\n            return (\n              <div key={topic.id} className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden p-6\">\n                <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"w-2 h-10 rounded-full\" style={{ backgroundColor: subject.color }} />\n                    <div>\n                      <p className=\"text-[10px] font-black uppercase tracking-widest text-slate-400\">{subject.name}</p>\n                      <h3 className=\"font-bold text-slate-800 dark:text-slate-100 text-lg\">{topic.title}</h3>\n                    </div>\n                  </div>\n                  <button onClick={() => setEditingTopicId(topic.id)} className=\"bg-indigo-600 text-white px-6 py-2.5 rounded-xl text-sm font-bold\">Revisar Agora</button>\n                </div>\n                <div className=\"grid grid-cols-3 gap-3\">\n                  {[7, 15, 30].map(d => (\n                    <div key={d} className={`p-3 rounded-2xl border ${done.includes(d) ? 'bg-emerald-50 dark:bg-emerald-900/10 border-emerald-100 dark:border-emerald-900/30 text-emerald-600' : 'bg-slate-50 dark:bg-slate-800/50 border-slate-100 dark:border-slate-800 text-slate-500'}`}>\n                      <span className=\"text-[10px] font-bold uppercase\">{d} Dias</span>\n                      {done.includes(d) && <CheckCircle2 size={12} className=\"mt-1\" />}\n                    </div>\n                  ))}\n                </div>\n                {editingTopicId === topic.id && (\n                  <div className=\"mt-6 p-5 bg-indigo-50/50 dark:bg-indigo-900/10 border border-indigo-100 dark:border-indigo-900/30 rounded-2xl animate-in zoom-in-95\">\n                    <div className=\"flex gap-2 mb-4\">{[7, 15, 30].map(m => (<button key={m} onClick={() => setSelectedMilestone(m)} className={`flex-1 py-2 rounded-lg text-xs font-bold ${selectedMilestone === m ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-slate-900 dark:text-slate-400 border border-slate-200 dark:border-slate-800'}`}>{m}d</button>))}</div>\n                    <div className=\"grid grid-cols-3 gap-3\">\n                      <input type=\"number\" placeholder=\"Minutos\" className=\"px-3 py-2 rounded-lg bg-white dark:bg-slate-950 dark:text-white border border-slate-200 dark:border-slate-800\" value={editMinutes} onChange={e => setEditMinutes(parseInt(e.target.value) || 0)} />\n                      <input type=\"number\" placeholder=\"Questões\" className=\"px-3 py-2 rounded-lg bg-white dark:bg-slate-950 dark:text-white border border-slate-200 dark:border-slate-800\" value={editAttempted} onChange={e => setEditAttempted(parseInt(e.target.value) || 0)} />\n                      <input type=\"number\" placeholder=\"Acertos\" className=\"px-3 py-2 rounded-lg bg-white dark:bg-slate-950 dark:text-white border border-slate-200 dark:border-slate-800\" value={editCorrect} onChange={e => setEditCorrect(parseInt(e.target.value) || 0)} />\n                    </div>\n                    <div className=\"flex justify-end gap-2 mt-4\"><button onClick={() => setEditingTopicId(null)} className=\"px-4 py-2 text-xs text-slate-500\">Cancel</button><button onClick={() => saveStats(subject.id, topic.id)} className=\"px-6 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold\">Finalizar</button></div>\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n        <div className=\"space-y-6\">\n          <div className=\"bg-slate-900 dark:bg-indigo-950/40 text-white p-8 rounded-[2rem] shadow-xl relative overflow-hidden group\">\n            <h3 className=\"text-xl font-bold mb-4\">Curva do Esquecimento</h3>\n            <p className=\"text-slate-400 dark:text-indigo-200 text-sm leading-relaxed\">As revisões são marcos fixos que não postergam. Mantenha a disciplina nos ciclos de 7, 15 e 30 dias para memorização definitiva.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Revisao;\n"
            }
          ]
        }
      ]
