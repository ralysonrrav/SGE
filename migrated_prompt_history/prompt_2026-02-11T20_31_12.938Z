          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon,\n  ShieldAlert,\n  Users,\n  Database,\n  Zap,\n  Target,\n  AlertCircle,\n  Sparkles\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession, PredefinedEdital } from './types';\nimport { supabase } from './lib/supabase';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\nimport Admin from './components/Admin';\nimport Profile from './components/Profile';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [predefinedEditais, setPredefinedEditais] = useState<PredefinedEdital[]>([]);\n  const [allUsers, setAllUsers] = useState<User[]>([]);\n\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const [isLoaded, setIsLoaded] = useState(false);\n  const [isDemoMode, setIsDemoMode] = useState(false);\n  \n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    if (saved) return saved === 'dark';\n    return window.matchMedia('(prefers-color-scheme: dark)').matches;\n  });\n\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (isDarkMode) {\n      root.classList.add('dark');\n      localStorage.setItem('theme', 'dark');\n    } else {\n      root.classList.remove('dark');\n      localStorage.setItem('theme', 'light');\n    }\n  }, [isDarkMode]);\n\n  useEffect(() => {\n    const checkAuth = async () => {\n      if (!supabase) {\n        setIsLoaded(true);\n        return;\n      }\n\n      const { data: { session } } = await supabase.auth.getSession();\n      \n      if (session?.user) {\n        const { data: profile } = await supabase\n          .from('profiles')\n          .select('*')\n          .eq('id', session.user.id)\n          .maybeSingle();\n\n        const userData: User = {\n          id: session.user.id,\n          name: profile?.name || session.user.user_metadata?.full_name || 'Usuário',\n          email: session.user.email!,\n          role: profile?.role || 'student',\n          status: profile?.status || 'active',\n          isOnline: true,\n          weeklyGoal: profile?.weekly_goal || 20\n        };\n\n        setUser(userData);\n        fetchUserData(userData.id);\n      }\n      setIsLoaded(true);\n    };\n\n    checkAuth();\n\n    if (supabase) {\n      const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, session) => {\n        if (event === 'SIGNED_IN' && session) {\n          checkAuth();\n        } else if (event === 'SIGNED_OUT') {\n          if (!isDemoMode) {\n            setUser(null);\n            setSubjects([]);\n            setMocks([]);\n            setStudyLogs([]);\n          }\n        }\n      });\n      return () => subscription.unsubscribe();\n    }\n  }, [isDemoMode]);\n\n  const fetchUserData = async (userId: string) => {\n    if (!supabase || isDemoMode) return;\n\n    // Ajustado para ler a tabela 'subjects' com a coluna 'topics' (JSONB)\n    const { data: subData, error: subError } = await supabase\n      .from('subjects')\n      .select('*');\n    \n    if (subError) {\n      console.error(\"Erro ao carregar disciplinas:\", subError.message);\n    } else if (subData) {\n      // Garantir que topics seja um array se vier nulo do banco\n      const mappedSubjects = subData.map(s => ({\n        ...s,\n        id: s.id.toString(), // Converter BIGINT para String para a UI\n        topics: s.topics || []\n      }));\n      setSubjects(mappedSubjects);\n    }\n\n    const { data: mockData } = await supabase\n      .from('mock_exams')\n      .select('*')\n      .eq('user_id', userId);\n    \n    if (mockData) setMocks(mockData);\n\n    const { data: logData } = await supabase\n      .from('study_logs')\n      .select('*')\n      .eq('user_id', userId);\n    \n    if (logData) setStudyLogs(logData);\n\n    const { data: cycleData } = await supabase\n      .from('study_cycles')\n      .select('*')\n      .eq('user_id', userId)\n      .maybeSingle();\n    \n    if (cycleData) setCycle(cycleData);\n  };\n\n  const handleUpdateUser = async (updatedUser: User) => {\n    setUser(updatedUser);\n    if (!supabase || isDemoMode) return;\n\n    const { error } = await supabase\n      .from('profiles')\n      .upsert({ \n        id: updatedUser.id,\n        name: updatedUser.name, \n        weekly_goal: updatedUser.weeklyGoal \n      });\n    \n    if (error) console.error(\"Erro ao atualizar perfil:\", error);\n  };\n\n  const handleLogout = async () => {\n    if (supabase) await supabase.auth.signOut();\n    setUser(null);\n    setIsDemoMode(false);\n  };\n\n  const handleLogin = (loggedUser: User) => {\n    setUser(loggedUser);\n    if (loggedUser.id === 'demo-user') {\n      setIsDemoMode(true);\n    }\n  };\n\n  if (!isLoaded) return (\n    <div className=\"min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950\">\n      <div className=\"animate-spin rounded-full h-12 w-12 border-4 border-indigo-600 border-t-transparent\"></div>\n    </div>\n  );\n\n  if (!supabase) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950 p-6\">\n        <div className=\"max-w-md w-full bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] shadow-2xl border border-rose-100 text-center\">\n          <AlertCircle size={48} className=\"text-rose-500 mx-auto mb-4\" />\n          <h2 className=\"text-2xl font-black text-slate-900 dark:text-slate-100\">Erro de Conexão</h2>\n          <p className=\"text-slate-500 mt-4 font-medium\">O banco de dados (Supabase) não foi configurado corretamente.</p>\n          <p className=\"text-xs text-slate-400 mt-6 uppercase font-black tracking-widest\">Verifique suas VITE_KEYS no painel da Vercel</p>\n        </div>\n      </div>\n    );\n  }\n\n  if (!user) {\n    return <Login users={[]} onLogin={handleLogin} onRegister={() => {}} />;\n  }\n\n  const renderPage = () => {\n    if (user.role === 'admin') {\n      return (\n        <Admin \n          users={allUsers} setUsers={setAllUsers}\n          editais={predefinedEditais} setEditais={setPredefinedEditais} \n          view={currentPage.includes('dashboard') ? 'users' : 'editais'}\n        />\n      );\n    }\n\n    switch (currentPage) {\n      case 'inicio': return (\n        <Dashboard \n          subjects={subjects} mocks={mocks} cycle={cycle} \n          studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20}\n          onUpdateGoal={(hours) => handleUpdateUser({ ...user, weeklyGoal: hours })}\n          isDarkMode={isDarkMode}\n        />\n      );\n      case 'disciplinas': return (\n        <Disciplinas \n          subjects={subjects} setSubjects={setSubjects} \n          predefinedEditais={predefinedEditais}\n          onAddLog={(minutes, topicId, subjectId) => {\n            const newLog: StudySession = { id: Date.now().toString(), minutes, topicId, subjectId, date: new Date().toISOString(), type: 'estudo' };\n            setStudyLogs(prev => [...prev, newLog]);\n          }}\n        />\n      );\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return (\n        <Revisao \n          subjects={subjects} setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => {\n            const newLog: StudySession = { id: Date.now().toString(), minutes, topicId, subjectId, date: new Date().toISOString(), type: 'revisao' };\n            setStudyLogs(prev => [...prev, newLog]);\n          }}\n        />\n      );\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={(hours) => handleUpdateUser({ ...user, weeklyGoal: hours })} isDarkMode={isDarkMode} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-white dark:bg-slate-950 overflow-hidden transition-colors duration-500\">\n      \n      {isDemoMode && (\n        <div className=\"fixed bottom-6 right-6 z-50 bg-amber-500 text-white px-6 py-3 rounded-2xl shadow-2xl font-black text-xs flex items-center gap-2 animate-bounce\">\n          <Sparkles size={16} /> MODO DEMONSTRAÇÃO ATIVO\n        </div>\n      )}\n\n      <button className=\"md:hidden fixed top-6 left-6 z-50 p-3 bg-indigo-600 text-white rounded-2xl shadow-xl\" onClick={() => setIsSidebarOpen(!isSidebarOpen)}>\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      <aside className={`fixed inset-y-0 left-0 z-40 w-72 bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 md:translate-x-0 ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-8 flex items-center gap-4\">\n            <div className={`w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-lg ${user.role === 'admin' ? 'bg-rose-600' : 'bg-indigo-600'}`}>\n              {user.role === 'admin' ? <ShieldAlert size={28} /> : <Award size={28} />}\n            </div>\n            <div>\n              <h1 className=\"text-xl font-black text-slate-900 dark:text-slate-100 leading-none\">StudyFlow</h1>\n              <p className={`text-[10px] font-black uppercase tracking-widest mt-1 ${user.role === 'admin' ? 'text-rose-600' : 'text-indigo-600'}`}>\n                {user.role === 'admin' ? 'Admin' : 'Concursos'}\n              </p>\n            </div>\n          </div>\n\n          <nav className=\"flex-1 px-4 py-4 space-y-2\">\n            {(user.role === 'admin' ? [\n              { id: 'admin_dashboard', label: 'Gestão de Usuários', icon: <Users size={20} /> },\n              { id: 'admin_editais', label: 'Catálogo de Editais', icon: <Database size={20} /> },\n            ] : [\n              { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n              { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n              { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n              { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n              { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n            ]).map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`w-full flex items-center gap-3 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all ${currentPage === item.id ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800'}`}\n              >\n                {item.icon} {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-6 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n            <div className=\"bg-slate-200 dark:bg-slate-950 p-1 rounded-2xl flex items-center\">\n              <button onClick={() => setIsDarkMode(false)} className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${!isDarkMode ? 'bg-white text-indigo-600 shadow-md font-black' : 'text-slate-500'}`}>\n                <Sun size={18} /> <span className=\"text-xs\">Claro</span>\n              </button>\n              <button onClick={() => setIsDarkMode(true)} className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${isDarkMode ? 'bg-slate-800 text-indigo-400 shadow-md font-black' : 'text-slate-500'}`}>\n                <Moon size={18} /> <span className=\"text-xs\">Escuro</span>\n              </button>\n            </div>\n            <div className=\"flex items-center gap-3 p-3 bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-800 relative group\">\n              <div className=\"w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-black cursor-pointer\" onClick={() => setIsProfileOpen(true)}>\n                {user.name.charAt(0)}\n              </div>\n              <div className=\"flex-1 truncate cursor-pointer\" onClick={() => setIsProfileOpen(true)}>\n                <p className=\"text-sm font-bold text-slate-900 dark:text-slate-100 leading-none\">{user.name}</p>\n                <p className=\"text-[10px] text-slate-500 mt-1\">Configurações</p>\n              </div>\n              <button onClick={handleLogout} className=\"p-2 text-rose-500 hover:bg-rose-50 rounded-xl\">\n                <LogOut size={18} />\n              </button>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      <main className=\"flex-1 md:ml-72 overflow-y-auto bg-white dark:bg-slate-950 transition-colors\">\n        <div className=\"max-w-6xl mx-auto p-6 md:p-12\">\n          {renderPage()}\n        </div>\n      </main>\n\n      {isProfileOpen && (\n        <Profile \n          user={user} onUpdate={handleUpdateUser} \n          onDelete={() => {}} \n          onClose={() => setIsProfileOpen(false)}\n          onExport={() => {}} onImport={() => {}}\n        />\n      )}\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação de persistência real com Supabase na tabela 'subjects' usando a coluna JSONB 'topics'.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic, PredefinedEdital } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  BookOpen, \n  X, \n  Edit3, \n  Check,\n  Layers,\n  Database,\n  ArrowRight,\n  Clock,\n  Target,\n  Trophy,\n  Activity,\n  Zap,\n  Loader2\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  predefinedEditais: PredefinedEdital[];\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\ninterface TopicToDelete {\n  subjectId: string;\n  topicId: string;\n  title: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, predefinedEditais, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [loading, setLoading] = useState(false);\n  \n  // Modals state\n  const [isCatalogOpen, setIsCatalogOpen] = useState(false);\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<TopicToDelete | null>(null);\n\n  // Performance logging states\n  const [loggingTopicId, setLoggingTopicId] = useState<string | null>(null);\n  const [logHours, setLogHours] = useState('1');\n  const [logMinutes, setLogMinutes] = useState('0');\n  const [logAttempted, setLogAttempted] = useState('0');\n  const [logCorrect, setLogCorrect] = useState('0');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = async () => {\n    if (!newSubjectName.trim() || !supabase) return;\n    setLoading(true);\n\n    const color = colors[subjects.length % colors.length];\n    \n    // Inserir no Supabase\n    const { data, error } = await supabase\n      .from('subjects')\n      .insert([{ name: newSubjectName, topics: [], color: color }])\n      .select()\n      .single();\n\n    if (error) {\n      alert(\"Erro ao salvar disciplina: \" + error.message);\n    } else if (data) {\n      const newSub: Subject = {\n        id: data.id.toString(),\n        name: data.name,\n        topics: data.topics || [],\n        color: data.color || color\n      };\n      setSubjects([...subjects, newSub]);\n      setNewSubjectName('');\n    }\n    setLoading(false);\n  };\n\n  const removeSubject = async (subjectId: string) => {\n    if (!supabase) return;\n    setLoading(true);\n    \n    const { error } = await supabase\n      .from('subjects')\n      .delete()\n      .eq('id', subjectId);\n\n    if (error) {\n      alert(\"Erro ao excluir: \" + error.message);\n    } else {\n      setSubjects(subjects.filter(s => s.id !== subjectId));\n      setSubjectToDelete(null);\n    }\n    setLoading(false);\n  };\n\n  const updateSubjectTopics = async (subjectId: string, updatedTopics: Topic[]) => {\n    if (!supabase) return;\n    \n    const { error } = await supabase\n      .from('subjects')\n      .update({ topics: updatedTopics })\n      .eq('id', subjectId);\n\n    if (error) {\n      console.error(\"Erro ao atualizar tópicos:\", error.message);\n      return false;\n    }\n    return true;\n  };\n\n  const addTopic = async (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    \n    const targetSubject = subjects.find(s => s.id === subjectId);\n    if (!targetSubject) return;\n\n    const newTopic: Topic = { \n      id: Math.random().toString(36).substr(2, 9), \n      title: newTopicTitle, \n      completed: false, \n      importance: 3,\n      studyTimeMinutes: 0,\n      questionsAttempted: 0,\n      questionsCorrect: 0\n    };\n\n    const updatedTopics = [...targetSubject.topics, newTopic];\n    \n    const success = await updateSubjectTopics(subjectId, updatedTopics);\n    if (success) {\n      setSubjects(subjects.map(s => s.id === subjectId ? { ...s, topics: updatedTopics } : s));\n      setNewTopicTitle('');\n    }\n  };\n\n  const toggleTopicCompletion = async (subjectId: string, topicId: string) => {\n    const targetSubject = subjects.find(s => s.id === subjectId);\n    if (!targetSubject) return;\n\n    const updatedTopics = targetSubject.topics.map(t => \n      t.id === topicId ? { \n        ...t, \n        completed: !t.completed, \n        lastStudiedAt: !t.completed ? new Date().toISOString() : t.lastStudiedAt \n      } : t\n    );\n\n    const success = await updateSubjectTopics(subjectId, updatedTopics);\n    if (success) {\n      setSubjects(subjects.map(s => s.id === subjectId ? { ...s, topics: updatedTopics } : s));\n    }\n  };\n\n  const handleSavePerformance = async (subjectId: string, topicId: string) => {\n    const h = parseInt(logHours) || 0;\n    const m = parseInt(logMinutes) || 0;\n    const totalMinutes = (h * 60) + m;\n    const attempted = parseInt(logAttempted) || 0;\n    const correct = parseInt(logCorrect) || 0;\n\n    if (totalMinutes <= 0 && attempted <= 0) return;\n\n    const targetSubject = subjects.find(s => s.id === subjectId);\n    if (!targetSubject) return;\n\n    const updatedTopics = targetSubject.topics.map(t => t.id === topicId ? { \n      ...t, \n      studyTimeMinutes: (t.studyTimeMinutes || 0) + totalMinutes,\n      questionsAttempted: (t.questionsAttempted || 0) + attempted,\n      questionsCorrect: (t.questionsCorrect || 0) + correct,\n      lastStudiedAt: new Date().toISOString()\n    } : t);\n\n    const success = await updateSubjectTopics(subjectId, updatedTopics);\n    if (success) {\n      onAddLog(totalMinutes, topicId, subjectId);\n      setSubjects(prev => prev.map(s => s.id === subjectId ? { ...s, topics: updatedTopics } : s));\n      setLoggingTopicId(null);\n      setLogHours('1'); setLogMinutes('0'); setLogAttempted('0'); setLogCorrect('0');\n    }\n  };\n\n  const deleteTopic = async (subjectId: string, topicId: string) => {\n    const targetSubject = subjects.find(s => s.id === subjectId);\n    if (!targetSubject) return;\n\n    const updatedTopics = targetSubject.topics.filter(t => t.id !== topicId);\n    const success = await updateSubjectTopics(subjectId, updatedTopics);\n    if (success) {\n      setSubjects(subjects.map(s => s.id === subjectId ? { ...s, topics: updatedTopics } : s));\n      setTopicToDelete(null);\n    }\n  };\n\n  const getAccuracyColor = (perc: number) => {\n    if (perc >= 80) return 'text-emerald-500';\n    if (perc >= 60) return 'text-amber-500';\n    return 'text-rose-500';\n  };\n\n  const getAccuracyBg = (perc: number) => {\n    if (perc >= 80) return 'bg-emerald-50 dark:bg-emerald-900/20';\n    if (perc >= 60) return 'bg-amber-50 dark:bg-amber-900/20';\n    return 'bg-rose-50 dark:bg-rose-900/20';\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight transition-colors\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium transition-colors\">Sincronizado em tempo real com seu banco Supabase.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            disabled={loading}\n            placeholder=\"Nova disciplina...\"\n            className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-48 shadow-sm transition-all text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-900 font-bold disabled:opacity-50\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject} \n            disabled={loading}\n            className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all shadow-lg shrink-0 disabled:opacity-50\"\n          >\n            {loading ? <Loader2 className=\"animate-spin\" size={24} /> : <Plus size={24} />}\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.map(subject => {\n          const completedT = subject.topics.filter(t => t.completed).length;\n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n              <div className=\"p-5 flex items-center justify-between cursor-pointer\" onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}>\n                <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                  <div className=\"w-3 h-10 rounded-full\" style={{ backgroundColor: subject.color }} />\n                  <div className=\"flex-1 min-w-0\">\n                    <h3 className=\"font-bold text-lg text-slate-800 dark:text-slate-100 truncate\">{subject.name}</h3>\n                    <p className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest\">{completedT} / {subject.topics.length} concluídos</p>\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-3\">\n                  <button onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }} className=\"p-2 text-rose-500 bg-rose-50 dark:bg-rose-900/20 rounded-xl hover:bg-rose-600 hover:text-white transition-all\"><Trash2 size={18} /></button>\n                  <div className={`p-2 rounded-xl ${expandedSubject === subject.id ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-400'}`}>\n                    {expandedSubject === subject.id ? <ChevronUp size={18} /> : <ChevronDown size={18} />}\n                  </div>\n                </div>\n              </div>\n\n              {expandedSubject === subject.id && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800 space-y-3\">\n                   <div className=\"flex gap-2 mb-4\">\n                      <input type=\"text\" placeholder=\"Novo tópico...\" className=\"flex-1 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 outline-none text-sm font-medium text-slate-900 dark:text-slate-100\" value={newTopicTitle} onChange={(e) => setNewTopicTitle(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)} />\n                      <button onClick={() => addTopic(subject.id)} className=\"bg-slate-800 dark:bg-slate-700 text-white px-6 rounded-xl font-bold text-sm\">Add</button>\n                   </div>\n                   {subject.topics.map(topic => {\n                     const acc = (topic.questionsAttempted || 0) > 0 ? Math.round((topic.questionsCorrect! / topic.questionsAttempted!) * 100) : 0;\n                     return (\n                        <div key={topic.id} className=\"flex flex-col gap-2 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-800 group transition-colors\">\n                          <div className=\"flex items-center gap-4\">\n                              <button onClick={() => toggleTopicCompletion(subject.id, topic.id)} className={`transition-all ${topic.completed ? 'text-emerald-500' : 'text-slate-300'}`}>\n                                <CheckCircle size={22} />\n                              </button>\n                              <div className=\"flex-1 min-w-0\">\n                                <div className=\"flex items-center gap-2\">\n                                  <span className={`text-sm font-bold truncate ${topic.completed ? 'text-slate-400 line-through' : 'text-slate-700 dark:text-slate-200'}`}>{topic.title}</span>\n                                  {topic.questionsAttempted ? topic.questionsAttempted > 0 && (\n                                    <span className={`px-2 py-0.5 rounded-full text-[9px] font-black uppercase ${getAccuracyBg(acc)} ${getAccuracyColor(acc)}`}>\n                                      <Trophy size={10} className=\"inline mr-1\" /> {acc}% Acertos\n                                    </span>\n                                  ) : null}\n                                </div>\n                                <div className=\"flex items-center gap-3 mt-1 text-[9px] font-black text-slate-400 uppercase tracking-tighter\">\n                                  {topic.studyTimeMinutes ? <span className=\"flex items-center gap-1\"><Clock size={10} /> {Math.floor(topic.studyTimeMinutes / 60)}h {topic.studyTimeMinutes % 60}m</span> : null}\n                                  {topic.questionsAttempted ? <span className=\"flex items-center gap-1\"><Target size={10} /> {topic.questionsCorrect}/{topic.questionsAttempted} Q</span> : null}\n                                </div>\n                              </div>\n                              <div className=\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                                <button onClick={() => setLoggingTopicId(topic.id)} className=\"p-2 text-emerald-500 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 rounded-lg\"><Activity size={14} /></button>\n                                <button onClick={() => setTopicToDelete({ subjectId: subject.id, topicId: topic.id, title: topic.title })} className=\"p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-lg\"><Trash2 size={14} /></button>\n                              </div>\n                          </div>\n\n                          {loggingTopicId === topic.id && (\n                            <div className=\"mt-2 p-5 bg-white dark:bg-slate-900 rounded-2xl border border-indigo-100 dark:border-indigo-900/30 animate-in slide-in-from-top-2 shadow-sm\">\n                              <div className=\"flex items-center justify-between mb-4\">\n                                <h4 className=\"text-[10px] font-black text-indigo-600 uppercase tracking-widest flex items-center gap-2\"><Zap size={14} /> Registrar Performance</h4>\n                                <button onClick={() => setLoggingTopicId(null)} className=\"text-slate-400\"><X size={16} /></button>\n                              </div>\n                              <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                                <div><label className=\"text-[9px] font-black text-slate-400 uppercase mb-1 block\">Horas</label><input type=\"number\" className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 font-bold text-sm text-slate-900 dark:text-white\" value={logHours} onChange={(e) => setLogHours(e.target.value)} /></div>\n                                <div><label className=\"text-[9px] font-black text-slate-400 uppercase mb-1 block\">Minutos</label><input type=\"number\" className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 font-bold text-sm text-slate-900 dark:text-white\" value={logMinutes} onChange={(e) => setLogMinutes(e.target.value)} /></div>\n                                <div><label className=\"text-[9px] font-black text-slate-400 uppercase mb-1 block\">Questões</label><input type=\"number\" className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 font-bold text-sm text-slate-900 dark:text-white\" value={logAttempted} onChange={(e) => setLogAttempted(e.target.value)} /></div>\n                                <div><label className=\"text-[9px] font-black text-slate-400 uppercase mb-1 block\">Acertos</label><input type=\"number\" className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 font-bold text-sm text-slate-900 dark:text-white\" value={logCorrect} onChange={(e) => setLogCorrect(e.target.value)} /></div>\n                              </div>\n                              <button onClick={() => handleSavePerformance(subject.id, topic.id)} className=\"mt-4 w-full bg-indigo-600 text-white font-black py-2 rounded-xl flex items-center justify-center gap-2\"><Check size={16} /> CONFIRMAR NO BANCO</button>\n                            </div>\n                          )}\n                        </div>\n                     );\n                   })}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-md rounded-[2rem] p-8 text-center border border-slate-100 dark:border-slate-800 shadow-2xl\">\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 mb-4\">Excluir do Banco de Dados?</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 mb-8 font-medium\">Remover <strong>{subjectToDelete.name}</strong> permanentemente do seu Supabase?</p>\n            <div className=\"flex flex-col gap-3\">\n              <button onClick={() => removeSubject(subjectToDelete.id)} className=\"w-full bg-rose-500 text-white font-black py-4 rounded-xl\">SIM, EXCLUIR AGORA</button>\n              <button onClick={() => setSubjectToDelete(null)} className=\"w-full text-slate-500 font-bold py-4\">CANCELAR</button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {topicToDelete && (\n        <div className=\"fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-md rounded-[2rem] p-8 text-center border border-slate-100 dark:border-slate-800 shadow-2xl\">\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 mb-4\">Remover Tópico?</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 mb-8 font-medium\">Remover o tópico \"{topicToDelete.title}\"?</p>\n            <div className=\"flex flex-col gap-3\">\n              <button onClick={() => deleteTopic(topicToDelete.subjectId, topicToDelete.topicId)} className=\"w-full bg-rose-500 text-white font-black py-4 rounded-xl\">CONFIRMAR REMOÇÃO</button>\n              <button onClick={() => setTopicToDelete(null)} className=\"w-full text-slate-500 font-bold py-4\">VOLTAR</button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
    },
