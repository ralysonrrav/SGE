          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { ShieldCheck, Award, Lock, Mail, User as UserIcon, Info, AlertTriangle, CheckCircle2, RefreshCw } from 'lucide-react';\n\ninterface LoginProps {\n  users: User[];\n  onLogin: (user: User) => void;\n  onRegister: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = () => {\n  const [isRegistering, setIsRegistering] = useState(false);\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n  const [confirmPassword, setConfirmPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [resending, setResending] = useState(false);\n  const [error, setError] = useState<{ msg: string; type: 'error' | 'warning' | 'info' | 'success'; code?: string } | null>(null);\n\n  const handleResendEmail = async () => {\n    if (!supabase || !email) return;\n    setResending(true);\n    const { error: resendError } = await supabase.auth.resend({\n      type: 'signup',\n      email: email,\n    });\n\n    if (resendError) {\n      setError({ msg: \"Erro ao reenviar: \" + resendError.message, type: 'error' });\n    } else {\n      setError({ msg: \"E-mail de confirmação reenviado! Verifique sua caixa de entrada e spam.\", type: 'success' });\n    }\n    setResending(false);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n\n    if (!supabase) {\n      setError({ msg: \"Banco de dados não configurado corretamente.\", type: 'error' });\n      return;\n    }\n\n    setLoading(true);\n\n    if (isRegistering) {\n      if (password !== confirmPassword) {\n        setError({ msg: \"As senhas não coincidem!\", type: 'error' });\n        setLoading(false);\n        return;\n      }\n      \n      const { data, error: signUpError } = await supabase.auth.signUp({\n        email,\n        password,\n        options: {\n          data: { full_name: name }\n        }\n      });\n\n      if (signUpError) {\n        setError({ msg: signUpError.message, type: 'error' });\n      } else if (data.user) {\n        // Se a sessão for nula, significa que o e-mail precisa de confirmação\n        if (!data.session) {\n          setError({ \n            msg: \"Conta criada! Enviamos um link de confirmação para seu e-mail. Você precisa clicar nele antes de acessar.\", \n            type: 'warning',\n            code: 'email_not_confirmed'\n          });\n        } else {\n          setError({ msg: \"Conta criada e logada com sucesso!\", type: 'success' });\n        }\n        setIsRegistering(false);\n      }\n    } else {\n      const { error: signInError } = await supabase.auth.signInWithPassword({\n        email,\n        password,\n      });\n\n      if (signInError) {\n        let msg = \"E-mail ou senha incorretos.\";\n        let type: 'error' | 'warning' = 'error';\n        let code = '';\n\n        if (signInError.message.includes(\"Email not confirmed\")) {\n          msg = \"Seu e-mail ainda não foi confirmado. Verifique sua caixa de entrada.\";\n          type = 'warning';\n          code = 'email_not_confirmed';\n        }\n\n        setError({ msg, type, code });\n      }\n    }\n    setLoading(false);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-4\">\n      <div className=\"max-w-md w-full bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl p-10 relative overflow-hidden border border-slate-100 dark:border-slate-800\">\n        <div className=\"text-center mb-10\">\n          <div className=\"mx-auto w-20 h-20 bg-indigo-600 rounded-3xl flex items-center justify-center text-white shadow-2xl mb-6\">\n            <Award size={40} />\n          </div>\n          <h1 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">\n            {isRegistering ? 'Criar Conta' : 'StudyFlow'}\n          </h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-2 font-medium\">\n            {isRegistering ? 'Cadastre-se para começar' : 'Sua jornada para a aprovação'}\n          </p>\n        </div>\n\n        {error && (\n          <div className={`mb-6 p-4 rounded-2xl flex flex-col gap-3 border ${\n            error.type === 'error' ? 'bg-rose-50 border-rose-100 text-rose-600' :\n            error.type === 'success' ? 'bg-emerald-50 border-emerald-100 text-emerald-700' :\n            error.type === 'warning' ? 'bg-amber-50 border-amber-100 text-amber-700' :\n            'bg-sky-50 border-sky-100 text-sky-700'\n          }`}>\n            <div className=\"flex items-start gap-3\">\n              {error.type === 'success' ? <CheckCircle2 size={18} className=\"shrink-0 mt-0.5\" /> : <Info size={18} className=\"shrink-0 mt-0.5\" />}\n              <p className=\"text-xs font-bold leading-relaxed\">{error.msg}</p>\n            </div>\n            \n            {error.code === 'email_not_confirmed' && !isRegistering && (\n              <button \n                onClick={handleResendEmail}\n                disabled={resending}\n                className=\"flex items-center justify-center gap-2 text-[10px] font-black uppercase tracking-widest bg-amber-600 text-white py-2 rounded-xl hover:bg-amber-700 transition-all disabled:opacity-50\"\n              >\n                <RefreshCw size={12} className={resending ? 'animate-spin' : ''} />\n                {resending ? 'Enviando...' : 'Reenviar Link de Confirmação'}\n              </button>\n            )}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-5\">\n          {isRegistering && (\n            <div className=\"relative\">\n              <UserIcon className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n              <input type=\"text\" required className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\" placeholder=\"Nome Completo\" value={name} onChange={(e) => setName(e.target.value)} />\n            </div>\n          )}\n          <div className=\"relative\">\n            <Mail className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n            <input type=\"email\" required className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\" placeholder=\"seu@email.com\" value={email} onChange={(e) => setEmail(e.target.value)} />\n          </div>\n          <div className=\"relative\">\n            <Lock className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n            <input type=\"password\" required className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\" placeholder=\"Sua Senha\" value={password} onChange={(e) => setPassword(e.target.value)} />\n          </div>\n          {isRegistering && (\n            <div className=\"relative\">\n              <ShieldCheck className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n              <input type=\"password\" required className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white outline-none font-bold\" placeholder=\"Confirmar Senha\" value={confirmPassword} onChange={(e) => setConfirmPassword(e.target.value)} />\n            </div>\n          )}\n          <button \n            type=\"submit\" \n            disabled={loading}\n            className={`w-full text-white font-black py-5 rounded-2xl transition-all shadow-xl bg-indigo-600 hover:bg-indigo-700 ${loading ? 'opacity-50 cursor-not-allowed' : ''}`}\n          >\n            {loading ? 'CARREGANDO...' : (isRegistering ? 'CRIAR CONTA' : 'ACESSAR AGORA')}\n          </button>\n        </form>\n\n        <div className=\"mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center\">\n          <button onClick={() => { setIsRegistering(!isRegistering); setError(null); }} className=\"text-indigo-600 dark:text-indigo-400 text-sm font-bold hover:underline\">\n            {isRegistering ? 'Já tenho conta: Fazer Login' : 'Novo por aqui? Cadastre-se'}\n          </button>\n        </div>\n\n        <div className=\"mt-4 flex flex-col items-center gap-2\">\n           <p className=\"text-[9px] text-slate-400 dark:text-slate-500 font-black uppercase tracking-widest text-center\">\n             Problemas com o e-mail? Verifique seu SPAM ou desative a confirmação no painel do Supabase.\n           </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
