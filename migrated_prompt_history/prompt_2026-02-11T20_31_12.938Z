          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  RefreshCcw, \n  Bell, \n  CheckCircle, \n  Calendar, \n  Clock, \n  Target, \n  Check, \n  Activity,\n  ArrowRight,\n  AlertCircle,\n  History,\n  // Added X to the list of icons imported from lucide-react\n  X\n} from 'lucide-react';\n\ninterface RevisaoProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n}\n\nconst Revisao: React.FC<RevisaoProps> = ({ subjects, setSubjects }) => {\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  \n  // Stats editing state\n  const [editMinutes, setEditMinutes] = useState(0);\n  const [editAttempted, setEditAttempted] = useState(0);\n  const [editCorrect, setEditCorrect] = useState(0);\n  const [editDate, setEditDate] = useState('');\n\n  const getAllCompletedTopics = () => {\n    const list: { subject: Subject; topic: Topic }[] = [];\n    subjects.forEach(s => {\n      s.topics.forEach(t => {\n        if (t.completed && t.lastStudiedAt) {\n          list.push({ subject: s, topic: t });\n        }\n      });\n    });\n    // Ordenar pelos que foram concluídos mais recentemente\n    return list.sort((a, b) => \n      new Date(b.topic.lastStudiedAt!).getTime() - new Date(a.topic.lastStudiedAt!).getTime()\n    );\n  };\n\n  const calculateMilestone = (baseDate: string, days: number) => {\n    const date = new Date(baseDate);\n    date.setDate(date.getDate() + days);\n    return date;\n  };\n\n  const getStatusInfo = (date: Date) => {\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n    const target = new Date(date);\n    target.setHours(0, 0, 0, 0);\n\n    const diff = target.getTime() - today.getTime();\n    const diffDays = Math.ceil(diff / (1000 * 3600 * 24));\n\n    if (diffDays < 0) return { label: 'Atrasada', color: 'text-rose-500 bg-rose-50', icon: <AlertCircle size={12} /> };\n    if (diffDays === 0) return { label: 'Hoje', color: 'text-amber-600 bg-amber-50 animate-pulse', icon: <Bell size={12} /> };\n    return { label: `Em ${diffDays}d`, color: 'text-slate-400 bg-slate-50', icon: <Calendar size={12} /> };\n  };\n\n  const startEditing = (topic: Topic) => {\n    setEditingTopicId(topic.id);\n    setEditMinutes(topic.studyTimeMinutes || 0);\n    setEditAttempted(topic.questionsAttempted || 0);\n    setEditCorrect(topic.questionsCorrect || 0);\n    \n    const d = new Date();\n    const year = d.getFullYear();\n    const month = String(d.getMonth() + 1).padStart(2, '0');\n    const day = String(d.getDate()).padStart(2, '0');\n    setEditDate(`${year}-${month}-${day}`);\n  };\n\n  const saveStats = (subjectId: string, topicId: string) => {\n    setSubjects(prev => prev.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const finalDate = new Date(`${editDate}T12:00:00`).toISOString();\n              return { \n                ...t, \n                studyTimeMinutes: editMinutes,\n                questionsAttempted: editAttempted,\n                questionsCorrect: editCorrect,\n                lastStudiedAt: finalDate // Atualiza a data para resetar o ciclo se o usuário desejar\n              };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n    setEditingTopicId(null);\n  };\n\n  const completedTopics = getAllCompletedTopics();\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Painel de Revisões</h2>\n        <p className=\"text-slate-500 font-medium\">Ciclo automatizado de 7, 15 e 30 dias baseado na sua data de conclusão.</p>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-4\">\n          {completedTopics.length > 0 ? (\n            completedTopics.map(({ subject, topic }) => {\n              const m7 = calculateMilestone(topic.lastStudiedAt!, 7);\n              const m15 = calculateMilestone(topic.lastStudiedAt!, 15);\n              const m30 = calculateMilestone(topic.lastStudiedAt!, 30);\n              \n              const s7 = getStatusInfo(m7);\n              const s15 = getStatusInfo(m15);\n              const s30 = getStatusInfo(m30);\n\n              const hitRate = topic.questionsAttempted && topic.questionsAttempted > 0 \n                ? Math.round((topic.questionsCorrect! / topic.questionsAttempted) * 100) \n                : null;\n\n              return (\n                <div key={topic.id} className=\"bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden hover:shadow-md transition-all\">\n                  <div className=\"p-6\">\n                    <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6\">\n                      <div className=\"flex items-center gap-4\">\n                        <div className=\"w-2 h-10 rounded-full\" style={{ backgroundColor: subject.color }} />\n                        <div>\n                          <p className=\"text-[10px] font-black uppercase tracking-widest text-slate-400 mb-0.5\">{subject.name}</p>\n                          <h3 className=\"font-bold text-slate-800 text-lg leading-tight\">{topic.title}</h3>\n                          <p className=\"text-xs text-slate-400 flex items-center gap-1 mt-1\">\n                            <History size={12} /> Concluído em {new Date(topic.lastStudiedAt!).toLocaleDateString('pt-BR')}\n                          </p>\n                        </div>\n                      </div>\n                      \n                      <button \n                        onClick={() => editingTopicId === topic.id ? setEditingTopicId(null) : startEditing(topic)}\n                        className={`px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 shadow-sm\n                          ${editingTopicId === topic.id ? 'bg-slate-800 text-white' : 'bg-indigo-600 text-white hover:bg-indigo-700 shadow-indigo-100'}\n                        `}\n                      >\n                        {editingTopicId === topic.id ? <X size={18} /> : <RefreshCcw size={18} />}\n                        {editingTopicId === topic.id ? 'Cancelar' : 'Registrar Revisão'}\n                      </button>\n                    </div>\n\n                    {/* Milestones Timeline */}\n                    <div className=\"grid grid-cols-3 gap-3 mb-2\">\n                      {[ \n                        { label: '7 Dias', date: m7, status: s7 },\n                        { label: '15 Dias', date: m15, status: s15 },\n                        { label: '30 Dias', date: m30, status: s30 }\n                      ].map((m, i) => (\n                        <div key={i} className=\"flex flex-col p-3 rounded-2xl bg-slate-50 border border-slate-100\">\n                          <span className=\"text-[10px] font-black text-slate-400 uppercase mb-1\">{m.label}</span>\n                          <span className=\"text-xs font-bold text-slate-700\">{m.date.toLocaleDateString('pt-BR')}</span>\n                          <div className={`mt-2 flex items-center justify-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-black uppercase ${m.status.color}`}>\n                            {m.status.icon}\n                            {m.status.label}\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n\n                    {/* Quick Stats Display */}\n                    {hitRate !== null && !editingTopicId && (\n                      <div className=\"mt-4 flex items-center gap-4 pt-4 border-t border-slate-50\">\n                        <div className=\"flex items-center gap-2\">\n                          <div className={`w-2 h-2 rounded-full ${hitRate >= 80 ? 'bg-emerald-500' : hitRate >= 60 ? 'bg-amber-500' : 'bg-rose-500'}`} />\n                          <span className=\"text-xs font-bold text-slate-600\">{hitRate}% Aproveitamento</span>\n                        </div>\n                        <div className=\"flex items-center gap-2 text-slate-400\">\n                          <Clock size={12} />\n                          <span className=\"text-xs font-medium\">{topic.studyTimeMinutes} min gastos</span>\n                        </div>\n                      </div>\n                    )}\n\n                    {/* Integrated Editing Panel (Similar to Disciplinas) */}\n                    {editingTopicId === topic.id && (\n                      <div className=\"mt-6 p-5 bg-indigo-50/50 border border-indigo-100 rounded-2xl animate-in slide-in-from-top-4 duration-300\">\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                          <div>\n                            <label className=\"block text-[10px] font-black text-slate-500 uppercase mb-1 flex items-center gap-1\">\n                              <Calendar size={10} /> Data Revisão\n                            </label>\n                            <input \n                              type=\"date\" \n                              style={{ colorScheme: 'light' }}\n                              className=\"w-full px-3 py-2 border-2 border-slate-200 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white text-slate-900\"\n                              value={editDate}\n                              onChange={(e) => setEditDate(e.target.value)}\n                            />\n                          </div>\n                          <div>\n                            <label className=\"block text-[10px] font-black text-slate-500 uppercase mb-1 flex items-center gap-1\">\n                              <Clock size={10} /> Minutos\n                            </label>\n                            <input \n                              type=\"number\" \n                              className=\"w-full px-3 py-2 border-2 border-slate-200 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white text-slate-900\"\n                              value={editMinutes}\n                              onChange={(e) => setEditMinutes(parseInt(e.target.value) || 0)}\n                            />\n                          </div>\n                          <div>\n                            <label className=\"block text-[10px] font-black text-slate-500 uppercase mb-1 flex items-center gap-1\">\n                              <Target size={10} /> Questões\n                            </label>\n                            <input \n                              type=\"number\" \n                              className=\"w-full px-3 py-2 border-2 border-slate-200 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white text-slate-900\"\n                              value={editAttempted}\n                              onChange={(e) => setEditAttempted(parseInt(e.target.value) || 0)}\n                            />\n                          </div>\n                          <div>\n                            <label className=\"block text-[10px] font-black text-slate-500 uppercase mb-1 flex items-center gap-1\">\n                              <Check size={10} /> Acertos\n                            </label>\n                            <input \n                              type=\"number\" \n                              className=\"w-full px-3 py-2 border-2 border-slate-200 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white text-slate-900\"\n                              value={editCorrect}\n                              onChange={(e) => setEditCorrect(parseInt(e.target.value) || 0)}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"flex justify-end gap-2 mt-4 pt-4 border-t border-indigo-100\">\n                          <button \n                            onClick={() => setEditingTopicId(null)}\n                            className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:bg-slate-200 rounded-lg transition-all\"\n                          >\n                            Cancelar\n                          </button>\n                          <button \n                            onClick={() => saveStats(subject.id, topic.id)}\n                            className=\"px-6 py-2 text-xs font-bold bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 shadow-md transition-all flex items-center gap-2\"\n                          >\n                            <CheckCircle size={14} /> Concluir e Salvar Revisão\n                          </button>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })\n          ) : (\n            <div className=\"bg-white rounded-[2.5rem] border border-dashed border-slate-300 p-20 text-center\">\n              <div className=\"w-20 h-20 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-200\">\n                <RefreshCcw size={40} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-800\">Nada para revisar ainda</h3>\n              <p className=\"text-slate-500 mt-2 max-w-sm mx-auto font-medium\">Conclua tópicos na página de disciplinas para ativar o seu ciclo de revisão inteligente.</p>\n            </div>\n          )}\n        </div>\n\n        {/* Sidebar Info */}\n        <div className=\"space-y-6\">\n          <div className=\"bg-indigo-600 text-white p-8 rounded-[2rem] shadow-xl shadow-indigo-100 relative overflow-hidden group\">\n            <div className=\"absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full blur-2xl group-hover:bg-white/20 transition-all\" />\n            <h3 className=\"text-xl font-bold mb-4 flex items-center gap-2\">\n              <Activity size={20} /> Spaced Repetition\n            </h3>\n            <p className=\"text-indigo-100 text-sm leading-relaxed mb-6 font-medium\">\n              O segredo da aprovação não é quanto você estuda, mas quanto você revisa. Este painel monitora a curva do esquecimento para você.\n            </p>\n            <div className=\"flex items-center gap-2 text-xs font-black bg-white/10 p-3 rounded-xl border border-white/20 uppercase tracking-tighter\">\n              <ArrowRight size={14} /> Memorização de longo prazo ativa\n            </div>\n          </div>\n\n          <div className=\"bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm\">\n            <h4 className=\"font-bold text-slate-800 mb-4 flex items-center gap-2\">\n              <History size={18} className=\"text-indigo-500\" /> Metas de Ciclo\n            </h4>\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-3 group\">\n                <div className=\"w-10 h-10 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-500 text-xs font-black group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors\">7d</div>\n                <div className=\"text-xs font-bold text-slate-500 uppercase\">Resumo e Questões</div>\n              </div>\n              <div className=\"flex items-center gap-3 group\">\n                <div className=\"w-10 h-10 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-500 text-xs font-black group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors\">15d</div>\n                <div className=\"text-xs font-bold text-slate-500 uppercase\">Mapas e Esquemas</div>\n              </div>\n              <div className=\"flex items-center gap-3 group\">\n                <div className=\"w-10 h-10 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-500 text-xs font-black group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors\">30d</div>\n                <div className=\"text-xs font-bold text-slate-500 uppercase\">Simulado do Tópico</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Revisao;\n"
            }
          ]
        }
      ]
    },
