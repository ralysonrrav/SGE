  {
    "id": 951,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Ciclos.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Upgrade para Master UI: Sincronização optimística, design de alta fidelidade com o protótipo \"Flow\" e suporte a colunas de banco otimizadas.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useMemo, useEffect } from 'react';\nimport { \n  BrainCircuit, CheckCircle2, Target, Trophy, Clock, AlertCircle, \n  Loader2, RefreshCw, GripVertical, Wand2, Zap, ShieldCheck, \n  ChevronRight, ArrowRight, Settings2, Trash2, Plus, Info, AlertTriangle\n} from 'lucide-react';\nimport { User, Subject, CycleSubject, StudyCycle, NivelConhecimento, PesoDisciplina, Ciclo } from '../types';\nimport { calcularTempoEstudo, gerarCiclos } from '../services/cycleLogic';\nimport { supabase } from '../lib/supabase';\n\ninterface CiclosProps {\n  user: User;\n  subjects: Subject[];\n  cycle: StudyCycle | null;\n  setCycle: (cycle: StudyCycle | null) => void;\n}\n\nconst Ciclos: React.FC<CiclosProps> = ({ user, subjects, cycle, setCycle }) => {\n  // Estado local para configurações sincronizadas\n  const [configSubjects, setConfigSubjects] = useState<CycleSubject[]>([]);\n  const [disciplinasPorCiclo, setDisciplinasPorCiclo] = useState(3);\n  const [hoursPerDay, setHoursPerDay] = useState(4);\n  const [numCiclos, setNumCiclos] = useState(4);\n  const [isSaving, setIsSaving] = useState(false);\n  const [showDeleteModal, setShowDeleteModal] = useState(false);\n  const [activeCycles, setActiveCycles] = useState<Ciclo[]>([]);\n  const [materiasConcluidasIds, setMateriasConcluidasIds] = useState<string[]>([]);\n  const [draggedItem, setDraggedItem] = useState<{ cycleId: number, index: number } | null>(null);\n\n  // Estados do Formulário\n  const [selectedSubjectId, setSelectedSubjectId] = useState('');\n  const [nivel, setNivel] = useState<NivelConhecimento>(NivelConhecimento.INTERMEDIARIO);\n  const [peso, setPeso] = useState<PesoDisciplina>(PesoDisciplina.NORMAL);\n\n  // Carregamento de Estado Inicial\n  useEffect(() => {\n    if (cycle) {\n      const raw = cycle as any;\n      const sch = raw.schedule || {};\n      const isArray = Array.isArray(sch);\n      \n      const cycles = isArray ? sch : (sch.cycles || []);\n      const concluidas = raw.materias_concluidas_ids || sch.materias_concluidas_ids || [];\n      const config = raw.config_disciplinas || sch.config_disciplinas || [];\n      \n      setActiveCycles(cycles);\n      setMateriasConcluidasIds(concluidas);\n      setConfigSubjects(config);\n      setNumCiclos(raw.num_ciclos || sch.num_ciclos || 4);\n      setDisciplinasPorCiclo(raw.disciplinas_por_ciclo || sch.disciplinas_por_ciclo || 3);\n      setHoursPerDay(raw.hours_per_day || sch.hours_per_day || 4);\n    }\n  }, [cycle?.id]);\n\n  // Cálculo de Fase Ativa Automática\n  const calculateActivePhase = (concluidasIds: string[], currentCycles: Ciclo[]): number => {\n    if (!currentCycles || currentCycles.length === 0) return 1;\n    for (const ciclo of currentCycles) {\n      const isCicloComplete = ciclo.materias.length > 0 && \n        ciclo.materias.every(m => m.instanceId && concluidasIds.includes(m.instanceId));\n      if (!isCicloComplete) return ciclo.id;\n    }\n    return currentCycles.length > 0 ? currentCycles[currentCycles.length - 1].id : 1;\n  };\n\n  // Motor de Persistência Otimizado\n  const saveCycleState = async (updates: any, updatedSchedule?: Ciclo[]) => {\n    if (!supabase || user.role === 'visitor') return;\n    setIsSaving(true);\n    \n    try {\n      const finalCycles = updatedSchedule || activeCycles;\n      const finalConcluidas = updates.materias_concluidas_ids !== undefined \n        ? updates.materias_concluidas_ids \n        : materiasConcluidasIds;\n      \n      const nextActivePhase = calculateActivePhase(finalConcluidas, finalCycles);\n\n      // Agrupamento para Coluna JSONB (Segurança de Esquema)\n      const packedSchedule = {\n        cycles: finalCycles,\n        materias_concluidas_ids: finalConcluidas,\n        config_disciplinas: updates.config_disciplinas || configSubjects,\n        num_ciclos: updates.num_ciclos || numCiclos,\n        disciplinas_por_ciclo: updates.disciplinas_por_ciclo || disciplinasPorCiclo,\n        ciclo_atual: nextActivePhase\n      };\n\n      // Payload Híbrido: Suporta Colunas Nativas e Legado\n      const payload: any = {\n        user_id: user.id,\n        board: updates.board || cycle?.board || 'Personalizado',\n        exam_date: updates.exam_date || updates.examDate || cycle?.examDate || user.examDate || new Date().toISOString().split('T')[0],\n        hours_per_day: updates.hours_per_day || updates.hoursPerDay || hoursPerDay,\n        meta_atual: updates.meta_atual || cycle?.meta_atual || 1,\n        // Colunas Novas (Otimização)\n        ciclo_atual: nextActivePhase,\n        num_ciclos: updates.num_ciclos || numCiclos,\n        disciplinas_por_ciclo: updates.disciplinas_por_ciclo || disciplinasPorCiclo,\n        materias_concluidas_ids: finalConcluidas,\n        config_disciplinas: updates.config_disciplinas || configSubjects,\n        schedule: packedSchedule\n      };\n\n      const cycleId = cycle?.id ? String(cycle.id) : null;\n      let result;\n\n      if (cycleId && !cycleId.startsWith('local-')) {\n        result = await supabase.from('study_cycles').update(payload).eq('id', cycleId).select().single();\n      } else {\n        result = await supabase.from('study_cycles').insert([payload]).select().single();\n      }\n\n      if (result.error) {\n        // Fallback: Tenta salvar apenas com colunas básicas se as novas não existirem ainda\n        const fallbackPayload = { \n          user_id: user.id, board: payload.board, exam_date: payload.exam_date, \n          hours_per_day: payload.hours_per_day, meta_atual: payload.meta_atual, schedule: payload.schedule \n        };\n        result = cycleId \n          ? await supabase.from('study_cycles').update(fallbackPayload).eq('id', cycleId).select().single()\n          : await supabase.from('study_cycles').insert([fallbackPayload]).select().single();\n      }\n\n      if (result.data) {\n        setCycle({ ...result.data, id: String(result.data.id) });\n      }\n    } catch (e: any) {\n      console.error(\"[Sincronia] Erro:\", e.message);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleGenerate = async () => {\n    if (configSubjects.length === 0 || isSaving) return;\n    const suggestion = gerarCiclos(configSubjects, disciplinasPorCiclo, numCiclos);\n    setActiveCycles(suggestion);\n    setMateriasConcluidasIds([]);\n    await saveCycleState({ materias_concluidas_ids: [] }, suggestion);\n  };\n\n  const toggleMateria = async (instanceId: string) => {\n    const isDone = materiasConcluidasIds.includes(instanceId);\n    const next = isDone \n      ? materiasConcluidasIds.filter(id => id !== instanceId)\n      : [...materiasConcluidasIds, instanceId];\n    \n    setMateriasConcluidasIds(next); // Update imediato\n    await saveCycleState({ materias_concluidas_ids: next });\n  };\n\n  const activePhase = useMemo(() => calculateActivePhase(materiasConcluidasIds, activeCycles), [materiasConcluidasIds, activeCycles]);\n  const currentPhaseMaterias = activeCycles.find(c => c.id === activePhase)?.materias || [];\n  const allDoneInPhase = currentPhaseMaterias.length > 0 && currentPhaseMaterias.every(m => m.instanceId && materiasConcluidasIds.includes(m.instanceId));\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700\">\n      \n      {/* STATUS BAR - TOP COMMAND */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"glass-card p-6 border-l-4 border-indigo-500 relative group overflow-hidden\">\n          <div className=\"absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity\"><Target size={64}/></div>\n          <div className=\"flex items-center gap-4 relative z-10\">\n            <div className=\"w-12 h-12 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center shadow-inner\"><Target size={24}/></div>\n            <div>\n              <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-[0.3em]\">Meta Estratégica</p>\n              <p className=\"text-2xl font-black text-white\"># {cycle?.meta_atual || 1}</p>\n            </div>\n          </div>\n        </div>\n        <div className=\"glass-card p-6 border-l-4 border-emerald-500 relative group overflow-hidden\">\n           <div className=\"absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity\"><Trophy size={64}/></div>\n           <div className=\"flex items-center gap-4 relative z-10\">\n            <div className=\"w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center shadow-inner\"><Trophy size={24}/></div>\n            <div>\n              <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-[0.3em]\">Metas Concluídas</p>\n              <p className=\"text-2xl font-black text-white\">{cycle?.metas_concluidas || 0}</p>\n            </div>\n          </div>\n        </div>\n        <div className=\"glass-card p-6 border-l-4 border-amber-500 relative group overflow-hidden\">\n           <div className=\"absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity\"><BrainCircuit size={64}/></div>\n           <div className=\"flex items-center gap-4 relative z-10\">\n            <div className=\"w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center shadow-inner\"><BrainCircuit size={24}/></div>\n            <div className=\"flex-1\">\n              <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-[0.3em]\">Fase Ativa (Auto)</p>\n              <div className=\"flex items-center gap-2\">\n                <p className=\"text-2xl font-black text-white\">Fase {activePhase}</p>\n                <span className=\"text-[10px] font-bold text-slate-500 mt-1\">/ {activeCycles.length || 0}</span>\n              </div>\n            </div>\n            {isSaving && <RefreshCw size={14} className=\"text-indigo-500 animate-spin\" />}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        \n        {/* PANEL: OPERATIONAL MATRIX */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"glass-card p-8 rounded-[2.5rem] border border-white/5 relative overflow-hidden\">\n            <div className=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent\"></div>\n            \n            <div className=\"flex items-center justify-between mb-8\">\n              <h3 className=\"text-[10px] font-black uppercase tracking-[0.4em] text-white flex items-center gap-2\">\n                <Settings2 size={14} className=\"text-indigo-400\" /> MATRIZ OPERACIONAL\n              </h3>\n              {cycle && (\n                <button onClick={() => setShowDeleteModal(true)} className=\"p-2 text-slate-600 hover:text-rose-500 transition-all hover:rotate-90\">\n                  <RefreshCw size={14} />\n                </button>\n              )}\n            </div>\n\n            <div className=\"space-y-5\">\n              <div className=\"grid grid-cols-3 gap-3\">\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-[8px] font-black text-slate-500 uppercase tracking-widest ml-1\">Mat/Ciclo</label>\n                  <input type=\"number\" value={disciplinasPorCiclo} onChange={e => setDisciplinasPorCiclo(Math.max(1, parseInt(e.target.value)||1))} className=\"w-full bg-black/40 border border-white/5 rounded-xl px-3 py-3 text-xs font-black text-white focus:border-indigo-500 outline-none transition-all\" />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-[8px] font-black text-slate-500 uppercase tracking-widest ml-1\">Estudo(H)</label>\n                  <input type=\"number\" value={hoursPerDay} onChange={e => setHoursPerDay(Math.max(1, parseInt(e.target.value)||1))} className=\"w-full bg-black/40 border border-white/5 rounded-xl px-3 py-3 text-xs font-black text-white focus:border-indigo-500 outline-none transition-all\" />\n                </div>\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-[8px] font-black text-slate-500 uppercase tracking-widest ml-1\">Qtd Fases</label>\n                  <input type=\"number\" value={numCiclos} onChange={e => setNumCiclos(Math.max(1, parseInt(e.target.value)||1))} className=\"w-full bg-black/40 border border-white/5 rounded-xl px-3 py-3 text-xs font-black text-white focus:border-indigo-500 outline-none transition-all\" />\n                </div>\n              </div>\n\n              <div className=\"pt-6 border-t border-white/5\">\n                <label className=\"text-[9px] font-black text-indigo-400/70 uppercase tracking-widest mb-3 block\">Vincular Matéria à Base</label>\n                <div className=\"space-y-3\">\n                  <select value={selectedSubjectId} onChange={e => setSelectedSubjectId(e.target.value)} className=\"w-full bg-black/60 border border-white/10 rounded-xl px-4 py-3.5 text-xs font-bold text-white outline-none focus:border-indigo-500 transition-all\">\n                    <option value=\"\">SELECIONAR DISCIPLINA...</option>\n                    {subjects.map(s => <option key={s.id} value={s.id}>{s.name.toUpperCase()}</option>)}\n                  </select>\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <select value={nivel} onChange={e => setNivel(e.target.value as any)} className=\"bg-black/40 border border-white/5 rounded-lg px-3 py-2 text-[10px] font-black text-slate-300 uppercase\">\n                      {Object.values(NivelConhecimento).map(v => <option key={v} value={v}>{v}</option>)}\n                    </select>\n                    <select value={peso} onChange={e => setPeso(e.target.value as any)} className=\"bg-black/40 border border-white/5 rounded-lg px-3 py-2 text-[10px] font-black text-slate-300 uppercase\">\n                      {Object.values(PesoDisciplina).map(v => <option key={v} value={v}>{v}</option>)}\n                    </select>\n                  </div>\n                  <button onClick={async () => {\n                    const base = subjects.find(s => String(s.id) === String(selectedSubjectId));\n                    if (!base) return;\n                    const next = [...configSubjects, { ...base, nivelConhecimento: nivel, peso, tempoEstudo: calcularTempoEstudo(nivel, peso) }];\n                    setConfigSubjects(next);\n                    setSelectedSubjectId('');\n                    await saveCycleState({ config_disciplinas: next });\n                  }} disabled={!selectedSubjectId || isSaving} className=\"w-full py-4 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-[10px] font-black uppercase tracking-[0.2em] flex items-center justify-center gap-2 border border-white/5 active:scale-95 transition-all disabled:opacity-50\">\n                    <Plus size={14}/> VINCULAR À MATRIZ\n                  </button>\n                </div>\n              </div>\n\n              {configSubjects.length > 0 && (\n                <div className=\"pt-4\">\n                  <button onClick={handleGenerate} disabled={isSaving} className=\"w-full py-5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl text-[11px] font-black uppercase tracking-[0.3em] flex items-center justify-center gap-3 transition-all shadow-xl shadow-indigo-600/20 active:scale-95 disabled:opacity-50 group\">\n                    {isSaving ? <Loader2 size={16} className=\"animate-spin\" /> : <Wand2 size={18} className=\"group-hover:rotate-12 transition-transform\" />}\n                    GERAR CICLO ESTRATÉGICO\n                  </button>\n                </div>\n              )}\n\n              <div className=\"mt-8 space-y-2 max-h-[260px] overflow-y-auto custom-scrollbar pr-2\">\n                <p className=\"text-[8px] font-black text-slate-600 uppercase mb-3 tracking-widest\">Base de Matérias Selecionadas ({configSubjects.length})</p>\n                {configSubjects.map(s => (\n                  <div key={s.id} className=\"group flex items-center justify-between p-4 bg-white/[0.02] rounded-xl border border-white/5 hover:border-indigo-500/30 transition-all\">\n                    <div className=\"min-w-0\">\n                      <p className=\"text-[10px] font-black text-white truncate uppercase tracking-tight\">{s.name}</p>\n                      <p className=\"text-[7px] text-indigo-400 uppercase font-black mt-0.5\">{s.nivelConhecimento} • {s.tempoEstudo}M</p>\n                    </div>\n                    <button onClick={async () => {\n                      const next = configSubjects.filter(ps => ps.id !== s.id);\n                      setConfigSubjects(next);\n                      await saveCycleState({ config_disciplinas: next });\n                    }} className=\"p-2 text-rose-500/50 hover:text-rose-500 opacity-0 group-hover:opacity-100 transition-all\"><Trash2 size={14}/></button>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* LISTA DE SETORES (FASES) */}\n        <div className=\"lg:col-span-8\">\n          {activeCycles.length > 0 ? (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              {activeCycles.map((ciclo) => {\n                const isCurrent = ciclo.id === activePhase;\n                const isCompleted = ciclo.id < activePhase;\n                const progressCount = ciclo.materias.filter(m => materiasConcluidasIds.includes(m.instanceId || '')).length;\n                const percent = (progressCount / (ciclo.materias.length || 1)) * 100;\n\n                return (\n                  <div key={ciclo.id} className={`glass-card overflow-hidden transition-all duration-500 border-2 ${isCurrent ? 'border-indigo-500 scale-[1.02] shadow-[0_20px_60px_rgba(79,70,229,0.15)] bg-indigo-500/[0.03]' : isCompleted ? 'border-emerald-500/30 bg-emerald-500/[0.02] opacity-70' : 'border-white/5 opacity-50'}`}>\n                    <div className={`p-6 border-b border-white/5 flex items-center justify-between ${isCurrent ? 'bg-indigo-500/10' : 'bg-white/5'}`}>\n                      <div>\n                        <div className=\"flex items-center gap-2\">\n                          <p className=\"text-[9px] font-black uppercase text-slate-500 tracking-widest mb-1\">Setor 0{ciclo.id}</p>\n                          {isCompleted && <span className=\"bg-emerald-500/10 text-emerald-500 text-[8px] font-black px-1.5 py-0.5 rounded uppercase mb-1\">CONCLUÍDO</span>}\n                          {isCurrent && <span className=\"bg-indigo-500/10 text-indigo-500 text-[8px] font-black px-1.5 py-0.5 rounded uppercase mb-1\">EM CURSO</span>}\n                        </div>\n                        <h4 className=\"text-xl font-black text-white uppercase tracking-tighter\">FASE {ciclo.id}</h4>\n                      </div>\n                      <div className=\"text-right\">\n                         <Clock size={16} className=\"text-indigo-400 ml-auto mb-1\" />\n                         <p className=\"text-[10px] font-black text-slate-400\">{Math.floor(ciclo.tempoTotal / 60)}H {ciclo.tempoTotal % 60}M</p>\n                      </div>\n                    </div>\n                    \n                    <div className=\"h-1 bg-slate-900 w-full\">\n                      <div className={`h-full transition-all duration-1000 ${isCompleted ? 'bg-emerald-500' : 'bg-indigo-500'}`} style={{ width: `${isCompleted ? 100 : percent}%` }} />\n                    </div>\n\n                    <div className=\"p-6 space-y-3 min-h-[220px]\">\n                      {ciclo.materias.map((m, idx) => {\n                        const isDone = materiasConcluidasIds.includes(m.instanceId || '');\n                        return (\n                          <div key={m.instanceId || idx} className={`flex items-center justify-between p-4 rounded-xl border transition-all group ${isDone ? 'bg-emerald-500/5 border-emerald-500/30' : 'bg-black/40 border-white/5'} ${isCurrent ? 'hover:border-indigo-500/50' : ''}`}>\n                            <div className=\"flex items-center gap-4 min-w-0 flex-1\">\n                              <button disabled={isSaving || !isCurrent} onClick={() => m.instanceId && toggleMateria(m.instanceId)} className={`w-6 h-6 rounded-lg flex items-center justify-center border-2 transition-all ${isDone ? 'bg-emerald-500 border-emerald-500 text-slate-950' : 'bg-transparent border-slate-700 hover:border-indigo-500'}`}>\n                                {isDone && <CheckCircle2 size={12} strokeWidth={3} />}\n                              </button>\n                              <div className=\"min-w-0 flex-1\">\n                                <span className={`text-[11px] font-black uppercase tracking-tight block truncate ${isDone ? 'text-slate-500 line-through' : 'text-slate-200'}`}>{m.name}</span>\n                                <span className=\"text-[8px] font-bold text-slate-500 uppercase tracking-widest\">{m.tempoEstudo}M • {m.nivelConhecimento}</span>\n                              </div>\n                            </div>\n                            <div className=\"flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n                              <GripVertical size={14} className=\"text-slate-700 cursor-grab active:cursor-grabbing\" />\n                            </div>\n                          </div>\n                        );\n                      })}\n\n                      {isCurrent && (\n                        <div className=\"pt-4\">\n                          <button disabled={!allDoneInPhase || isSaving} onClick={async () => {\n                            if (activePhase === activeCycles.length) {\n                               await saveCycleState({ meta_atual: (cycle?.meta_atual || 1) + 1, metas_concluidas: (cycle?.metas_concluidas || 0) + 1, materias_concluidas_ids: [] });\n                            } else {\n                               // O saveCycleState já calcula o ciclo_atual automaticamente\n                               await saveCycleState({ materias_concluidas_ids: materiasConcluidasIds });\n                            }\n                          }} className={`w-full py-5 rounded-2xl font-black text-[11px] uppercase tracking-[0.3em] transition-all flex items-center justify-center gap-3 ${allDoneInPhase ? 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-xl shadow-indigo-600/30' : 'bg-slate-800/50 text-slate-600 cursor-not-allowed border border-white/5'}`}>\n                            {allDoneInPhase ? <><Zap size={16}/> FINALIZAR SETOR 0{ciclo.id}</> : <><AlertCircle size={16}/> CONCLUIR OBJETIVOS</>}\n                          </button>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          ) : (\n            <div className=\"h-full flex flex-col items-center justify-center p-24 glass-card rounded-[3rem] border-dashed border-white/10 opacity-40\">\n               <div className=\"w-24 h-24 bg-indigo-500/5 rounded-full flex items-center justify-center mb-8 border border-white/5 animate-pulse\">\n                 <Wand2 size={40} className=\"text-slate-700\" />\n               </div>\n               <h3 className=\"text-xl font-black text-white uppercase tracking-tighter mb-2\">Motor de Estratégia Prontificado</h3>\n               <p className=\"text-center text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] max-w-xs leading-relaxed\">Vincule as disciplinas na matriz ao lado para materializar seu plano tático.</p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* MODAL: PURGA DE PLANO */}\n      {showDeleteModal && (\n        <div className=\"fixed inset-0 z-[250] flex items-center justify-center p-6 bg-slate-950/90 backdrop-blur-2xl animate-in fade-in\">\n           <div className=\"glass-card w-full max-w-sm p-12 rounded-[3rem] border border-rose-500/20 text-center shadow-[0_0_100px_rgba(244,63,94,0.1)]\">\n              <div className=\"w-20 h-20 rounded-[2rem] bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto mb-8 border border-rose-500/20\"><AlertTriangle size={40}/></div>\n              <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter mb-4\">EXPURGAR PLANO?</h3>\n              <p className=\"text-slate-400 text-xs font-bold uppercase mb-10 leading-relaxed tracking-wide\">Esta ação desintegrará seu ciclo de estudos atual do banco de dados. Esta operação não pode ser desfeita.</p>\n              <div className=\"flex flex-col gap-4\">\n                <button onClick={async () => {\n                   if (!cycle || user.role === 'visitor') return;\n                   setIsSaving(true);\n                   try {\n                     await supabase.from('study_cycles').delete().eq('id', cycle.id);\n                     setCycle(null);\n                     setActiveCycles([]);\n                     setConfigSubjects([]);\n                     setShowDeleteModal(false);\n                   } finally { setIsSaving(false); }\n                }} className=\"py-5 rounded-2xl font-black text-[11px] uppercase tracking-widest transition-all bg-rose-600 hover:bg-rose-500 text-white shadow-xl shadow-rose-900/20\">\n                  CONFIRMAR PURGA\n                </button>\n                <button onClick={() => setShowDeleteModal(false)} className=\"py-4 text-[10px] font-black text-slate-500 uppercase tracking-widest hover:text-white transition-colors\">ABORTAR COMANDO</button>\n              </div>\n           </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Ciclos;\n"
            }
          ]
        },
        {
