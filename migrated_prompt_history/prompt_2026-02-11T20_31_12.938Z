  {
    "id": 453,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Refatoração completa para gestão de estado resiliente, integração profunda com Supabase e UI otimizada para múltiplos dispositivos.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect, useCallback, useRef } from 'react';\nimport { \n  Home, BookOpen, RefreshCcw, Calendar, BarChart2, LogOut, Menu, X,\n  BrainCircuit, Award, Sun, Moon, Users, Database, Loader2, ShieldCheck, \n  Eye, Settings, WifiOff, CloudSync, User as UserIcon\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession, PredefinedEdital } from './types';\nimport { supabase, isNetworkError } from './lib/supabase';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\nimport Admin from './components/Admin';\nimport Profile from './components/Profile';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [allUsers, setAllUsers] = useState<User[]>([]);\n  const [isLoaded, setIsLoaded] = useState(false);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isLoggingOut, setIsLoggingOut] = useState(false);\n  const [isOffline, setIsOffline] = useState(false);\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const loggingOutRef = useRef(false);\n  \n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    return saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;\n  });\n\n  const [editais, setEditais] = useState<PredefinedEdital[]>([\n    {\n      id: 'edital-pf-agente',\n      name: 'Agente da Polícia Federal',\n      organization: 'PF / Cebraspe',\n      lastUpdated: new Date().toISOString(),\n      subjects: [\n        { id: 'pf-1', name: 'Português', color: '#6366f1', topics: [{ id: 't1', title: 'Compreensão de textos', completed: false, importance: 5, studyTimeMinutes: 0 }] },\n        { id: 'pf-2', name: 'Informática', color: '#10b981', topics: [{ id: 't3', title: 'Segurança da Informação', completed: false, importance: 5, studyTimeMinutes: 0 }] }\n      ]\n    }\n  ]);\n\n  const saveToLocal = (key: string, data: any) => {\n    localStorage.setItem(`sf_cache_${key}`, JSON.stringify(data));\n  };\n\n  const loadFromLocal = (key: string) => {\n    const data = localStorage.getItem(`sf_cache_${key}`);\n    return data ? JSON.parse(data) : null;\n  };\n\n  const fetchUserData = useCallback(async (userId: string) => {\n    // 1. Carregamento imediato via Cache (Experiência Instantânea)\n    const cachedSubjects = loadFromLocal('subjects');\n    const cachedMocks = loadFromLocal('mocks');\n    const cachedLogs = loadFromLocal('logs');\n\n    if (cachedSubjects) setSubjects(cachedSubjects);\n    if (cachedMocks) setMocks(cachedMocks);\n    if (cachedLogs) setStudyLogs(cachedLogs);\n\n    if (!supabase || loggingOutRef.current) return;\n\n    // 2. Sincronização em Background com o Supabase\n    try {\n      const { data: subData, error: subError } = await supabase.from('subjects').select('*').order('created_at', { ascending: true });\n      if (subError) throw subError;\n      if (subData) {\n        const mappedSubjects = subData.map((s, index) => ({\n          ...s,\n          id: String(s.id),\n          topics: s.topics || [],\n          color: s.color || ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6'][index % 5]\n        }));\n        setSubjects(mappedSubjects);\n        saveToLocal('subjects', mappedSubjects);\n      }\n\n      const { data: mockData, error: mockError } = await supabase.from('mocks').select('*').order('date', { ascending: false });\n      if (mockError) throw mockError;\n      if (mockData) {\n        const mappedMocks = mockData.map(m => ({ ...m, id: String(m.id) }));\n        setMocks(mappedMocks);\n        saveToLocal('mocks', mappedMocks);\n      }\n\n      const { data: logData, error: logError } = await supabase.from('study_logs').select('*').order('date', { ascending: false });\n      if (logError) throw logError;\n      if (logData) {\n        const mappedLogs = logData.map(l => ({ ...l, id: String(l.id) }));\n        setStudyLogs(mappedLogs);\n        saveToLocal('logs', mappedLogs);\n      }\n      setIsOffline(false);\n    } catch (e: any) {\n      if (isNetworkError(e)) {\n        setIsOffline(true);\n      } else {\n        console.error(\"Erro Crítico de Sincronização:\", e);\n      }\n    }\n  }, []);\n\n  const addStudyLog = async (minutes: number, topicId: string, subjectId: string) => {\n    const newLogEntry: StudySession = { \n      id: `local-${Date.now()}`, \n      minutes, \n      topicId, \n      subjectId, \n      date: new Date().toISOString(), \n      type: 'estudo' \n    };\n\n    setStudyLogs(prev => {\n      const updated = [newLogEntry, ...prev];\n      saveToLocal('logs', updated);\n      return updated;\n    });\n\n    if (user?.role === 'visitor') return;\n\n    if (supabase && !loggingOutRef.current) {\n      try {\n        const { data, error } = await supabase.from('study_logs').insert([{\n          minutes, topic_id: topicId, subject_id: subjectId, date: newLogEntry.date, type: 'estudo'\n        }]).select().single();\n        if (!error && data) {\n          setStudyLogs(prev => prev.map(l => l.id === newLogEntry.id ? { ...data, id: String(data.id) } : l));\n        }\n      } catch (e) {\n        if (isNetworkError(e)) setIsOffline(true);\n      }\n    }\n  };\n\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (isDarkMode) root.classList.add('dark');\n    else root.classList.remove('dark');\n    localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');\n  }, [isDarkMode]);\n\n  useEffect(() => {\n    let isMounted = true;\n    const initializeAuth = async () => {\n      if (!supabase) { setIsLoaded(true); return; }\n      try {\n        const { data: { session }, error } = await supabase.auth.getSession();\n        if (error) throw error;\n        \n        if (isMounted && session?.user) {\n          const isAdmin = session.user.email === 'ralysonriccelli@gmail.com';\n          const isVisitor = session.user.user_metadata?.role === 'visitor';\n          \n          const newUser: User = {\n            id: session.user.id,\n            name: session.user.user_metadata?.full_name || 'Usuário',\n            email: session.user.email!,\n            role: isAdmin ? 'administrator' : isVisitor ? 'visitor' : 'student',\n            status: 'active',\n            isOnline: true,\n            weeklyGoal: session.user.user_metadata?.weekly_goal || 20\n          };\n          \n          setUser(newUser);\n          fetchUserData(session.user.id);\n          if (isAdmin) {\n             const { data: profiles } = await supabase.from('profiles').select('*');\n             if (profiles) setAllUsers(profiles);\n          }\n        }\n      } catch (e) {\n        console.warn(\"Auth initialization fallback to offline/guest mode.\");\n      } finally { \n        if (isMounted) setIsLoaded(true); \n      }\n    };\n    initializeAuth();\n    return () => { isMounted = false; };\n  }, [fetchUserData]);\n\n  const handleLogout = async () => {\n    loggingOutRef.current = true;\n    setIsLoggingOut(true);\n    if (supabase) await supabase.auth.signOut();\n    localStorage.clear();\n    setUser(null);\n    setSubjects([]);\n    setMocks([]);\n    setIsLoggingOut(false);\n    loggingOutRef.current = false;\n  };\n\n  if (!isLoaded || isLoggingOut) {\n    return (\n      <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex flex-col items-center justify-center\">\n        <div className=\"relative\">\n          <Loader2 className=\"animate-spin text-indigo-600 mb-4\" size={56} strokeWidth={1} />\n          <CloudSync className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-indigo-400 opacity-20\" size={24} />\n        </div>\n        <p className=\"text-slate-500 font-black uppercase text-[10px] tracking-[0.3em] animate-pulse\">Sincronizando Ecossistema...</p>\n      </div>\n    );\n  }\n\n  if (!user) {\n    return <Login users={allUsers} onLogin={(u) => { setUser(u); fetchUserData(u.id); }} onRegister={(u) => { setUser(u); fetchUserData(u.id); }} />;\n  }\n\n  const navItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={18} />, roles: ['administrator', 'student', 'visitor'] },\n    { id: 'disciplinas', label: 'Edital Vertical', icon: <BookOpen size={18} />, roles: ['administrator', 'student', 'visitor'] },\n    { id: 'ciclos', label: 'Ciclos IA', icon: <BrainCircuit size={18} />, roles: ['administrator', 'student', 'visitor'] },\n    { id: 'revisao', label: 'Revisões 7/15/30', icon: <RefreshCcw size={18} />, roles: ['administrator', 'student', 'visitor'] },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={18} />, roles: ['administrator', 'student', 'visitor'] },\n    { id: 'admin_users', label: 'Gestão de Alunos', icon: <Users size={18} />, roles: ['administrator'] },\n    { id: 'admin_editais', label: 'Catálogo de Editais', icon: <Settings size={18} />, roles: ['administrator'] },\n  ].filter(item => item.roles.includes(user.role));\n\n  return (\n    <div className=\"flex h-screen bg-white dark:bg-slate-950 overflow-hidden font-sans\">\n      {/* Banner de Status Crítico */}\n      {isOffline && (\n        <div className=\"fixed top-0 left-0 right-0 z-[100] bg-rose-600 text-white text-[9px] font-black uppercase tracking-[0.4em] py-1.5 text-center flex items-center justify-center gap-3 shadow-lg\">\n          <WifiOff size={10} strokeWidth={3} /> CONEXÃO LIMITADA: OPERANDO VIA CACHE LOCAL\n        </div>\n      )}\n      {!isOffline && user.role === 'visitor' && (\n        <div className=\"fixed top-0 left-0 right-0 z-[100] bg-amber-500 text-white text-[9px] font-black uppercase tracking-[0.4em] py-1.5 text-center flex items-center justify-center gap-3 shadow-lg\">\n          <Eye size={10} strokeWidth={3} /> MODO VISITANTE: ACESSO DE DEGUSTAÇÃO\n        </div>\n      )}\n\n      {/* Mobile Trigger */}\n      <button \n        className={`md:hidden fixed z-[60] p-4 bg-indigo-600 text-white rounded-2xl shadow-2xl transition-all active:scale-95 ${isOffline || user.role === 'visitor' ? 'top-12 left-6' : 'top-6 left-6'}`} \n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      {/* Sidebar - Design PhD */}\n      <aside className={`fixed inset-y-0 left-0 z-50 w-80 bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-all duration-500 ease-in-out md:translate-x-0 ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full shadow-none'}`}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-10 pt-16 flex items-center gap-5\">\n            <div className=\"w-14 h-14 rounded-[1.25rem] bg-indigo-600 flex items-center justify-center text-white shadow-2xl shadow-indigo-100 dark:shadow-none transform hover:rotate-6 transition-transform\"><Award size={32} strokeWidth={1.5} /></div>\n            <div>\n              <h1 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tighter leading-none\">StudyFlow</h1>\n              <p className=\"text-[9px] font-black uppercase tracking-[0.2em] mt-1.5 text-indigo-600 dark:text-indigo-400\">\n                {user.role === 'administrator' ? 'Command Center' : user.role === 'visitor' ? 'Preview Access' : 'Academic Master'}\n              </p>\n            </div>\n          </div>\n          \n          <nav className=\"flex-1 px-6 py-4 space-y-2 overflow-y-auto\">\n            {navItems.map((item) => (\n              <button \n                key={item.id} \n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }} \n                className={`w-full flex items-center gap-4 px-5 py-4 rounded-2xl text-[11px] font-black uppercase tracking-wider transition-all duration-300 ${currentPage === item.id ? 'bg-indigo-600 text-white shadow-2xl shadow-indigo-100 dark:shadow-none translate-x-2' : 'text-slate-500 dark:text-slate-400 hover:bg-white dark:hover:bg-slate-800 hover:text-indigo-600 hover:shadow-sm'}`}\n              >\n                <div className={`${currentPage === item.id ? 'text-white' : 'text-indigo-500'}`}>{item.icon}</div> \n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-8 border-t border-slate-200 dark:border-slate-800 space-y-5\">\n             <div className=\"bg-slate-200/50 dark:bg-slate-950 p-1.5 rounded-2xl flex items-center\">\n                <button onClick={() => setIsDarkMode(false)} className={`flex-1 flex items-center justify-center py-2.5 rounded-xl transition-all ${!isDarkMode ? 'bg-white text-indigo-600 shadow-md' : 'text-slate-400'}`}><Sun size={18} /></button>\n                <button onClick={() => setIsDarkMode(true)} className={`flex-1 flex items-center justify-center py-2.5 rounded-xl transition-all ${isDarkMode ? 'bg-slate-800 text-indigo-400 shadow-md' : 'text-slate-400'}`}><Moon size={18} /></button>\n             </div>\n             \n             <button \n               onClick={() => setIsProfileOpen(true)}\n               className=\"w-full p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 transition-all hover:shadow-lg group text-left\"\n             >\n               <div className=\"flex items-center gap-4\">\n                 <div className=\"w-10 h-10 rounded-xl bg-indigo-50 dark:bg-slate-950 flex items-center justify-center text-indigo-600 font-black text-sm border border-indigo-100 dark:border-slate-800 group-hover:bg-indigo-600 group-hover:text-white transition-all\">\n                   {user.name.charAt(0)}\n                 </div>\n                 <div className=\"min-w-0\">\n                   <p className=\"text-xs font-black text-slate-800 dark:text-slate-200 truncate leading-none\">{user.name}</p>\n                   <p className=\"text-[9px] font-bold text-slate-400 uppercase tracking-tight truncate mt-1\">{user.email}</p>\n                 </div>\n               </div>\n             </button>\n\n             <button onClick={handleLogout} className=\"w-full flex items-center justify-center gap-3 text-rose-500 font-black text-[10px] uppercase tracking-widest p-4 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-2xl transition-all\">\n               <LogOut size={16} /> Encerrar Sessão\n             </button>\n          </div>\n        </div>\n      </aside>\n\n      {/* Conteúdo Principal - Layout PhD */}\n      <main className={`flex-1 md:ml-80 overflow-y-auto bg-white dark:bg-slate-950 transition-all duration-500 ${isOffline || user.role === 'visitor' ? 'pt-14' : 'pt-0'}`}>\n        <div className=\"max-w-7xl mx-auto p-8 md:p-16\">\n          {currentPage === 'inicio' && <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={() => {}} isDarkMode={isDarkMode} />}\n          {currentPage === 'disciplinas' && <Disciplinas subjects={subjects} setSubjects={setSubjects} predefinedEditais={editais} onAddLog={addStudyLog} />}\n          {currentPage === 'ciclos' && <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />}\n          {currentPage === 'revisao' && <Revisao subjects={subjects} setSubjects={setSubjects} onAddLog={addStudyLog} />}\n          {currentPage === 'simulados' && <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />}\n          {currentPage === 'admin_users' && <Admin users={allUsers} setUsers={setAllUsers} editais={editais} setEditais={setEditais} view=\"users\" />}\n          {currentPage === 'admin_editais' && <Admin users={allUsers} setUsers={setAllUsers} editais={editais} setEditais={setEditais} view=\"editais\" />}\n        </div>\n      </main>\n\n      {isProfileOpen && (\n        <Profile \n          user={user} \n          onUpdate={(u) => { setUser(u); saveToLocal('user', u); }} \n          onDelete={handleLogout} \n          onClose={() => setIsProfileOpen(false)} \n          onExport={() => {}} \n          onImport={() => {}} \n        />\n      )}\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Dashboard.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Upgrade visual e de performance no dashboard, com gráficos mais precisos e cards informativos de alto impacto.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect, useMemo } from 'react';\nimport { Subject, MockExam, StudyCycle, StudySession } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell, AreaChart, Area\n} from 'recharts';\nimport { CheckCircle2, TrendingUp, Clock, BookOpen, BarChart2, Zap, Settings, Target, Award, Calendar } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n  studyLogs: StudySession[];\n  weeklyGoal: number;\n  onUpdateGoal: (hours: number) => void;\n  isDarkMode: boolean;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, cycle, studyLogs, weeklyGoal, onUpdateGoal, isDarkMode }) => {\n  const [isEditingGoal, setIsEditingGoal] = useState(false);\n  const [tempGoal, setTempGoal] = useState(weeklyGoal);\n  const [isMounted, setIsMounted] = useState(false);\n\n  useEffect(() => {\n    setIsMounted(true);\n  }, []);\n\n  const totalMinutes = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.studyTimeMinutes || 0), 0), 0), [subjects]);\n  const totalHours = Math.floor(totalMinutes / 60);\n  const totalTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.length, 0), [subjects]);\n  const completedTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0), [subjects]);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  const thisWeekHours = useMemo(() => {\n    const now = new Date();\n    const lastSunday = new Date(now);\n    lastSunday.setDate(now.getDate() - now.getDay());\n    lastSunday.setHours(0, 0, 0, 0);\n    const mins = studyLogs.reduce((acc, log) => new Date(log.date) >= lastSunday ? acc + log.minutes : acc, 0);\n    return parseFloat((mins / 60).toFixed(1));\n  }, [studyLogs]);\n\n  const weeklyGoalPercent = Math.min(100, Math.round((thisWeekHours / weeklyGoal) * 100));\n\n  const mockData = useMemo(() => mocks.map(m => ({\n    name: m.title.substring(0, 10),\n    acerto: Math.round((m.score / m.totalQuestions) * 100)\n  })).slice(-6).reverse(), [mocks]);\n\n  const chartTheme = {\n    grid: isDarkMode ? '#1e293b' : '#f1f5f9',\n    text: isDarkMode ? '#94a3b8' : '#64748b',\n    primary: '#6366f1',\n    bg: isDarkMode ? '#0f172a' : '#ffffff',\n    border: isDarkMode ? '#1e293b' : '#f1f5f9'\n  };\n\n  return (\n    <div className=\"space-y-12 animate-in fade-in slide-in-from-bottom-8 duration-1000 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-end justify-between gap-8\">\n        <div>\n          <h2 className=\"text-5xl font-black text-slate-900 dark:text-slate-100 tracking-tighter leading-[0.9]\">Performance Hub</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-bold mt-4 flex items-center gap-2 text-sm uppercase tracking-widest\">\n            <Calendar size={14} className=\"text-indigo-500\" /> Sincronizado: {new Date().toLocaleDateString('pt-BR')}\n          </p>\n        </div>\n        \n        <div className=\"flex gap-4\">\n          <div className=\"bg-white dark:bg-slate-900 px-8 py-5 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-xl flex items-center gap-5 group transition-all hover:scale-105\">\n            <div className=\"p-3 bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all\">\n              <Clock size={28} strokeWidth={1.5} />\n            </div>\n            <div>\n              <p className=\"text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] leading-none mb-1\">Carga Horária Total</p>\n              <p className=\"text-2xl font-black text-slate-900 dark:text-slate-100 leading-none\">{totalHours}<span className=\"text-xs text-slate-400 ml-1\">h</span></p>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Bloco Superior: Meta Semanal & Cobertura */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        <div className=\"lg:col-span-8 bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-2xl p-12 flex flex-col md:flex-row items-center gap-12 group overflow-hidden relative\">\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-50 dark:bg-indigo-950/20 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl opacity-50\" />\n          \n          <div className=\"relative w-64 h-64 shrink-0 flex items-center justify-center transform group-hover:scale-105 transition-transform duration-700\">\n             <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 192 192\">\n               <circle cx=\"96\" cy=\"96\" r=\"84\" className=\"stroke-slate-100 dark:stroke-slate-800 fill-none\" strokeWidth=\"12\" />\n               <circle \n                 cx=\"96\" cy=\"96\" r=\"84\" \n                 className=\"stroke-indigo-600 dark:stroke-indigo-500 fill-none transition-all duration-1000 ease-in-out\" \n                 strokeWidth=\"12\"\n                 strokeDasharray={2 * Math.PI * 84}\n                 strokeDashoffset={(2 * Math.PI * 84) * (1 - weeklyGoalPercent / 100)}\n                 strokeLinecap=\"round\"\n               />\n             </svg>\n             <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n               <span className=\"text-6xl font-black text-slate-900 dark:text-slate-100 tracking-tighter leading-none\">{weeklyGoalPercent}%</span>\n               <span className=\"text-[10px] font-black text-indigo-500 uppercase tracking-[0.3em] mt-2\">Atividade</span>\n             </div>\n          </div>\n\n          <div className=\"flex-1 space-y-6 z-10\">\n             <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-4\">\n                  <Target className=\"text-indigo-600\" size={32} /> Meta Semanal\n                </h3>\n                <button onClick={() => setIsEditingGoal(!isEditingGoal)} className=\"p-3 bg-slate-50 dark:bg-slate-800 text-slate-400 hover:text-indigo-600 hover:bg-white rounded-2xl transition-all shadow-sm\">\n                  <Settings size={20} />\n                </button>\n             </div>\n             \n             <p className=\"text-slate-500 dark:text-slate-400 font-bold text-xl leading-snug\">\n               Você registrou <span className=\"text-indigo-600 font-black\">{thisWeekHours}h</span> líquidas das <span className=\"text-slate-900 dark:text-slate-100 font-black\">{weeklyGoal}h</span> estabelecidas para este ciclo.\n             </p>\n\n             {isEditingGoal && (\n               <div className=\"flex gap-4 animate-in slide-in-from-top-4 duration-300 bg-slate-50 dark:bg-slate-950 p-4 rounded-3xl border border-slate-100 dark:border-slate-800\">\n                  <input type=\"number\" className=\"flex-1 px-6 py-4 border-2 border-white dark:border-slate-800 rounded-2xl outline-none bg-white dark:bg-slate-900 dark:text-white font-black text-xl\" value={tempGoal} onChange={(e) => setTempGoal(parseInt(e.target.value) || 0)} />\n                  <button onClick={() => { onUpdateGoal(tempGoal); setIsEditingGoal(false); }} className=\"bg-indigo-600 text-white px-10 py-4 rounded-2xl font-black shadow-xl hover:bg-indigo-700 active:scale-95 transition-all uppercase text-xs tracking-widest\">Ajustar Meta</button>\n               </div>\n             )}\n             \n             <div className=\"grid grid-cols-2 gap-4 pt-4\">\n               <div className=\"p-5 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border border-slate-100 dark:border-slate-800\">\n                  <p className=\"text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1\">Status do Ciclo</p>\n                  <p className=\"font-black text-slate-800 dark:text-white text-lg\">{weeklyGoalPercent >= 80 ? 'EXCELENTE' : weeklyGoalPercent >= 50 ? 'PROMISSOR' : 'A REFORÇAR'}</p>\n               </div>\n               <div className=\"p-5 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border border-slate-100 dark:border-slate-800\">\n                  <p className=\"text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1\">Foco Sugerido</p>\n                  <p className=\"font-black text-slate-800 dark:text-white text-lg\">QUESTÕES</p>\n               </div>\n             </div>\n          </div>\n        </div>\n\n        <div className=\"lg:col-span-4 bg-white dark:bg-slate-900 p-10 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-xl flex flex-col items-center justify-center text-center group\">\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 mb-6 uppercase tracking-widest text-[10px]\">Cobertura do Edital</h3>\n            <div className=\"w-full h-56 relative transform group-hover:scale-110 transition-transform duration-700\">\n              {isMounted && (\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <PieChart>\n                    <Pie\n                      data={[\n                        { name: 'Concluído', value: completedTopics || 0.0001 },\n                        { name: 'Pendente', value: Math.max(0.0001, totalTopics - completedTopics) }\n                      ]}\n                      cx=\"50%\" cy=\"50%\" innerRadius={65} outerRadius={85} paddingAngle={8} dataKey=\"value\" stroke=\"none\"\n                    >\n                      <Cell fill={chartTheme.primary} />\n                      <Cell fill={isDarkMode ? '#1e293b' : '#f8fafc'} />\n                    </Pie>\n                    <Tooltip contentStyle={{ borderRadius: '16px', border: 'none', boxShadow: '0 20px 25px -5px rgb(0 0 0 / 0.1)' }} />\n                  </PieChart>\n                </ResponsiveContainer>\n              )}\n            </div>\n            <div className=\"mt-6\">\n              <p className=\"text-5xl font-black text-slate-900 dark:text-slate-100 tracking-tighter leading-none\">{progressPercent}%</p>\n              <p className=\"text-[9px] font-black text-slate-400 uppercase tracking-[0.3em] mt-3\">Meta Curricular</p>\n            </div>\n        </div>\n      </div>\n\n      {/* Evolução Histórica & Domínio */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n        <div className=\"bg-white dark:bg-slate-900 p-12 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-xl\">\n          <div className=\"flex items-center justify-between mb-10\">\n            <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Evolução em Simulados</h3>\n            <Award className=\"text-indigo-500\" size={28} strokeWidth={1.5} />\n          </div>\n          <div className=\"w-full h-80\">\n            {isMounted && mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <AreaChart data={mockData}>\n                  <defs>\n                    <linearGradient id=\"colorAcerto\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                      <stop offset=\"5%\" stopColor={chartTheme.primary} stopOpacity={0.3}/>\n                      <stop offset=\"95%\" stopColor={chartTheme.primary} stopOpacity={0}/>\n                    </linearGradient>\n                  </defs>\n                  <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke={chartTheme.grid} />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{ fill: chartTheme.text, fontSize: 10, fontWeight: '900' }} />\n                  <YAxis axisLine={false} tickLine={false} tick={{ fill: chartTheme.text, fontSize: 10, fontWeight: '900' }} unit=\"%\" />\n                  <Tooltip \n                    contentStyle={{ borderRadius: '16px', border: 'none', backgroundColor: chartTheme.bg, boxShadow: '0 20px 25px -5px rgb(0 0 0 / 0.1)' }}\n                    itemStyle={{ fontWeight: '900', color: chartTheme.primary }}\n                  />\n                  <Area type=\"monotone\" dataKey=\"acerto\" stroke={chartTheme.primary} strokeWidth={4} fillOpacity={1} fill=\"url(#colorAcerto)\" dot={{ r: 6, fill: chartTheme.primary, strokeWidth: 3, stroke: '#fff' }} activeDot={{ r: 8, strokeWidth: 0 }} />\n                </AreaChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-300 gap-4 opacity-40\">\n                <BarChart2 size={64} strokeWidth={1} />\n                <p className=\"font-black uppercase tracking-widest text-[10px]\">Aguardando dados de simulados</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-12 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-xl flex flex-col\">\n          <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-10\">Domínio Curricular</h3>\n          <div className=\"space-y-6 flex-1 overflow-y-auto pr-4 scrollbar-thin\">\n            {subjects.length > 0 ? (\n              subjects.map((s) => {\n                const subCompleted = s.topics.filter(t => t.completed).length;\n                const subPercent = s.topics.length > 0 ? Math.round((subCompleted / s.topics.length) * 100) : 0;\n                \n                return (\n                  <div key={s.id} className=\"space-y-3 group cursor-pointer\">\n                    <div className=\"flex justify-between items-end\">\n                      <span className=\"font-black text-slate-800 dark:text-slate-200 text-sm tracking-tight group-hover:text-indigo-600 transition-colors\">{s.name}</span>\n                      <span className=\"text-[10px] font-black text-slate-400 group-hover:text-slate-600 transition-colors uppercase tracking-widest\">{subCompleted} / {s.topics.length}</span>\n                    </div>\n                    <div className=\"h-4 bg-slate-50 dark:bg-slate-800 rounded-full overflow-hidden border border-slate-100 dark:border-slate-700 shadow-inner p-1\">\n                      <div \n                        className=\"h-full transition-all duration-1000 ease-out rounded-full shadow-sm\"\n                        style={{ \n                          width: `${subPercent}%`,\n                          backgroundColor: s.color \n                        }}\n                      />\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <div className=\"py-20 text-center text-slate-300 font-black uppercase tracking-[0.2em] text-[10px] space-y-4\">\n                 <BookOpen size={48} className=\"mx-auto mb-4 opacity-20\" />\n                 <p>Inicie o Edital para visualizar</p>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        }
      ]
