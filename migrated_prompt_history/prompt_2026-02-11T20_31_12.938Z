              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { MockExam, Subject } from '../types';\nimport { BarChart2, Plus, Trash2, TrendingUp, Award, FileText } from 'lucide-react';\n\ninterface SimuladosProps {\n  mocks: MockExam[];\n  setMocks: React.Dispatch<React.SetStateAction<MockExam[]>>;\n  subjects: Subject[];\n}\n\nconst Simulados: React.FC<SimuladosProps> = ({ mocks, setMocks, subjects }) => {\n  const [showAddForm, setShowAddForm] = useState(false);\n  const [title, setTitle] = useState('');\n  const [score, setScore] = useState(0);\n  const [total, setTotal] = useState(100);\n  const [date, setDate] = useState(new Date().toISOString().split('T')[0]);\n\n  const addMock = () => {\n    if (!title.trim()) return;\n    const newMock: MockExam = {\n      id: Date.now().toString(),\n      title,\n      date,\n      score,\n      totalQuestions: total,\n      subjectPerformance: {}\n    };\n    setMocks([...mocks, newMock]);\n    setShowAddForm(false);\n    setTitle('');\n  };\n\n  const removeMock = (id: string) => {\n    setMocks(mocks.filter(m => m.id !== id));\n  };\n\n  const averageScore = mocks.length > 0 \n    ? Math.round(mocks.reduce((acc, m) => acc + (m.score / m.totalQuestions), 0) / mocks.length * 100)\n    : 0;\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Estatísticas de Simulados</h2>\n          <p className=\"text-slate-500 font-medium\">Mensure seu desempenho e identifique gargalos.</p>\n        </div>\n        <button \n          onClick={() => setShowAddForm(true)}\n          className=\"bg-indigo-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-indigo-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-100\"\n        >\n          <Plus size={20} />\n          Novo Simulado\n        </button>\n      </header>\n\n      {/* Highlights */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n          <p className=\"text-xs font-bold text-slate-400 uppercase tracking-widest mb-1\">Média Geral</p>\n          <div className=\"flex items-end gap-2\">\n            <h3 className=\"text-3xl font-extrabold text-indigo-600\">{averageScore}%</h3>\n            <TrendingUp size={24} className=\"text-emerald-500 mb-1\" />\n          </div>\n        </div>\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n          <p className=\"text-xs font-bold text-slate-400 uppercase tracking-widest mb-1\">Total Realizados</p>\n          <h3 className=\"text-3xl font-extrabold text-slate-800\">{mocks.length}</h3>\n        </div>\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n          <p className=\"text-xs font-bold text-slate-400 uppercase tracking-widest mb-1\">Melhor Score</p>\n          <h3 className=\"text-3xl font-extrabold text-emerald-600\">\n            {mocks.length > 0 ? Math.max(...mocks.map(m => Math.round((m.score / m.totalQuestions) * 100))) : 0}%\n          </h3>\n        </div>\n      </div>\n\n      {showAddForm && (\n        <div className=\"bg-white p-8 rounded-3xl border border-indigo-100 shadow-xl shadow-indigo-50 animate-in zoom-in-95 duration-200\">\n          <h3 className=\"text-xl font-bold text-slate-800 mb-6\">Cadastrar Simulado</h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600\">Título / Nome</label>\n              <input \n                type=\"text\" \n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                placeholder=\"Ex: Simulado 01 - PDF Estratégia\"\n                value={title}\n                onChange={(e) => setTitle(e.target.value)}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600\">Acertos</label>\n              <input \n                type=\"number\" \n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={score}\n                onChange={(e) => setScore(parseInt(e.target.value))}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600\">Total Questões</label>\n              <input \n                type=\"number\" \n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={total}\n                onChange={(e) => setTotal(parseInt(e.target.value))}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600\">Data</label>\n              <input \n                type=\"date\" \n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={date}\n                onChange={(e) => setDate(e.target.value)}\n              />\n            </div>\n          </div>\n          <div className=\"flex gap-4 mt-8\">\n            <button \n              onClick={addMock}\n              className=\"bg-indigo-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-indigo-700 transition-all\"\n            >\n              Salvar Dados\n            </button>\n            <button \n              onClick={() => setShowAddForm(false)}\n              className=\"text-slate-500 px-8 py-3 font-semibold\"\n            >\n              Cancelar\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden\">\n        <table className=\"w-full text-left\">\n          <thead className=\"bg-slate-50 border-b border-slate-100\">\n            <tr>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Simulado</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-center\">Data</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-center\">Acertos / Total</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-center\">Percentual</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-right\">Ações</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50\">\n            {mocks.map(mock => {\n              const perc = Math.round((mock.score / mock.totalQuestions) * 100);\n              return (\n                <tr key={mock.id} className=\"hover:bg-slate-50/50 transition-colors group\">\n                  <td className=\"px-6 py-5\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"p-2 bg-slate-100 text-slate-500 rounded-lg\">\n                        <FileText size={18} />\n                      </div>\n                      <span className=\"font-bold text-slate-700\">{mock.title}</span>\n                    </div>\n                  </td>\n                  <td className=\"px-6 py-5 text-center text-sm font-medium text-slate-500\">\n                    {new Date(mock.date).toLocaleDateString('pt-BR')}\n                  </td>\n                  <td className=\"px-6 py-5 text-center text-sm font-bold text-slate-600\">\n                    {mock.score} / {mock.totalQuestions}\n                  </td>\n                  <td className=\"px-6 py-5 text-center\">\n                    <span className={`px-3 py-1 rounded-full text-xs font-bold ${\n                      perc >= 80 ? 'bg-emerald-50 text-emerald-600' : \n                      perc >= 60 ? 'bg-amber-50 text-amber-600' : 'bg-red-50 text-red-600'\n                    }`}>\n                      {perc}%\n                    </span>\n                  </td>\n                  <td className=\"px-6 py-5 text-right\">\n                    <button \n                      onClick={() => removeMock(mock.id)}\n                      className=\"text-slate-300 hover:text-red-500 transition-colors p-2\"\n                    >\n                      <Trash2 size={18} />\n                    </button>\n                  </td>\n                </tr>\n              );\n            })}\n            {mocks.length === 0 && (\n              <tr>\n                <td colSpan={5} className=\"px-6 py-20 text-center text-slate-400\">\n                  <div className=\"flex flex-col items-center\">\n                    <Award size={48} className=\"opacity-20 mb-4\" />\n                    <p>Nenhum simulado cadastrado ainda.</p>\n                  </div>\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n};\n\nexport default Simulados;\n"
