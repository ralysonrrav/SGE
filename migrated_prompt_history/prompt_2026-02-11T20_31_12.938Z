        {
          "path": "components/Disciplinas.tsx",
          "generationType": 2,
          "isDone": true,
          "description": "Finish Disciplinas component implementation and add default export to resolve the module not found error.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic, PredefinedEdital } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  X, \n  Layers,\n  ArrowRight,\n  Loader2,\n  BookOpen,\n  TrendingUp\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  predefinedEditais: PredefinedEdital[];\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, predefinedEditais, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [isCatalogOpen, setIsCatalogOpen] = useState(false);\n  \n  // States for logging performance\n  const [activeProgressTopic, setActiveProgressTopic] = useState<string | null>(null);\n  const [progDate, setProgDate] = useState<string>('');\n  const [progHours, setProgHours] = useState<number>(0);\n  const [progMinutes, setProgMinutes] = useState<number>(0);\n  const [progAttempted, setProgAttempted] = useState<number>(0);\n  const [progCorrect, setProgCorrect] = useState<number>(0);\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const updateSubjectInDb = async (subjectId: string, topics: Topic[]) => {\n    if (supabase) {\n      try {\n        await supabase.from('subjects').update({ topics }).eq('id', subjectId);\n      } catch (err) {\n        console.error(\"Erro ao sincronizar com Supabase:\", err);\n      }\n    }\n  };\n\n  const addSubject = async (name: string, topics: Topic[] = []) => {\n    if (!name.trim()) return;\n    setLoading(true);\n    let newId = Date.now().toString();\n    try {\n      if (supabase) {\n        const { data, error } = await supabase.from('subjects').insert([{ name: name.trim(), topics }]).select().single();\n        if (!error && data) newId = String(data.id);\n      }\n      setSubjects(prev => [...prev, { id: newId, name: name.trim(), topics, color: colors[prev.length % colors.length] }]);\n      setNewSubjectName('');\n    } finally { setLoading(false); }\n  };\n\n  const deleteSubject = async (id: string) => {\n    if (!window.confirm(\"Deseja realmente excluir esta disciplina?\")) return;\n    const idToDelete = String(id);\n    setSubjects(prev => prev.filter(s => String(s.id) !== idToDelete));\n    if (expandedSubject === idToDelete) setExpandedSubject(null);\n    if (supabase) {\n      try { await supabase.from('subjects').delete().eq('id', idToDelete); } catch (err) { console.error(\"Erro ao deletar disciplina:\", err); }\n    }\n  };\n\n  const openProgressForm = (topic: Topic) => {\n    setActiveProgressTopic(topic.id);\n    const initialDate = topic.lastStudiedAt || topic.concludedAt || new Date().toISOString();\n    setProgDate(initialDate.split('T')[0]);\n    const totalMin = topic.studyTimeMinutes || 0;\n    setProgHours(Math.floor(totalMin / 60));\n    setProgMinutes(totalMin % 60);\n    setProgAttempted(topic.questionsAttempted || 0);\n    setProgCorrect(topic.questionsCorrect || 0);\n  };\n\n  const saveTopicProgress = async (subjectId: string, topicId: string) => {\n    const sId = String(subjectId);\n    const tId = String(topicId);\n    const newDateStr = `${progDate}T12:00:00`;\n    const newIsoDate = new Date(newDateStr).toISOString();\n    const totalMinutes = (progHours * 60) + progMinutes;\n\n    setSubjects(prev => {\n      return prev.map(s => {\n        if (String(s.id) === sId) {\n          const updatedTopics = s.topics.map(t => {\n            if (String(t.id) === tId) {\n              return {\n                ...t,\n                studyTimeMinutes: (t.studyTimeMinutes || 0) + totalMinutes,\n                questionsAttempted: (t.questionsAttempted || 0) + progAttempted,\n                questionsCorrect: (t.questionsCorrect || 0) + progCorrect,\n                lastStudiedAt: newIsoDate,\n                concludedAt: t.completed ? newIsoDate : t.concludedAt\n              };\n            }\n            return t;\n          });\n          updateSubjectInDb(sId, updatedTopics);\n          return { ...s, topics: updatedTopics };\n        }\n        return s;\n      });\n    });\n\n    if (totalMinutes > 0) onAddLog(totalMinutes, topicId, subjectId);\n    setActiveProgressTopic(null);\n  };\n\n  const toggleTopic = async (subjectId: string, topicId: string) => {\n    const sId = String(subjectId);\n    const tId = String(topicId);\n    \n    setSubjects(prev => {\n      return prev.map(s => {\n        if (String(s.id) === sId) {\n          const updatedTopics = s.topics.map(t => {\n            if (String(t.id) === tId) {\n              const isFinishing = !t.completed;\n              const now = new Date().toISOString();\n              return { \n                ...t, \n                completed: isFinishing, \n                concludedAt: isFinishing ? now : t.concludedAt,\n                lastStudiedAt: isFinishing ? now : t.lastStudiedAt \n              };\n            }\n            return t;\n          });\n          updateSubjectInDb(sId, updatedTopics);\n          return { ...s, topics: updatedTopics };\n        }\n        return s;\n      });\n    });\n  };\n\n  const addTopic = async (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    const sId = String(subjectId);\n    const newTopic: Topic = { \n      id: Math.random().toString(36).substr(2, 9), \n      title: newTopicTitle.trim(), \n      completed: false, \n      importance: 3,\n      studyTimeMinutes: 0,\n      questionsAttempted: 0,\n      questionsCorrect: 0\n    };\n\n    setSubjects(prev => {\n      return prev.map(s => {\n        if (String(s.id) === sId) {\n          const updatedTopics = [...s.topics, newTopic];\n          updateSubjectInDb(sId, updatedTopics);\n          return { ...s, topics: updatedTopics };\n        }\n        return s;\n      });\n    });\n    setNewTopicTitle('');\n  };\n\n  const deleteTopic = async (subjectId: string, topicId: string) => {\n    if (!window.confirm(\"Remover este tópico?\")) return;\n    const sId = String(subjectId);\n    setSubjects(prev => {\n      return prev.map(s => {\n        if (String(s.id) === sId) {\n          const updatedTopics = s.topics.filter(t => String(t.id) !== String(topicId));\n          updateSubjectInDb(sId, updatedTopics);\n          return { ...s, topics: updatedTopics };\n        }\n        return s;\n      });\n    });\n  };\n\n  const importEdital = async (edital: PredefinedEdital) => {\n    if (!window.confirm(`Importar o edital \"${edital.name}\"?`)) return;\n    setLoading(true);\n    try {\n      for (const subject of edital.subjects) {\n        const topicsWithCleanIds = subject.topics.map(t => ({\n          ...t,\n          id: Math.random().toString(36).substr(2, 9),\n          completed: false,\n          studyTimeMinutes: 0,\n          questionsAttempted: 0,\n          questionsCorrect: 0\n        }));\n        await addSubject(subject.name, topicsWithCleanIds);\n      }\n      setIsCatalogOpen(false);\n    } catch (err) {\n      console.error(\"Erro ao importar edital:\", err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Suas Disciplinas</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Gerencie seu conteúdo programático e acompanhe seu desempenho.</p>\n        </div>\n        <button \n          onClick={() => setIsCatalogOpen(true)}\n          className=\"bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 px-6 py-3 rounded-2xl font-black border border-slate-200 dark:border-slate-800 hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm\"\n        >\n          <Layers size={20} />\n          Catálogo de Editais\n        </button>\n      </header>\n\n      {/* New Subject Input */}\n      <div className=\"bg-white dark:bg-slate-900 p-2 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-2 focus-within:ring-2 focus-within:ring-indigo-500 transition-all\">\n        <div className=\"pl-4 text-slate-400\"><BookOpen size={20} /></div>\n        <input \n          type=\"text\" \n          placeholder=\"Nome da nova disciplina...\"\n          className=\"flex-1 py-4 bg-transparent outline-none font-bold text-slate-700 dark:text-slate-200\"\n          value={newSubjectName}\n          onChange={(e) => setNewSubjectName(e.target.value)}\n          onKeyDown={(e) => e.key === 'Enter' && addSubject(newSubjectName)}\n        />\n        <button \n          onClick={() => addSubject(newSubjectName)}\n          disabled={loading}\n          className=\"bg-indigo-600 text-white px-8 py-4 rounded-2xl font-black flex items-center gap-2 hover:bg-indigo-700 transition-all shadow-lg\"\n        >\n          {loading ? <Loader2 className=\"animate-spin\" size={20} /> : <Plus size={20} />}\n          Adicionar\n        </button>\n      </div>\n\n      {/* Catalog Modal */}\n      {isCatalogOpen && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md animate-in fade-in\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-2xl rounded-[3rem] shadow-2xl p-10 border border-slate-100 dark:border-slate-800\">\n            <div className=\"flex justify-between items-center mb-8\">\n              <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100\">Catálogo</h3>\n              <button onClick={() => setIsCatalogOpen(false)} className=\"p-2 text-slate-400 hover:bg-slate-100 rounded-xl\">\n                <X size={24} />\n              </button>\n            </div>\n            <div className=\"space-y-4 max-h-[60vh] overflow-y-auto pr-2\">\n              {predefinedEditais.map(edital => (\n                <div key={edital.id} className=\"flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 rounded-3xl border border-slate-100 dark:border-slate-700\">\n                  <div>\n                    <h4 className=\"font-black text-slate-800 dark:text-slate-100\">{edital.name}</h4>\n                    <p className=\"text-xs font-black text-indigo-600 uppercase tracking-widest\">{edital.organization}</p>\n                  </div>\n                  <button onClick={() => importEdital(edital)} className=\"px-6 py-3 bg-indigo-600 text-white font-black rounded-2xl shadow-lg hover:bg-indigo-700 transition-all\">Importar</button>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Subjects Grid */}\n      <div className=\"grid grid-cols-1 gap-6\">\n        {subjects.map(subject => (\n          <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all group/card\">\n            <div \n              className=\"p-8 cursor-pointer flex items-center justify-between\"\n              onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n            >\n              <div className=\"flex items-center gap-6\">\n                <div className=\"w-2 h-12 rounded-full\" style={{ backgroundColor: subject.color }} />\n                <div>\n                  <h3 className=\"text-xl font-black text-slate-800 dark:text-slate-100 leading-none\">{subject.name}</h3>\n                  <p className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest mt-2\">\n                    {subject.topics.filter(t => t.completed).length} / {subject.topics.length} Concluídos\n                  </p>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-4\">\n                <button \n                  onClick={(e) => { e.stopPropagation(); deleteSubject(subject.id); }}\n                  className=\"p-2 text-slate-300 hover:text-rose-500 transition-colors opacity-0 group-hover/card:opacity-100\"\n                >\n                  <Trash2 size={20} />\n                </button>\n                {expandedSubject === subject.id ? <ChevronUp size={24} className=\"text-slate-400\" /> : <ChevronDown size={24} className=\"text-slate-400\" />}\n              </div>\n            </div>\n\n            {expandedSubject === subject.id && (\n              <div className=\"px-8 pb-8 space-y-6 animate-in slide-in-from-top-4 duration-300\">\n                <div className=\"flex gap-2\">\n                  <input \n                    type=\"text\" \n                    placeholder=\"Novo tópico para esta disciplina...\"\n                    className=\"flex-1 px-6 py-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800 outline-none font-bold text-sm text-slate-700 dark:text-slate-200\"\n                    value={newTopicTitle}\n                    onChange={(e) => setNewTopicTitle(e.target.value)}\n                    onKeyDown={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                  />\n                  <button onClick={() => addTopic(subject.id)} className=\"p-4 bg-indigo-600 text-white rounded-2xl shadow-lg hover:bg-indigo-700 transition-all\"><Plus size={20} /></button>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {subject.topics.map(topic => (\n                    <div key={topic.id} className=\"flex flex-col md:flex-row md:items-center justify-between p-4 bg-slate-50/50 dark:bg-slate-800/30 rounded-2xl border border-slate-100 dark:border-slate-800 group/topic transition-all\">\n                      <div className=\"flex items-center gap-4 flex-1\">\n                        <button \n                          onClick={() => toggleTopic(subject.id, topic.id)}\n                          className={`p-2 rounded-xl transition-all ${topic.completed ? 'text-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'text-slate-300 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800'}`}\n                        >\n                          <CheckCircle size={20} />\n                        </button>\n                        <div>\n                          <p className={`font-bold text-sm ${topic.completed ? 'line-through text-slate-400' : 'text-slate-700 dark:text-slate-200'}`}>{topic.title}</p>\n                          {topic.lastStudiedAt && <p className=\"text-[10px] text-slate-400 font-black uppercase tracking-tight\">Último estudo: {new Date(topic.lastStudiedAt).toLocaleDateString()}</p>}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 mt-4 md:mt-0\">\n                        <button \n                          onClick={() => openProgressForm(topic)}\n                          className=\"flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 rounded-lg text-[10px] font-black uppercase border border-slate-100 dark:border-slate-800 hover:border-indigo-500 hover:text-indigo-500 transition-all\"\n                        >\n                          <TrendingUp size={14} /> Registrar Desempenho\n                        </button>\n                        <button \n                          onClick={() => deleteTopic(subject.id, topic.id)}\n                          className=\"p-2 text-slate-300 hover:text-rose-500 opacity-0 group-hover/topic:opacity-100 transition-all\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n\n                      {activeProgressTopic === topic.id && (\n                        <div className=\"fixed inset-0 z-[110] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in\">\n                          <div className=\"bg-white dark:bg-slate-900 w-full max-w-md rounded-[2.5rem] p-10 border border-slate-100 dark:border-slate-800 shadow-2xl\">\n                            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 mb-6\">Registrar Estudo</h3>\n                            <div className=\"space-y-4\">\n                              <div>\n                                <label className=\"text-[10px] font-black text-slate-400 uppercase mb-1 block\">Data do Estudo</label>\n                                <input type=\"date\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 dark:text-white font-bold outline-none\" value={progDate} onChange={(e) => setProgDate(e.target.value)} />\n                              </div>\n                              <div className=\"grid grid-cols-2 gap-4\">\n                                <div>\n                                  <label className=\"text-[10px] font-black text-slate-400 uppercase mb-1 block\">Horas</label>\n                                  <input type=\"number\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 dark:text-white font-bold outline-none\" value={progHours || ''} onChange={(e) => setProgHours(parseInt(e.target.value) || 0)} />\n                                </div>\n                                <div>\n                                  <label className=\"text-[10px] font-black text-slate-400 uppercase mb-1 block\">Minutos</label>\n                                  <input type=\"number\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 dark:text-white font-bold outline-none\" value={progMinutes || ''} onChange={(e) => setProgMinutes(parseInt(e.target.value) || 0)} />\n                                </div>\n                              </div>\n                              <div className=\"grid grid-cols-2 gap-4\">\n                                <div>\n                                  <label className=\"text-[10px] font-black text-slate-400 uppercase mb-1 block\">Qtd. Questões</label>\n                                  <input type=\"number\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 dark:text-white font-bold outline-none\" value={progAttempted || ''} onChange={(e) => setProgAttempted(parseInt(e.target.value) || 0)} />\n                                </div>\n                                <div>\n                                  <label className=\"text-[10px] font-black text-slate-400 uppercase mb-1 block\">Acertos</label>\n                                  <input type=\"number\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 dark:text-white font-bold outline-none\" value={progCorrect || ''} onChange={(e) => setProgCorrect(parseInt(e.target.value) || 0)} />\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"mt-8 flex gap-3\">\n                              <button onClick={() => saveTopicProgress(subject.id, topic.id)} className=\"flex-1 bg-indigo-600 text-white font-black py-4 rounded-2xl shadow-lg hover:bg-indigo-700 transition-all\">SALVAR</button>\n                              <button onClick={() => setActiveProgressTopic(null)} className=\"flex-1 text-slate-500 font-bold py-4 hover:bg-slate-100 rounded-2xl transition-all\">CANCELAR</button>\n                            </div>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
    },
