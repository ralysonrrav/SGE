    "payload": {
      "type": "text",
      "text": "Aja como um programador full stack sênior e web designer.\nVamos trabalhar apenas na página de disciplinas.\nO texto de alguns tópicos desconfigurou a página, chegando a impedir o aparecimento e funcionamento dos botões reset e excluir.\nIsso ocorre em textos grandes, como o tópico 4.1 cadastrado em Lingua Portuguesa.",
      "files": [],
      "fileUploads": [],
      "cMarkNode": {}
    },
    "createdTimestamp": {
