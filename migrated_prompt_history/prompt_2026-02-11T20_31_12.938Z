  {
    "id": 908,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Ciclos.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação da funcionalidade de remoção do plano de ciclos com exclusão no banco de dados e modal de confirmação padrão.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useMemo, useEffect } from 'react';\nimport { \n  BrainCircuit, CheckCircle2, ChevronRight, Settings2, Plus, \n  Trash2, Edit3, Target, Trophy, Clock, AlertCircle, Loader2, Save, Undo2, Zap, ShieldX, AlertTriangle, RefreshCw\n} from 'lucide-react';\nimport { User, Subject, CycleSubject, StudyCycle, NivelConhecimento, PesoDisciplina, Ciclo } from '../types';\nimport { calcularTempoEstudo, gerarCiclos } from '../services/cycleLogic';\nimport { supabase } from '../lib/supabase';\n\ninterface CiclosProps {\n  user: User;\n  subjects: Subject[];\n  cycle: StudyCycle | null;\n  setCycle: (cycle: StudyCycle | null) => void;\n}\n\nconst Ciclos: React.FC<CiclosProps> = ({ user, subjects, cycle, setCycle }) => {\n  const [configSubjects, setConfigSubjects] = useState<CycleSubject[]>(cycle?.config_disciplinas || []);\n  const [disciplinasPorCiclo, setDisciplinasPorCiclo] = useState(cycle?.disciplinas_por_ciclo || 3);\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const [isSaving, setIsSaving] = useState(false);\n  const [showDeleteModal, setShowDeleteModal] = useState(false);\n\n  // Form State\n  const [selectedSubjectId, setSelectedSubjectId] = useState('');\n  const [nivel, setNivel] = useState<NivelConhecimento>(NivelConhecimento.INICIANTE);\n  const [peso, setPeso] = useState<PesoDisciplina>(PesoDisciplina.NORMAL);\n\n  const ciclosGerados = useMemo(() => {\n    return gerarCiclos(configSubjects, disciplinasPorCiclo);\n  }, [configSubjects, disciplinasPorCiclo]);\n\n  /**\n   * LÓGICA CORE: Identifica automaticamente qual deve ser a fase ativa\n   * percorrendo os ciclos gerados e verificando o progresso real.\n   */\n  const calculateActivePhase = (concluidasIds: string[]): number => {\n    for (const ciclo of ciclosGerados) {\n      const isCicloComplete = ciclo.materias.length > 0 && \n        ciclo.materias.every(m => m.instanceId && concluidasIds.includes(m.instanceId));\n      \n      if (!isCicloComplete) return ciclo.id;\n    }\n    return 4;\n  };\n\n  const saveCycleState = async (newState: Partial<StudyCycle>) => {\n    if (!supabase) return;\n    setIsSaving(true);\n    \n    const currentData = cycle || {\n      board: 'Personalizado',\n      examDate: user.examDate || new Date().toISOString(),\n      hoursPerDay: 4,\n      schedule: [],\n      meta_atual: 1,\n      ciclo_atual: 1,\n      metas_concluidas: 0,\n      materias_concluidas_ids: [],\n      config_disciplinas: configSubjects,\n      disciplinas_por_ciclo: disciplinasPorCiclo\n    };\n\n    const updatedCycle = {\n      ...currentData,\n      ...newState,\n      config_disciplinas: newState.config_disciplinas || configSubjects,\n      disciplinas_por_ciclo: newState.disciplinas_por_ciclo || disciplinasPorCiclo,\n      user_id: user.id\n    } as StudyCycle;\n\n    try {\n      if (user.role === 'visitor') {\n        setCycle(updatedCycle);\n      } else {\n        const payload = {\n          user_id: user.id,\n          board: updatedCycle.board,\n          exam_date: updatedCycle.examDate,\n          hours_per_day: updatedCycle.hoursPerDay,\n          meta_atual: updatedCycle.meta_atual,\n          ciclo_atual: updatedCycle.ciclo_atual,\n          metas_concluidas: updatedCycle.metas_concluidas,\n          materias_concluidas_ids: updatedCycle.materias_concluidas_ids || [],\n          config_disciplinas: updatedCycle.config_disciplinas || [],\n          disciplinas_por_ciclo: updatedCycle.disciplinas_por_ciclo,\n          schedule: updatedCycle.schedule || []\n        };\n\n        const isExisting = !!cycle?.id;\n\n        let result;\n        if (isExisting) {\n          result = await supabase.from('study_cycles').update(payload).eq('id', cycle.id).select().single();\n        } else {\n          result = await supabase.from('study_cycles').insert([payload]).select().single();\n        }\n\n        if (result.error) throw result.error;\n        if (result.data) {\n          setCycle({\n            ...updatedCycle,\n            id: String(result.data.id),\n            ciclo_atual: result.data.ciclo_atual,\n            meta_atual: result.data.meta_atual,\n            metas_concluidas: result.data.metas_concluidas\n          });\n        }\n      }\n    } catch (e: any) {\n      console.error(\"[Ciclos Sync Error]\", e);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleDeletePlan = async () => {\n    if (!cycle || !supabase || isSaving) return;\n    setIsSaving(true);\n    try {\n      if (user.role !== 'visitor') {\n        const { error } = await supabase\n          .from('study_cycles')\n          .delete()\n          .eq('id', cycle.id);\n        if (error) throw error;\n      }\n      setCycle(null);\n      setConfigSubjects([]);\n      setShowDeleteModal(false);\n    } catch (e: any) {\n      console.error(\"[Ciclos Delete Error]\", e);\n      alert(\"Falha ao remover plano: \" + e.message);\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  const handleToggleMateria = async (instanceId: string) => {\n    if (!cycle || isSaving) return;\n    \n    const currentConcluidas = cycle.materias_concluidas_ids || [];\n    const isDone = currentConcluidas.includes(instanceId);\n    \n    const nextConcluidas = isDone \n      ? currentConcluidas.filter(id => id !== instanceId)\n      : [...currentConcluidas, instanceId];\n    \n    const nextActivePhaseId = calculateActivePhase(nextConcluidas);\n    \n    const phasesDone = ciclosGerados.filter(c => \n      c.id < nextActivePhaseId && \n      c.materias.every(m => m.instanceId && nextConcluidas.includes(m.instanceId))\n    ).length;\n\n    await saveCycleState({\n      materias_concluidas_ids: nextConcluidas,\n      ciclo_atual: nextActivePhaseId,\n      metas_concluidas: phasesDone\n    });\n  };\n\n  const handleCompleteCycle = async () => {\n    if (!cycle || isSaving) return;\n    const isLastSubCycle = (cycle.ciclo_atual || 1) >= 4;\n\n    await saveCycleState({\n      ciclo_atual: isLastSubCycle ? 1 : (cycle.ciclo_atual || 1) + 1,\n      meta_atual: isLastSubCycle ? (cycle.meta_atual || 1) + 1 : (cycle.meta_atual || 1),\n      metas_concluidas: (cycle.metas_concluidas || 0) + 1,\n      materias_concluidas_ids: isLastSubCycle ? [] : cycle.materias_concluidas_ids\n    });\n  };\n\n  const handleAddOrUpdateSubject = () => {\n    const baseSubject = subjects.find(s => String(s.id) === String(selectedSubjectId));\n    if (!baseSubject) return;\n\n    const newCycleSubject: CycleSubject = {\n      ...baseSubject,\n      nivelConhecimento: nivel,\n      peso,\n      tempoEstudo: calcularTempoEstudo(nivel, peso)\n    };\n\n    let newConfigs;\n    if (editingId) {\n      newConfigs = configSubjects.map(s => s.id === editingId ? newCycleSubject : s);\n      setEditingId(null);\n    } else {\n      if (configSubjects.find(s => String(s.id) === String(selectedSubjectId))) return;\n      newConfigs = [...configSubjects, newCycleSubject];\n    }\n    \n    setConfigSubjects(newConfigs);\n    setSelectedSubjectId('');\n    saveCycleState({ config_disciplinas: newConfigs });\n  };\n\n  const activeCicloId = cycle?.ciclo_atual || 1;\n  const activeCiclo = ciclosGerados.find(c => c.id === activeCicloId);\n  const allMateriaDone = activeCiclo?.materias.length > 0 && \n    activeCiclo?.materias.every(m => m.instanceId && cycle?.materias_concluidas_ids?.includes(m.instanceId));\n\n  const hasAvailableSubjects = subjects && subjects.length > 0;\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700\">\n      {/* INDICADORES SUPERIORES */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"glass-card p-6 border-l-4 border-indigo-500 flex items-center gap-4 relative overflow-hidden group\">\n          <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><Target size={100} /></div>\n          <div className=\"w-12 h-12 rounded-xl bg-indigo-500/20 flex items-center justify-center text-indigo-400\"><Target size={24} /></div>\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Meta Estratégica</p>\n            <p className=\"text-2xl font-black text-white\"># {cycle?.meta_atual || 1}</p>\n          </div>\n        </div>\n\n        <div className=\"glass-card p-6 border-l-4 border-emerald-500 flex items-center gap-4 relative overflow-hidden group\">\n          <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><Trophy size={100} /></div>\n          <div className=\"w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-400\"><Trophy size={24} /></div>\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Fases Concluídas</p>\n            <p className=\"text-2xl font-black text-white\">{cycle?.metas_concluidas || 0}</p>\n          </div>\n        </div>\n\n        <div className=\"glass-card p-6 border-l-4 border-amber-500 flex items-center gap-4 relative overflow-hidden group\">\n          <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><BrainCircuit size={100} /></div>\n          <div className=\"w-12 h-12 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400\"><BrainCircuit size={24} /></div>\n          <div className=\"flex-1\">\n            <p className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">Fase Ativa (Auto)</p>\n            <p className=\"text-2xl font-black text-white\">Ciclo {activeCicloId} / 4</p>\n          </div>\n          {isSaving && <Loader2 size={16} className=\"animate-spin text-indigo-500\" />}\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"glass-card p-8\">\n            <div className=\"flex items-center justify-between mb-8\">\n              <h3 className=\"text-[11px] font-black uppercase tracking-[0.3em] text-white flex items-center gap-2\">\n                <Settings2 size={14} className=\"text-indigo-400\" /> Matriz Operacional\n              </h3>\n              {cycle && (\n                <button \n                  onClick={() => setShowDeleteModal(true)}\n                  className=\"p-2 text-slate-600 hover:text-rose-500 transition-colors\"\n                  title=\"Expurgar Ciclo Atual\"\n                >\n                  <RefreshCw size={14} />\n                </button>\n              )}\n            </div>\n\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"text-[9px] font-black uppercase text-slate-500 mb-2 block tracking-widest\">Disciplinas por Ciclo</label>\n                <input \n                  type=\"number\" \n                  value={disciplinasPorCiclo}\n                  onChange={(e) => setDisciplinasPorCiclo(Math.max(1, parseInt(e.target.value) || 1))}\n                  className=\"w-full bg-slate-900 border border-white/5 rounded-xl px-4 py-3 text-xs text-white focus:border-indigo-500 outline-none transition-all\" \n                />\n              </div>\n\n              <div className=\"pt-6 border-t border-white/5\">\n                <label className=\"text-[9px] font-black text-slate-500 mb-2 block tracking-widest\">Vincular Matéria</label>\n                {hasAvailableSubjects ? (\n                  <div className=\"space-y-4\">\n                    <select value={selectedSubjectId} onChange={(e) => setSelectedSubjectId(e.target.value)} className=\"w-full bg-slate-900 border border-white/5 rounded-xl px-4 py-3 text-xs text-white focus:border-indigo-500 outline-none transition-all\">\n                      <option value=\"\">SELECIONE...</option>\n                      {subjects.map(s => <option key={s.id} value={s.id}>{s.name.toUpperCase()}</option>)}\n                    </select>\n                    <div className=\"grid grid-cols-2 gap-3\">\n                      <select value={nivel} onChange={(e) => setNivel(e.target.value as any)} className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-3 py-2 text-[10px] text-white outline-none\">\n                        {Object.values(NivelConhecimento).map(v => <option key={v} value={v}>{v}</option>)}\n                      </select>\n                      <select value={peso} onChange={(e) => setPeso(e.target.value as any)} className=\"w-full bg-slate-900 border border-white/5 rounded-lg px-3 py-2 text-[10px] text-white outline-none\">\n                        {Object.values(PesoDisciplina).map(v => <option key={v} value={v}>{v}</option>)}\n                      </select>\n                    </div>\n                    <button onClick={handleAddOrUpdateSubject} disabled={!selectedSubjectId || isSaving} className=\"w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-[10px] font-black uppercase tracking-[0.2em] flex items-center justify-center gap-2 transition-all shadow-lg active:scale-95 disabled:opacity-50\">\n                      {editingId ? <Edit3 size={14}/> : <Plus size={14}/>} {editingId ? 'Atualizar' : 'Vincular'}\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 text-center\">\n                    <p className=\"text-[9px] font-black text-amber-400 uppercase tracking-widest\">Nenhuma disciplina ativa.</p>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"mt-8 space-y-2\">\n                {configSubjects.map(s => (\n                  <div key={s.id} className=\"group flex items-center justify-between p-4 bg-white/[0.03] rounded-xl border border-white/5 hover:border-indigo-500/30 transition-all\">\n                    <div className=\"min-w-0\">\n                      <p className=\"text-[10px] font-bold text-white truncate uppercase tracking-tighter\">{s.name}</p>\n                      <p className=\"text-[8px] text-slate-500 uppercase font-black mt-0.5\">{s.nivelConhecimento} • {s.tempoEstudo}M</p>\n                    </div>\n                    <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                      <button onClick={() => { setEditingId(String(s.id)); setSelectedSubjectId(String(s.id)); setNivel(s.nivelConhecimento); setPeso(s.peso); }} className=\"p-2 hover:bg-white/10 rounded-lg text-amber-500\"><Edit3 size={14}/></button>\n                      <button onClick={() => { const next = configSubjects.filter(ps => ps.id !== s.id); setConfigSubjects(next); saveCycleState({ config_disciplinas: next }); }} className=\"p-2 hover:bg-white/10 rounded-lg text-rose-500\"><Trash2 size={14}/></button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* LISTAGEM DE CICLOS */}\n        <div className=\"lg:col-span-8\">\n          {ciclosGerados.length > 0 ? (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              {ciclosGerados.map((ciclo) => {\n                const isCicloFullyMarked = ciclo.materias.length > 0 && \n                  ciclo.materias.every(m => m.instanceId && cycle?.materias_concluidas_ids?.includes(m.instanceId));\n                \n                const isActive = ciclo.id === activeCicloId;\n                const isCompleted = isCicloFullyMarked && ciclo.id < activeCicloId;\n                const isLocked = ciclo.id > activeCicloId;\n                \n                const progressCount = ciclo.materias.filter(m => cycle?.materias_concluidas_ids?.includes(m.instanceId || '')).length;\n                const percent = (progressCount / (ciclo.materias.length || 1)) * 100;\n\n                return (\n                  <div key={ciclo.id} className={`glass-card overflow-hidden transition-all duration-500 border-2 ${isActive ? 'border-indigo-500 scale-[1.02] shadow-2xl' : isCompleted ? 'border-emerald-500/30 bg-emerald-500/[0.02]' : 'border-white/5 opacity-40 grayscale'}`}>\n                    <div className=\"p-6 border-b border-white/5 bg-white/5 flex items-center justify-between\">\n                      <div>\n                        <div className=\"flex items-center gap-2\">\n                          <p className=\"text-[9px] font-black uppercase text-slate-500 tracking-widest mb-1\">Setor 0{ciclo.id}</p>\n                          {isCompleted && <span className=\"bg-emerald-500/10 text-emerald-500 text-[8px] font-black px-1.5 py-0.5 rounded uppercase mb-1\">Finalizada</span>}\n                          {isActive && <span className=\"bg-indigo-500/10 text-indigo-500 text-[8px] font-black px-1.5 py-0.5 rounded uppercase mb-1\">Fase Ativa</span>}\n                        </div>\n                        <h4 className=\"text-xl font-black text-white uppercase tracking-tighter\">FASE {ciclo.id}</h4>\n                      </div>\n                      <div className=\"text-right\">\n                         <Clock size={18} className=\"text-indigo-400 ml-auto mb-1\" />\n                         <p className=\"text-[10px] font-black text-slate-300\">{Math.floor(ciclo.tempoTotal / 60)}H {ciclo.tempoTotal % 60}M</p>\n                      </div>\n                    </div>\n\n                    <div className=\"h-1.5 bg-slate-900 w-full overflow-hidden\">\n                      <div className={`h-full transition-all duration-1000 ${isCompleted ? 'bg-emerald-500' : 'bg-indigo-500'}`} style={{ width: `${isCompleted ? 100 : percent}%` }} />\n                    </div>\n\n                    <div className=\"p-6 space-y-3\">\n                      {ciclo.materias.map((m, idx) => {\n                        const isDone = cycle?.materias_concluidas_ids?.includes(m.instanceId || '');\n                        const canEditThis = !isLocked;\n\n                        return (\n                          <div key={idx} onClick={() => canEditThis && !isSaving && m.instanceId && handleToggleMateria(m.instanceId)} className={`flex items-center justify-between p-4 rounded-xl border-2 transition-all ${canEditThis ? 'cursor-pointer hover:border-indigo-500/50 hover:bg-white/5 group active:scale-95' : 'cursor-not-allowed opacity-50'} ${isDone ? 'bg-emerald-500/5 border-emerald-500/20' : 'bg-black/30 border-white/5'}`}>\n                            <div className=\"flex items-center gap-4 min-w-0\">\n                              <div className={`w-6 h-6 rounded-lg flex items-center justify-center border-2 transition-all ${isDone ? 'bg-emerald-500 border-emerald-500 text-slate-950 scale-110 shadow-lg' : 'bg-transparent border-slate-700'}`}>\n                                {isDone && <CheckCircle2 size={14} strokeWidth={3} />}\n                              </div>\n                              <span className={`text-[11px] font-black uppercase tracking-tight truncate ${isDone ? 'text-slate-600 line-through' : 'text-slate-100'}`}>{m.name}</span>\n                            </div>\n                            <span className={`text-[9px] font-black px-2.5 py-1 rounded-lg ${isDone ? 'bg-emerald-500/20 text-emerald-400' : 'bg-indigo-500/20 text-indigo-400'}`}>{m.tempoEstudo}M</span>\n                          </div>\n                        );\n                      })}\n\n                      {isActive && (\n                        <button disabled={!allMateriaDone || isSaving} onClick={handleCompleteCycle} className={`w-full mt-6 py-5 rounded-2xl font-black text-[11px] uppercase tracking-[0.25em] transition-all flex items-center justify-center gap-3 ${allMateriaDone ? 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-xl shadow-indigo-500/30 active:scale-[0.98]' : 'bg-slate-800 text-slate-500 cursor-not-allowed opacity-50'}`}>\n                          {isSaving ? <Loader2 size={16} className=\"animate-spin\" /> : allMateriaDone ? <><Zap size={16} /> AVANÇAR E ARQUIVAR</> : <>CONCLUA OS OBJETIVOS <AlertCircle size={16} /></>}\n                        </button>\n                      )}\n\n                      {isCompleted && (\n                         <div className=\"mt-4 pt-4 border-t border-white/5 text-center\">\n                            <p className=\"text-[9px] font-black text-emerald-500/50 uppercase tracking-[0.2em]\">Protocolo Arquivado</p>\n                         </div>\n                      )}\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          ) : (\n            <div className=\"h-full flex flex-col items-center justify-center p-20 glass-card rounded-[3rem] border-dashed border-white/5 opacity-50\">\n               <BrainCircuit size={64} className=\"text-slate-800 mb-6\" />\n               <p className=\"text-[10px] font-black text-slate-500 uppercase tracking-[0.5em]\">Aguardando Definição de Matriz</p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* MODAL DE CONFIRMAÇÃO DE EXCLUSÃO (PADRÃO DO SISTEMA) */}\n      {showDeleteModal && (\n        <div className=\"fixed inset-0 z-[250] flex items-center justify-center p-6 bg-slate-950/80 backdrop-blur-xl animate-in fade-in\">\n           <div className=\"glass-card w-full max-w-sm p-10 rounded-[2.5rem] border border-rose-500/20 text-center shadow-2xl\">\n              <div className=\"w-16 h-16 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto mb-6 border border-rose-500/20\">\n                <AlertTriangle size={32}/>\n              </div>\n              \n              <h3 className=\"text-xl font-black text-white uppercase tracking-tighter mb-4\">\n                EXPURGAR PLANO?\n              </h3>\n              \n              <p className=\"text-slate-400 text-xs font-bold uppercase mb-8 leading-relaxed tracking-wide\">\n                Esta ação destruirá permanentemente seu ciclo de estudos atual e todo o progresso de metas vinculado a ele. Deseja prosseguir?\n              </p>\n              \n              <div className=\"flex flex-col gap-3\">\n                <button \n                  onClick={handleDeletePlan}\n                  disabled={isSaving}\n                  className=\"py-4 rounded-xl font-black text-[10px] uppercase tracking-widest transition-all bg-rose-600 hover:bg-rose-500 text-white shadow-lg active:scale-95 flex items-center justify-center gap-2\"\n                >\n                  {isSaving ? <Loader2 size={14} className=\"animate-spin\" /> : <ShieldX size={14} />}\n                  CONFIRMAR PURGA\n                </button>\n                <button \n                  onClick={() => setShowDeleteModal(false)} \n                  className=\"py-3 text-[9px] font-black text-slate-500 uppercase tracking-widest hover:text-white\"\n                >\n                  MANTER CICLO\n                </button>\n              </div>\n           </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Ciclos;\n"
            }
          ]
        }
      ]
    },
