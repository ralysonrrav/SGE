        {
          "path": "App.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "Main application component with routing and state management.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  BrainCircuit,\n  Award\n} from 'lucide-react';\nimport { \n  BarChart, \n  Bar, \n  XAxis, \n  YAxis, \n  CartesianGrid, \n  Tooltip, \n  ResponsiveContainer, \n  Cell,\n  PieChart,\n  Pie\n} from 'recharts';\nimport { User, Subject, MockExam, StudyCycle, Topic } from './types';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n\n  // Persistence\n  useEffect(() => {\n    const savedUser = localStorage.getItem('user');\n    if (savedUser) {\n      setUser(JSON.parse(savedUser));\n      const savedSubjects = localStorage.getItem(`subjects_${JSON.parse(savedUser).id}`);\n      if (savedSubjects) setSubjects(JSON.parse(savedSubjects));\n      const savedMocks = localStorage.getItem(`mocks_${JSON.parse(savedUser).id}`);\n      if (savedMocks) setMocks(JSON.parse(savedMocks));\n      const savedCycle = localStorage.getItem(`cycle_${JSON.parse(savedUser).id}`);\n      if (savedCycle) setCycle(JSON.parse(savedCycle));\n    }\n  }, []);\n\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem(`subjects_${user.id}`, JSON.stringify(subjects));\n      localStorage.setItem(`mocks_${user.id}`, JSON.stringify(mocks));\n      if (cycle) localStorage.setItem(`cycle_${user.id}`, JSON.stringify(cycle));\n    }\n  }, [subjects, mocks, cycle, user]);\n\n  if (!user) {\n    return <Login onLogin={(u) => { setUser(u); localStorage.setItem('user', JSON.stringify(u)); }} />;\n  }\n\n  const navItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n    { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n    { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n    { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n  ];\n\n  const handleLogout = () => {\n    setUser(null);\n    localStorage.removeItem('user');\n  };\n\n  const renderPage = () => {\n    switch (currentPage) {\n      case 'inicio': return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} />;\n      case 'disciplinas': return <Disciplinas subjects={subjects} setSubjects={setSubjects} />;\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return <Revisao subjects={subjects} setSubjects={setSubjects} />;\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-slate-50 overflow-hidden\">\n      {/* Mobile Sidebar Toggle */}\n      <button \n        className=\"md:hidden fixed top-4 left-4 z-50 p-2 bg-indigo-600 text-white rounded-md shadow-lg\"\n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      {/* Sidebar */}\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-64 bg-white border-r border-slate-200 transform transition-transform duration-300 ease-in-out md:translate-x-0\n        ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}\n      `}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-6 flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-indigo-200 shadow-lg\">\n              <Award size={24} />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-slate-800\">Concurseiro</h1>\n              <p className=\"text-xs text-indigo-600 font-semibold uppercase tracking-widest\">Premium AI</p>\n            </div>\n          </div>\n\n          <nav className=\"flex-1 px-4 py-4 space-y-1\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`\n                  w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-all\n                  ${currentPage === item.id \n                    ? 'bg-indigo-50 text-indigo-700' \n                    : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'}\n                `}\n              >\n                {item.icon}\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-4 border-t border-slate-100\">\n            <div className=\"flex items-center gap-3 px-4 py-3 mb-4\">\n              <div className=\"w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 text-xs font-bold\">\n                {user.name.charAt(0)}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-semibold text-slate-900 truncate\">{user.name}</p>\n                <p className=\"text-xs text-slate-500 truncate\">{user.email}</p>\n              </div>\n            </div>\n            <button\n              onClick={handleLogout}\n              className=\"w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-red-500 hover:bg-red-50 rounded-lg transition-all\"\n            >\n              <LogOut size={20} />\n              Sair\n            </button>\n          </div>\n        </div>\n      </aside>\n\n      {/* Main Content */}\n      <main className=\"flex-1 md:ml-64 overflow-y-auto p-4 md:p-8\">\n        <div className=\"max-w-6xl mx-auto\">\n          {renderPage()}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Login.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "Simple login component for user simulation.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { ShieldCheck, Award } from 'lucide-react';\n\ninterface LoginProps {\n  onLogin: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = ({ onLogin }) => {\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (email && password) {\n      onLogin({ id: 'user_' + Date.now(), name: name || 'Estudante', email });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex items-center justify-center p-4\">\n      <div className=\"max-w-md w-full bg-white rounded-2xl shadow-xl shadow-slate-200 border border-slate-100 p-8\">\n        <div className=\"text-center mb-10\">\n          <div className=\"mx-auto w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-indigo-100 mb-6 rotate-3 hover:rotate-0 transition-transform cursor-pointer\">\n            <Award size={32} />\n          </div>\n          <h1 className=\"text-3xl font-extrabold text-slate-900\">Concurseiro Pro AI</h1>\n          <p className=\"text-slate-500 mt-2 font-medium\">Sua jornada para a aprovação começa aqui.</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 mb-2\">Seu Nome</label>\n            <input\n              type=\"text\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none\"\n              placeholder=\"Ex: João Silva\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 mb-2\">E-mail</label>\n            <input\n              type=\"email\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none\"\n              placeholder=\"seu@email.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 mb-2\">Senha</label>\n            <input\n              type=\"password\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none\"\n              placeholder=\"••••••••\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-indigo-600 text-white font-bold py-4 rounded-xl hover:bg-indigo-700 transition-colors shadow-lg shadow-indigo-100 flex items-center justify-center gap-2\"\n          >\n            <ShieldCheck size={20} />\n            Acessar Plataforma\n          </button>\n        </form>\n\n        <p className=\"text-center text-slate-400 text-xs mt-8\">\n          Ambiente de alta performance para controle de estudos.\n        </p>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
            }
          ]
        },
        {
          "path": "components/Dashboard.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "Overview dashboard with stats and charts.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React from 'react';\nimport { Subject, MockExam, StudyCycle } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, Cell,\n  PieChart, Pie\n} from 'recharts';\nimport { CheckCircle2, TrendingUp, Clock, BookOpen } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, cycle }) => {\n  const totalTopics = subjects.reduce((acc, s) => acc + s.topics.length, 0);\n  const completedTopics = subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  const mockData = mocks.map(m => ({\n    name: m.title,\n    acerto: Math.round((m.score / m.totalQuestions) * 100)\n  })).slice(-5);\n\n  const subjectProgressData = subjects.map(s => ({\n    name: s.name,\n    total: s.topics.length,\n    concluido: s.topics.filter(t => t.completed).length,\n    color: s.color\n  }));\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Bem-vindo ao seu QG</h2>\n        <p className=\"text-slate-500 font-medium\">Aqui está o resumo do seu progresso rumo à aprovação.</p>\n      </header>\n\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n          <div className=\"p-3 bg-indigo-50 text-indigo-600 rounded-xl\">\n            <CheckCircle2 size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">Tópicos Concluídos</p>\n            <h3 className=\"text-2xl font-bold text-slate-900\">{completedTopics} / {totalTopics}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n          <div className=\"p-3 bg-emerald-50 text-emerald-600 rounded-xl\">\n            <TrendingUp size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">Progresso Geral</p>\n            <h3 className=\"text-2xl font-bold text-slate-900\">{progressPercent}%</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n          <div className=\"p-3 bg-amber-50 text-amber-600 rounded-xl\">\n            <BookOpen size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">Disciplinas</p>\n            <h3 className=\"text-2xl font-bold text-slate-900\">{subjects.length}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4\">\n          <div className=\"p-3 bg-purple-50 text-purple-600 rounded-xl\">\n            <Clock size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">Prova em</p>\n            <h3 className=\"text-2xl font-bold text-slate-900\">\n              {cycle ? new Date(cycle.examDate).toLocaleDateString('pt-BR') : 'Sem data'}\n            </h3>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n        {/* Performance in Mocks */}\n        <div className=\"bg-white p-8 rounded-3xl border border-slate-100 shadow-sm\">\n          <h3 className=\"text-lg font-bold text-slate-800 mb-6\">Desempenho nos Últimos Simulados (%)</h3>\n          <div className=\"h-[300px]\">\n            {mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={mockData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#f1f5f9\" />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} />\n                  <YAxis axisLine={false} tickLine={false} />\n                  <Tooltip \n                    contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 10px 15px -3px rgb(0 0 0 / 0.1)' }}\n                    cursor={{ fill: '#f8fafc' }}\n                  />\n                  <Bar dataKey=\"acerto\" fill=\"#4f46e5\" radius={[6, 6, 0, 0]} barSize={40} />\n                </BarChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-400 gap-2\">\n                <BarChart2 size={48} className=\"opacity-20\" />\n                <p>Nenhum simulado cadastrado ainda.</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Subjects Progress */}\n        <div className=\"bg-white p-8 rounded-3xl border border-slate-100 shadow-sm\">\n          <h3 className=\"text-lg font-bold text-slate-800 mb-6\">Progresso por Disciplina</h3>\n          <div className=\"space-y-6\">\n            {subjectProgressData.length > 0 ? (\n              subjectProgressData.map((s) => (\n                <div key={s.name} className=\"space-y-2\">\n                  <div className=\"flex justify-between text-sm\">\n                    <span className=\"font-semibold text-slate-700\">{s.name}</span>\n                    <span className=\"text-slate-500\">{s.concluido} / {s.total} tópicos</span>\n                  </div>\n                  <div className=\"h-3 bg-slate-100 rounded-full overflow-hidden\">\n                    <div \n                      className=\"h-full transition-all duration-1000\"\n                      style={{ \n                        width: `${s.total > 0 ? (s.concluido / s.total) * 100 : 0}%`,\n                        backgroundColor: s.color \n                      }}\n                    />\n                  </div>\n                </div>\n              ))\n            ) : (\n              <p className=\"text-slate-400 text-center py-10\">Cadastre disciplinas para ver o progresso.</p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        },
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "Subject and topic management.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { Plus, Trash2, ChevronDown, ChevronUp, CheckCircle, Circle, AlertCircle } from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: newSubjectName,\n      topics: [],\n      color: colors[subjects.length % colors.length]\n    };\n    setSubjects([...subjects, newSub]);\n    setNewSubjectName('');\n  };\n\n  const removeSubject = (id: string) => {\n    setSubjects(subjects.filter(s => s.id !== id));\n  };\n\n  const addTopic = (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: [...s.topics, { \n            id: Date.now().toString(), \n            title: newTopicTitle, \n            completed: false, \n            importance: 3 \n          }]\n        };\n      }\n      return s;\n    }));\n    setNewTopicTitle('');\n  };\n\n  const toggleTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const now = new Date().toISOString();\n              return { ...t, completed: !t.completed, lastStudiedAt: !t.completed ? now : t.lastStudiedAt };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n  };\n\n  const removeTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return { ...s, topics: s.topics.filter(t => t.id !== topicId) };\n      }\n      return s;\n    }));\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 font-medium\">Gerencie suas disciplinas e tópicos de estudo.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Nova disciplina...\"\n            className=\"px-4 py-2 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject}\n            className=\"bg-indigo-600 text-white p-2 rounded-xl hover:bg-indigo-700 transition-all flex items-center justify-center shadow-lg shadow-indigo-100\"\n          >\n            <Plus size={24} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 && (\n          <div className=\"text-center py-20 bg-white rounded-3xl border border-dashed border-slate-300\">\n            <BookOpen className=\"mx-auto text-slate-300 mb-4\" size={48} />\n            <p className=\"text-slate-500 font-medium\">Nenhuma disciplina cadastrada. Adicione uma acima!</p>\n          </div>\n        )}\n\n        {subjects.map(subject => (\n          <div key={subject.id} className=\"bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n            <div \n              className=\"p-5 flex items-center justify-between cursor-pointer\"\n              onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n            >\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-4 h-12 rounded-full\" style={{ backgroundColor: subject.color }} />\n                <div>\n                  <h3 className=\"font-bold text-lg text-slate-800\">{subject.name}</h3>\n                  <p className=\"text-xs text-slate-400 font-semibold uppercase tracking-widest\">\n                    {subject.topics.filter(t => t.completed).length} / {subject.topics.length} Tópicos\n                  </p>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-4\">\n                <button \n                  onClick={(e) => { e.stopPropagation(); removeSubject(subject.id); }}\n                  className=\"text-slate-300 hover:text-red-500 transition-colors p-2\"\n                >\n                  <Trash2 size={20} />\n                </button>\n                {expandedSubject === subject.id ? <ChevronUp className=\"text-slate-400\" /> : <ChevronDown className=\"text-slate-400\" />}\n              </div>\n            </div>\n\n            {expandedSubject === subject.id && (\n              <div className=\"px-5 pb-5 pt-2 border-t border-slate-50 bg-slate-50/30\">\n                <div className=\"flex gap-2 mb-6\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Novo tópico para esta disciplina...\"\n                    className=\"flex-1 px-4 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none\"\n                    value={newTopicTitle}\n                    onChange={(e) => setNewTopicTitle(e.target.value)}\n                    onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                  />\n                  <button \n                    onClick={() => addTopic(subject.id)}\n                    className=\"bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-indigo-700 transition-all\"\n                  >\n                    Adicionar\n                  </button>\n                </div>\n\n                <div className=\"space-y-2\">\n                  {subject.topics.map(topic => (\n                    <div \n                      key={topic.id}\n                      className=\"group flex items-center justify-between p-3 rounded-xl bg-white border border-slate-100 transition-all hover:border-indigo-200\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <button \n                          onClick={() => toggleTopic(subject.id, topic.id)}\n                          className={`transition-colors ${topic.completed ? 'text-emerald-500' : 'text-slate-300 hover:text-indigo-400'}`}\n                        >\n                          {topic.completed ? <CheckCircle size={22} /> : <Circle size={22} />}\n                        </button>\n                        <span className={`text-sm font-medium ${topic.completed ? 'text-slate-400 line-through' : 'text-slate-700'}`}>\n                          {topic.title}\n                        </span>\n                      </div>\n                      <div className=\"flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n                         <span className=\"text-[10px] bg-amber-50 text-amber-600 px-2 py-1 rounded-full font-bold uppercase tracking-tighter\">\n                          Prioridade {topic.importance}\n                        </span>\n                        <button \n                          onClick={() => removeTopic(subject.id, topic.id)}\n                          className=\"text-slate-300 hover:text-red-400 transition-colors\"\n                        >\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                  {subject.topics.length === 0 && (\n                    <p className=\"text-center text-slate-400 text-sm py-4\">Nenhum tópico adicionado.</p>\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        },
        {
          "path": "components/Ciclos.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "AI-driven study cycle planner.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, StudyCycle } from '../types';\nimport { BrainCircuit, Loader2, Calendar, Target, Clock, Zap } from 'lucide-react';\nimport { generateStudyCycle } from '../services/geminiService';\n\ninterface CiclosProps {\n  subjects: Subject[];\n  cycle: StudyCycle | null;\n  setCycle: React.Dispatch<React.SetStateAction<StudyCycle | null>>;\n}\n\nconst Ciclos: React.FC<CiclosProps> = ({ subjects, cycle, setCycle }) => {\n  const [loading, setLoading] = useState(false);\n  const [board, setBoard] = useState('Cebraspe');\n  const [examDate, setExamDate] = useState('');\n  const [hoursPerDay, setHoursPerDay] = useState(4);\n\n  const boards = ['Cebraspe', 'FGV', 'Vunesp', 'FCC', 'Outra'];\n\n  const handleGenerate = async () => {\n    if (subjects.length === 0) {\n      alert(\"Adicione disciplinas primeiro!\");\n      return;\n    }\n    setLoading(true);\n    try {\n      const result = await generateStudyCycle(board, examDate, hoursPerDay, subjects);\n      const newCycle: StudyCycle = {\n        id: Date.now().toString(),\n        board,\n        examDate,\n        hoursPerDay,\n        schedule: result.schedule\n      };\n      setCycle(newCycle);\n    } catch (error) {\n      alert(\"Houve um erro ao gerar o ciclo. Tente novamente.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Ciclos de Estudo AI</h2>\n        <p className=\"text-slate-500 font-medium\">Nossa inteligência artificial cria o cronograma perfeito baseado em Pareto.</p>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Configuration Panel */}\n        <div className=\"lg:col-span-1 bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-6 h-fit\">\n          <div className=\"flex items-center gap-2 text-indigo-600 font-bold\">\n            <Zap size={20} />\n            <span>Configuração do Plano</span>\n          </div>\n\n          <div className=\"space-y-4\">\n            <div>\n              <label className=\"block text-sm font-semibold text-slate-700 mb-1\">Banca Examinadora</label>\n              <select \n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={board}\n                onChange={(e) => setBoard(e.target.value)}\n              >\n                {boards.map(b => <option key={b} value={b}>{b}</option>)}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-sm font-semibold text-slate-700 mb-1\">Data da Prova</label>\n              <input \n                type=\"date\"\n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={examDate}\n                onChange={(e) => setExamDate(e.target.value)}\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-sm font-semibold text-slate-700 mb-1\">Horas por Dia</label>\n              <input \n                type=\"number\"\n                min=\"1\"\n                max=\"24\"\n                className=\"w-full px-4 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500\"\n                value={hoursPerDay}\n                onChange={(e) => setHoursPerDay(parseInt(e.target.value))}\n              />\n            </div>\n\n            <button\n              onClick={handleGenerate}\n              disabled={loading}\n              className={`\n                w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white shadow-lg transition-all\n                ${loading ? 'bg-slate-400 cursor-not-allowed' : 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-100'}\n              `}\n            >\n              {loading ? <Loader2 className=\"animate-spin\" size={20} /> : <BrainCircuit size={20} />}\n              {loading ? 'Otimizando Ciclos...' : 'Gerar Cronograma IA'}\n            </button>\n          </div>\n        </div>\n\n        {/* Results Panel */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          {!cycle && !loading && (\n            <div className=\"bg-white rounded-3xl border border-dashed border-slate-300 p-12 text-center\">\n              <div className=\"w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300\">\n                <Calendar size={32} />\n              </div>\n              <p className=\"text-slate-500 font-medium\">Configure as informações ao lado e clique em \"Gerar\" para ver seu plano personalizado.</p>\n            </div>\n          )}\n\n          {loading && (\n            <div className=\"bg-white rounded-3xl border border-slate-100 p-12 text-center animate-pulse\">\n              <BrainCircuit className=\"mx-auto mb-4 text-indigo-200\" size={48} />\n              <h3 className=\"text-lg font-bold text-slate-800\">Analisando tendências da banca {board}...</h3>\n              <p className=\"text-slate-400 mt-2\">Nossa IA está calculando o melhor custo-benefício para seus estudos.</p>\n            </div>\n          )}\n\n          {cycle && !loading && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-xl font-bold text-slate-800\">Seu Plano Semanal (Banca: {cycle.board})</h3>\n                <div className=\"px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full text-xs font-bold uppercase\">Baseado em Pareto 80/20</div>\n              </div>\n              \n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {cycle.schedule.map((dayPlan, idx) => (\n                  <div key={idx} className=\"bg-white p-5 rounded-2xl border border-slate-100 shadow-sm transition-transform hover:-translate-y-1\">\n                    <h4 className=\"font-bold text-indigo-600 mb-3 border-b border-indigo-50 pb-2\">{dayPlan.day}</h4>\n                    <div className=\"space-y-3\">\n                      {dayPlan.sessions.map((session, sIdx) => (\n                        <div key={sIdx} className=\"flex justify-between items-start gap-4 p-2 rounded-lg bg-slate-50/50\">\n                          <div>\n                            <p className=\"text-sm font-bold text-slate-700\">{session.subjectName}</p>\n                            <p className=\"text-xs text-slate-500 font-medium\">{session.focus}</p>\n                          </div>\n                          <div className=\"flex items-center gap-1 text-xs font-bold text-slate-400\">\n                            <Clock size={12} />\n                            {session.duration}m\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Ciclos;\n"
            }
          ]
        },
        {
          "path": "components/Revisao.tsx",
          "generationType": 0,
          "isDone": true,
          "description": "Spaced repetition management.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React from 'react';\nimport { Subject, Topic, ReviewAlert } from '../types';\nimport { RefreshCcw, Bell, CheckCircle, Calendar, ArrowRight } from 'lucide-react';\n\ninterface RevisaoProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n}\n\nconst Revisao: React.FC<RevisaoProps> = ({ subjects, setSubjects }) => {\n  const getReviews = (): ReviewAlert[] => {\n    const alerts: ReviewAlert[] = [];\n    const now = new Date();\n\n    subjects.forEach(subject => {\n      subject.topics.forEach(topic => {\n        if (topic.completed && topic.lastStudiedAt) {\n          const lastDate = new Date(topic.lastStudiedAt);\n          const diffDays = Math.floor((now.getTime() - lastDate.getTime()) / (1000 * 3600 * 24));\n          \n          const reviewMilestones = [7, 15, 30];\n          \n          reviewMilestones.forEach(milestone => {\n            if (diffDays >= milestone && diffDays < milestone + 2) {\n              const dueDate = new Date(lastDate);\n              dueDate.setDate(dueDate.getDate() + milestone);\n              \n              alerts.push({\n                subjectName: subject.name,\n                topicTitle: topic.title,\n                daysPassed: diffDays,\n                dueDate: dueDate.toLocaleDateString('pt-BR')\n              });\n            }\n          });\n        }\n      });\n    });\n\n    return alerts.sort((a, b) => a.daysPassed - b.daysPassed);\n  };\n\n  const reviews = getReviews();\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">Revisão Espaçada</h2>\n        <p className=\"text-slate-500 font-medium\">Alertas automáticos para revisões de 7, 15 e 30 dias.</p>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-4\">\n          {reviews.length > 0 ? (\n            reviews.map((rev, idx) => (\n              <div key={idx} className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row md:items-center gap-4 hover:border-indigo-200 transition-colors\">\n                <div className=\"p-3 bg-amber-50 text-amber-600 rounded-xl h-fit\">\n                  <Bell size={24} />\n                </div>\n                <div className=\"flex-1\">\n                  <p className=\"text-xs text-slate-400 font-bold uppercase tracking-wider mb-1\">{rev.subjectName}</p>\n                  <h3 className=\"font-bold text-slate-800 text-lg\">{rev.topicTitle}</h3>\n                  <div className=\"flex items-center gap-4 mt-2\">\n                    <span className=\"flex items-center gap-1 text-xs text-indigo-600 font-bold bg-indigo-50 px-2 py-1 rounded-lg\">\n                      <Calendar size={12} />\n                      Vence em: {rev.dueDate}\n                    </span>\n                    <span className=\"text-xs text-slate-500 font-medium\">Ciclo de {rev.daysPassed} dias</span>\n                  </div>\n                </div>\n                <button className=\"bg-emerald-500 text-white px-6 py-2 rounded-xl text-sm font-bold hover:bg-emerald-600 transition-all flex items-center justify-center gap-2 shadow-lg shadow-emerald-100\">\n                  <CheckCircle size={18} />\n                  Revisado\n                </button>\n              </div>\n            ))\n          ) : (\n            <div className=\"bg-white rounded-3xl border border-dashed border-slate-300 p-20 text-center\">\n              <RefreshCcw className=\"mx-auto text-slate-200 mb-4\" size={64} />\n              <h3 className=\"text-xl font-bold text-slate-800\">Sem revisões pendentes!</h3>\n              <p className=\"text-slate-500 mt-2 max-w-sm mx-auto\">Suas revisões de 7, 15 e 30 dias aparecerão aqui conforme você avança nos estudos.</p>\n            </div>\n          )}\n        </div>\n\n        <div className=\"space-y-6\">\n          <div className=\"bg-indigo-600 text-white p-8 rounded-3xl shadow-xl shadow-indigo-100\">\n            <h3 className=\"text-xl font-bold mb-4\">Curva do Esquecimento</h3>\n            <p className=\"text-indigo-100 text-sm leading-relaxed mb-6\">\n              Estudos mostram que esquecemos até 80% do que aprendemos em apenas 24 horas. \n              As revisões em 7, 15 e 30 dias são cruciais para mover o conhecimento para a memória de longo prazo.\n            </p>\n            <div className=\"flex items-center gap-2 text-sm font-bold bg-white/10 p-3 rounded-xl border border-white/20\">\n              <ArrowRight size={16} />\n              Mantenha o foco constante!\n            </div>\n          </div>\n\n          <div className=\"bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n            <h4 className=\"font-bold text-slate-800 mb-4\">Próximos Marcos</h4>\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs font-bold\">7d</div>\n                <div className=\"text-xs font-medium text-slate-600\">Revisão Rápida (Questões)</div>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs font-bold\">15d</div>\n                <div className=\"text-xs font-medium text-slate-600\">Revisão Teórica (Mapas Mentais)</div>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs font-bold\">30d</div>\n                <div className=\"text-xs font-medium text-slate-600\">Consolidação (Questões Difíceis)</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Revisao;\n"
