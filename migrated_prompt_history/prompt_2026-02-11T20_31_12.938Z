    "id": 64,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Adição do estado de modo escuro, lógica de persistência e botão de alternância na barra lateral.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession } from './types';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    return saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);\n  });\n\n  // Theme synchronization\n  useEffect(() => {\n    if (isDarkMode) {\n      document.documentElement.classList.add('dark');\n      localStorage.setItem('theme', 'dark');\n    } else {\n      document.documentElement.classList.remove('dark');\n      localStorage.setItem('theme', 'light');\n    }\n  }, [isDarkMode]);\n\n  // Persistence\n  useEffect(() => {\n    const savedUser = localStorage.getItem('user');\n    if (savedUser) {\n      const parsedUser = JSON.parse(savedUser);\n      setUser(parsedUser);\n      const savedSubjects = localStorage.getItem(`subjects_${parsedUser.id}`);\n      if (savedSubjects) setSubjects(JSON.parse(savedSubjects));\n      const savedMocks = localStorage.getItem(`mocks_${parsedUser.id}`);\n      if (savedMocks) setMocks(JSON.parse(savedMocks));\n      const savedCycle = localStorage.getItem(`cycle_${parsedUser.id}`);\n      if (savedCycle) setCycle(JSON.parse(savedCycle));\n      const savedLogs = localStorage.getItem(`logs_${parsedUser.id}`);\n      if (savedLogs) setStudyLogs(JSON.parse(savedLogs));\n    }\n  }, []);\n\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem('user', JSON.stringify(user));\n      localStorage.setItem(`subjects_${user.id}`, JSON.stringify(subjects));\n      localStorage.setItem(`mocks_${user.id}`, JSON.stringify(mocks));\n      localStorage.setItem(`logs_${user.id}`, JSON.stringify(studyLogs));\n      if (cycle) localStorage.setItem(`cycle_${user.id}`, JSON.stringify(cycle));\n    }\n  }, [subjects, mocks, cycle, user, studyLogs]);\n\n  if (!user) {\n    return <Login onLogin={(u) => { setUser(u); localStorage.setItem('user', JSON.stringify(u)); }} />;\n  }\n\n  const navItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n    { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n    { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n    { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n  ];\n\n  const handleLogout = () => {\n    setUser(null);\n    localStorage.removeItem('user');\n  };\n\n  const addStudyLog = (log: Omit<StudySession, 'id'>) => {\n    const newLog: StudySession = { ...log, id: Date.now().toString() };\n    setStudyLogs(prev => [...prev, newLog]);\n  };\n\n  const updateWeeklyGoal = (hours: number) => {\n    setUser(prev => prev ? { ...prev, weeklyGoal: hours } : null);\n  };\n\n  const renderPage = () => {\n    switch (currentPage) {\n      case 'inicio': return (\n        <Dashboard \n          subjects={subjects} \n          mocks={mocks} \n          cycle={cycle} \n          studyLogs={studyLogs} \n          weeklyGoal={user.weeklyGoal || 20}\n          onUpdateGoal={updateWeeklyGoal}\n          isDarkMode={isDarkMode}\n        />\n      );\n      case 'disciplinas': return (\n        <Disciplinas \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'estudo' })}\n        />\n      );\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return (\n        <Revisao \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'revisao' })}\n        />\n      );\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={updateWeeklyGoal} isDarkMode={isDarkMode} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-slate-50 dark:bg-slate-950 overflow-hidden transition-colors duration-300\">\n      {/* Mobile Sidebar Toggle */}\n      <button \n        className=\"md:hidden fixed top-4 left-4 z-50 p-2 bg-indigo-600 text-white rounded-md shadow-lg\"\n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      {/* Sidebar */}\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 ease-in-out md:translate-x-0\n        ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}\n      `}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-6 flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-indigo-200 dark:shadow-indigo-900/20 shadow-lg\">\n              <Award size={24} />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-slate-800 dark:text-slate-100\">Concurseiro</h1>\n              <p className=\"text-xs text-indigo-600 dark:text-indigo-400 font-semibold uppercase tracking-widest\">Premium AI</p>\n            </div>\n          </div>\n\n          <nav className=\"flex-1 px-4 py-4 space-y-1\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`\n                  w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-all\n                  ${currentPage === item.id \n                    ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-400' \n                    : 'text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100'}\n                `}\n              >\n                {item.icon}\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-4 border-t border-slate-100 dark:border-slate-800\">\n            {/* Theme Toggle Button */}\n            <button\n              onClick={() => setIsDarkMode(!isDarkMode)}\n              className=\"w-full flex items-center gap-3 px-4 py-3 mb-2 text-sm font-medium text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-all\"\n            >\n              {isDarkMode ? <Sun size={20} className=\"text-amber-500\" /> : <Moon size={20} className=\"text-indigo-500\" />}\n              {isDarkMode ? 'Modo Claro' : 'Modo Escuro'}\n            </button>\n\n            <div className=\"flex items-center gap-3 px-4 py-3 mb-4\">\n              <div className=\"w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-700 dark:text-indigo-400 text-xs font-bold\">\n                {user.name.charAt(0)}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-semibold text-slate-900 dark:text-slate-100 truncate\">{user.name}</p>\n                <p className=\"text-xs text-slate-500 dark:text-slate-500 truncate\">{user.email}</p>\n              </div>\n            </div>\n            <button\n              onClick={handleLogout}\n              className=\"w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 rounded-lg transition-all\"\n            >\n              <LogOut size={20} />\n              Sair\n            </button>\n          </div>\n        </div>\n      </aside>\n\n      {/* Main Content */}\n      <main className=\"flex-1 md:ml-64 overflow-y-auto p-4 md:p-8\">\n        <div className=\"max-w-6xl mx-auto\">\n          {renderPage()}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Dashboard.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação do suporte ao modo escuro no painel e nos gráficos.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, MockExam, StudyCycle, StudySession } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell\n} from 'recharts';\nimport { CheckCircle2, TrendingUp, Clock, BookOpen, BarChart2, Zap, Settings, Target } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n  studyLogs: StudySession[];\n  weeklyGoal: number;\n  onUpdateGoal: (hours: number) => void;\n  isDarkMode: boolean;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, cycle, studyLogs, weeklyGoal, onUpdateGoal, isDarkMode }) => {\n  const [isEditingGoal, setIsEditingGoal] = useState(false);\n  const [tempGoal, setTempGoal] = useState(weeklyGoal);\n\n  // --- CÁLCULOS DE MÉTRICAS GLOBAIS ---\n\n  // Horas Totais (Vitalício)\n  const totalMinutes = subjects.reduce((acc, s) => {\n    return acc + s.topics.reduce((tAcc, t) => tAcc + (t.studyTimeMinutes || 0), 0);\n  }, 0);\n  const totalHours = Math.floor(totalMinutes / 60);\n\n  // Progresso de Tópicos do Edital\n  const totalTopics = subjects.reduce((acc, s) => acc + s.topics.length, 0);\n  const completedTopics = subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  // Unificação de Questões (Tópicos + Simulados)\n  const questionsFromTopics = subjects.reduce((acc, s) => {\n    return acc + s.topics.reduce((tAcc, t) => tAcc + (t.questionsAttempted || 0), 0);\n  }, 0);\n  const hitsFromTopics = subjects.reduce((acc, s) => {\n    return acc + s.topics.reduce((tAcc, t) => tAcc + (t.questionsCorrect || 0), 0);\n  }, 0);\n\n  const questionsFromMocks = mocks.reduce((acc, m) => acc + m.totalQuestions, 0);\n  const hitsFromMocks = mocks.reduce((acc, m) => acc + m.score, 0);\n\n  const totalQuestionsAttempted = questionsFromTopics + questionsFromMocks;\n  const totalQuestionsCorrect = hitsFromTopics + hitsFromMocks;\n  const globalHitRate = totalQuestionsAttempted > 0 \n    ? Math.round((totalQuestionsCorrect / totalQuestionsAttempted) * 100) \n    : 0;\n\n  // Meta Semanal (Domingo a Domingo)\n  const getThisWeekMinutes = () => {\n    const now = new Date();\n    const dayOfWeek = now.getDay();\n    const diffToSunday = dayOfWeek; \n    const lastSunday = new Date(now);\n    lastSunday.setDate(now.getDate() - diffToSunday);\n    lastSunday.setHours(0, 0, 0, 0);\n\n    return studyLogs.reduce((acc, log) => {\n      const logDate = new Date(log.date);\n      if (logDate >= lastSunday) {\n        return acc + log.minutes;\n      }\n      return acc;\n    }, 0);\n  };\n\n  const thisWeekMinutes = getThisWeekMinutes();\n  const thisWeekHours = parseFloat((thisWeekMinutes / 60).toFixed(1));\n  const weeklyGoalPercent = Math.min(100, Math.round((thisWeekHours / weeklyGoal) * 100));\n\n  // Dados para Gráficos\n  const mockData = mocks.map(m => ({\n    name: m.title,\n    acerto: Math.round((m.score / m.totalQuestions) * 100)\n  })).slice(-5);\n\n  const subjectProgressData = subjects.map(s => ({\n    name: s.name,\n    total: s.topics.length,\n    concluido: s.topics.filter(t => t.completed).length,\n    color: s.color\n  }));\n\n  const chartThemeColors = {\n    grid: isDarkMode ? '#1e293b' : '#f1f5f9',\n    text: isDarkMode ? '#94a3b8' : '#64748b',\n    tooltipBg: isDarkMode ? '#0f172a' : '#ffffff',\n    tooltipBorder: isDarkMode ? '#1e293b' : '#f1f5f9',\n  };\n\n  const saveGoal = () => {\n    onUpdateGoal(tempGoal);\n    setIsEditingGoal(false);\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">QG de Performance</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle absoluto da sua jornada de estudos.</p>\n        </div>\n        <div className=\"flex items-center gap-3 bg-white dark:bg-slate-900 px-4 py-2 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <div className=\"p-2 bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 rounded-lg\">\n            <Zap size={18} />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase leading-none\">Total Estudado</p>\n            <p className=\"text-sm font-bold text-slate-800 dark:text-slate-100\">{totalHours} Horas</p>\n          </div>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Weekly Goal Card */}\n        <div className=\"lg:col-span-2 bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-xl shadow-slate-100/50 dark:shadow-none p-8 relative overflow-hidden group transition-colors\">\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-50 dark:bg-indigo-900/10 rounded-full blur-3xl -mr-32 -mt-32 opacity-50 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900/20 transition-colors\" />\n          \n          <div className=\"relative flex flex-col md:flex-row items-center gap-8\">\n            <div className=\"relative w-48 h-48 shrink-0 flex items-center justify-center\">\n               <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 192 192\">\n                 <circle \n                   cx=\"96\" cy=\"96\" r=\"78\" \n                   className=\"stroke-slate-100 dark:stroke-slate-800 fill-none transition-colors\" \n                   strokeWidth=\"12\"\n                 />\n                 <circle \n                   cx=\"96\" cy=\"96\" r=\"78\" \n                   className=\"stroke-indigo-600 dark:stroke-indigo-500 fill-none transition-all duration-1000 ease-out\" \n                   strokeWidth=\"12\"\n                   strokeDasharray={2 * Math.PI * 78}\n                   strokeDashoffset={(2 * Math.PI * 78) * (1 - weeklyGoalPercent / 100)}\n                   strokeLinecap=\"round\"\n                 />\n               </svg>\n               <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n                 <span className=\"text-4xl font-black text-slate-900 dark:text-slate-100\">{weeklyGoalPercent}%</span>\n                 <span className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Da Meta</span>\n               </div>\n            </div>\n\n            <div className=\"flex-1 space-y-6\">\n               <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <h3 className=\"text-2xl font-black text-slate-800 dark:text-slate-100 flex items-center gap-2\">\n                      <Target className=\"text-indigo-600 dark:text-indigo-500\" /> Meta da Semana\n                    </h3>\n                    <button \n                      onClick={() => setIsEditingGoal(!isEditingGoal)}\n                      className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-xl transition-all\"\n                    >\n                      <Settings size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Você estudou <span className=\"text-indigo-600 dark:text-indigo-400 font-bold\">{thisWeekHours}h</span> das <span className=\"text-slate-800 dark:text-slate-200 font-bold\">{weeklyGoal}h</span> planejadas.</p>\n               </div>\n\n               {isEditingGoal && (\n                 <div className=\"flex gap-2 animate-in slide-in-from-top-2 duration-200\">\n                    <input \n                      type=\"number\" \n                      className=\"flex-1 px-4 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-800 dark:text-white\"\n                      value={tempGoal}\n                      onChange={(e) => setTempGoal(parseInt(e.target.value) || 0)}\n                    />\n                    <button onClick={saveGoal} className=\"bg-indigo-600 text-white px-6 py-2 rounded-xl font-bold transition-colors\">Salvar</button>\n                 </div>\n               )}\n\n               <div className=\"grid grid-cols-2 gap-4 pt-4\">\n                  <div className=\"p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800 transition-colors\">\n                    <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase mb-1\">Status</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{weeklyGoalPercent >= 100 ? 'Meta Batida! 🎉' : 'Foco Total 🚀'}</p>\n                  </div>\n                  <div className=\"p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800 transition-colors\">\n                    <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase mb-1\">Reinicia em</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">Próximo Domingo</p>\n                  </div>\n               </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Progress Pie Card */}\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col items-center justify-center text-center transition-colors\">\n            <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Progresso do Edital</h3>\n            <div className=\"h-[180px] w-full\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <PieChart>\n                  <Pie\n                    data={[\n                      { name: 'Concluído', value: completedTopics },\n                      { name: 'Pendente', value: Math.max(0, totalTopics - completedTopics) }\n                    ]}\n                    cx=\"50%\" cy=\"50%\" innerRadius={60} outerRadius={80} paddingAngle={5} dataKey=\"value\"\n                  >\n                    <Cell fill=\"#4f46e5\" />\n                    <Cell fill={isDarkMode ? '#1e293b' : '#f1f5f9'} className=\"transition-colors\" />\n                  </Pie>\n                  <Tooltip \n                    contentStyle={{ \n                      backgroundColor: chartThemeColors.tooltipBg, \n                      border: `1px solid ${chartThemeColors.tooltipBorder}`, \n                      borderRadius: '12px',\n                      color: chartThemeColors.text\n                    }} \n                  />\n                </PieChart>\n              </ResponsiveContainer>\n            </div>\n            <p className=\"text-2xl font-black text-slate-900 dark:text-slate-100 mt-4\">{progressPercent}%</p>\n            <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-1\">Geral Concluído</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors\">\n          <div className=\"p-3 bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 rounded-xl\">\n            <CheckCircle2 size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">Tópicos</p>\n            <h3 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">{completedTopics} / {totalTopics}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors\">\n          <div className=\"p-3 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 rounded-xl\">\n            <TrendingUp size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">Aproveitamento</p>\n            <h3 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">{globalHitRate}%</h3>\n            <p className=\"text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase mt-0.5\">{totalQuestionsAttempted} Questões Feitas</p>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors\">\n          <div className=\"p-3 bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 rounded-xl\">\n            <BookOpen size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">Disciplinas</p>\n            <h3 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">{subjects.length}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors\">\n          <div className=\"p-3 bg-purple-50 dark:bg-purple-900/20 text-purple-600 dark:text-purple-400 rounded-xl\">\n            <Clock size={24} />\n          </div>\n          <div>\n            <p className=\"text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">Prova em</p>\n            <h3 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">\n              {cycle ? new Date(cycle.examDate).toLocaleDateString('pt-BR') : 'Sem data'}\n            </h3>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Desempenho nos Simulados (%)</h3>\n          <div className=\"h-[300px]\">\n            {mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={mockData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke={chartThemeColors.grid} />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{ fill: chartThemeColors.text }} />\n                  <YAxis axisLine={false} tickLine={false} tick={{ fill: chartThemeColors.text }} />\n                  <Tooltip \n                    contentStyle={{ \n                      borderRadius: '12px', \n                      border: `1px solid ${chartThemeColors.tooltipBorder}`, \n                      backgroundColor: chartThemeColors.tooltipBg,\n                      color: chartThemeColors.text,\n                      boxShadow: '0 10px 15px -3px rgb(0 0 0 / 0.1)' \n                    }}\n                    cursor={{ fill: isDarkMode ? '#1e293b' : '#f8fafc' }}\n                  />\n                  <Bar dataKey=\"acerto\" fill=\"#4f46e5\" radius={[6, 6, 0, 0]} barSize={40} />\n                </BarChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-400 dark:text-slate-600 gap-2\">\n                <BarChart2 size={48} className=\"opacity-20\" />\n                <p>Nenhum simulado cadastrado ainda.</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Progresso por Disciplina</h3>\n          <div className=\"space-y-6\">\n            {subjectProgressData.length > 0 ? (\n              subjectProgressData.map((s) => (\n                <div key={s.name} className=\"space-y-2\">\n                  <div className=\"flex justify-between text-sm\">\n                    <span className=\"font-semibold text-slate-700 dark:text-slate-300\">{s.name}</span>\n                    <span className=\"text-slate-500 dark:text-slate-500\">{s.concluido} / {s.total} tópicos</span>\n                  </div>\n                  <div className=\"h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden transition-colors\">\n                    <div \n                      className=\"h-full transition-all duration-1000\"\n                      style={{ \n                        width: `${s.total > 0 ? (s.concluido / s.total) * 100 : 0}%`,\n                        backgroundColor: s.color \n                      }}\n                    />\n                  </div>\n                </div>\n              ))\n            ) : (\n              <p className=\"text-slate-400 dark:text-slate-600 text-center py-10\">Cadastre disciplinas para ver o progresso.</p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        },
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Suporte para modo escuro no componente Disciplinas.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  Circle, \n  BookOpen, \n  AlertTriangle, \n  X, \n  Edit3, \n  Check,\n  Activity,\n  Clock,\n  Target,\n  Calendar\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\ninterface TopicToDelete {\n  subjectId: string;\n  topicId: string;\n  title: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  \n  // Modals state\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<TopicToDelete | null>(null);\n\n  // Editing state\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editingStatsId, setEditingStatsId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState('');\n  \n  // Stats editing state\n  const [editMinutes, setEditMinutes] = useState(0);\n  const [editAttempted, setEditAttempted] = useState(0);\n  const [editCorrect, setEditCorrect] = useState(0);\n  const [editDate, setEditDate] = useState(() => {\n    const today = new Date();\n    const year = today.getFullYear();\n    const month = String(today.getMonth() + 1).padStart(2, '0');\n    const day = String(today.getDate()).padStart(2, '0');\n    return `${year}-${month}-${day}`;\n  });\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: newSubjectName,\n      topics: [],\n      color: colors[subjects.length % colors.length]\n    };\n    setSubjects([...subjects, newSub]);\n    setNewSubjectName('');\n  };\n\n  const confirmRemoveSubject = () => {\n    if (subjectToDelete) {\n      setSubjects(subjects.filter(s => s.id !== subjectToDelete.id));\n      setSubjectToDelete(null);\n    }\n  };\n\n  const confirmRemoveTopic = () => {\n    if (topicToDelete) {\n      setSubjects(subjects.map(s => {\n        if (s.id === topicToDelete.subjectId) {\n          return { ...s, topics: s.topics.filter(t => t.id !== topicToDelete.topicId) };\n        }\n        return s;\n      }));\n      setTopicToDelete(null);\n    }\n  };\n\n  const startEditingSubject = (e: React.MouseEvent, subject: Subject) => {\n    e.stopPropagation();\n    setEditingSubjectId(subject.id);\n    setEditValue(subject.name);\n  };\n\n  const saveSubjectName = (e?: React.MouseEvent | React.KeyboardEvent) => {\n    if (e) e.stopPropagation();\n    if (!editValue.trim() || !editingSubjectId) {\n      setEditingSubjectId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => s.id === editingSubjectId ? { ...s, name: editValue } : s));\n    setEditingSubjectId(null);\n  };\n\n  const startEditingTopic = (e: React.MouseEvent, topic: Topic) => {\n    e.stopPropagation();\n    setEditingTopicId(topic.id);\n    setEditValue(topic.title);\n  };\n\n  const startEditingStats = (e: React.MouseEvent, topic: Topic) => {\n    e.stopPropagation();\n    setEditingStatsId(topic.id);\n    setEditMinutes(0);\n    setEditAttempted(0);\n    setEditCorrect(0);\n    \n    const d = new Date();\n    const year = d.getFullYear();\n    const month = String(d.getMonth() + 1).padStart(2, '0');\n    const day = String(d.getDate()).padStart(2, '0');\n    setEditDate(`${year}-${month}-${day}`);\n  };\n\n  const saveTopicTitle = (subjectId: string, topicId: string) => {\n    if (!editValue.trim()) {\n      setEditingTopicId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => t.id === topicId ? { ...t, title: editValue } : t)\n        };\n      }\n      return s;\n    }));\n    setEditingTopicId(null);\n  };\n\n  const saveTopicStats = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const finalDate = new Date(`${editDate}T12:00:00`).toISOString();\n              // Adiciona ao log global\n              if (editMinutes > 0) onAddLog(editMinutes, topicId, subjectId);\n              \n              return { \n                ...t, \n                studyTimeMinutes: (t.studyTimeMinutes || 0) + editMinutes,\n                questionsAttempted: (t.questionsAttempted || 0) + editAttempted,\n                questionsCorrect: (t.questionsCorrect || 0) + editCorrect,\n                lastStudiedAt: finalDate\n              };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n    setEditingStatsId(null);\n  };\n\n  const addTopic = (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: [...s.topics, { \n            id: Date.now().toString(), \n            title: newTopicTitle, \n            completed: false, \n            importance: 3,\n            studyTimeMinutes: 0,\n            questionsAttempted: 0,\n            questionsCorrect: 0\n          }]\n        };\n      }\n      return s;\n    }));\n    setNewTopicTitle('');\n  };\n\n  const toggleTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const becomingCompleted = !t.completed;\n              const today = new Date();\n              const year = today.getFullYear();\n              const month = String(today.getMonth() + 1).padStart(2, '0');\n              const day = String(today.getDate()).padStart(2, '0');\n              const safeNow = new Date(`${year}-${month}-${day}T12:00:00`).toISOString();\n              \n              return { \n                ...t, \n                completed: becomingCompleted, \n                lastStudiedAt: becomingCompleted ? safeNow : t.lastStudiedAt \n              };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n  };\n\n  const calculateHitRate = (attempted?: number, correct?: number) => {\n    if (!attempted || attempted === 0) return null;\n    return Math.round(((correct || 0) / attempted) * 100);\n  };\n\n  const getHitRateColor = (rate: number | null) => {\n    if (rate === null) return 'bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500';\n    if (rate >= 80) return 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/30';\n    if (rate >= 60) return 'bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30';\n    return 'bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-900/30';\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle total sobre seu conteúdo programático e métricas.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Nova disciplina...\"\n            className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-72 shadow-sm transition-all text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-900\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject}\n            className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all flex items-center justify-center shadow-lg shadow-indigo-100 dark:shadow-none shrink-0\"\n          >\n            <Plus size={24} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 && (\n          <div className=\"text-center py-24 bg-white dark:bg-slate-900 rounded-[2rem] border-2 border-dashed border-slate-200 dark:border-slate-800 transition-colors\">\n            <div className=\"w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-300 dark:text-slate-700\">\n              <BookOpen size={40} />\n            </div>\n            <h3 className=\"text-xl font-bold text-slate-400 dark:text-slate-600\">Nenhuma disciplina cadastrada</h3>\n          </div>\n        )}\n\n        {subjects.map(subject => {\n          const totalT = subject.topics.length;\n          const completedT = subject.topics.filter(t => t.completed).length;\n          const perc = totalT > 0 ? Math.round((completedT / totalT) * 100) : 0;\n          \n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n              <div \n                className=\"p-5 flex flex-col cursor-pointer\"\n                onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                    <div className=\"w-4 h-12 rounded-full shrink-0\" style={{ backgroundColor: subject.color }} />\n                    \n                    {editingSubjectId === subject.id ? (\n                      <div className=\"flex items-center gap-2 flex-1 max-w-md\" onClick={(e) => e.stopPropagation()}>\n                        <input\n                          autoFocus\n                          type=\"text\"\n                          className=\"w-full px-4 py-2 border-2 border-indigo-500 rounded-xl outline-none font-bold text-slate-900 dark:text-white bg-white dark:bg-slate-800\"\n                          value={editValue}\n                          onChange={(e) => setEditValue(e.target.value)}\n                          onKeyDown={(e) => e.key === 'Enter' && saveSubjectName()}\n                          onBlur={() => saveSubjectName()}\n                        />\n                        <button onClick={() => saveSubjectName()} className=\"p-2 bg-emerald-500 text-white rounded-xl\">\n                          <Check size={20} />\n                        </button>\n                      </div>\n                    ) : (\n                      <div className=\"flex flex-col min-w-0 flex-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <h3 className=\"font-bold text-xl text-slate-800 dark:text-slate-100 truncate\">{subject.name}</h3>\n                          {perc > 0 && (\n                            <span className=\"text-[10px] font-black px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400\">\n                              {perc}%\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"flex items-center gap-3\">\n                          <p className=\"text-xs text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider\">\n                            {completedT} de {totalT} tópicos\n                          </p>\n                        </div>\n                        {/* Mini Barra de Progresso Discreta */}\n                        <div className=\"mt-2 h-1 w-full max-w-[200px] bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden transition-colors\">\n                          <div \n                            className=\"h-full transition-all duration-700 ease-out\"\n                            style={{ \n                              width: `${perc}%`, \n                              backgroundColor: subject.color,\n                              boxShadow: perc === 100 ? `0 0 8px ${subject.color}80` : 'none'\n                            }}\n                          />\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2 ml-4\">\n                    <button \n                      onClick={(e) => startEditingSubject(e, subject)}\n                      className=\"p-2.5 text-indigo-500 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/20 hover:bg-indigo-600 dark:hover:bg-indigo-500 hover:text-white rounded-xl transition-all shadow-sm\"\n                      title=\"Editar Disciplina\"\n                    >\n                      <Edit3 size={18} />\n                    </button>\n                    <button \n                      onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }}\n                      className=\"p-2.5 text-rose-500 dark:text-rose-400 bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-600 dark:hover:bg-rose-500 hover:text-white rounded-xl transition-all shadow-sm\"\n                      title=\"Excluir Disciplina\"\n                    >\n                      <Trash2 size={18} />\n                    </button>\n                    <div className={`p-2 rounded-xl transition-colors ${expandedSubject === subject.id ? 'bg-slate-800 dark:bg-slate-700 text-white' : 'bg-slate-50 dark:bg-slate-800 text-slate-400 dark:text-slate-500'}`}>\n                      {expandedSubject === subject.id ? <ChevronUp size={20} /> : <ChevronDown size={20} />}\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {expandedSubject === subject.id && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800 bg-slate-50/20 dark:bg-slate-800/10 transition-colors\">\n                  <div className=\"flex gap-2 mb-6 mt-2\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Adicionar novo tópico...\"\n                      className=\"flex-1 px-4 py-3 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none text-slate-900 dark:text-white bg-white dark:bg-slate-900\"\n                      value={newTopicTitle}\n                      onChange={(e) => setNewTopicTitle(e.target.value)}\n                      onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                    />\n                    <button \n                      onClick={() => addTopic(subject.id)}\n                      className=\"bg-slate-800 dark:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold hover:bg-slate-900 dark:hover:bg-slate-600 transition-all\"\n                    >\n                      Adicionar\n                    </button>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    {subject.topics.map(topic => {\n                      const hitRate = calculateHitRate(topic.questionsAttempted, topic.questionsCorrect);\n                      const formattedDate = topic.lastStudiedAt ? new Date(topic.lastStudiedAt).toLocaleDateString('pt-BR') : null;\n                      \n                      return (\n                        <div \n                          key={topic.id}\n                          className=\"flex flex-col p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-sm hover:border-indigo-100 dark:hover:border-indigo-900 transition-all\"\n                        >\n                          <div className=\"flex items-center justify-between mb-2\">\n                            <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                              <button \n                                onClick={() => toggleTopic(subject.id, topic.id)}\n                                className={`transition-all shrink-0 ${topic.completed ? 'text-emerald-500 dark:text-emerald-400' : 'text-slate-200 dark:text-slate-700 hover:text-indigo-400'}`}\n                              >\n                                {topic.completed ? <CheckCircle size={24} /> : <Circle size={24} />}\n                              </button>\n                              \n                              {editingTopicId === topic.id ? (\n                                <div className=\"flex items-center gap-2 flex-1\" onClick={(e) => e.stopPropagation()}>\n                                  <input\n                                    autoFocus\n                                    type=\"text\"\n                                    className=\"w-full px-3 py-1.5 text-sm border-2 border-indigo-400 rounded-lg outline-none text-slate-900 dark:text-white bg-white dark:bg-slate-800\"\n                                    value={editValue}\n                                    onChange={(e) => setEditValue(e.target.value)}\n                                    onKeyDown={(e) => e.key === 'Enter' && saveTopicTitle(subject.id, topic.id)}\n                                    onBlur={() => saveTopicTitle(subject.id, topic.id)}\n                                  />\n                                </div>\n                              ) : (\n                                <div className=\"flex flex-col min-w-0 flex-1\">\n                                  <span className={`text-sm font-bold truncate ${topic.completed ? 'text-slate-300 dark:text-slate-600 line-through' : 'text-slate-700 dark:text-slate-200'}`}>\n                                    {topic.title}\n                                  </span>\n                                  {topic.completed && (\n                                    <div className=\"flex flex-wrap items-center gap-3 mt-1\">\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Calendar size={10} />\n                                        {formattedDate || 'Não informada'}\n                                      </div>\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Clock size={10} />\n                                        {Math.floor((topic.studyTimeMinutes || 0) / 60)}h {(topic.studyTimeMinutes || 0) % 60}m\n                                      </div>\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Target size={10} />\n                                        {topic.questionsCorrect || 0}/{topic.questionsAttempted || 0} Acertos\n                                      </div>\n                                      {hitRate !== null && (\n                                        <span className={`text-[10px] px-2 py-0.5 rounded-full font-black ${getHitRateColor(hitRate)}`}>\n                                          {hitRate}% APROVEITAMENTO\n                                        </span>\n                                      )}\n                                    </div>\n                                  )}\n                                </div>\n                              )}\n                            </div>\n                            \n                            <div className=\"flex items-center gap-2 ml-4 shrink-0\">\n                              <button \n                                onClick={(e) => startEditingStats(e, topic)}\n                                className={`p-2 rounded-lg transition-all ${editingStatsId === topic.id ? 'bg-indigo-600 dark:bg-indigo-500 text-white shadow-md' : 'text-indigo-400 dark:text-indigo-500 bg-indigo-50 dark:bg-indigo-900/20 hover:bg-indigo-100 dark:hover:bg-indigo-800'}`}\n                                title=\"Editar Métricas e Data\"\n                              >\n                                <Activity size={15} />\n                              </button>\n                              {editingTopicId !== topic.id && (\n                                <button \n                                  onClick={(e) => startEditingTopic(e, topic)}\n                                  className=\"p-2 text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-500 dark:hover:bg-indigo-600 hover:text-white rounded-lg transition-all\"\n                                  title=\"Editar Nome\"\n                                >\n                                  <Edit3 size={15} />\n                                </button>\n                              )}\n                              <button \n                                onClick={(e) => { e.stopPropagation(); setTopicToDelete({ subjectId: subject.id, topicId: topic.id, title: topic.title }); }}\n                                className=\"p-2 text-rose-400 dark:text-rose-500 bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-500 dark:hover:bg-rose-600 hover:text-white rounded-lg transition-all\"\n                                title=\"Excluir Tópico\"\n                              >\n                                <Trash2 size={15} />\n                              </button>\n                            </div>\n                          </div>\n\n                          {/* Stats Editing Panel */}\n                          {editingStatsId === topic.id && (\n                            <div className=\"mt-3 p-4 bg-slate-50 dark:bg-slate-800/50 border border-indigo-100 dark:border-indigo-900/30 rounded-xl shadow-inner animate-in slide-in-from-top-2 duration-200\">\n                              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                                <div className=\"relative\">\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Calendar size={10} /> Data do Estudo\n                                  </label>\n                                  <input \n                                    type=\"date\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white cursor-pointer hover:border-indigo-200 dark:hover:border-indigo-700 transition-colors\"\n                                    value={editDate}\n                                    onChange={(e) => setEditDate(e.target.value)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Clock size={10} /> Adicionar Minutos\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editMinutes}\n                                    onChange={(e) => setEditMinutes(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Target size={10} /> Questões\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editAttempted}\n                                    onChange={(e) => setEditAttempted(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Check size={10} /> Acertos\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editCorrect}\n                                    onChange={(e) => setEditCorrect(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                              </div>\n                              <div className=\"flex justify-end gap-2 mt-4 pt-4 border-t border-slate-200 dark:border-slate-700\">\n                                <button \n                                  onClick={() => setEditingStatsId(null)}\n                                  className=\"px-4 py-2 text-xs font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-lg transition-all\"\n                                >\n                                  Cancelar\n                                </button>\n                                <button \n                                  onClick={() => saveTopicStats(subject.id, topic.id)}\n                                  className=\"px-6 py-2 text-xs font-bold bg-indigo-600 dark:bg-indigo-500 text-white rounded-lg hover:bg-indigo-700 dark:hover:bg-indigo-400 shadow-md transition-all flex items-center gap-2\"\n                                >\n                                  <Check size={14} /> Salvar Sessão\n                                </button>\n                              </div>\n                            </div>\n                          )}\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Modais de Confirmação */}\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in-95 duration-300 border border-slate-100 dark:border-slate-800\">\n            <div className=\"p-10 text-center\">\n              <div className=\"w-20 h-20 bg-rose-50 dark:bg-rose-900/20 text-rose-500 dark:text-rose-400 rounded-3xl flex items-center justify-center mx-auto mb-6\">\n                <AlertTriangle size={40} />\n              </div>\n              <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 mb-4\">Excluir Disciplina?</h3>\n              <p className=\"text-slate-500 dark:text-slate-400 mb-8\">\n                Toda a matéria <span className=\"font-bold text-slate-800 dark:text-slate-200\">\"{subjectToDelete.name}\"</span> e seus tópicos serão removidos permanentemente.\n              </p>\n              <div className=\"flex flex-col gap-3\">\n                <button onClick={confirmRemoveSubject} className=\"w-full bg-rose-500 text-white font-bold py-4 rounded-2xl hover:bg-rose-600 transition-all shadow-lg shadow-rose-100 dark:shadow-none\">EXCLUIR TUDO</button>\n                <button onClick={() => setSubjectToDelete(null)} className=\"w-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold py-4 rounded-2xl hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors\">CANCELAR</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {topicToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/60 backdrop-blur-sm\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] shadow-2xl w-full max-w-sm overflow-hidden animate-in zoom-in-95 duration-200 border border-slate-100 dark:border-slate-800\">\n            <div className=\"p-8 text-center\">\n              <div className=\"w-16 h-16 bg-rose-50 dark:bg-rose-900/20 text-rose-500 dark:text-rose-400 rounded-2xl flex items-center justify-center mx-auto mb-4\">\n                <Trash2 size={32} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900 dark:text-slate-100 mb-2\">Remover Tópico?</h3>\n              <p className=\"text-slate-500 dark:text-slate-400 text-sm mb-6\">Deseja remover \"{topicToDelete.title}\"?</p>\n              <div className=\"flex gap-3\">\n                <button onClick={() => setTopicToDelete(null)} className=\"flex-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold py-3 rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors\">Não</button>\n                <button onClick={confirmRemoveTopic} className=\"flex-1 bg-rose-500 text-white font-bold py-3 rounded-xl hover:bg-rose-600 transition-colors\">Sim, Remover</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        },
