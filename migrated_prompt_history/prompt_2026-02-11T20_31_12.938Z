              "target": "",
              "replacement": "\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  password?: string;\n  role: 'admin' | 'student' | 'visitor';\n  status: 'active' | 'blocked';\n  isOnline: boolean;\n  lastAccess?: string;\n  weeklyGoal?: number;\n}\n\nexport interface Topic {\n  id: string;\n  title: string;\n  completed: boolean;\n  lastStudiedAt?: string;\n  importance: number; // 1-5 (Pareto)\n  studyTimeMinutes?: number;\n  questionsAttempted?: number;\n  questionsCorrect?: number;\n  revisionsDone?: number[];\n}\n\nexport interface Subject {\n  id: string;\n  name: string;\n  topics: Topic[];\n  color: string;\n}\n\nexport interface StudySession {\n  id: string;\n  topicId: string;\n  subjectId: string;\n  minutes: number;\n  date: string;\n  type: 'estudo' | 'revisao';\n}\n\nexport interface MockExam {\n  id: string;\n  title: string;\n  date: string;\n  score: number;\n  totalQuestions: number;\n  // Added subjectPerformance property to match usage in Simulados.tsx\n  subjectPerformance?: Record<string, number>;\n}\n\nexport interface StudyCycle {\n  id: string;\n  board: string;\n  examDate: string;\n  hoursPerDay: number;\n  schedule: Array<{\n    day: string;\n    sessions: Array<{\n      subjectName: string;\n      duration: number;\n      focus: string;\n    }>;\n  }>;\n}\n\nexport interface PredefinedEdital {\n  id: string;\n  name: string;\n  organization: string;\n  subjects: Subject[];\n  lastUpdated: string;\n  // Added examDate property to match usage in Admin.tsx\n  examDate?: string;\n}\n"
