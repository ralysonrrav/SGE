          "path": "components/Admin.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Adição de confirmações para exclusões no painel administrativo.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User, PredefinedEdital, Subject, Topic } from '../types';\nimport { \n  Users, Database, Plus, Trash2, Edit3, X, Save, \n  Lock, Unlock, AlignLeft, BookOpen, Check\n} from 'lucide-react';\n\ninterface AdminProps {\n  users: User[];\n  setUsers: React.Dispatch<React.SetStateAction<User[]>>;\n  editais: PredefinedEdital[];\n  setEditais: React.Dispatch<React.SetStateAction<PredefinedEdital[]>>;\n  view: 'users' | 'editais';\n}\n\nconst Admin: React.FC<AdminProps> = ({ users, setUsers, editais, setEditais, view }) => {\n  const [isCreatingEdital, setIsCreatingEdital] = useState(false);\n  const [editingEdital, setEditingEdital] = useState<PredefinedEdital | null>(null);\n  const [newEditalName, setNewEditalName] = useState('');\n  const [newEditalOrg, setNewEditalOrg] = useState('');\n  const [newEditalExamDate, setNewEditalExamDate] = useState('');\n  const [editalSubjects, setEditalSubjects] = useState<Subject[]>([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  \n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubjectToEdital = () => {\n    setEditalSubjects([...editalSubjects, { id: Date.now().toString(), name: 'Nova Disciplina', topics: [], color: colors[editalSubjects.length % colors.length] }]);\n  };\n\n  const removeSubjectFromEdital = (id: string) => {\n    if (!confirm(\"Remover esta disciplina do edital?\")) return;\n    setEditalSubjects(editalSubjects.filter(s => s.id !== id));\n  };\n\n  const handleTopicsChange = (sIdx: number, text: string) => {\n    const lines = text.split('\\n').filter(l => l.trim() !== '');\n    const newTopics = lines.map(line => ({ id: Math.random().toString(36).substr(2, 9), title: line.trim(), completed: false, importance: 3 }));\n    const n = [...editalSubjects];\n    n[sIdx].topics = newTopics;\n    setEditalSubjects(n);\n  };\n\n  const deleteTopicFromEdital = (sIdx: number, tIdx: number) => {\n    if (!confirm(\"Excluir este tópico?\")) return;\n    const n = [...editalSubjects];\n    n[sIdx].topics = n[sIdx].topics.filter((_, i) => i !== tIdx);\n    setEditalSubjects(n);\n  };\n\n  const deleteEdital = (id: string) => {\n    if (!confirm(\"Atenção Admin: Deseja realmente excluir este edital do catálogo permanentemente?\")) return;\n    setEditais(editais.filter(e => e.id !== id));\n  };\n\n  const saveEdital = () => {\n    if (!newEditalName || !newEditalOrg) return;\n    const edital: PredefinedEdital = { id: editingEdital?.id || Date.now().toString(), name: newEditalName, organization: newEditalOrg, examDate: newEditalExamDate, subjects: editalSubjects, lastUpdated: new Date().toISOString() };\n    if (editingEdital) setEditais(prev => prev.map(e => e.id === editingEdital.id ? edital : e));\n    else setEditais([...editais, edital]);\n    setIsCreatingEdital(false);\n  };\n\n  if (view === 'users') {\n    return (\n      <div className=\"space-y-8 animate-in fade-in duration-500\">\n        <header className=\"flex items-center justify-between\">\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100\">Gestão de Alunos</h2>\n        </header>\n        <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden overflow-x-auto\">\n          <table className=\"w-full text-left min-w-[600px]\">\n            <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800\">\n              <tr><th className=\"px-8 py-5 text-[10px] font-black uppercase\">Aluno</th><th className=\"px-8 py-5 text-[10px] font-black uppercase text-center\">Status</th><th className=\"px-8 py-5 text-[10px] font-black uppercase text-right\">Ações</th></tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n              {users.map(u => (\n                <tr key={u.id} className=\"hover:bg-slate-50/50\">\n                  <td className=\"px-8 py-6\"><div className=\"font-bold text-slate-800 dark:text-slate-100\">{u.name}</div><div className=\"text-xs text-slate-500\">{u.email}</div></td>\n                  <td className=\"px-8 py-6 text-center\"><span className={`inline-flex px-3 py-1 rounded-full text-[10px] font-black uppercase ${u.status === 'active' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600'}`}>{u.status === 'active' ? 'Ativo' : 'Bloqueado'}</span></td>\n                  <td className=\"px-8 py-6 text-right\"><button onClick={() => setUsers(users.map(usr => usr.id === u.id ? {...usr, status: usr.status === 'active' ? 'blocked' : 'active'} : usr))} className=\"p-2 text-amber-500 hover:bg-amber-50 rounded-xl\">{u.status === 'active' ? <Lock size={18} /> : <Unlock size={18} />}</button></td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header className=\"flex items-center justify-between\">\n        <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100\">Catálogo de Editais</h2>\n        <button onClick={() => { setIsCreatingEdital(true); setEditingEdital(null); setNewEditalName(''); setNewEditalOrg(''); setEditalSubjects([]); }} className=\"bg-rose-600 text-white px-8 py-3 rounded-2xl font-black shadow-xl hover:bg-rose-700 transition-all flex items-center gap-2\"><Plus size={20} /> Novo Edital</button>\n      </header>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {editais.map(edital => (\n          <div key={edital.id} className=\"bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm relative group\">\n            <div className=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2\">\n              <button onClick={() => { setEditingEdital(edital); setNewEditalName(edital.name); setNewEditalOrg(edital.organization); setEditalSubjects(edital.subjects); setIsCreatingEdital(true); }} className=\"p-2 text-indigo-500 hover:bg-indigo-50 rounded-xl\"><Edit3 size={18} /></button>\n              <button onClick={() => deleteEdital(edital.id)} className=\"p-2 text-rose-500 hover:bg-rose-50 rounded-xl\"><Trash2 size={18} /></button>\n            </div>\n            <div className=\"w-14 h-14 bg-rose-50 dark:bg-rose-900/20 text-rose-600 rounded-2xl flex items-center justify-center mb-6\"><Database size={28} /></div>\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 leading-tight\">{edital.name}</h3>\n            <p className=\"text-xs font-black text-rose-600 uppercase mt-1\">{edital.organization}</p>\n          </div>\n        ))}\n      </div>\n\n      {isCreatingEdital && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-5xl rounded-[3rem] shadow-2xl overflow-hidden border border-slate-100 dark:border-slate-800 h-[85vh] flex flex-col\">\n             <div className=\"flex flex-1 overflow-hidden flex-col md:flex-row\">\n               <div className=\"w-full md:w-1/3 p-10 bg-slate-50 dark:bg-slate-950 border-r border-slate-100 space-y-6 overflow-y-auto\">\n                 <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100\">Configurar Edital</h3>\n                 <div className=\"space-y-4\">\n                   <input type=\"text\" placeholder=\"Nome do Concurso\" className=\"w-full px-5 py-3 rounded-xl border border-slate-200 outline-none font-bold bg-white dark:bg-slate-900 dark:text-white\" value={newEditalName} onChange={(e) => setNewEditalName(e.target.value)} />\n                   <input type=\"text\" placeholder=\"Banca\" className=\"w-full px-5 py-3 rounded-xl border border-slate-200 outline-none font-bold bg-white dark:bg-slate-900 dark:text-white\" value={newEditalOrg} onChange={(e) => setNewEditalOrg(e.target.value)} />\n                 </div>\n                 <div className=\"pt-6 space-y-3\">\n                   <button onClick={saveEdital} className=\"w-full bg-rose-600 text-white font-black py-4 rounded-2xl shadow-xl hover:bg-rose-700 transition-all flex items-center justify-center gap-2\"><Save size={18} /> PUBLICAR AGORA</button>\n                   <button onClick={() => setIsCreatingEdital(false)} className=\"w-full text-slate-500 font-bold py-4 hover:bg-slate-200 rounded-2xl\">CANCELAR</button>\n                 </div>\n               </div>\n               <div className=\"flex-1 p-10 overflow-y-auto\">\n                  <div className=\"flex items-center justify-between mb-8 pb-4 border-b\">\n                    <h4 className=\"font-black text-xl flex items-center gap-2 dark:text-white\"><BookOpen className=\"text-rose-600\" /> Grade Curricular</h4>\n                    <button onClick={addSubjectToEdital} className=\"text-[10px] font-black bg-rose-600 text-white px-5 py-2 rounded-xl hover:bg-rose-700 shadow-lg transition-all\">+ ADD MATÉRIA</button>\n                  </div>\n                  <div className=\"space-y-8\">\n                    {editalSubjects.map((sub, sIdx) => (\n                      <div key={sub.id} className=\"p-6 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border border-slate-100 relative group/sub\">\n                        <button onClick={() => removeSubjectFromEdital(sub.id)} className=\"absolute top-4 right-4 p-2 text-rose-500 hover:bg-rose-100 rounded-xl opacity-0 group-hover/sub:opacity-100\"><Trash2 size={16} /></button>\n                        <div className=\"flex items-center gap-3 mb-4\">\n                          <div className=\"w-2 h-8 rounded-full\" style={{ backgroundColor: sub.color }} />\n                          <input value={sub.name} onChange={(e) => { const n = [...editalSubjects]; n[sIdx].name = e.target.value; setEditalSubjects(n); }} className=\"bg-transparent font-black text-lg outline-none border-b border-rose-100 focus:border-rose-500 w-full dark:text-white\" />\n                        </div>\n                        <div className=\"space-y-4\">\n                           <div>\n                             <p className=\"text-[10px] font-black text-slate-400 uppercase mb-2 flex items-center gap-1\"><AlignLeft size={10} /> Editar em Massa (Cole abaixo)</p>\n                             <textarea defaultValue={sub.topics.map(t => t.title).join('\\n')} onBlur={(e) => handleTopicsChange(sIdx, e.target.value)} className=\"w-full h-32 bg-white dark:bg-slate-900 rounded-2xl p-4 outline-none border border-slate-200 focus:border-rose-500 dark:text-slate-200 text-sm font-bold\" />\n                           </div>\n                           {sub.topics.length > 0 && (\n                             <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2\">\n                               {sub.topics.map((t, tIdx) => (\n                                 <div key={t.id} className=\"flex items-center justify-between p-2 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-800 group/topic\">\n                                   <input className=\"bg-transparent text-xs font-bold outline-none flex-1 dark:text-slate-300\" value={t.title} onChange={(e) => { const n = [...editalSubjects]; n[sIdx].topics[tIdx].title = e.target.value; setEditalSubjects(n); }} />\n                                   <button onClick={() => deleteTopicFromEdital(sIdx, tIdx)} className=\"p-1 text-rose-400 hover:text-rose-600 opacity-0 group-hover/topic:opacity-100\"><Trash2 size={12} /></button>\n                                 </div>\n                               ))}\n                             </div>\n                           )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n               </div>\n             </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Admin;\n"
            }
          ]
        },
        {
          "path": "components/Simulados.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Adição de confirmação para exclusão de simulados.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { MockExam, Subject } from '../types';\nimport { BarChart2, Plus, Trash2, TrendingUp, Award, FileText, X } from 'lucide-react';\n\ninterface SimuladosProps {\n  mocks: MockExam[];\n  setMocks: React.Dispatch<React.SetStateAction<MockExam[]>>;\n  subjects: Subject[];\n}\n\nconst Simulados: React.FC<SimuladosProps> = ({ mocks, setMocks, subjects }) => {\n  const [showAddForm, setShowAddForm] = useState(false);\n  const [title, setTitle] = useState('');\n  const [score, setScore] = useState(0);\n  const [total, setTotal] = useState(100);\n  const [date, setDate] = useState(new Date().toISOString().split('T')[0]);\n\n  const addMock = () => {\n    if (!title.trim()) return;\n    const newMock: MockExam = {\n      id: Date.now().toString(),\n      title,\n      date,\n      score,\n      totalQuestions: total,\n      subjectPerformance: {}\n    };\n    setMocks([...mocks, newMock]);\n    setShowAddForm(false);\n    setTitle('');\n  };\n\n  const removeMock = (id: string) => {\n    if (!confirm(\"Deseja realmente excluir os dados deste simulado? Esta ação não pode ser desfeita.\")) return;\n    setMocks(mocks.filter(m => m.id !== id));\n  };\n\n  const averageScore = mocks.length > 0 \n    ? Math.round(mocks.reduce((acc, m) => acc + (m.score / m.totalQuestions), 0) / mocks.length * 100)\n    : 0;\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight transition-colors\">Estatísticas de Simulados</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium transition-colors\">Mensure seu desempenho e identifique gargalos.</p>\n        </div>\n        <button \n          onClick={() => setShowAddForm(true)}\n          className=\"bg-indigo-600 dark:bg-indigo-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-indigo-700 dark:hover:bg-indigo-400 transition-all flex items-center justify-center gap-2 shadow-lg dark:shadow-none\"\n        >\n          <Plus size={20} />\n          Novo Simulado\n        </button>\n      </header>\n\n      {/* Highlights */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1 transition-colors\">Média Geral</p>\n          <div className=\"flex items-end gap-2\">\n            <h3 className=\"text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 transition-colors\">{averageScore}%</h3>\n            <TrendingUp size={24} className=\"text-emerald-500 dark:text-emerald-400 mb-1 transition-colors\" />\n          </div>\n        </div>\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1 transition-colors\">Total Realizados</p>\n          <h3 className=\"text-3xl font-extrabold text-slate-800 dark:text-slate-100 transition-colors\">{mocks.length}</h3>\n        </div>\n        <div className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-colors\">\n          <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1 transition-colors\">Melhor Score</p>\n          <h3 className=\"text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 transition-colors\">\n            {mocks.length > 0 ? Math.max(...mocks.map(m => Math.round((m.score / m.totalQuestions) * 100))) : 0}%\n          </h3>\n        </div>\n      </div>\n\n      {showAddForm && (\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-indigo-100 dark:border-indigo-900/30 shadow-xl dark:shadow-none animate-in zoom-in-95 duration-200 transition-colors relative\">\n          <button \n            onClick={() => setShowAddForm(false)} \n            className=\"absolute top-4 right-4 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-colors\"\n          >\n            <X size={24} />\n          </button>\n          <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 mb-6 transition-colors\">Cadastrar Simulado</h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400 transition-colors\">Título / Nome</label>\n              <input \n                type=\"text\" \n                className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-colors\"\n                placeholder=\"Ex: Simulado 01 - PDF Estratégia\"\n                value={title}\n                onChange={(e) => setTitle(e.target.value)}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400 transition-colors\">Acertos</label>\n              <input \n                type=\"number\" \n                className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-colors\"\n                value={score}\n                onChange={(e) => setScore(parseInt(e.target.value) || 0)}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400 transition-colors\">Total Questões</label>\n              <input \n                type=\"number\" \n                className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-colors\"\n                value={total}\n                onChange={(e) => setTotal(parseInt(e.target.value) || 0)}\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400 transition-colors\">Data</label>\n              <input \n                type=\"date\" \n                className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-colors\"\n                value={date}\n                onChange={(e) => setDate(e.target.value)}\n              />\n            </div>\n          </div>\n          <div className=\"flex gap-4 mt-8\">\n            <button \n              onClick={addMock}\n              className=\"bg-indigo-600 dark:bg-indigo-500 text-white px-8 py-3 rounded-xl font-bold hover:bg-indigo-700 dark:hover:bg-indigo-400 transition-all w-full md:w-auto shadow-lg dark:shadow-none\"\n            >\n              Salvar Dados\n            </button>\n            <button \n              onClick={() => setShowAddForm(false)}\n              className=\"text-slate-500 dark:text-slate-400 px-8 py-3 font-semibold transition-colors w-full md:w-auto\"\n            >\n              Cancelar\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-colors\">\n        <table className=\"w-full text-left\">\n          <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800 transition-colors\">\n            <tr>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest transition-colors\">Simulado</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center transition-colors\">Data</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center transition-colors\">Acertos / Total</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center transition-colors\">Percentual</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-right transition-colors\">Ações</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800 transition-colors\">\n            {mocks.map(mock => {\n              const perc = Math.round((mock.score / mock.totalQuestions) * 100);\n              return (\n                <tr key={mock.id} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors group\">\n                  <td className=\"px-6 py-5\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"p-2 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 rounded-lg transition-colors\">\n                        <FileText size={18} />\n                      </div>\n                      <span className=\"font-bold text-slate-700 dark:text-slate-300 transition-colors\">{mock.title}</span>\n                    </div>\n                  </td>\n                  <td className=\"px-6 py-5 text-center text-sm font-medium text-slate-500 dark:text-slate-500 transition-colors\">\n                    {new Date(mock.date).toLocaleDateString('pt-BR')}\n                  </td>\n                  <td className=\"px-6 py-5 text-center text-sm font-bold text-slate-600 dark:text-slate-400 transition-colors\">\n                    {mock.score} / {mock.totalQuestions}\n                  </td>\n                  <td className=\"px-6 py-5 text-center\">\n                    <span className={`px-3 py-1 rounded-full text-xs font-bold transition-colors ${\n                      perc >= 80 ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400' : \n                      perc >= 60 ? 'bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400' : 'bg-red-50 dark:bg-rose-900/20 text-red-600 dark:text-rose-400'\n                    }`}>\n                      {perc}%\n                    </span>\n                  </td>\n                  <td className=\"px-6 py-5 text-right\">\n                    <button \n                      onClick={() => removeMock(mock.id)}\n                      className=\"text-slate-300 dark:text-slate-700 hover:text-red-500 dark:hover:text-rose-400 transition-colors p-2\"\n                    >\n                      <Trash2 size={18} />\n                    </button>\n                  </td>\n                </tr>\n              );\n            })}\n            {mocks.length === 0 && (\n              <tr>\n                <td colSpan={5} className=\"px-6 py-20 text-center text-slate-400 dark:text-slate-600 transition-colors\">\n                  <div className=\"flex flex-col items-center\">\n                    <Award size={48} className=\"opacity-20 mb-4\" />\n                    <p>Nenhum simulado cadastrado ainda.</p>\n                  </div>\n                </td>\n              </tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n};\n\nexport default Simulados;\n"
            }
          ]
        }
      ]
    },
