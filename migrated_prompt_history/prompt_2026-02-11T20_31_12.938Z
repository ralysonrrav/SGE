          "path": "components/Admin.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Criação do componente Admin para gestão de usuários e criação de editais modelo.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User, PredefinedEdital, Subject, Topic } from '../types';\nimport { \n  Users, Database, Plus, Trash2, CheckCircle, Activity, \n  Search, ShieldCheck, Mail, Calendar, Layers, X, Save, AlertTriangle\n} from 'lucide-react';\n\ninterface AdminProps {\n  users: User[];\n  editais: PredefinedEdital[];\n  setEditais: React.Dispatch<React.SetStateAction<PredefinedEdital[]>>;\n  view: 'users' | 'editais';\n}\n\nconst Admin: React.FC<AdminProps> = ({ users, editais, setEditais, view }) => {\n  const [isCreatingEdital, setIsCreatingEdital] = useState(false);\n  const [newEditalName, setNewEditalName] = useState('');\n  const [newEditalOrg, setNewEditalOrg] = useState('');\n  const [editalSubjects, setEditalSubjects] = useState<Subject[]>([]);\n  const [searchTerm, setSearchTerm] = useState('');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubjectToEdital = () => {\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: 'Nova Disciplina',\n      topics: [],\n      color: colors[editalSubjects.length % colors.length]\n    };\n    setEditalSubjects([...editalSubjects, newSub]);\n  };\n\n  const saveEdital = () => {\n    if (!newEditalName || !newEditalOrg) return;\n    const edital: PredefinedEdital = {\n      id: Date.now().toString(),\n      name: newEditalName,\n      organization: newEditalOrg,\n      subjects: editalSubjects,\n      lastUpdated: new Date().toISOString()\n    };\n    setEditais([...editais, edital]);\n    setIsCreatingEdital(false);\n    setNewEditalName('');\n    setNewEditalOrg('');\n    setEditalSubjects([]);\n  };\n\n  const removeEdital = (id: string) => {\n    setEditais(editais.filter(e => e.id !== id));\n  };\n\n  const filteredUsers = users.filter(u => \n    u.name.toLowerCase().includes(searchTerm.toLowerCase()) || \n    u.email.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  if (view === 'users') {\n    return (\n      <div className=\"space-y-8 animate-in fade-in duration-500\">\n        <header>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Gestão de Alunos</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Monitore o engajamento e a saúde da plataforma.</p>\n        </header>\n\n        <div className=\"relative\">\n          <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" size={20} />\n          <input \n            type=\"text\" \n            placeholder=\"Buscar por nome ou e-mail...\"\n            className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 outline-none focus:ring-2 focus:ring-rose-500 font-bold\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n          />\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden\">\n          <table className=\"w-full text-left\">\n            <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800\">\n              <tr>\n                <th className=\"px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest\">Alunoe</th>\n                <th className=\"px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest\">Acesso</th>\n                <th className=\"px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center\">Status</th>\n                <th className=\"px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right\">Perfil</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n              {filteredUsers.map(u => (\n                <tr key={u.id} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors\">\n                  <td className=\"px-8 py-6\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center font-black text-slate-400\">\n                        {u.name.charAt(0)}\n                      </div>\n                      <div>\n                        <p className=\"font-bold text-slate-800 dark:text-slate-100 leading-none\">{u.name}</p>\n                        <p className=\"text-xs text-slate-500 mt-1\">{u.email}</p>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6\">\n                    <div className=\"flex items-center gap-2 text-xs font-bold text-slate-500\">\n                      <Calendar size={14} />\n                      {u.lastAccess ? new Date(u.lastAccess).toLocaleDateString('pt-BR') : 'Nunca'}\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6 text-center\">\n                    <span className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase ${u.status === 'active' ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-400'}`}>\n                      <div className={`w-1.5 h-1.5 rounded-full ${u.status === 'active' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`} />\n                      {u.status === 'active' ? 'Ativo' : 'Inativo'}\n                    </span>\n                  </td>\n                  <td className=\"px-8 py-6 text-right\">\n                    <span className={`text-[10px] font-black px-2 py-1 rounded border ${u.role === 'admin' ? 'border-rose-200 text-rose-600 bg-rose-50' : 'border-indigo-200 text-indigo-600 bg-indigo-50'}`}>\n                      {u.role.toUpperCase()}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header className=\"flex items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Catálogo de Editais</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Crie editais modelo para importação simplificada.</p>\n        </div>\n        <button \n          onClick={() => setIsCreatingEdital(true)}\n          className=\"bg-rose-600 text-white px-8 py-3 rounded-2xl font-black shadow-xl shadow-rose-100 dark:shadow-none hover:bg-rose-700 flex items-center gap-2 transition-all\"\n        >\n          <Plus size={20} /> Novo Edital\n        </button>\n      </header>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {editais.map(edital => (\n          <div key={edital.id} className=\"bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm relative group hover:border-rose-200 transition-all\">\n            <div className=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity\">\n              <button onClick={() => removeEdital(edital.id)} className=\"p-2 text-rose-500 hover:bg-rose-50 rounded-xl\">\n                <Trash2 size={18} />\n              </button>\n            </div>\n            <div className=\"w-14 h-14 bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 rounded-2xl flex items-center justify-center mb-6\">\n              <Database size={28} />\n            </div>\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 leading-tight\">{edital.name}</h3>\n            <p className=\"text-xs font-black text-slate-400 uppercase tracking-widest mt-1\">{edital.organization}</p>\n            <div className=\"mt-6 pt-6 border-t border-slate-50 dark:border-slate-800 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-xs font-bold text-slate-500\">\n                <Layers size={14} />\n                {edital.subjects.length} Disciplinas\n              </div>\n              <span className=\"text-[10px] font-bold text-slate-400\">\n                v.{new Date(edital.lastUpdated).toLocaleDateString()}\n              </span>\n            </div>\n          </div>\n        ))}\n        {editais.length === 0 && !isCreatingEdital && (\n          <div className=\"lg:col-span-3 py-20 text-center bg-slate-50 dark:bg-slate-900/50 rounded-[2.5rem] border-2 border-dashed border-slate-200 dark:border-slate-800\">\n            <Database className=\"mx-auto mb-4 text-slate-300\" size={48} />\n            <p className=\"text-slate-400 font-bold\">Nenhum edital modelo cadastrado.</p>\n          </div>\n        )}\n      </div>\n\n      {isCreatingEdital && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-4xl rounded-[3rem] shadow-2xl overflow-hidden border border-slate-100 dark:border-slate-800 animate-in zoom-in-95 duration-300\">\n            <div className=\"flex h-[80vh]\">\n              {/* Left: Metadata */}\n              <div className=\"w-1/3 p-10 bg-slate-50 dark:bg-slate-950 border-r border-slate-100 dark:border-slate-800 space-y-6\">\n                <div className=\"w-14 h-14 bg-rose-600 text-white rounded-2xl flex items-center justify-center shadow-lg mb-8\">\n                  <Database size={28} />\n                </div>\n                <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Novo Edital</h3>\n                \n                <div className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2\">Título do Certame</label>\n                    <input \n                      type=\"text\" \n                      placeholder=\"Ex: Auditor RFB\"\n                      className=\"w-full px-5 py-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 outline-none focus:ring-2 focus:ring-rose-500 font-bold\"\n                      value={newEditalName}\n                      onChange={(e) => setNewEditalName(e.target.value)}\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2\">Órgão / Banca</label>\n                    <input \n                      type=\"text\" \n                      placeholder=\"Ex: Receita Federal / FGV\"\n                      className=\"w-full px-5 py-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 outline-none focus:ring-2 focus:ring-rose-500 font-bold\"\n                      value={newEditalOrg}\n                      onChange={(e) => setNewEditalOrg(e.target.value)}\n                    />\n                  </div>\n                </div>\n\n                <div className=\"pt-10 space-y-3\">\n                  <button onClick={saveEdital} className=\"w-full bg-rose-600 text-white font-black py-4 rounded-2xl shadow-xl hover:bg-rose-700 transition-all flex items-center justify-center gap-2\">\n                    <Save size={18} /> PUBLICAR EDITAL\n                  </button>\n                  <button onClick={() => setIsCreatingEdital(false)} className=\"w-full text-slate-500 font-bold py-4 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-2xl\">\n                    CANCELAR\n                  </button>\n                </div>\n              </div>\n\n              {/* Right: Subjects Editor */}\n              <div className=\"flex-1 p-10 overflow-y-auto space-y-6 bg-white dark:bg-slate-900\">\n                <div className=\"flex items-center justify-between mb-4\">\n                   <h4 className=\"font-black text-slate-900 dark:text-slate-100 flex items-center gap-2\">\n                     <Layers size={18} className=\"text-rose-600\" /> Estrutura de Matérias\n                   </h4>\n                   <button onClick={addSubjectToEdital} className=\"text-xs font-black bg-rose-50 text-rose-600 px-4 py-2 rounded-xl hover:bg-rose-600 hover:text-white transition-all\">\n                     + ADICIONAR MATÉRIA\n                   </button>\n                </div>\n\n                <div className=\"space-y-4\">\n                  {editalSubjects.map((sub, sIdx) => (\n                    <div key={sIdx} className=\"p-6 bg-slate-50 dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 group\">\n                      <div className=\"flex items-center gap-3 mb-4\">\n                        <input \n                          type=\"text\" \n                          className=\"flex-1 bg-transparent font-black text-slate-800 dark:text-slate-100 outline-none border-b-2 border-transparent focus:border-rose-500 pb-1\"\n                          value={sub.name}\n                          onChange={(e) => {\n                            const newSubs = [...editalSubjects];\n                            newSubs[sIdx].name = e.target.value;\n                            setEditalSubjects(newSubs);\n                          }}\n                        />\n                        <button onClick={() => setEditalSubjects(editalSubjects.filter((_, i) => i !== sIdx))} className=\"text-rose-500 opacity-0 group-hover:opacity-100 transition-opacity\">\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                      <textarea \n                        className=\"w-full h-24 p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm outline-none resize-none\"\n                        placeholder=\"Cole os tópicos separados por linha...\"\n                        onChange={(e) => {\n                          const topics: Topic[] = e.target.value.split('\\n').filter(l => l.trim()).map(l => ({\n                            id: Math.random().toString(36).substr(2, 9),\n                            title: l.trim(),\n                            completed: false,\n                            importance: 3\n                          }));\n                          const newSubs = [...editalSubjects];\n                          newSubs[sIdx].topics = topics;\n                          setEditalSubjects(newSubs);\n                        }}\n                      />\n                    </div>\n                  ))}\n                  {editalSubjects.length === 0 && (\n                    <div className=\"text-center py-20 opacity-30\">\n                       <Database className=\"mx-auto mb-2\" />\n                       <p className=\"text-xs font-bold\">Nenhuma disciplina definida ainda.</p>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Admin;\n"
            }
          ]
