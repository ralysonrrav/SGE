  {
    "id": 84,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "types.ts",
          "generationType": 1,
          "isDone": true,
          "description": "Expansão dos tipos para suportar Perfis Administrativos e Modelos de Edital.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  password?: string;\n  role: 'admin' | 'student';\n  status: 'active' | 'inactive';\n  lastAccess?: string;\n  weeklyGoal?: number;\n}\n\nexport interface StudySession {\n  id: string;\n  topicId: string;\n  subjectId: string;\n  minutes: number;\n  date: string;\n  type: 'estudo' | 'revisao';\n}\n\nexport interface Topic {\n  id: string;\n  title: string;\n  completed: boolean;\n  lastStudiedAt?: string;\n  importance: number;\n  studyTimeMinutes?: number;\n  questionsAttempted?: number;\n  questionsCorrect?: number;\n  revisionsDone?: number[];\n}\n\nexport interface Subject {\n  id: string;\n  name: string;\n  topics: Topic[];\n  color: string;\n}\n\n// Novo: Modelo de Edital Pré-cadastrado pelo Admin\nexport interface PredefinedEdital {\n  id: string;\n  name: string;\n  organization: string; // Ex: Polícia Federal, TJ-SP\n  subjects: Subject[];\n  lastUpdated: string;\n}\n\nexport interface MockExam {\n  id: string;\n  title: string;\n  date: string;\n  score: number;\n  totalQuestions: number;\n  subjectPerformance: Record<string, number>;\n}\n\nexport interface StudyCycle {\n  id: string;\n  board: string;\n  examDate: string;\n  hoursPerDay: number;\n  schedule: Array<{\n    day: string;\n    sessions: Array<{\n      subjectName: string;\n      duration: number;\n      focus: string;\n    }>;\n  }>;\n}\n\nexport interface ReviewAlert {\n  subjectName: string;\n  topicTitle: string;\n  daysPassed: number;\n  dueDate: string;\n}\n"
            }
          ]
        },
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Inclusão da lógica de navegação administrativa e gerenciamento de editais globais.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon,\n  ShieldAlert,\n  Users,\n  Database\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession, PredefinedEdital } from './types';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\nimport Admin from './components/Admin';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  \n  // New: Global Editais and Users for Admin\n  const [predefinedEditais, setPredefinedEditais] = useState<PredefinedEdital[]>([]);\n  const [allUsers, setAllUsers] = useState<User[]>([]);\n\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    if (saved) return saved === 'dark';\n    return window.matchMedia('(prefers-color-scheme: dark)').matches;\n  });\n\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (isDarkMode) {\n      root.classList.add('dark');\n      localStorage.setItem('theme', 'dark');\n    } else {\n      root.classList.remove('dark');\n      localStorage.setItem('theme', 'light');\n    }\n  }, [isDarkMode]);\n\n  // Load Persistence\n  useEffect(() => {\n    const savedUser = localStorage.getItem('user');\n    const savedEditais = localStorage.getItem('global_editais');\n    const savedAllUsers = localStorage.getItem('global_users');\n\n    if (savedEditais) setPredefinedEditais(JSON.parse(savedEditais));\n    if (savedAllUsers) setAllUsers(JSON.parse(savedAllUsers));\n\n    if (savedUser) {\n      const parsedUser = JSON.parse(savedUser);\n      setUser(parsedUser);\n      const savedSubjects = localStorage.getItem(`subjects_${parsedUser.id}`);\n      if (savedSubjects) setSubjects(JSON.parse(savedSubjects));\n      const savedMocks = localStorage.getItem(`mocks_${parsedUser.id}`);\n      if (savedMocks) setMocks(JSON.parse(savedMocks));\n      const savedCycle = localStorage.getItem(`cycle_${parsedUser.id}`);\n      if (savedCycle) setCycle(JSON.parse(savedCycle));\n      const savedLogs = localStorage.getItem(`logs_${parsedUser.id}`);\n      if (savedLogs) setStudyLogs(JSON.parse(savedLogs));\n    }\n  }, []);\n\n  // Save Persistence\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem('user', JSON.stringify(user));\n      if (user.role === 'student') {\n        localStorage.setItem(`subjects_${user.id}`, JSON.stringify(subjects));\n        localStorage.setItem(`mocks_${user.id}`, JSON.stringify(mocks));\n        localStorage.setItem(`logs_${user.id}`, JSON.stringify(studyLogs));\n        if (cycle) localStorage.setItem(`cycle_${user.id}`, JSON.stringify(cycle));\n      }\n    }\n    localStorage.setItem('global_editais', JSON.stringify(predefinedEditais));\n    localStorage.setItem('global_users', JSON.stringify(allUsers));\n  }, [subjects, mocks, cycle, user, studyLogs, predefinedEditais, allUsers]);\n\n  if (!user) {\n    return <Login onLogin={(u) => { \n      setUser(u); \n      setAllUsers(prev => {\n        const exists = prev.find(p => p.email === u.email);\n        if (exists) return prev.map(p => p.email === u.email ? { ...p, lastAccess: new Date().toISOString(), status: 'active' } : p);\n        return [...prev, u];\n      });\n    }} />;\n  }\n\n  const studentNavItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n    { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n    { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n    { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n  ];\n\n  const adminNavItems = [\n    { id: 'admin_dashboard', label: 'Gestão de Usuários', icon: <Users size={20} /> },\n    { id: 'admin_editais', label: 'Catálogo de Editais', icon: <Database size={20} /> },\n  ];\n\n  const currentNavItems = user.role === 'admin' ? adminNavItems : studentNavItems;\n\n  const handleLogout = () => {\n    setAllUsers(prev => prev.map(p => p.id === user.id ? { ...p, status: 'inactive' } : p));\n    setUser(null);\n    localStorage.removeItem('user');\n  };\n\n  const addStudyLog = (log: Omit<StudySession, 'id'>) => {\n    const newLog: StudySession = { ...log, id: Date.now().toString() };\n    setStudyLogs(prev => [...prev, newLog]);\n  };\n\n  const updateWeeklyGoal = (hours: number) => {\n    setUser(prev => prev ? { ...prev, weeklyGoal: hours } : null);\n  };\n\n  const renderPage = () => {\n    if (user.role === 'admin') {\n      return (\n        <Admin \n          users={allUsers} \n          editais={predefinedEditais} \n          setEditais={setPredefinedEditais} \n          view={currentPage.includes('dashboard') ? 'users' : 'editais'}\n        />\n      );\n    }\n\n    switch (currentPage) {\n      case 'inicio': return (\n        <Dashboard \n          subjects={subjects} \n          mocks={mocks} \n          cycle={cycle} \n          studyLogs={studyLogs} \n          weeklyGoal={user.weeklyGoal || 20}\n          onUpdateGoal={updateWeeklyGoal}\n          isDarkMode={isDarkMode}\n        />\n      );\n      case 'disciplinas': return (\n        <Disciplinas \n          subjects={subjects} \n          setSubjects={setSubjects} \n          predefinedEditais={predefinedEditais}\n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'estudo' })}\n        />\n      );\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return (\n        <Revisao \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'revisao' })}\n        />\n      );\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={updateWeeklyGoal} isDarkMode={isDarkMode} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-white dark:bg-slate-950 overflow-hidden transition-colors duration-500\">\n      <button \n        className=\"md:hidden fixed top-6 left-6 z-50 p-3 bg-indigo-600 text-white rounded-2xl shadow-xl hover:scale-105 active:scale-95 transition-all\"\n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-72 bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 ease-in-out md:translate-x-0\n        ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}\n      `}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-8 flex items-center gap-4\">\n            <div className={`w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-lg ${user.role === 'admin' ? 'bg-rose-600' : 'bg-indigo-600'}`}>\n              {user.role === 'admin' ? <ShieldAlert size={28} /> : <Award size={28} />}\n            </div>\n            <div>\n              <h1 className=\"text-xl font-black tracking-tight text-slate-900 dark:text-slate-100\">StudyFlow</h1>\n              <p className={`text-[10px] font-black uppercase tracking-widest leading-none mt-1 ${user.role === 'admin' ? 'text-rose-600' : 'text-indigo-600'}`}>\n                {user.role === 'admin' ? 'Painel Admin' : 'Concursos AI'}\n              </p>\n            </div>\n          </div>\n\n          <nav className=\"flex-1 px-4 py-4 space-y-2\">\n            {currentNavItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`\n                  w-full flex items-center gap-3 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all\n                  ${currentPage === item.id \n                    ? (user.role === 'admin' ? 'bg-rose-600 text-white shadow-lg' : 'bg-indigo-600 text-white shadow-lg') \n                    : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100'}\n                `}\n              >\n                {item.icon}\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-6 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n            <div className=\"bg-slate-200 dark:bg-slate-950 p-1 rounded-2xl flex items-center border border-slate-300 dark:border-slate-800\">\n              <button\n                onClick={() => setIsDarkMode(false)}\n                className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${!isDarkMode ? 'bg-white text-indigo-600 shadow-md font-black' : 'text-slate-500 dark:text-slate-600 font-bold'}`}\n              >\n                <Sun size={18} />\n                <span className=\"text-xs\">Claro</span>\n              </button>\n              <button\n                onClick={() => setIsDarkMode(true)}\n                className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${isDarkMode ? 'bg-slate-800 text-indigo-400 shadow-md font-black border border-slate-700' : 'text-slate-500 dark:text-slate-600 font-bold'}`}\n              >\n                <Moon size={18} />\n                <span className=\"text-xs\">Escuro</span>\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-3 p-3 bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm\">\n              <div className={`w-10 h-10 rounded-xl flex items-center justify-center text-sm font-black shrink-0 ${user.role === 'admin' ? 'bg-rose-100 text-rose-700' : 'bg-indigo-100 text-indigo-700'}`}>\n                {user.name.charAt(0).toUpperCase()}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-bold text-slate-900 dark:text-slate-100 truncate leading-none\">{user.name}</p>\n                <p className=\"text-[10px] text-slate-500 truncate mt-1\">{user.role.toUpperCase()}</p>\n              </div>\n              <button onClick={handleLogout} className=\"p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/10 rounded-xl\" title=\"Sair\">\n                <LogOut size={18} />\n              </button>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      <main className=\"flex-1 md:ml-72 overflow-y-auto bg-white dark:bg-slate-950 transition-colors duration-500\">\n        <div className=\"max-w-6xl mx-auto p-6 md:p-12\">\n          {renderPage()}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Login.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Atualização do Login para suportar detecção de perfil Admin (admin@studyflow.com).",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { ShieldCheck, Award, Lock, Mail, User as UserIcon } from 'lucide-react';\n\ninterface LoginProps {\n  onLogin: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = ({ onLogin }) => {\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (email && password) {\n      // Simple logic: if email is admin@studyflow.com, it's an admin\n      const role = email.toLowerCase() === 'admin@studyflow.com' ? 'admin' : 'student';\n      onLogin({ \n        id: 'user_' + Date.now(), \n        name: name || (role === 'admin' ? 'Administrador' : 'Estudante'), \n        email,\n        role,\n        status: 'active',\n        lastAccess: new Date().toISOString()\n      });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-4 transition-colors duration-300\">\n      <div className=\"max-w-md w-full bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl shadow-slate-200 dark:shadow-none border border-slate-100 dark:border-slate-800 p-10 transition-colors relative overflow-hidden\">\n        \n        {/* Decorative elements */}\n        <div className=\"absolute top-0 right-0 w-32 h-32 bg-indigo-50 dark:bg-indigo-900/10 rounded-full blur-3xl -mr-16 -mt-16\" />\n\n        <div className=\"text-center mb-10 relative\">\n          <div className=\"mx-auto w-20 h-20 bg-indigo-600 rounded-3xl flex items-center justify-center text-white shadow-2xl shadow-indigo-200 dark:shadow-none mb-6 rotate-3 hover:rotate-0 transition-transform cursor-pointer\">\n            <Award size={40} />\n          </div>\n          <h1 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight transition-colors\">StudyFlow</h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-2 font-medium transition-colors\">Sua jornada para a aprovação começa aqui.</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6 relative\">\n          <div className=\"space-y-4\">\n            <div className=\"relative\">\n              <label className=\"block text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-2 ml-1\">Nome Completo</label>\n              <div className=\"relative group\">\n                <UserIcon className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n                <input\n                  type=\"text\"\n                  required\n                  className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white transition-all outline-none font-bold\"\n                  placeholder=\"Seu nome\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                />\n              </div>\n            </div>\n\n            <div className=\"relative\">\n              <label className=\"block text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-2 ml-1\">E-mail</label>\n              <div className=\"relative group\">\n                <Mail className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n                <input\n                  type=\"email\"\n                  required\n                  className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white transition-all outline-none font-bold\"\n                  placeholder=\"seu@email.com\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                />\n              </div>\n            </div>\n\n            <div className=\"relative\">\n              <label className=\"block text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-2 ml-1\">Senha de Acesso</label>\n              <div className=\"relative group\">\n                <Lock className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors\" size={18} />\n                <input\n                  type=\"password\"\n                  required\n                  className=\"w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 dark:text-white transition-all outline-none font-bold\"\n                  placeholder=\"••••••••\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                />\n              </div>\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-indigo-600 text-white font-black py-5 rounded-2xl hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 dark:shadow-none flex items-center justify-center gap-3 active:scale-95\"\n          >\n            <ShieldCheck size={22} />\n            ACESSAR PLATAFORMA\n          </button>\n        </form>\n\n        <div className=\"mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center\">\n          <p className=\"text-slate-400 dark:text-slate-600 text-[10px] font-black uppercase tracking-tighter\">\n            Dica: Use <span className=\"text-indigo-600 dark:text-indigo-400\">admin@studyflow.com</span> para perfil de gestão.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
            }
          ]
        },
