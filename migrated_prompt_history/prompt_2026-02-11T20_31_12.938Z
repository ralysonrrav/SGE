          "isDone": true,
          "description": "Inclusão de políticas de exclusão de perfis e regras de integridade referencial CASCADE.",
          "diffs": [
            {
              "target": "",
              "replacement": "\n-- 1. Garantir que a estrutura de perfis seja sólida e sem recursão\ncreate or replace function public.is_admin()\nreturns boolean as $$\nbegin\n  return exists (\n    select 1 from public.profiles\n    where id = auth.uid()\n    and (role = 'administrator' or role = 'admin')\n  );\nend;\n$$ language plpgsql security definer;\n\n-- 2. Permitir que administradores excluam qualquer perfil (Correção Crítica)\ndrop policy if exists \"Admins podem deletar qualquer perfil\" on public.profiles;\ncreate policy \"Admins podem deletar qualquer perfil\" \non public.profiles \nfor delete \nto authenticated \nusing (public.is_admin());\n\n-- 3. Tabela de Matrizes (Predefined Editais)\ncreate table if not exists public.predefined_editais (\n  id uuid primary key default gen_random_uuid(),\n  name text not null,\n  organization text not null,\n  exam_date text,\n  subjects jsonb not null default '[]'::jsonb,\n  last_updated timestamptz default now(),\n  created_by uuid references auth.users(id) default auth.uid()\n);\n\n-- 4. Permissões e RLS\ngrant all on table public.predefined_editais to authenticated;\ngrant all on table public.predefined_editais to service_role;\nalter table public.predefined_editais enable row level security;\n\n-- 5. Blindagem CASCADE (Limpeza Automática de Registros Órfãos)\n-- Isso garante que ao deletar da tabela profiles, os dados vinculados sumam\nALTER TABLE public.study_logs DROP CONSTRAINT IF EXISTS study_logs_user_id_fkey,\nADD CONSTRAINT study_logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;\n\nALTER TABLE public.mocks DROP CONSTRAINT IF EXISTS mocks_user_id_fkey,\nADD CONSTRAINT mocks_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;\n\nALTER TABLE public.study_cycles DROP CONSTRAINT IF EXISTS study_cycles_user_id_fkey,\nADD CONSTRAINT study_cycles_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;\n\nALTER TABLE public.subjects DROP CONSTRAINT IF EXISTS subjects_user_id_fkey,\nADD CONSTRAINT subjects_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;\n"
            }
          ]
        }
      ]
