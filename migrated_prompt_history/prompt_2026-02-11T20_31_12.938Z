    "id": 514,
    "author": "user",
    "payload": {
      "type": "text",
      "text": "Analise agora a minha tabela de usuarios:\n\n-- 1. Criar tabela de perfis para estender o auth.users\ncreate table if not exists profiles (\n  id uuid references auth.users on delete cascade primary key,\n  name text,\n  email text,\n  role text default 'student',\n  status text default 'active',\n  created_at timestamptz default now()\n);\n\n-- 2. Atualizar a tabela de disciplinas para ser vinculada ao usuário\nalter table subjects add column if not exists user_id uuid references auth.users default auth.uid();\n\n-- 3. Habilitar RLS (Row Level Security)\nalter table profiles enable row level security;\nalter table subjects enable row level security;\n\n-- 4. Políticas para Perfis (O usuário só vê o seu)\ncreate policy \"Usuários podem ver o próprio perfil\" \non profiles for select using (auth.uid() = id);\n\n-- 5. Políticas para Disciplinas (O usuário só vê/edita as suas)\ndrop policy if exists \"Acesso Publico\" on subjects;\ncreate policy \"Usuários gerenciam suas próprias disciplinas\" \non subjects for all \nusing (auth.uid() = user_id) \nwith check (auth.uid() = user_id);\n\n-- 6. Trigger para criar perfil automaticamente no cadastro\ncreate or replace function public.handle_new_user()\nreturns trigger as $$\nbegin\n  insert into public.profiles (id, name, email)\n  values (new.id, new.raw_user_meta_data->>'full_name', new.email);\n  return new;\nend;\n$$ language plpgsql security definer;\n\ncreate or replace trigger on_auth_user_created\n  after insert on auth.users\n  for each row execute procedure public.handle_new_user();\n\nGostaria de integrar ao meu projeto o gerenciamento de usuários, quero saber quem está online, quem está bloqueado e qual o privilégio de cada um. Também quero editar os usuários e até mesmo apagá-los se necessário.",
      "files": [],
      "fileUploads": [],
      "cMarkNode": {}
    },
    "createdTimestamp": {
