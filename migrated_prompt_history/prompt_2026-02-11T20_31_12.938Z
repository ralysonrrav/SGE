  {
    "id": 80,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Adição da funcionalidade de importação de tópicos em massa com detecção automática por numeração.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  Circle, \n  BookOpen, \n  AlertTriangle, \n  X, \n  Edit3, \n  Check,\n  Activity,\n  Clock,\n  Target,\n  Calendar,\n  Layers,\n  FileText,\n  Import\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\ninterface TopicToDelete {\n  subjectId: string;\n  topicId: string;\n  title: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  \n  // Bulk Import State\n  const [isBulkModalOpen, setIsBulkModalOpen] = useState(false);\n  const [bulkText, setBulkText] = useState('');\n  const [activeSubjectForBulk, setActiveSubjectForBulk] = useState<string | null>(null);\n\n  // Modals state\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<TopicToDelete | null>(null);\n\n  // Editing state\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editingStatsId, setEditingStatsId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState('');\n  \n  // Stats editing state\n  const [editMinutes, setEditMinutes] = useState(0);\n  const [editAttempted, setEditAttempted] = useState(0);\n  const [editCorrect, setEditCorrect] = useState(0);\n  const [editDate, setEditDate] = useState(() => {\n    const today = new Date();\n    const year = today.getFullYear();\n    const month = String(today.getMonth() + 1).padStart(2, '0');\n    const day = String(today.getDate()).padStart(2, '0');\n    return `${year}-${month}-${day}`;\n  });\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    const newSub: Subject = {\n      id: Date.now().toString(),\n      name: newSubjectName,\n      topics: [],\n      color: colors[subjects.length % colors.length]\n    };\n    setSubjects([...subjects, newSub]);\n    setNewSubjectName('');\n  };\n\n  const confirmRemoveSubject = () => {\n    if (subjectToDelete) {\n      setSubjects(subjects.filter(s => s.id !== subjectToDelete.id));\n      setSubjectToDelete(null);\n    }\n  };\n\n  const confirmRemoveTopic = () => {\n    if (topicToDelete) {\n      setSubjects(subjects.map(s => {\n        if (s.id === topicToDelete.subjectId) {\n          return { ...s, topics: s.topics.filter(t => t.id !== topicToDelete.topicId) };\n        }\n        return s;\n      }));\n      setTopicToDelete(null);\n    }\n  };\n\n  const startEditingSubject = (e: React.MouseEvent, subject: Subject) => {\n    e.stopPropagation();\n    setEditingSubjectId(subject.id);\n    setEditValue(subject.name);\n  };\n\n  const saveSubjectName = (e?: React.MouseEvent | React.KeyboardEvent) => {\n    if (e) e.stopPropagation();\n    if (!editValue.trim() || !editingSubjectId) {\n      setEditingSubjectId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => s.id === editingSubjectId ? { ...s, name: editValue } : s));\n    setEditingSubjectId(null);\n  };\n\n  const startEditingTopic = (e: React.MouseEvent, topic: Topic) => {\n    e.stopPropagation();\n    setEditingTopicId(topic.id);\n    setEditValue(topic.title);\n  };\n\n  const startEditingStats = (e: React.MouseEvent, topic: Topic) => {\n    e.stopPropagation();\n    setEditingStatsId(topic.id);\n    setEditMinutes(0);\n    setEditAttempted(0);\n    setEditCorrect(0);\n    \n    const d = new Date();\n    const year = d.getFullYear();\n    const month = String(d.getMonth() + 1).padStart(2, '0');\n    const day = String(d.getDate()).padStart(2, '0');\n    setEditDate(`${year}-${month}-${day}`);\n  };\n\n  const saveTopicTitle = (subjectId: string, topicId: string) => {\n    if (!editValue.trim()) {\n      setEditingTopicId(null);\n      return;\n    }\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => t.id === topicId ? { ...t, title: editValue } : t)\n        };\n      }\n      return s;\n    }));\n    setEditingTopicId(null);\n  };\n\n  const saveTopicStats = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const finalDate = new Date(`${editDate}T12:00:00`).toISOString();\n              if (editMinutes > 0) onAddLog(editMinutes, topicId, subjectId);\n              \n              return { \n                ...t, \n                studyTimeMinutes: (t.studyTimeMinutes || 0) + editMinutes,\n                questionsAttempted: (t.questionsAttempted || 0) + editAttempted,\n                questionsCorrect: (t.questionsCorrect || 0) + editCorrect,\n                lastStudiedAt: finalDate\n              };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n    setEditingStatsId(null);\n  };\n\n  const addTopic = (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: [...s.topics, { \n            id: Date.now().toString() + Math.random().toString(36).substr(2, 9), \n            title: newTopicTitle, \n            completed: false, \n            importance: 3,\n            studyTimeMinutes: 0,\n            questionsAttempted: 0,\n            questionsCorrect: 0\n          }]\n        };\n      }\n      return s;\n    }));\n    setNewTopicTitle('');\n  };\n\n  const handleBulkImport = () => {\n    if (!bulkText.trim() || !activeSubjectForBulk) return;\n    \n    // Regex para identificar linhas que começam com números (1., 1.1, etc)\n    const lines = bulkText.split('\\n').filter(line => line.trim() !== '');\n    const newTopics: Topic[] = lines.map(line => {\n      // Opcional: Limpar o título mas manter a numeração conforme solicitado\n      return {\n        id: Date.now().toString() + Math.random().toString(36).substr(2, 9),\n        title: line.trim(),\n        completed: false,\n        importance: 3,\n        studyTimeMinutes: 0,\n        questionsAttempted: 0,\n        questionsCorrect: 0\n      };\n    });\n\n    setSubjects(subjects.map(s => {\n      if (s.id === activeSubjectForBulk) {\n        return { ...s, topics: [...s.topics, ...newTopics] };\n      }\n      return s;\n    }));\n\n    setBulkText('');\n    setIsBulkModalOpen(false);\n    setActiveSubjectForBulk(null);\n  };\n\n  const toggleTopic = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => {\n      if (s.id === subjectId) {\n        return {\n          ...s,\n          topics: s.topics.map(t => {\n            if (t.id === topicId) {\n              const becomingCompleted = !t.completed;\n              const today = new Date();\n              const year = today.getFullYear();\n              const month = String(today.getMonth() + 1).padStart(2, '0');\n              const day = String(today.getDate()).padStart(2, '0');\n              const safeNow = new Date(`${year}-${month}-${day}T12:00:00`).toISOString();\n              \n              return { \n                ...t, \n                completed: becomingCompleted, \n                lastStudiedAt: becomingCompleted ? safeNow : t.lastStudiedAt \n              };\n            }\n            return t;\n          })\n        };\n      }\n      return s;\n    }));\n  };\n\n  const calculateHitRate = (attempted?: number, correct?: number) => {\n    if (!attempted || attempted === 0) return null;\n    return Math.round(((correct || 0) / attempted) * 100);\n  };\n\n  const getHitRateColor = (rate: number | null) => {\n    if (rate === null) return 'bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500';\n    if (rate >= 80) return 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/30';\n    if (rate >= 60) return 'bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 border border-amber-100 dark:border-amber-900/30';\n    return 'bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-900/30';\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle total sobre seu conteúdo programático.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Nova disciplina...\"\n            className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-72 shadow-sm transition-all text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-900 font-bold\"\n            value={newSubjectName}\n            onChange={(e) => setNewSubjectName(e.target.value)}\n            onKeyPress={(e) => e.key === 'Enter' && addSubject()}\n          />\n          <button \n            onClick={addSubject}\n            className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all flex items-center justify-center shadow-lg shadow-indigo-100 dark:shadow-none shrink-0\"\n          >\n            <Plus size={24} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 && (\n          <div className=\"text-center py-24 bg-white dark:bg-slate-900 rounded-[2rem] border-2 border-dashed border-slate-200 dark:border-slate-800 transition-colors\">\n            <div className=\"w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-300 dark:text-slate-700\">\n              <BookOpen size={40} />\n            </div>\n            <h3 className=\"text-xl font-bold text-slate-400 dark:text-slate-600\">Nenhuma disciplina cadastrada</h3>\n          </div>\n        )}\n\n        {subjects.map(subject => {\n          const totalT = subject.topics.length;\n          const completedT = subject.topics.filter(t => t.completed).length;\n          const perc = totalT > 0 ? Math.round((completedT / totalT) * 100) : 0;\n          \n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n              <div \n                className=\"p-5 flex flex-col cursor-pointer\"\n                onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                    <div className=\"w-4 h-12 rounded-full shrink-0\" style={{ backgroundColor: subject.color }} />\n                    \n                    {editingSubjectId === subject.id ? (\n                      <div className=\"flex items-center gap-2 flex-1 max-w-md\" onClick={(e) => e.stopPropagation()}>\n                        <input\n                          autoFocus\n                          type=\"text\"\n                          className=\"w-full px-4 py-2 border-2 border-indigo-500 rounded-xl outline-none font-bold text-slate-900 dark:text-white bg-white dark:bg-slate-800\"\n                          value={editValue}\n                          onChange={(e) => setEditValue(e.target.value)}\n                          onKeyDown={(e) => e.key === 'Enter' && saveSubjectName()}\n                          onBlur={() => saveSubjectName()}\n                        />\n                        <button onClick={() => saveSubjectName()} className=\"p-2 bg-emerald-500 text-white rounded-xl\">\n                          <Check size={20} />\n                        </button>\n                      </div>\n                    ) : (\n                      <div className=\"flex flex-col min-w-0 flex-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <h3 className=\"font-bold text-xl text-slate-800 dark:text-slate-100 truncate\">{subject.name}</h3>\n                          {perc > 0 && (\n                            <span className=\"text-[10px] font-black px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400\">\n                              {perc}%\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"flex items-center gap-3\">\n                          <p className=\"text-xs text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider\">\n                            {completedT} de {totalT} tópicos\n                          </p>\n                        </div>\n                        <div className=\"mt-2 h-1 w-full max-w-[200px] bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden transition-colors\">\n                          <div \n                            className=\"h-full transition-all duration-700 ease-out\"\n                            style={{ \n                              width: `${perc}%`, \n                              backgroundColor: subject.color,\n                            }}\n                          />\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2 ml-4\">\n                    <button \n                      onClick={(e) => { e.stopPropagation(); setActiveSubjectForBulk(subject.id); setIsBulkModalOpen(true); }}\n                      className=\"p-2.5 text-indigo-500 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/20 hover:bg-indigo-600 dark:hover:bg-indigo-500 hover:text-white rounded-xl transition-all shadow-sm\"\n                      title=\"Importar Lista de Tópicos\"\n                    >\n                      <Layers size={18} />\n                    </button>\n                    <button \n                      onClick={(e) => startEditingSubject(e, subject)}\n                      className=\"p-2.5 text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-600 dark:hover:bg-indigo-500 hover:text-white rounded-xl transition-all shadow-sm\"\n                      title=\"Editar Disciplina\"\n                    >\n                      <Edit3 size={18} />\n                    </button>\n                    <button \n                      onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }}\n                      className=\"p-2.5 text-rose-500 dark:text-rose-400 bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-600 dark:hover:bg-rose-500 hover:text-white rounded-xl transition-all shadow-sm\"\n                      title=\"Excluir Disciplina\"\n                    >\n                      <Trash2 size={18} />\n                    </button>\n                    <div className={`p-2 rounded-xl transition-colors ${expandedSubject === subject.id ? 'bg-slate-800 dark:bg-slate-700 text-white' : 'bg-slate-50 dark:bg-slate-800 text-slate-400 dark:text-slate-500'}`}>\n                      {expandedSubject === subject.id ? <ChevronUp size={20} /> : <ChevronDown size={20} />}\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {expandedSubject === subject.id && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800 bg-slate-50/20 dark:bg-slate-800/10 transition-colors\">\n                  <div className=\"flex gap-2 mb-6 mt-2\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Adicionar novo tópico (ex: 1. Introdução)...\"\n                      className=\"flex-1 px-4 py-3 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none text-slate-900 dark:text-white bg-white dark:bg-slate-900 font-medium\"\n                      value={newTopicTitle}\n                      onChange={(e) => setNewTopicTitle(e.target.value)}\n                      onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)}\n                    />\n                    <button \n                      onClick={() => addTopic(subject.id)}\n                      className=\"bg-slate-800 dark:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold hover:bg-slate-900 dark:hover:bg-slate-600 transition-all\"\n                    >\n                      Adicionar\n                    </button>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    {subject.topics.map(topic => {\n                      const hitRate = calculateHitRate(topic.questionsAttempted, topic.questionsCorrect);\n                      const formattedDate = topic.lastStudiedAt ? new Date(topic.lastStudiedAt).toLocaleDateString('pt-BR') : null;\n                      \n                      return (\n                        <div \n                          key={topic.id}\n                          className=\"flex flex-col p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-sm hover:border-indigo-100 dark:hover:border-indigo-900 transition-all\"\n                        >\n                          <div className=\"flex items-center justify-between mb-2\">\n                            <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                              <button \n                                onClick={() => toggleTopic(subject.id, topic.id)}\n                                className={`transition-all shrink-0 ${topic.completed ? 'text-emerald-500 dark:text-emerald-400' : 'text-slate-200 dark:text-slate-700 hover:text-indigo-400'}`}\n                              >\n                                {topic.completed ? <CheckCircle size={24} /> : <Circle size={24} />}\n                              </button>\n                              \n                              {editingTopicId === topic.id ? (\n                                <div className=\"flex items-center gap-2 flex-1\" onClick={(e) => e.stopPropagation()}>\n                                  <input\n                                    autoFocus\n                                    type=\"text\"\n                                    className=\"w-full px-3 py-1.5 text-sm border-2 border-indigo-400 rounded-lg outline-none text-slate-900 dark:text-white bg-white dark:bg-slate-800\"\n                                    value={editValue}\n                                    onChange={(e) => setEditValue(e.target.value)}\n                                    onKeyDown={(e) => e.key === 'Enter' && saveTopicTitle(subject.id, topic.id)}\n                                    onBlur={() => saveTopicTitle(subject.id, topic.id)}\n                                  />\n                                </div>\n                              ) : (\n                                <div className=\"flex flex-col min-w-0 flex-1\">\n                                  <span className={`text-sm font-bold truncate ${topic.completed ? 'text-slate-300 dark:text-slate-600 line-through' : 'text-slate-700 dark:text-slate-200'}`}>\n                                    {topic.title}\n                                  </span>\n                                  {topic.completed && (\n                                    <div className=\"flex flex-wrap items-center gap-3 mt-1\">\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Calendar size={10} />\n                                        {formattedDate || 'Não informada'}\n                                      </div>\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Clock size={10} />\n                                        {Math.floor((topic.studyTimeMinutes || 0) / 60)}h {(topic.studyTimeMinutes || 0) % 60}m\n                                      </div>\n                                      <div className=\"flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-500 font-bold\">\n                                        <Target size={10} />\n                                        {topic.questionsCorrect || 0}/{topic.questionsAttempted || 0} Acertos\n                                      </div>\n                                      {hitRate !== null && (\n                                        <span className={`text-[10px] px-2 py-0.5 rounded-full font-black ${getHitRateColor(hitRate)}`}>\n                                          {hitRate}% APROVEITAMENTO\n                                        </span>\n                                      )}\n                                    </div>\n                                  )}\n                                </div>\n                              )}\n                            </div>\n                            \n                            <div className=\"flex items-center gap-2 ml-4 shrink-0\">\n                              <button \n                                onClick={(e) => startEditingStats(e, topic)}\n                                className={`p-2 rounded-lg transition-all ${editingStatsId === topic.id ? 'bg-indigo-600 dark:bg-indigo-500 text-white shadow-md' : 'text-indigo-400 dark:text-indigo-500 bg-indigo-50 dark:bg-indigo-900/20 hover:bg-indigo-100 dark:hover:bg-indigo-800'}`}\n                                title=\"Editar Métricas e Data\"\n                              >\n                                <Activity size={15} />\n                              </button>\n                              {editingTopicId !== topic.id && (\n                                <button \n                                  onClick={(e) => startEditingTopic(e, topic)}\n                                  className=\"p-2 text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-500 dark:hover:bg-indigo-600 hover:text-white rounded-lg transition-all\"\n                                  title=\"Editar Nome\"\n                                >\n                                  <Edit3 size={15} />\n                                </button>\n                              )}\n                              <button \n                                onClick={(e) => { e.stopPropagation(); setTopicToDelete({ subjectId: subject.id, topicId: topic.id, title: topic.title }); }}\n                                className=\"p-2 text-rose-400 dark:text-rose-500 bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-500 dark:hover:bg-rose-600 hover:text-white rounded-lg transition-all\"\n                                title=\"Excluir Tópico\"\n                              >\n                                <Trash2 size={15} />\n                              </button>\n                            </div>\n                          </div>\n\n                          {editingStatsId === topic.id && (\n                            <div className=\"mt-3 p-4 bg-slate-50 dark:bg-slate-800/50 border border-indigo-100 dark:border-indigo-900/30 rounded-xl shadow-inner animate-in slide-in-from-top-2 duration-200\">\n                              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                                <div className=\"relative\">\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Calendar size={10} /> Data do Estudo\n                                  </label>\n                                  <input \n                                    type=\"date\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white cursor-pointer hover:border-indigo-200 dark:hover:border-indigo-700 transition-colors\"\n                                    value={editDate}\n                                    onChange={(e) => setEditDate(e.target.value)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Clock size={10} /> Adicionar Minutos\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editMinutes}\n                                    onChange={(e) => setEditMinutes(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Target size={10} /> Questões\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editAttempted}\n                                    onChange={(e) => setEditAttempted(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                                <div>\n                                  <label className=\"block text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase mb-1 flex items-center gap-1\">\n                                    <Check size={10} /> Acertos\n                                  </label>\n                                  <input \n                                    type=\"number\" \n                                    className=\"w-full px-3 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-900 text-slate-900 dark:text-white transition-colors\"\n                                    value={editCorrect}\n                                    onChange={(e) => setEditCorrect(parseInt(e.target.value) || 0)}\n                                  />\n                                </div>\n                              </div>\n                              <div className=\"flex justify-end gap-2 mt-4 pt-4 border-t border-slate-200 dark:border-slate-700\">\n                                <button \n                                  onClick={() => setEditingStatsId(null)}\n                                  className=\"px-4 py-2 text-xs font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-lg transition-all\"\n                                >\n                                  Cancelar\n                                </button>\n                                <button \n                                  onClick={() => saveTopicStats(subject.id, topic.id)}\n                                  className=\"px-6 py-2 text-xs font-bold bg-indigo-600 dark:bg-indigo-500 text-white rounded-lg hover:bg-indigo-700 dark:hover:bg-indigo-400 shadow-md transition-all flex items-center gap-2\"\n                                >\n                                  <Check size={14} /> Salvar Sessão\n                                </button>\n                              </div>\n                            </div>\n                          )}\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Modal de Importação em Massa */}\n      {isBulkModalOpen && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl w-full max-w-2xl overflow-hidden animate-in zoom-in-95 duration-300 border border-slate-100 dark:border-slate-800\">\n            <div className=\"p-8\">\n              <div className=\"flex items-center justify-between mb-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-3 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-2xl\">\n                    <Import size={24} />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100\">Importação Inteligente</h3>\n                    <p className=\"text-xs text-slate-500 font-bold uppercase tracking-wider\">Cole os tópicos do edital abaixo</p>\n                  </div>\n                </div>\n                <button \n                  onClick={() => setIsBulkModalOpen(false)}\n                  className=\"p-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-all\"\n                >\n                  <X size={24} />\n                </button>\n              </div>\n\n              <div className=\"space-y-4\">\n                <div className=\"bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/20 p-4 rounded-2xl flex items-start gap-3\">\n                  <AlertTriangle className=\"text-amber-600 shrink-0\" size={18} />\n                  <p className=\"text-xs text-amber-800 dark:text-amber-300 font-medium leading-relaxed\">\n                    Cada linha será salva como um tópico individual. O sistema preservará a numeração original (ex: \"1. Introdução\").\n                  </p>\n                </div>\n\n                <textarea\n                  className=\"w-full h-64 px-5 py-4 border-2 border-slate-100 dark:border-slate-800 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white font-medium resize-none text-sm\"\n                  placeholder=\"Cole aqui seu edital...&#10;1. Princípios Fundamentais&#10;2. Direitos e Garantias&#10;2.1 Direitos Individuais\"\n                  value={bulkText}\n                  onChange={(e) => setBulkText(e.target.value)}\n                />\n\n                <div className=\"flex items-center justify-between pt-4\">\n                  <span className=\"text-xs font-bold text-slate-400\">\n                    {bulkText.split('\\n').filter(l => l.trim()).length} tópicos detectados\n                  </span>\n                  <div className=\"flex gap-3\">\n                    <button \n                      onClick={() => setIsBulkModalOpen(false)}\n                      className=\"px-6 py-3 text-sm font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-all\"\n                    >\n                      Cancelar\n                    </button>\n                    <button \n                      onClick={handleBulkImport}\n                      className=\"px-8 py-3 bg-indigo-600 text-white text-sm font-black rounded-xl hover:bg-indigo-700 shadow-lg shadow-indigo-100 dark:shadow-none transition-all\"\n                    >\n                      IMPORTAR TÓPICOS\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Modais de Confirmação de Exclusão */}\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in-95 duration-300 border border-slate-100 dark:border-slate-800\">\n            <div className=\"p-10 text-center\">\n              <div className=\"w-20 h-20 bg-rose-50 dark:bg-rose-900/20 text-rose-500 dark:text-rose-400 rounded-3xl flex items-center justify-center mx-auto mb-6\">\n                <AlertTriangle size={40} />\n              </div>\n              <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 mb-4\">Excluir Disciplina?</h3>\n              <p className=\"text-slate-500 dark:text-slate-400 mb-8\">\n                Toda a matéria <span className=\"font-bold text-slate-800 dark:text-slate-200\">\"{subjectToDelete.name}\"</span> e seus tópicos serão removidos permanentemente.\n              </p>\n              <div className=\"flex flex-col gap-3\">\n                <button onClick={confirmRemoveSubject} className=\"w-full bg-rose-500 text-white font-bold py-4 rounded-2xl hover:bg-rose-600 transition-all shadow-lg shadow-rose-100 dark:shadow-none\">EXCLUIR TUDO</button>\n                <button onClick={() => setSubjectToDelete(null)} className=\"w-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold py-4 rounded-2xl hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors\">CANCELAR</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {topicToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/60 backdrop-blur-sm\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl w-full max-w-sm overflow-hidden animate-in zoom-in-95 duration-200 border border-slate-100 dark:border-slate-800\">\n            <div className=\"p-8 text-center\">\n              <div className=\"w-16 h-16 bg-rose-50 dark:bg-rose-900/20 text-rose-500 dark:text-rose-400 rounded-2xl flex items-center justify-center mx-auto mb-4\">\n                <Trash2 size={32} />\n              </div>\n              <h3 className=\"text-xl font-bold text-slate-900 dark:text-slate-100 mb-2\">Remover Tópico?</h3>\n              <p className=\"text-slate-500 dark:text-slate-400 text-sm mb-6\">Deseja remover \"{topicToDelete.title}\"?</p>\n              <div className=\"flex gap-3\">\n                <button onClick={() => setTopicToDelete(null)} className=\"flex-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold py-3 rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors\">Não</button>\n                <button onClick={confirmRemoveTopic} className=\"flex-1 bg-rose-500 text-white font-bold py-3 rounded-xl hover:bg-rose-600 transition-colors\">Sim, Remover</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
    },
