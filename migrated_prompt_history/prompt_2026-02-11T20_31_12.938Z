          "path": "components/Dashboard.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Refatoração do Dashboard para um visual \"Command Center\" futurista.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect, useMemo } from 'react';\nimport { Subject, MockExam, StudyCycle, StudySession } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell, AreaChart, Area\n} from 'recharts';\nimport { TrendingUp, Clock, Settings, Target, Zap, Calendar, ArrowUpRight } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n  studyLogs: StudySession[];\n  weeklyGoal: number;\n  onUpdateGoal: (hours: number) => void;\n  isDarkMode: boolean;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, studyLogs, weeklyGoal, onUpdateGoal }) => {\n  const [isEditingGoal, setIsEditingGoal] = useState(false);\n  const [tempGoal, setTempGoal] = useState(weeklyGoal);\n  const [isMounted, setIsMounted] = useState(false);\n\n  useEffect(() => { setIsMounted(true); }, []);\n\n  const totalMinutes = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.studyTimeMinutes || 0), 0), 0), [subjects]);\n  const totalHours = Math.floor(totalMinutes / 60);\n  const totalTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.length, 0), [subjects]);\n  const completedTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0), [subjects]);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  const thisWeekHours = useMemo(() => {\n    const now = new Date();\n    const lastSun = new Date(now);\n    lastSun.setDate(now.getDate() - now.getDay());\n    lastSun.setHours(0, 0, 0, 0);\n    const mins = studyLogs.reduce((acc, log) => new Date(log.date) >= lastSun ? acc + log.minutes : acc, 0);\n    return parseFloat((mins / 60).toFixed(1));\n  }, [studyLogs]);\n\n  const weeklyGoalPercent = Math.min(100, Math.round((thisWeekHours / weeklyGoal) * 100));\n  const mockData = useMemo(() => mocks.map(m => ({ name: m.title.substring(0, 8), acerto: Math.round((m.score / m.totalQuestions) * 100) })).slice(-5).reverse(), [mocks]);\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-1000\">\n      \n      {/* Hero Stats Section */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        {[\n          { label: 'Minutos Acumulados', value: `${totalMinutes}m`, icon: <Clock size={20}/>, color: 'text-indigo-400' },\n          { label: 'Carga Horária Total', value: `${totalHours}h`, icon: <Zap size={20}/>, color: 'text-amber-400' },\n          { label: 'Eficiência Geral', value: `${progressPercent}%`, icon: <Target size={20}/>, color: 'text-emerald-400' },\n          { label: 'Sessões Ativas', value: studyLogs.length, icon: <TrendingUp size={20}/>, color: 'text-sky-400' },\n        ].map((stat, i) => (\n          <div key={i} className=\"glass-card p-6 rounded-3xl relative overflow-hidden group hover:scale-[1.02] transition-all\">\n            <div className={`absolute -right-4 -bottom-4 opacity-5 ${stat.color}`}><stat.icon.type size={120} /></div>\n            <div className=\"flex items-center gap-3 mb-4\">\n               <div className={`p-2 rounded-lg bg-white/5 ${stat.color}`}>{stat.icon}</div>\n               <span className=\"text-[10px] font-black uppercase text-slate-500 tracking-widest\">{stat.label}</span>\n            </div>\n            <p className=\"text-3xl font-black text-white\">{stat.value}</p>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Weekly Productivity Visualizer */}\n        <div className=\"lg:col-span-8 glass-card rounded-[2.5rem] p-10 relative overflow-hidden\">\n          <div className=\"flex justify-between items-center mb-10\">\n            <div>\n              <h3 className=\"text-xl font-black text-white tracking-tight\">Performance Semanal</h3>\n              <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mt-1\">Status da Meta Ativa</p>\n            </div>\n            <button onClick={() => setIsEditingGoal(!isEditingGoal)} className=\"p-3 bg-white/5 text-slate-400 hover:text-indigo-400 rounded-xl transition-all\"><Settings size={18} /></button>\n          </div>\n\n          <div className=\"flex flex-col md:flex-row items-center gap-12\">\n            <div className=\"w-48 h-48 shrink-0 relative flex items-center justify-center\">\n              <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n                <circle cx=\"50\" cy=\"50\" r=\"42\" className=\"stroke-white/5 fill-none\" strokeWidth=\"8\" />\n                <circle \n                  cx=\"50\" cy=\"50\" r=\"42\" \n                  className=\"stroke-indigo-500 fill-none transition-all duration-1000 ease-out\" \n                  strokeWidth=\"8\"\n                  strokeDasharray={2 * Math.PI * 42}\n                  strokeDashoffset={(2 * Math.PI * 42) * (1 - weeklyGoalPercent / 100)}\n                  strokeLinecap=\"round\"\n                />\n              </svg>\n              <div className=\"absolute flex flex-col items-center\">\n                <span className=\"text-4xl font-black text-white\">{weeklyGoalPercent}%</span>\n                <span className=\"text-[8px] font-black text-indigo-400 uppercase tracking-widest\">Atingido</span>\n              </div>\n            </div>\n\n            <div className=\"flex-1 space-y-6\">\n              <div className=\"space-y-2\">\n                <p className=\"text-slate-400 text-sm font-medium leading-relaxed\">\n                  Você concluiu <span className=\"text-white font-black\">{thisWeekHours}h</span>. Para fechar a meta de <span className=\"text-indigo-400 font-black\">{weeklyGoal}h</span>, ainda restam <span className=\"text-white font-black\">{Math.max(0, weeklyGoal - thisWeekHours)}h</span> de estudo focado.\n                </p>\n              </div>\n\n              {isEditingGoal && (\n                <div className=\"flex gap-2 p-3 bg-black/20 rounded-2xl border border-white/5\">\n                  <input type=\"number\" className=\"flex-1 bg-transparent px-4 py-2 font-black text-white outline-none\" value={tempGoal} onChange={(e) => setTempGoal(parseInt(e.target.value) || 0)} />\n                  <button onClick={() => { onUpdateGoal(tempGoal); setIsEditingGoal(false); }} className=\"bg-indigo-600 px-6 py-2 rounded-xl text-[10px] font-black uppercase text-white hover:bg-indigo-500 transition-all\">Definir</button>\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"p-4 bg-white/5 rounded-2xl border border-white/5\">\n                   <p className=\"text-[8px] font-black text-slate-500 uppercase mb-1\">Ritmo Esperado</p>\n                   <p className=\"text-sm font-black text-indigo-300\">{(weeklyGoal/7).toFixed(1)}h / dia</p>\n                </div>\n                <div className=\"p-4 bg-white/5 rounded-2xl border border-white/5\">\n                   <p className=\"text-[8px] font-black text-slate-500 uppercase mb-1\">Previsão</p>\n                   <p className=\"text-sm font-black text-emerald-400\">{weeklyGoalPercent >= 80 ? 'Excelente' : 'Ajustar'}</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Coverage Card */}\n        <div className=\"lg:col-span-4 glass-card rounded-[2.5rem] p-10 flex flex-col justify-between border-t-2 border-t-indigo-500 shadow-indigo-500/10 shadow-2xl\">\n          <div>\n            <h3 className=\"text-xl font-black text-white tracking-tight\">Matriz Vertical</h3>\n            <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mt-1\">Consumo do Edital</p>\n          </div>\n          <div className=\"py-8\">\n            <p className=\"text-6xl font-black text-white tracking-tighter leading-none\">{progressPercent}%</p>\n            <div className=\"h-2 bg-white/5 rounded-full mt-6 overflow-hidden\">\n               <div className=\"h-full bg-indigo-500 rounded-full shadow-[0_0_10px_rgba(99,102,241,0.5)] transition-all duration-1000\" style={{ width: `${progressPercent}%` }} />\n            </div>\n          </div>\n          <p className=\"text-[10px] font-bold text-slate-400\">Total de <span className=\"text-indigo-400\">{completedTopics}</span> de <span className=\"text-white\">{totalTopics}</span> assuntos marcados como lidos.</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Real-time Performance Chart */}\n        <div className=\"glass-card rounded-[2.5rem] p-10\">\n          <div className=\"flex items-center justify-between mb-10\">\n            <h3 className=\"text-lg font-black text-white flex items-center gap-3\">\n               <ArrowUpRight className=\"text-indigo-400\" /> Evolução em Simulados\n            </h3>\n            <span className=\"text-[8px] font-black bg-white/5 px-3 py-1 rounded-full text-slate-500 uppercase tracking-widest\">Top 5 Resultados</span>\n          </div>\n          <div className=\"h-64\">\n            {isMounted && mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <AreaChart data={mockData}>\n                  <defs>\n                    <linearGradient id=\"colorScore\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                      <stop offset=\"5%\" stopColor=\"#6366f1\" stopOpacity={0.3}/>\n                      <stop offset=\"95%\" stopColor=\"#6366f1\" stopOpacity={0}/>\n                    </linearGradient>\n                  </defs>\n                  <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"rgba(255,255,255,0.03)\" />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{ fill: '#64748b', fontSize: 9, fontWeight: '800' }} dy={10} />\n                  <YAxis axisLine={false} tickLine={false} tick={{ fill: '#64748b', fontSize: 9, fontWeight: '800' }} unit=\"%\" />\n                  <Tooltip contentStyle={{ background: '#0f172a', border: '1px solid rgba(255,255,255,0.08)', borderRadius: '15px' }} />\n                  <Area type=\"monotone\" dataKey=\"acerto\" stroke=\"#6366f1\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorScore)\" />\n                </AreaChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-600 gap-4 opacity-30\">\n                <Calendar size={48} />\n                <p className=\"font-black text-[10px] uppercase tracking-widest\">Sem registros históricos</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Breakdown Panel */}\n        <div className=\"glass-card rounded-[2.5rem] p-10 overflow-hidden\">\n           <h3 className=\"text-lg font-black text-white mb-8\">Nível por Disciplina</h3>\n           <div className=\"space-y-6 max-h-64 overflow-y-auto pr-2 custom-scrollbar\">\n             {subjects.map(s => {\n               const perc = s.topics.length > 0 ? Math.round((s.topics.filter(t => t.completed).length / s.topics.length) * 100) : 0;\n               return (\n                 <div key={s.id} className=\"space-y-2\">\n                   <div className=\"flex justify-between items-center text-[10px] font-black uppercase tracking-widest\">\n                      <span className=\"text-slate-300\">{s.name}</span>\n                      <span className=\"text-indigo-400\">{perc}%</span>\n                   </div>\n                   <div className=\"h-1.5 bg-white/5 rounded-full\">\n                      <div className=\"h-full rounded-full transition-all duration-700\" style={{ width: `${perc}%`, backgroundColor: s.color }} />\n                   </div>\n                 </div>\n               );\n             })}\n           </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        },
        {
          "path": "components/Login.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Design futurista para a tela de login, condizente com o novo ambiente de site.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { \n  ShieldCheck, Award, Lock, Mail, User as UserIcon, Info, \n  RefreshCw, Eye, BrainCircuit\n} from 'lucide-react';\n\ninterface LoginProps {\n  users: User[];\n  onLogin: (user: User) => void;\n  onRegister: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = ({ onLogin, onRegister }) => {\n  const [mode, setMode] = useState<'login' | 'register' | 'forgot'>('login');\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n  const [confirmPassword, setConfirmPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<{ msg: string; type: 'error' | 'warning' | 'info' | 'success' } | null>(null);\n\n  const handleDemoAccess = () => {\n    onLogin({\n      id: 'demo-visitor-id',\n      name: 'Visitante (Demo)',\n      email: 'demo@studyflow.com',\n      role: 'visitor',\n      status: 'active',\n      isOnline: true,\n      weeklyGoal: 20\n    });\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    if (!supabase) return;\n    setLoading(true);\n\n    try {\n      if (mode === 'register') {\n        if (password !== confirmPassword) {\n          setError({ msg: \"As senhas não coincidem!\", type: 'error' });\n          setLoading(false);\n          return;\n        }\n        const { data, error: signUpError } = await supabase.auth.signUp({\n          email, password, options: { data: { full_name: name } }\n        });\n        if (signUpError) throw signUpError;\n        if (data.user && data.session) {\n           onRegister({ id: data.user.id, name: name || 'Usuário', email, role: 'student', status: 'active', isOnline: true });\n        } else {\n           setError({ msg: \"Conta criada! Verifique seu e-mail para ativar.\", type: 'success' });\n        }\n      } else if (mode === 'login') {\n        const { data, error: signInError } = await supabase.auth.signInWithPassword({ email, password });\n        if (signInError) throw signInError;\n        if (data.session && data.user) {\n          onLogin({\n            id: data.user.id,\n            name: data.user.user_metadata?.full_name || 'Usuário',\n            email: data.user.email!,\n            role: data.user.email === 'ralysonriccelli@gmail.com' ? 'administrator' : 'student',\n            status: 'active',\n            isOnline: true\n          });\n        }\n      }\n    } catch (err: any) {\n      setError({ msg: err.message, type: 'error' });\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-study-dark flex items-center justify-center p-6 relative\">\n      <div className=\"absolute inset-0 bg-slate-950/80 pointer-events-none\"></div>\n      \n      <div className=\"max-w-md w-full glass-card rounded-[3rem] p-12 relative z-10 border border-white/10 shadow-indigo-500/10 shadow-2xl\">\n        <div className=\"text-center mb-12\">\n          <div className=\"w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-xl shadow-indigo-500/20\">\n            <BrainCircuit size={32} className=\"text-white\" />\n          </div>\n          <h1 className=\"text-3xl font-black text-white tracking-tighter neo-glow\">StudyFlow</h1>\n          <p className=\"text-[10px] font-black uppercase text-indigo-400 tracking-[0.4em] mt-2\">Plataforma Estratégica</p>\n        </div>\n\n        {error && (\n          <div className={`mb-8 p-4 rounded-2xl flex items-start gap-3 border text-xs font-bold ${error.type === 'error' ? 'bg-rose-500/10 border-rose-500/20 text-rose-400' : 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'}`}>\n            <Info size={16} className=\"shrink-0\" />\n            <p>{error.msg}</p>\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          {mode === 'register' && (\n            <div className=\"relative\">\n              <UserIcon className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-500\" size={16} />\n              <input type=\"text\" required className=\"w-full pl-14 pr-5 py-4 bg-white/5 border border-white/5 rounded-2xl text-white text-sm font-bold outline-none focus:border-indigo-500 transition-all\" placeholder=\"Nome Completo\" value={name} onChange={(e) => setName(e.target.value)} />\n            </div>\n          )}\n          <div className=\"relative\">\n            <Mail className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-500\" size={16} />\n            <input type=\"email\" required className=\"w-full pl-14 pr-5 py-4 bg-white/5 border border-white/5 rounded-2xl text-white text-sm font-bold outline-none focus:border-indigo-500 transition-all\" placeholder=\"E-mail\" value={email} onChange={(e) => setEmail(e.target.value)} />\n          </div>\n          <div className=\"relative\">\n            <Lock className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-500\" size={16} />\n            <input type=\"password\" required className=\"w-full pl-14 pr-5 py-4 bg-white/5 border border-white/5 rounded-2xl text-white text-sm font-bold outline-none focus:border-indigo-500 transition-all\" placeholder=\"Senha\" value={password} onChange={(e) => setPassword(e.target.value)} />\n          </div>\n          {mode === 'register' && (\n            <div className=\"relative\">\n              <ShieldCheck className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-500\" size={16} />\n              <input type=\"password\" required className=\"w-full pl-14 pr-5 py-4 bg-white/5 border border-white/5 rounded-2xl text-white text-sm font-bold outline-none focus:border-indigo-500 transition-all\" placeholder=\"Confirmar Senha\" value={confirmPassword} onChange={(e) => setConfirmPassword(e.target.value)} />\n            </div>\n          )}\n\n          <button disabled={loading} className=\"w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black py-5 rounded-2xl mt-4 shadow-xl shadow-indigo-500/20 transition-all flex items-center justify-center gap-3 active:scale-95 disabled:opacity-50\">\n            {loading ? <RefreshCw className=\"animate-spin\" size={18} /> : null}\n            {mode === 'login' ? 'AUTENTICAR' : 'CRIAR CONTA'}\n          </button>\n        </form>\n\n        <div className=\"mt-8 flex flex-col items-center gap-4\">\n           <button onClick={() => setMode(mode === 'login' ? 'register' : 'login')} className=\"text-[10px] font-black text-slate-500 uppercase tracking-widest hover:text-indigo-400\">\n             {mode === 'login' ? 'Novo por aqui? Criar conta' : 'Já possui cadastro? Acessar'}\n           </button>\n           <div className=\"w-full flex items-center gap-4 py-2\">\n             <div className=\"flex-1 h-px bg-white/5\"></div>\n             <span className=\"text-[8px] font-black text-slate-600 uppercase tracking-[0.3em]\">Ou</span>\n             <div className=\"flex-1 h-px bg-white/5\"></div>\n           </div>\n           <button onClick={handleDemoAccess} className=\"w-full py-4 rounded-2xl bg-white/5 border border-white/5 text-slate-300 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 transition-all flex items-center justify-center gap-2\">\n             <Eye size={14} /> Modo Visitante\n           </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
            }
          ]
        }
      ]
    },
    "createdTimestamp": {
