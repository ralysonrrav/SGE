    "id": 76,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "index.html",
          "generationType": 1,
          "isDone": true,
          "description": "Adição da configuração darkMode: 'class' para o Tailwind CSS.",
          "diffs": [
            {
              "target": "",
              "replacement": "\n<!DOCTYPE html>\n<html lang=\"pt-br\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Concurseiro Pro AI - Planejamento Inteligente</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        // Configura o Tailwind para usar a estratégia de classe para o modo escuro\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif'],\n                    },\n                }\n            }\n        }\n    </script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n        /* Transição suave para cores de fundo e texto ao trocar de tema */\n        * { transition: background-color 0.3s ease, border-color 0.3s ease, color 0.1s ease; }\n    </style>\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"@google/genai\": \"https://esm.sh/@google/genai@^1.38.0\",\n    \"recharts\": \"https://esm.sh/recharts@^3.7.0\",\n    \"lucide-react\": \"https://esm.sh/lucide-react@^0.562.0\",\n    \"react-dom/\": \"https://esm.sh/react-dom@^19.2.3/\",\n    \"react/\": \"https://esm.sh/react@^19.2.3/\",\n    \"react\": \"https://esm.sh/react@^19.2.3\"\n  }\n}\n</script>\n</head>\n<body class=\"bg-slate-50 text-slate-900 transition-colors duration-300\">\n    <div id=\"root\"></div>\n</body>\n</html>\n"
            }
          ]
        },
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Refinamento das classes de cores para garantir tons claros puros no modo Light.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession } from './types';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    // Se houver salvo, usa. Caso contrário, verifica preferência do sistema.\n    if (saved) return saved === 'dark';\n    return window.matchMedia('(prefers-color-scheme: dark)').matches;\n  });\n\n  // Sincronização do Tema com o Elemento Root (HTML)\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (isDarkMode) {\n      root.classList.add('dark');\n      localStorage.setItem('theme', 'dark');\n    } else {\n      root.classList.remove('dark');\n      localStorage.setItem('theme', 'light');\n    }\n  }, [isDarkMode]);\n\n  // Carregar dados salvos\n  useEffect(() => {\n    const savedUser = localStorage.getItem('user');\n    if (savedUser) {\n      const parsedUser = JSON.parse(savedUser);\n      setUser(parsedUser);\n      const savedSubjects = localStorage.getItem(`subjects_${parsedUser.id}`);\n      if (savedSubjects) setSubjects(JSON.parse(savedSubjects));\n      const savedMocks = localStorage.getItem(`mocks_${parsedUser.id}`);\n      if (savedMocks) setMocks(JSON.parse(savedMocks));\n      const savedCycle = localStorage.getItem(`cycle_${parsedUser.id}`);\n      if (savedCycle) setCycle(JSON.parse(savedCycle));\n      const savedLogs = localStorage.getItem(`logs_${parsedUser.id}`);\n      if (savedLogs) setStudyLogs(JSON.parse(savedLogs));\n    }\n  }, []);\n\n  // Salvar dados automaticamente\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem('user', JSON.stringify(user));\n      localStorage.setItem(`subjects_${user.id}`, JSON.stringify(subjects));\n      localStorage.setItem(`mocks_${user.id}`, JSON.stringify(mocks));\n      localStorage.setItem(`logs_${user.id}`, JSON.stringify(studyLogs));\n      if (cycle) localStorage.setItem(`cycle_${user.id}`, JSON.stringify(cycle));\n    }\n  }, [subjects, mocks, cycle, user, studyLogs]);\n\n  if (!user) {\n    return <Login onLogin={(u) => { setUser(u); localStorage.setItem('user', JSON.stringify(u)); }} />;\n  }\n\n  const navItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n    { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n    { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n    { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n  ];\n\n  const handleLogout = () => {\n    setUser(null);\n    localStorage.removeItem('user');\n  };\n\n  const addStudyLog = (log: Omit<StudySession, 'id'>) => {\n    const newLog: StudySession = { ...log, id: Date.now().toString() };\n    setStudyLogs(prev => [...prev, newLog]);\n  };\n\n  const updateWeeklyGoal = (hours: number) => {\n    setUser(prev => prev ? { ...prev, weeklyGoal: hours } : null);\n  };\n\n  const renderPage = () => {\n    switch (currentPage) {\n      case 'inicio': return (\n        <Dashboard \n          subjects={subjects} \n          mocks={mocks} \n          cycle={cycle} \n          studyLogs={studyLogs} \n          weeklyGoal={user.weeklyGoal || 20}\n          onUpdateGoal={updateWeeklyGoal}\n          isDarkMode={isDarkMode}\n        />\n      );\n      case 'disciplinas': return (\n        <Disciplinas \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'estudo' })}\n        />\n      );\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return (\n        <Revisao \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'revisao' })}\n        />\n      );\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={updateWeeklyGoal} isDarkMode={isDarkMode} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-white dark:bg-slate-950 overflow-hidden transition-colors duration-500\">\n      {/* Botão Mobile */}\n      <button \n        className=\"md:hidden fixed top-6 left-6 z-50 p-3 bg-indigo-600 text-white rounded-2xl shadow-xl hover:scale-105 active:scale-95 transition-all\"\n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      {/* Sidebar - Garantindo cores claras no modo light */}\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-72 bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 ease-in-out md:translate-x-0\n        ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}\n      `}>\n        <div className=\"flex flex-col h-full\">\n          {/* Logo Section */}\n          <div className=\"p-8 flex items-center gap-4\">\n            <div className=\"w-12 h-12 bg-indigo-600 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-indigo-100 dark:shadow-none\">\n              <Award size={28} />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-black tracking-tight text-slate-900 dark:text-slate-100 transition-colors\">StudyFlow</h1>\n              <p className=\"text-[10px] text-indigo-600 dark:text-indigo-400 font-black uppercase tracking-widest leading-none mt-1\">Concursos AI</p>\n            </div>\n          </div>\n\n          {/* Navegação */}\n          <nav className=\"flex-1 px-4 py-4 space-y-2\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`\n                  w-full flex items-center gap-3 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all\n                  ${currentPage === item.id \n                    ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100 dark:shadow-none' \n                    : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100'}\n                `}\n              >\n                {item.icon}\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          {/* Rodapé da Sidebar com Switch de Tema */}\n          <div className=\"p-6 border-t border-slate-200 dark:border-slate-800 space-y-6\">\n            \n            {/* Seletor de Tema Segmentado */}\n            <div className=\"bg-slate-200 dark:bg-slate-950 p-1 rounded-2xl flex items-center border border-slate-300 dark:border-slate-800\">\n              <button\n                onClick={() => setIsDarkMode(false)}\n                className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${!isDarkMode ? 'bg-white text-indigo-600 shadow-md font-black' : 'text-slate-500 dark:text-slate-600 font-bold'}`}\n              >\n                <Sun size={18} />\n                <span className=\"text-xs\">Claro</span>\n              </button>\n              <button\n                onClick={() => setIsDarkMode(true)}\n                className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl transition-all ${isDarkMode ? 'bg-slate-800 text-indigo-400 shadow-md font-black border border-slate-700' : 'text-slate-500 dark:text-slate-600 font-bold'}`}\n              >\n                <Moon size={18} />\n                <span className=\"text-xs\">Escuro</span>\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-3 p-3 bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-800 transition-colors shadow-sm\">\n              <div className=\"w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-700 dark:text-indigo-400 text-sm font-black shrink-0\">\n                {user.name.charAt(0).toUpperCase()}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-bold text-slate-900 dark:text-slate-100 truncate leading-none\">{user.name}</p>\n                <p className=\"text-[10px] text-slate-500 dark:text-slate-500 truncate mt-1\">{user.email}</p>\n              </div>\n              <button\n                onClick={handleLogout}\n                className=\"p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/10 rounded-xl transition-all\"\n                title=\"Sair\"\n              >\n                <LogOut size={18} />\n              </button>\n            </div>\n          </div>\n        </div>\n      </aside>\n\n      {/* Área de Conteúdo - Branco no modo light e Azul Profundo no modo dark */}\n      <main className=\"flex-1 md:ml-72 overflow-y-auto bg-white dark:bg-slate-950 transition-colors duration-500\">\n        <div className=\"max-w-6xl mx-auto p-6 md:p-12\">\n          {renderPage()}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        }
      ]
    },
