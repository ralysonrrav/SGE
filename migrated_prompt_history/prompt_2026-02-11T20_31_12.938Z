          "description": "Fix type overlap error in role comparison by casting to any to handle potential 'admin' role string from database.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useMemo } from 'react';\nimport { User, PredefinedEdital, Subject, Topic } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { \n  Trash2, Edit3, X, Save, Search, User as UserIcon, Loader2, \n  Plus, UserPlus, ShieldCheck, ShieldAlert, CheckCircle2, Ban,\n  FileText, Database, Calendar, Globe, Power, AlertTriangle, UserCheck,\n  ShieldX, Trash, HardDrive, Sparkles, Mail, Zap, Activity, RefreshCw\n} from 'lucide-react';\n\ninterface AdminProps {\n  user: User;\n  users: User[];\n  setUsers: React.Dispatch<React.SetStateAction<User[]>>;\n  editais: PredefinedEdital[];\n  setEditais: React.Dispatch<React.SetStateAction<PredefinedEdital[]>>;\n  view: 'users' | 'editais';\n}\n\nconst Admin: React.FC<AdminProps> = ({ user, users, setUsers, editais, setEditais, view }) => {\n  // Fix: Added 'as any' to allow comparison with legacy 'admin' role string from database.\n  if (user.role !== 'administrator' && (user.role as any) !== 'admin') {\n    return (\n      <div className=\"h-full flex flex-col items-center justify-center p-10\">\n        <div className=\"w-20 h-20 bg-rose-500/10 text-rose-500 rounded-3xl flex items-center justify-center mb-6\"><Ban size={40} /></div>\n        <h2 className=\"text-2xl font-black text-white uppercase tracking-tighter\">ACESSO NEGADO</h2>\n      </div>\n    );\n  }\n\n  const [searchTerm, setSearchTerm] = useState('');\n  const [loadingId, setLoadingId] = useState<string | null>(null);\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  \n  // States para Usuários\n  const [isUserModalOpen, setIsUserModalOpen] = useState(false);\n  const [editingUser, setEditingUser] = useState<User | null>(null);\n  const [editUserName, setEditUserName] = useState('');\n  const [editUserRole, setEditUserRole] = useState<'admin' | 'student' | 'visitor'>('student');\n  const [editUserStatus, setEditUserStatus] = useState<'active' | 'blocked' | 'suspended'>('active');\n\n  // Modal de Purga (Exclusão Total)\n  const [showConfirmDelete, setShowConfirmDelete] = useState(false);\n  const [userToPurge, setUserToPurge] = useState<User | null>(null);\n\n  const refreshUsers = async () => {\n    if (!supabase) return;\n    setIsRefreshing(true);\n    try {\n      const { data } = await supabase.from('profiles').select('*').order('name');\n      if (data) setUsers(data.map(p => ({ ...p, id: String(p.id), lastAccess: p.last_seen })));\n    } finally {\n      setIsRefreshing(false);\n    }\n  };\n\n  const handleSaveUser = async () => {\n    if (!editingUser || !supabase) return;\n    setLoadingId(editingUser.id);\n    try {\n      const { error } = await supabase\n        .from('profiles')\n        .update({ \n          name: editUserName, \n          role: editUserRole, \n          status: editUserStatus \n        })\n        .eq('id', editingUser.id);\n\n      if (error) throw error;\n      \n      setUsers(prev => prev.map(u => u.id === editingUser.id ? { \n        ...u, \n        name: editUserName, \n        role: editUserRole as any, \n        status: editUserStatus as any \n      } : u));\n      setIsUserModalOpen(false);\n    } catch (e: any) {\n      alert(`Erro: ${e.message || \"Falha ao atualizar operador.\"}`);\n    } finally {\n      setLoadingId(null);\n    }\n  };\n\n  const handlePurgeUser = async () => {\n    if (!userToPurge || !supabase) return;\n    setLoadingId(userToPurge.id);\n    try {\n      // Deletar da tabela profiles dispara o CASCADE no banco se o SQL de blindagem foi executado\n      const { error } = await supabase.from('profiles').delete().eq('id', userToPurge.id);\n      \n      if (error) {\n        // Se der erro de FK, explicamos ao usuário que o script SQL ainda é necessário\n        if (error.code === '23503') {\n          throw new Error(\"Não foi possível excluir. Existem dados vinculados sem regra de CASCADE. Execute o script SQL de blindagem no painel do Supabase.\");\n        }\n        throw error;\n      }\n\n      setUsers(prev => prev.filter(u => u.id !== userToPurge.id));\n      setShowConfirmDelete(false);\n      setUserToPurge(null);\n    } catch (e: any) {\n      alert(e.message);\n    } finally {\n      setLoadingId(null);\n    }\n  };\n\n  const filteredUsers = useMemo(() => \n    users.filter(u => \n      u.name?.toLowerCase().includes(searchTerm.toLowerCase()) || \n      u.email?.toLowerCase().includes(searchTerm.toLowerCase())\n    ), [users, searchTerm]\n  );\n\n  const getStatusBadge = (status: string) => {\n    switch (status) {\n      case 'active':\n        return <span className=\"bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 px-3 py-1 rounded-lg text-[8px] font-black uppercase tracking-widest flex items-center gap-2\"><CheckCircle2 size={10}/> ATIVO</span>;\n      case 'blocked':\n        return <span className=\"bg-rose-500/10 border border-rose-500/20 text-rose-500 px-3 py-1 rounded-lg text-[8px] font-black uppercase tracking-widest flex items-center gap-2\"><Ban size={10}/> BLOQUEADO</span>;\n      case 'suspended':\n        return <span className=\"bg-amber-500/10 border border-amber-500/20 text-amber-500 px-3 py-1 rounded-lg text-[8px] font-black uppercase tracking-widest flex items-center gap-2\"><AlertTriangle size={10}/> SUSPENSO</span>;\n      default:\n        return <span className=\"bg-slate-500/10 border border-slate-500/20 text-slate-500 px-3 py-1 rounded-lg text-[8px] font-black uppercase tracking-widest\">OFFLINE</span>;\n    }\n  };\n\n  if (view === 'editais') {\n    return (\n      <div className=\"space-y-8 animate-in fade-in duration-500\">\n        <header className=\"flex justify-between items-end\">\n          <div>\n            <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase leading-none\">CORE EDITAIS</h2>\n            <p className=\"text-slate-500 font-bold mt-3 text-[10px] uppercase tracking-[0.4em]\">Gestão de Matrizes de Certames</p>\n          </div>\n          <button className=\"bg-indigo-600 text-white px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest hover:bg-indigo-500 transition-all shadow-xl\">\n            <Plus size={16} className=\"inline mr-2\" /> NOVA MATRIZ\n          </button>\n        </header>\n        <div className=\"p-20 text-center glass-card rounded-[3rem] border-dashed border-white/5 opacity-50\">\n           <Database size={48} className=\"mx-auto text-slate-800 mb-4\" />\n           <p className=\"text-slate-500 font-black text-[10px] uppercase tracking-widest italic\">Módulo de Sincronização Ativo</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-700\">\n      <header className=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n        <div>\n          <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase leading-none\">GOVERNANÇA</h2>\n          <p className=\"text-slate-500 font-bold mt-3 text-[10px] uppercase tracking-[0.4em]\">Controle Central de Operadores</p>\n        </div>\n        <div className=\"flex gap-3\">\n          <div className=\"relative w-64\">\n            <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-500\" size={14}/>\n            <input \n              type=\"text\" \n              placeholder=\"PESQUISAR...\" \n              className=\"w-full pl-12 pr-6 py-4 bg-black/40 border border-white/5 rounded-2xl outline-none focus:border-indigo-500 font-black text-white text-[10px] tracking-widest uppercase transition-all\" \n              value={searchTerm} \n              onChange={(e) => setSearchTerm(e.target.value)} \n            />\n          </div>\n          <button \n            onClick={refreshUsers} \n            disabled={isRefreshing}\n            className=\"p-4 bg-white/5 border border-white/5 text-indigo-400 rounded-2xl hover:bg-white/10 transition-all active:scale-95 disabled:opacity-50\"\n          >\n            <RefreshCw size={20} className={isRefreshing ? 'animate-spin' : ''} />\n          </button>\n        </div>\n      </header>\n\n      <div className=\"glass-card rounded-[2.5rem] overflow-hidden border border-white/5 shadow-2xl\">\n        <table className=\"w-full text-left\">\n          <thead className=\"bg-white/5 border-b border-white/5\">\n            <tr>\n              <th className=\"px-10 py-7 text-[9px] font-black uppercase text-slate-500 tracking-widest\">OPERADOR / UUID</th>\n              <th className=\"px-10 py-7 text-[9px] font-black uppercase text-slate-500 tracking-widest\">NÍVEL</th>\n              <th className=\"px-10 py-7 text-[9px] font-black uppercase text-slate-500 tracking-widest\">SITUAÇÃO</th>\n              <th className=\"px-10 py-7 text-[9px] font-black uppercase text-slate-500 tracking-widest\">SINAL</th>\n              <th className=\"px-10 py-7 text-[9px] font-black uppercase text-slate-500 tracking-widest text-right\">COMANDOS</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-white/5\">\n            {filteredUsers.map(u => (\n              <tr key={u.id} className=\"hover:bg-white/[0.02] transition-all group\">\n                <td className=\"px-10 py-6\">\n                  <div className=\"flex items-center gap-5\">\n                    <div className=\"w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-black shadow-inner\">\n                      {u.name?.charAt(0).toUpperCase()}\n                    </div>\n                    <div>\n                      <p className=\"text-sm font-black text-white uppercase tracking-tight\">{u.name}</p>\n                      <p className=\"text-[9px] text-slate-600 font-bold lowercase mt-0.5\">{u.email}</p>\n                      <p className=\"text-[7px] font-black text-slate-800 uppercase tracking-tighter mt-1\">ID: {u.id.substring(0,8)}...</p>\n                    </div>\n                  </div>\n                </td>\n                <td className=\"px-10 py-6\">\n                  <span className={`px-3 py-1.5 rounded-lg text-[8px] font-black uppercase border tracking-widest ${u.role === 'administrator' || (u.role as any) === 'admin' ? 'bg-indigo-600/10 border-indigo-500/20 text-indigo-400' : 'bg-slate-500/10 border-slate-500/20 text-slate-400'}`}>\n                    {/* Fix: Added type cast to allow checking against 'admin' from database. */}\n                    {(u.role as any) === 'admin' || u.role === 'administrator' ? 'ADMIN' : u.role.toUpperCase()}\n                  </span>\n                </td>\n                <td className=\"px-10 py-6\">\n                  {getStatusBadge(u.status || 'active')}\n                </td>\n                <td className=\"px-10 py-6\">\n                   <div className=\"flex items-center gap-2\">\n                      <div className={`w-2 h-2 rounded-full ${u.isOnline ? 'bg-indigo-500 pulse-ring' : 'bg-slate-800'}`} />\n                      <span className={`text-[8px] font-black uppercase tracking-widest ${u.isOnline ? 'text-indigo-500' : 'text-slate-700'}`}>\n                        {u.isOnline ? 'ESTAÇÃO ONLINE' : 'OFFLINE'}\n                      </span>\n                   </div>\n                </td>\n                <td className=\"px-10 py-6 text-right\">\n                  <div className=\"flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0\">\n                    <button \n                      onClick={() => { setEditingUser(u); setEditUserName(u.name); setEditUserRole(u.role as any); setEditUserStatus(u.status as any || 'active'); setIsUserModalOpen(true); }} \n                      className=\"p-3 bg-white/5 border border-white/5 text-slate-400 hover:text-indigo-400 rounded-xl transition-all\"\n                    >\n                      <Edit3 size={16}/>\n                    </button>\n                    <button \n                      onClick={() => { setUserToPurge(u); setShowConfirmDelete(true); }} \n                      disabled={u.id === user.id || loadingId === u.id}\n                      className={`p-3 bg-white/5 border border-white/5 text-slate-400 hover:text-rose-500 rounded-xl transition-all ${u.id === user.id ? 'opacity-20 cursor-not-allowed' : ''}`}\n                    >\n                      {loadingId === u.id ? <Loader2 size={16} className=\"animate-spin\" /> : <Trash2 size={16}/>}\n                    </button>\n                  </div>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n\n      {/* MODAL DE PURGA CRÍTICA */}\n      {showConfirmDelete && userToPurge && (\n        <div className=\"fixed inset-0 z-[200] flex items-center justify-center p-6 bg-slate-950/95 backdrop-blur-2xl animate-in fade-in\">\n          <div className=\"glass-card w-full max-w-lg rounded-[3.5rem] p-12 border border-rose-500/30 shadow-[0_0_80px_rgba(244,63,94,0.15)] relative overflow-hidden\">\n             <div className=\"absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-transparent via-rose-500 to-transparent\"></div>\n             \n             <div className=\"text-center mb-10\">\n                <div className=\"w-20 h-20 bg-rose-500/10 text-rose-500 rounded-[2.5rem] border border-rose-500/20 flex items-center justify-center mx-auto mb-8 animate-pulse\">\n                   <ShieldX size={44} />\n                </div>\n                <h3 className=\"text-3xl font-black text-white uppercase tracking-tighter mb-4\">PROTOCOLO DE PURGA</h3>\n                <p className=\"text-slate-400 text-[11px] font-bold leading-relaxed uppercase tracking-widest mb-6\">\n                  ALERTA: ESTA OPERAÇÃO É IRREVERSÍVEL E LIMPARÁ O BANCO DE DADOS FISICAMENTE.\n                </p>\n                <div className=\"p-8 bg-black/40 rounded-[2rem] border border-white/5\">\n                   <p className=\"text-white font-black text-xl uppercase tracking-tight\">{userToPurge.name}</p>\n                   <p className=\"text-slate-500 text-[10px] font-black lowercase mt-1\">{userToPurge.email}</p>\n                </div>\n             </div>\n\n             <div className=\"space-y-4 mb-10\">\n                <div className=\"flex items-center gap-4 p-5 bg-rose-500/5 rounded-2xl border border-rose-500/10\">\n                   <HardDrive className=\"text-rose-500 shrink-0\" size={20} />\n                   <p className=\"text-[10px] font-black text-rose-400 uppercase tracking-widest leading-relaxed\">\n                     LÓGICA CASCADE: O SUPABASE APAGARÁ AUTOMATICAMENTE TODOS OS LOGS, CICLOS E MATÉRIAS.\n                   </p>\n                </div>\n                <div className=\"flex items-center gap-4 p-5 bg-emerald-500/5 rounded-2xl border border-emerald-500/10\">\n                   <Sparkles className=\"text-emerald-500 shrink-0\" size={20} />\n                   <p className=\"text-[10px] font-black text-emerald-500 uppercase tracking-widest leading-relaxed\">\n                     INTEGRIDADE: ESTA AÇÃO LIBERA STORAGE E OTIMIZA A PERFORMANCE DAS CONSULTAS.\n                   </p>\n                </div>\n             </div>\n\n             <div className=\"flex flex-col gap-4\">\n                <button \n                  onClick={handlePurgeUser} \n                  disabled={!!loadingId}\n                  className=\"w-full bg-rose-600 text-white p-6 rounded-[2rem] font-black text-[11px] uppercase tracking-widest hover:bg-rose-500 transition-all flex justify-center items-center gap-3 shadow-xl active:scale-95\"\n                >\n                  {loadingId === userToPurge.id ? (\n                    <><Loader2 className=\"animate-spin\" size={20} /> EXECUTANDO LIMPEZA...</>\n                  ) : (\n                    <>CONFIRMAR DESTRUIÇÃO TOTAL</>\n                  )}\n                </button>\n                <button onClick={() => setShowConfirmDelete(false)} className=\"py-4 text-[10px] font-black text-slate-500 uppercase tracking-[0.4em] hover:text-white transition-colors\">ABORTAR MISSÃO</button>\n             </div>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL DE EDIÇÃO */}\n      {isUserModalOpen && editingUser && (\n        <div className=\"fixed inset-0 z-[150] flex items-center justify-center p-6 bg-slate-950/90 backdrop-blur-xl animate-in fade-in\">\n          <div className=\"glass-card w-full max-w-md rounded-[3rem] p-12 border border-white/10 shadow-2xl relative\">\n            <div className=\"flex justify-between items-center mb-10\">\n              <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter\">EDITAR OPERADOR</h3>\n              <button onClick={() => setIsUserModalOpen(false)} className=\"p-2 text-slate-500 hover:text-white transition-colors\"><X size={32}/></button>\n            </div>\n            <div className=\"space-y-6\">\n              <div className=\"space-y-2\">\n                <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">NOME DE EXIBIÇÃO</label>\n                <input value={editUserName} onChange={e=>setEditUserName(e.target.value)} className=\"w-full px-6 py-4 bg-black/40 border border-white/5 rounded-2xl text-white text-xs outline-none focus:border-indigo-500 font-black uppercase tracking-widest\" />\n              </div>\n              <div className=\"space-y-2\">\n                <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">NÍVEL DE ACESSO</label>\n                <select value={editUserRole} onChange={e=>setEditUserRole(e.target.value as any)} className=\"w-full px-6 py-4 bg-black/40 border border-white/5 rounded-2xl text-white text-xs outline-none font-black uppercase tracking-widest\">\n                  <option value=\"student\">STUDENT (OPERADOR)</option>\n                  <option value=\"admin\">ADMIN (CORE)</option>\n                  <option value=\"visitor\">VISITOR (CONSULTA)</option>\n                </select>\n              </div>\n              <div className=\"space-y-2\">\n                <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">STATUS DO TERMINAL</label>\n                <select value={editUserStatus} onChange={e=>setEditUserStatus(e.target.value as any)} className=\"w-full px-6 py-4 bg-black/40 border border-white/5 rounded-2xl text-white text-xs outline-none font-black uppercase tracking-widest\">\n                  <option value=\"active\">ACTIVE (LIBERADO)</option>\n                  <option value=\"suspended\">SUSPENDED (AVISO)</option>\n                  <option value=\"blocked\">BLOCKED (REVOGADO)</option>\n                </select>\n              </div>\n              <button onClick={handleSaveUser} className=\"w-full bg-indigo-600 text-white p-5 rounded-2xl font-black text-[11px] uppercase tracking-widest hover:bg-indigo-500 transition-all flex justify-center items-center gap-3 mt-6 shadow-xl active:scale-95\">\n                <UserCheck size={20}/> SALVAR OPERADOR\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Admin;\n"
            }
          ]
        }
      ]
    },
