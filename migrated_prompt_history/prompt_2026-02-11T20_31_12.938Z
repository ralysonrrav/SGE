  },
  {
    "id": 627,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação de limpeza de registros (Reset) em cada tópico, permitindo zerar estatísticas de estudo e questões com um alerta de confirmação inteligente.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useCallback, useRef, useEffect } from 'react';\nimport { Subject, Topic, PredefinedEdital, User } from '../types';\nimport { supabase, isNetworkError } from '../lib/supabase';\nimport { \n  Plus, Trash2, ChevronDown, ChevronUp, CheckCircle, TrendingUp, Save, Clock, Calendar, X, DownloadCloud, Target, BarChart, AlertTriangle, Activity, Edit3, Check, RotateCcw\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  user: User;\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  predefinedEditais: PredefinedEdital[];\n  onAddLog: (minutes: number, topicId: string, subjectId: string, date: string) => void;\n}\n\ninterface DeleteConfirmation {\n  type: 'subject' | 'topic';\n  id: string;\n  parentId?: string;\n  label: string;\n}\n\ninterface ResetConfirmation {\n  topicId: string;\n  subjectId: string;\n  label: string;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ user, subjects, setSubjects, predefinedEditais, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [activeProgressTopic, setActiveProgressTopic] = useState<string | null>(null);\n  const [isSyncing, setIsSyncing] = useState<string | null>(null);\n  const [showCatalog, setShowCatalog] = useState(false);\n  const [deleteConfirmation, setDeleteConfirmation] = useState<DeleteConfirmation | null>(null);\n  const [resetConfirmation, setResetConfirmation] = useState<ResetConfirmation | null>(null);\n\n  // Estados de Edição\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [tempEditText, setTempEditText] = useState('');\n  const editInputRef = useRef<HTMLInputElement>(null);\n\n  // Modal Progress State\n  const [progDate, setProgDate] = useState<string>(new Date().toISOString().split('T')[0]);\n  const [progHours, setProgHours] = useState<number>(0);\n  const [progMinutes, setProgMinutes] = useState<number>(0);\n  const [progAttempted, setProgAttempted] = useState<number>(0);\n  const [progCorrect, setProgCorrect] = useState<number>(0);\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  // Focar no input ao iniciar edição\n  useEffect(() => {\n    if ((editingSubjectId || editingTopicId) && editInputRef.current) {\n      editInputRef.current.focus();\n    }\n  }, [editingSubjectId, editingTopicId]);\n\n  const handleSubjectUpdate = useCallback(async (subjectId: string, updatedTopics: Topic[], newName?: string) => {\n    const sId = String(subjectId);\n    setSubjects(prev => {\n      return prev.map(s => String(s.id) === sId ? { \n        ...s, \n        topics: updatedTopics,\n        name: newName !== undefined ? newName : s.name \n      } : s);\n    });\n\n    if (supabase && !sId.startsWith('local-') && !sId.startsWith('imported-')) {\n      setIsSyncing(sId);\n      try { \n        const updatePayload: any = { topics: updatedTopics };\n        if (newName !== undefined) updatePayload.name = newName;\n        \n        await supabase.from('subjects').update(updatePayload).eq('id', sId).eq('user_id', user.id);\n      } catch (err: any) { \n        if (!isNetworkError(err)) console.error(\"Database Sync Failed:\", err);\n      } finally { setIsSyncing(null); }\n    }\n  }, [setSubjects, user]);\n\n  const addSubject = async () => {\n    if (!newSubjectName.trim()) return;\n    const tempId = `local-${Date.now()}`;\n    const newSub: Subject = { id: tempId, name: newSubjectName.trim(), topics: [], color: colors[subjects.length % colors.length] };\n    \n    setSubjects(prev => [...prev, newSub]);\n    setNewSubjectName('');\n\n    if (supabase && user.role !== 'visitor') {\n      try {\n        const { data } = await supabase.from('subjects').insert([{ \n          name: newSub.name, \n          topics: [], \n          user_id: user.id,\n          color: newSub.color\n        }]).select().single();\n        if (data) setSubjects(prev => prev.map(s => s.id === tempId ? { ...s, id: String(data.id) } : s));\n      } catch (e) {}\n    }\n  };\n\n  const executeDelete = async () => {\n    if (!deleteConfirmation) return;\n\n    if (deleteConfirmation.type === 'subject') {\n      const sId = deleteConfirmation.id;\n      setSubjects(prev => prev.filter(s => String(s.id) !== sId));\n      if (supabase && !sId.startsWith('local-') && !sId.startsWith('imported-')) {\n        try {\n          await supabase.from('subjects').delete().eq('id', sId).eq('user_id', user.id);\n        } catch (err) { console.error(err); }\n      }\n    } else if (deleteConfirmation.type === 'topic' && deleteConfirmation.parentId) {\n      const subId = deleteConfirmation.parentId;\n      const topicId = deleteConfirmation.id;\n      const sub = subjects.find(s => String(s.id) === subId);\n      if (sub) {\n        const next = sub.topics.filter(t => String(t.id) !== String(topicId));\n        await handleSubjectUpdate(subId, next);\n      }\n    }\n\n    setDeleteConfirmation(null);\n  };\n\n  const executeReset = async () => {\n    if (!resetConfirmation) return;\n    const { subjectId, topicId } = resetConfirmation;\n    const sub = subjects.find(s => String(s.id) === subjectId);\n    \n    if (sub) {\n      const next = sub.topics.map(t => String(t.id) === topicId ? { \n        ...t, \n        studyTimeMinutes: 0, \n        questionsAttempted: 0, \n        questionsCorrect: 0, \n        lastStudiedAt: undefined,\n        revisionsDone: [],\n        completed: false\n      } : t);\n      await handleSubjectUpdate(subjectId, next);\n    }\n    setResetConfirmation(null);\n  };\n\n  const importFromCatalog = async (edital: PredefinedEdital) => {\n    const clonedSubjects: Subject[] = edital.subjects.map((sub, idx) => ({\n      ...sub,\n      id: `imported-${Date.now()}-${idx}`,\n      topics: sub.topics.map(topic => ({\n        ...topic,\n        id: `topic-${Math.random().toString(36).substr(2, 9)}`,\n        completed: false,\n        studyTimeMinutes: 0,\n        questionsAttempted: 0,\n        questionsCorrect: 0\n      }))\n    }));\n\n    setSubjects(prev => [...prev, ...clonedSubjects]);\n    setShowCatalog(false);\n\n    if (supabase && user.role !== 'visitor') {\n      for (const sub of clonedSubjects) {\n        try {\n          await supabase.from('subjects').insert([{ name: sub.name, topics: sub.topics, color: sub.color, user_id: user.id }]);\n        } catch (e) {}\n      }\n    }\n  };\n\n  const toggleTopic = async (subId: string, topicId: string) => {\n    const sub = subjects.find(s => String(s.id) === String(subId));\n    if (!sub) return;\n    const next = sub.topics.map(t => String(t.id) === String(topicId) ? { ...t, completed: !t.completed } : t);\n    await handleSubjectUpdate(subId, next);\n  };\n\n  const saveTopicProgress = async (subId: string, topicId: string) => {\n    const sub = subjects.find(s => String(s.id) === String(subId));\n    if (!sub) return;\n    const totalMins = (progHours * 60) + (progMinutes || 0);\n    const targetDate = new Date(`${progDate}T12:00:00`).toISOString();\n\n    const next = sub.topics.map(t => String(t.id) === String(topicId) ? {\n      ...t, \n      studyTimeMinutes: (t.studyTimeMinutes || 0) + totalMins,\n      questionsAttempted: (t.questionsAttempted || 0) + progAttempted,\n      questionsCorrect: (t.questionsCorrect || 0) + progCorrect,\n      lastStudiedAt: targetDate\n    } : t);\n\n    if (totalMins > 0 || progAttempted > 0) onAddLog(totalMins, topicId, subId, targetDate);\n    \n    await handleSubjectUpdate(subId, next);\n    setActiveProgressTopic(null);\n  };\n\n  // Funções de Edição de Nome\n  const startEditingSubject = (e: React.MouseEvent, subject: Subject) => {\n    e.stopPropagation();\n    setEditingSubjectId(String(subject.id));\n    setTempEditText(subject.name);\n  };\n\n  const saveSubjectName = async (subjectId: string) => {\n    if (!tempEditText.trim()) return;\n    const sub = subjects.find(s => String(s.id) === subjectId);\n    if (sub) {\n      await handleSubjectUpdate(subjectId, sub.topics, tempEditText.trim());\n    }\n    setEditingSubjectId(null);\n  };\n\n  const startEditingTopic = (topic: Topic) => {\n    setEditingTopicId(topic.id);\n    setTempEditText(topic.title);\n  };\n\n  const saveTopicName = async (subjectId: string, topicId: string) => {\n    if (!tempEditText.trim()) return;\n    const sub = subjects.find(s => String(s.id) === subjectId);\n    if (sub) {\n      const next = sub.topics.map(t => String(t.id) === topicId ? { ...t, title: tempEditText.trim() } : t);\n      await handleSubjectUpdate(subjectId, next);\n    }\n    setEditingTopicId(null);\n  };\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n        <div>\n          <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase\">QUESTS ATIVAS</h2>\n          <p className=\"text-slate-500 font-bold mt-2 text-[10px] uppercase tracking-[0.4em]\">Gerenciamento de Missões por Disciplina</p>\n        </div>\n        <div className=\"flex gap-4\">\n          <button onClick={() => setShowCatalog(!showCatalog)} className=\"flex items-center gap-2 px-6 py-4 rounded-xl font-black text-[10px] uppercase tracking-widest bg-white/5 border border-white/10 hover:bg-white/10 transition-all\">\n            {showCatalog ? <X size={16} /> : <DownloadCloud size={16} />}\n            CATÁLOGO MESTRE\n          </button>\n          <div className=\"hidden md:flex gap-2\">\n            <input type=\"text\" placeholder=\"NOVA MATÉRIA...\" className=\"px-6 py-4 rounded-xl border border-white/10 bg-black/40 text-white font-black text-[10px] tracking-widest uppercase outline-none focus:border-indigo-500 w-64\" value={newSubjectName} onChange={(e) => setNewSubjectName(e.target.value)} />\n            <button onClick={addSubject} className=\"bg-indigo-600 text-white p-4 rounded-xl hover:bg-indigo-500 transition-all shadow-xl active:scale-95\"><Plus size={20} /></button>\n          </div>\n        </div>\n      </header>\n\n      {showCatalog && (\n        <div className=\"glass-card p-10 rounded-[2.5rem] animate-in slide-in-from-top-6 duration-500\">\n          <h3 className=\"text-sm font-black text-white uppercase tracking-widest mb-8\">CATÁLOGO DE MATRIZES</h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {predefinedEditais.map(edital => (\n              <div key={edital.id} className=\"bg-black/40 p-8 rounded-3xl border border-white/5 hover:border-indigo-500/50 transition-all group\">\n                <h4 className=\"font-black text-white mb-2\">{edital.name}</h4>\n                <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mb-6\">{edital.organization}</p>\n                <button onClick={() => importFromCatalog(edital)} className=\"w-full bg-indigo-600 text-white py-3 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-indigo-500 transition-all\">IMPORTAR</button>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      <div className=\"grid grid-cols-1 gap-4\">\n        {subjects.map(sub => {\n          const total = sub.topics.length;\n          const done = sub.topics.filter(t => t.completed).length;\n          const isExp = expandedSubject === String(sub.id);\n          const perc = total > 0 ? Math.round((done / total) * 100) : 0;\n          const isEditing = editingSubjectId === String(sub.id);\n\n          return (\n            <div key={sub.id} className={`glass-card rounded-[2rem] border border-white/5 overflow-hidden transition-all duration-500 ${isExp ? 'ring-2 ring-indigo-500/30' : ''}`}>\n              <div className=\"p-8 flex items-center justify-between cursor-pointer\" onClick={() => !isEditing && setExpandedSubject(isExp ? null : String(sub.id))}>\n                <div className=\"flex items-center gap-6 flex-1\">\n                  <div className=\"w-1.5 h-12 rounded-full\" style={{ backgroundColor: sub.color }} />\n                  <div className=\"flex-1\">\n                    {isEditing ? (\n                      <div className=\"flex items-center gap-3\" onClick={e => e.stopPropagation()}>\n                        <input \n                          ref={editInputRef}\n                          className=\"bg-black/40 border border-indigo-500/50 px-4 py-2 rounded-lg text-lg font-black text-white uppercase tracking-tight outline-none w-full max-w-md\"\n                          value={tempEditText}\n                          onChange={e => setTempEditText(e.target.value)}\n                          onKeyDown={e => {\n                            if (e.key === 'Enter') saveSubjectName(String(sub.id));\n                            if (e.key === 'Escape') setEditingSubjectId(null);\n                          }}\n                        />\n                        <button onClick={() => saveSubjectName(String(sub.id))} className=\"p-2 text-emerald-500 hover:text-emerald-400\"><Check size={20}/></button>\n                        <button onClick={() => setEditingSubjectId(null)} className=\"p-2 text-rose-500 hover:text-rose-400\"><X size={20}/></button>\n                      </div>\n                    ) : (\n                      <div className=\"flex items-center gap-3 group/title\">\n                        <h3 className=\"font-black text-lg text-white tracking-tight uppercase\">{sub.name}</h3>\n                        <button \n                          onClick={(e) => startEditingSubject(e, sub)}\n                          className=\"opacity-0 group-hover/title:opacity-100 p-1.5 text-slate-500 hover:text-indigo-400 transition-all\"\n                        >\n                          <Edit3 size={14} />\n                        </button>\n                      </div>\n                    )}\n                    <div className=\"flex items-center gap-3 mt-1.5\">\n                       <div className=\"w-32 h-1 bg-slate-900 rounded-full overflow-hidden\">\n                          <div className=\"h-full transition-all duration-1000\" style={{ backgroundColor: sub.color, width: `${perc}%` }} />\n                       </div>\n                       <span className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest\">{done}/{total} COMPLETO</span>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-4\">\n                  <button \n                    onClick={(e) => {\n                      e.stopPropagation();\n                      setDeleteConfirmation({ type: 'subject', id: String(sub.id), label: sub.name });\n                    }} \n                    className=\"p-2 text-slate-500 hover:text-rose-500 transition-all\"\n                  >\n                    <Trash2 size={18} />\n                  </button>\n                  <div className={`p-2 rounded-lg transition-all ${isExp ? 'bg-indigo-600 text-white' : 'text-slate-500'}`}>\n                    {isExp ? <ChevronUp size={20} /> : <ChevronDown size={20} />}\n                  </div>\n                </div>\n              </div>\n\n              {isExp && (\n                <div className=\"px-10 pb-10 pt-4 border-t border-white/5 space-y-4 animate-in slide-in-from-top-4\">\n                  <div className=\"flex gap-2 mb-4\">\n                    <input type=\"text\" placeholder=\"ADICIONAR NOVA TASK...\" className=\"flex-1 px-5 py-4 rounded-xl bg-black/40 border border-white/5 text-white font-black text-[10px] tracking-widest uppercase outline-none focus:border-indigo-500 transition-all\" value={newTopicTitle} onChange={(e) => setNewTopicTitle(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && (async () => {\n                        const nt: Topic = { id: `topic-${Date.now()}`, title: newTopicTitle.trim(), completed: false, importance: 3, studyTimeMinutes: 0, questionsAttempted: 0, questionsCorrect: 0 };\n                        await handleSubjectUpdate(String(sub.id), [...sub.topics, nt]);\n                        setNewTopicTitle('');\n                      })()} />\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    {sub.topics.map(topic => {\n                      const correctPerc = topic.questionsAttempted && topic.questionsAttempted > 0 \n                        ? Math.round((topic.questionsCorrect! / topic.questionsAttempted!) * 100) \n                        : null;\n                      const isEditingTopic = editingTopicId === topic.id;\n\n                      return (\n                        <div key={topic.id} className=\"flex flex-col gap-4 p-6 bg-black/30 rounded-3xl border border-white/5 group hover:border-indigo-500/30 transition-all\">\n                          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                            <div className=\"flex items-center gap-4 flex-1\">\n                              <button onClick={() => toggleTopic(String(sub.id), topic.id)} className={`transition-all ${topic.completed ? 'text-indigo-500' : 'text-slate-700 hover:text-indigo-400'}`}>\n                                <CheckCircle size={24} strokeWidth={3} />\n                              </button>\n                              <div className=\"flex-1\">\n                                {isEditingTopic ? (\n                                  <div className=\"flex items-center gap-3\">\n                                    <input \n                                      ref={editInputRef}\n                                      className=\"bg-black/40 border border-indigo-500/50 px-4 py-1.5 rounded-lg text-[11px] font-black text-white uppercase tracking-widest outline-none w-full\"\n                                      value={tempEditText}\n                                      onChange={e => setTempEditText(e.target.value)}\n                                      onKeyDown={e => {\n                                        if (e.key === 'Enter') saveTopicName(String(sub.id), topic.id);\n                                        if (e.key === 'Escape') setEditingTopicId(null);\n                                      }}\n                                    />\n                                    <button onClick={() => saveTopicName(String(sub.id), topic.id)} className=\"p-1 text-emerald-500\"><Check size={16}/></button>\n                                    <button onClick={() => setEditingTopicId(null)} className=\"p-1 text-rose-500\"><X size={16}/></button>\n                                  </div>\n                                ) : (\n                                  <div className=\"flex items-center gap-3 group/topicTitle\">\n                                    <span className={`text-[11px] font-black uppercase tracking-widest ${topic.completed ? 'text-slate-600 line-through' : 'text-white'}`}>\n                                      {topic.title}\n                                    </span>\n                                    {!topic.completed && (\n                                      <button \n                                        onClick={() => startEditingTopic(topic)}\n                                        className=\"opacity-0 group-hover/topicTitle:opacity-100 p-1 text-slate-600 hover:text-indigo-400 transition-all\"\n                                      >\n                                        <Edit3 size={12} />\n                                      </button>\n                                    )}\n                                  </div>\n                                )}\n                                \n                                {/* TOPIC QUICK VIEW HUD */}\n                                <div className=\"flex flex-wrap gap-2 mt-2.5\">\n                                  <div className=\"flex items-center gap-1.5 px-2 py-1 bg-white/5 rounded-md border border-white/5 text-[8px] font-black text-indigo-400 uppercase tracking-widest\">\n                                    <Clock size={10} /> {topic.studyTimeMinutes || 0}m\n                                  </div>\n                                  \n                                  {topic.lastStudiedAt && (\n                                    <div className=\"flex items-center gap-1.5 px-2 py-1 bg-white/5 rounded-md border border-white/5 text-[8px] font-black text-slate-500 uppercase tracking-widest\">\n                                      <Calendar size={10} /> {new Date(topic.lastStudiedAt).toLocaleDateString('pt-BR')}\n                                    </div>\n                                  )}\n\n                                  <div className=\"flex items-center gap-1.5 px-2 py-1 bg-white/5 rounded-md border border-white/5 text-[8px] font-black text-emerald-500 uppercase tracking-widest\">\n                                    <Target size={10} /> Q: {topic.questionsAttempted || 0} / A: {topic.questionsCorrect || 0}\n                                  </div>\n\n                                  {correctPerc !== null && (\n                                    <div className={`flex items-center gap-1.5 px-2 py-1 rounded-md border text-[8px] font-black uppercase tracking-widest ${\n                                      correctPerc >= 80 ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' : \n                                      correctPerc >= 60 ? 'bg-amber-500/10 border-amber-500/20 text-amber-400' : \n                                      'bg-rose-500/10 border-rose-500/20 text-rose-400'\n                                    }`}>\n                                      <Activity size={10} /> {correctPerc}% EFICIÊNCIA\n                                    </div>\n                                  )}\n                                </div>\n                              </div>\n                            </div>\n\n                            <div className=\"flex items-center gap-3\">\n                               <button onClick={() => {\n                                 setProgHours(0);\n                                 setProgMinutes(0);\n                                 setProgAttempted(0);\n                                 setProgCorrect(0);\n                                 setActiveProgressTopic(topic.id);\n                               }} className=\"px-6 py-2.5 bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 rounded-xl text-[9px] font-black uppercase tracking-widest hover:bg-indigo-600 hover:text-white transition-all\">REGISTRAR SESSÃO</button>\n                               <div className=\"flex items-center gap-1.5\">\n                                 <button \n                                   onClick={() => setResetConfirmation({ topicId: String(topic.id), subjectId: String(sub.id), label: topic.title })}\n                                   className=\"p-2.5 text-slate-600 hover:text-amber-500 transition-colors bg-white/5 rounded-xl border border-white/5\"\n                                   title=\"Zerar registros do tópico\"\n                                 >\n                                   <RotateCcw size={16} />\n                                 </button>\n                                 <button \n                                   onClick={() => {\n                                     setDeleteConfirmation({ type: 'topic', id: String(topic.id), parentId: String(sub.id), label: topic.title });\n                                   }} \n                                   className=\"p-2.5 text-slate-600 hover:text-rose-500 transition-colors bg-white/5 rounded-xl border border-white/5\"\n                                   title=\"Deletar tópico\"\n                                 >\n                                  <Trash2 size={16} />\n                                </button>\n                               </div>\n                            </div>\n                          </div>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              );\n        })}\n      </div>\n\n      {activeProgressTopic && (\n        <div className=\"fixed inset-0 z-[120] flex items-center justify-center p-6 bg-slate-950/80 backdrop-blur-xl animate-in fade-in\">\n          <div className=\"glass-card w-full max-w-md rounded-[2.5rem] p-10 border border-white/10 shadow-indigo-500/20\">\n            <h3 className=\"text-xl font-black text-white mb-2 uppercase tracking-tighter\">CONSOLIDAR SESSÃO</h3>\n            <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mb-8\">Registro de Combate / Tópico</p>\n            <div className=\"space-y-6\">\n              <div className=\"space-y-2\">\n                <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">Data da Sessão</label>\n                <input type=\"date\" className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-black/40 text-white font-black text-sm outline-none focus:border-indigo-500 transition-all\" value={progDate} onChange={(e) => setProgDate(e.target.value)} />\n              </div>\n              <div className=\"space-y-2\">\n                <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">Tempo de Estudo Líquido</label>\n                <div className=\"grid grid-cols-2 gap-4\">\n                  <input type=\"number\" className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-black/40 text-white font-black text-lg outline-none focus:border-indigo-500 transition-all\" placeholder=\"Horas\" value={progHours || ''} onChange={e => setProgHours(parseInt(e.target.value) || 0)} />\n                  <input type=\"number\" className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-black/40 text-white font-black text-lg outline-none focus:border-indigo-500 transition-all\" placeholder=\"Mins\" value={progMinutes || ''} onChange={e => setProgMinutes(parseInt(e.target.value) || 0)} />\n                </div>\n              </div>\n              <div className=\"pt-4 border-t border-white/10 space-y-2\">\n                 <label className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest ml-1\">Performance em Questões</label>\n                 <div className=\"grid grid-cols-2 gap-4\">\n                    <input type=\"number\" className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-black/40 text-white font-black text-sm outline-none focus:border-indigo-500 transition-all\" placeholder=\"Total Resolvidas\" value={progAttempted || ''} onChange={e => setProgAttempted(parseInt(e.target.value) || 0)} />\n                    <input type=\"number\" className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-black/40 text-white font-black text-sm outline-none focus:border-emerald-500 transition-all\" placeholder=\"Acertos\" value={progCorrect || ''} onChange={e => setProgCorrect(parseInt(e.target.value) || 0)} />\n                 </div>\n              </div>\n            </div>\n            <button onClick={() => { const sId = subjects.find(s => s.topics.some(t => t.id === activeProgressTopic))?.id; if(sId) saveTopicProgress(sId, activeProgressTopic); }} className=\"w-full bg-indigo-600 text-white font-black py-5 rounded-2xl mt-10 hover:bg-indigo-500 transition-all uppercase text-[10px] tracking-widest shadow-xl shadow-indigo-900/20 active:scale-95\">SALVAR REGISTRO</button>\n            <button onClick={() => setActiveProgressTopic(null)} className=\"w-full mt-2 py-3 text-[9px] font-black text-slate-500 uppercase tracking-widest hover:text-white transition-colors\">CANCELAR</button>\n          </div>\n        </div>\n      )}\n\n      {/* INTELLIGENT CONFIRMATION MODAL (DELETE) */}\n      {deleteConfirmation && (\n        <div className=\"fixed inset-0 z-[200] flex items-center justify-center p-6 bg-slate-950/90 backdrop-blur-2xl animate-in fade-in duration-300\">\n          <div className=\"glass-card w-full max-w-md rounded-[3rem] p-12 border border-rose-500/20 shadow-[0_0_50px_rgba(244,63,94,0.1)] text-center scale-up-center\">\n            <div className=\"w-20 h-20 bg-rose-500/10 text-rose-500 rounded-[2.5rem] flex items-center justify-center mx-auto mb-8 border border-rose-500/20 animate-pulse\">\n              <AlertTriangle size={40} />\n            </div>\n            \n            <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter mb-4\">\n              {deleteConfirmation.type === 'subject' ? 'DELETAR DISCIPLINA?' : 'DELETAR TÓPICO?'}\n            </h3>\n            \n            <p className=\"text-slate-400 text-xs font-bold leading-relaxed mb-10 uppercase tracking-wide px-4\">\n              Você está prestes a remover <span className=\"text-rose-400\">\"{deleteConfirmation.label}\"</span>. \n              Esta ação é irreversível e apagará todo o histórico de estudo associado.\n            </p>\n\n            <div className=\"flex flex-col gap-4\">\n              <button \n                onClick={executeDelete}\n                className=\"w-full bg-rose-600 text-white font-black py-5 rounded-2xl text-[10px] tracking-[0.2em] hover:bg-rose-500 transition-all shadow-xl shadow-rose-950/30 active:scale-95 uppercase\"\n              >\n                CONFIRMAR EXCLUSÃO\n              </button>\n              \n              <button \n                onClick={() => setDeleteConfirmation(null)}\n                className=\"w-full py-4 text-[9px] font-black text-slate-500 uppercase tracking-[0.3em] hover:text-white transition-colors\"\n              >\n                ABORTAR AÇÃO\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* INTELLIGENT CONFIRMATION MODAL (RESET) */}\n      {resetConfirmation && (\n        <div className=\"fixed inset-0 z-[200] flex items-center justify-center p-6 bg-slate-950/90 backdrop-blur-2xl animate-in fade-in duration-300\">\n          <div className=\"glass-card w-full max-w-md rounded-[3rem] p-12 border border-amber-500/20 shadow-[0_0_50px_rgba(245,158,11,0.1)] text-center scale-up-center\">\n            <div className=\"w-20 h-20 bg-amber-500/10 text-amber-500 rounded-[2.5rem] flex items-center justify-center mx-auto mb-8 border border-amber-500/20\">\n              <RotateCcw size={40} />\n            </div>\n            \n            <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter mb-4\">\n              ZERAR REGISTROS?\n            </h3>\n            \n            <p className=\"text-slate-400 text-xs font-bold leading-relaxed mb-10 uppercase tracking-wide px-4\">\n              Deseja limpar todos os dados de <span className=\"text-amber-400\">\"{resetConfirmation.label}\"</span>? \n              Isso zerará o tempo, as questões e a data da última sessão, mantendo apenas o tópico.\n            </p>\n\n            <div className=\"flex flex-col gap-4\">\n              <button \n                onClick={executeReset}\n                className=\"w-full bg-amber-600 text-white font-black py-5 rounded-2xl text-[10px] tracking-[0.2em] hover:bg-amber-500 transition-all shadow-xl shadow-amber-950/30 active:scale-95 uppercase\"\n              >\n                CONFIRMAR LIMPEZA\n              </button>\n              \n              <button \n                onClick={() => setResetConfirmation(null)}\n                className=\"w-full py-4 text-[9px] font-black text-slate-500 uppercase tracking-[0.3em] hover:text-white transition-colors\"\n              >\n                CANCELAR\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n