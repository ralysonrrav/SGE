          "description": "Suporte para dark mode na geração de ciclos e cronograma.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, StudyCycle } from '../types';\nimport { BrainCircuit, Loader2, Calendar, Target, Clock, Zap } from 'lucide-react';\nimport { generateStudyCycle } from '../services/geminiService';\n\ninterface CiclosProps {\n  subjects: Subject[];\n  cycle: StudyCycle | null;\n  setCycle: React.Dispatch<React.SetStateAction<StudyCycle | null>>;\n}\n\nconst Ciclos: React.FC<CiclosProps> = ({ subjects, cycle, setCycle }) => {\n  const [loading, setLoading] = useState(false);\n  const [board, setBoard] = useState('Cebraspe');\n  const [examDate, setExamDate] = useState('');\n  const [hoursPerDay, setHoursPerDay] = useState(4);\n\n  const boards = ['Cebraspe', 'FGV', 'Vunesp', 'FCC', 'Outra'];\n\n  const handleGenerate = async () => {\n    if (subjects.length === 0) { alert(\"Adicione disciplinas primeiro!\"); return; }\n    setLoading(true);\n    try {\n      const result = await generateStudyCycle(board, examDate, hoursPerDay, subjects);\n      setCycle({ id: Date.now().toString(), board, examDate, hoursPerDay, schedule: result.schedule });\n    } catch (error) { alert(\"Erro ao gerar ciclo.\"); } finally { setLoading(false); }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header>\n        <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">Ciclos de Estudo AI</h2>\n        <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Nossa IA cria o cronograma perfeito baseado em Pareto.</p>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-1 bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm space-y-6 h-fit\">\n          <div className=\"flex items-center gap-2 text-indigo-600 dark:text-indigo-400 font-bold\"><Zap size={20} /><span>Plano de Estudo</span></div>\n          <div className=\"space-y-4\">\n            <div><label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1\">Banca</label><select className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white outline-none\" value={board} onChange={(e) => setBoard(e.target.value)}>{boards.map(b => <option key={b} value={b}>{b}</option>)}</select></div>\n            <div><label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1\">Data Prova</label><input type=\"date\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white outline-none\" value={examDate} onChange={(e) => setExamDate(e.target.value)} /></div>\n            <div><label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1\">Horas/Dia</label><input type=\"number\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white outline-none\" value={hoursPerDay} onChange={(e) => setHoursPerDay(parseInt(e.target.value))} /></div>\n            <button onClick={handleGenerate} disabled={loading} className={`w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white shadow-lg transition-all ${loading ? 'bg-slate-400 dark:bg-slate-700' : 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-100 dark:shadow-none'}`}>{loading ? <Loader2 className=\"animate-spin\" size={20} /> : <BrainCircuit size={20} />}{loading ? 'Otimizando...' : 'Gerar com IA'}</button>\n          </div>\n        </div>\n        <div className=\"lg:col-span-2 space-y-6\">\n          {!cycle && !loading ? (\n            <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 p-12 text-center text-slate-500 dark:text-slate-600\"><Calendar size={32} className=\"mx-auto mb-4\" />Configure e gere seu plano.</div>\n          ) : loading ? (\n            <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 p-12 text-center animate-pulse\"><BrainCircuit className=\"mx-auto mb-4 text-indigo-200 dark:text-indigo-800\" size={48} /><h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100\">Analisando banca {board}...</h3></div>\n          ) : cycle && (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {cycle.schedule.map((dayPlan, idx) => (\n                <div key={idx} className=\"bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm transition-transform hover:-translate-y-1\">\n                  <h4 className=\"font-bold text-indigo-600 dark:text-indigo-400 mb-3 border-b border-indigo-50 dark:border-indigo-900/30 pb-2\">{dayPlan.day}</h4>\n                  <div className=\"space-y-3\">{dayPlan.sessions.map((s, si) => (<div key={si} className=\"flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-800/50\"><div><p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{s.subjectName}</p><p className=\"text-xs text-slate-500 dark:text-slate-500\">{s.focus}</p></div><div className=\"flex items-center gap-1 text-xs font-bold text-slate-400 dark:text-slate-600\"><Clock size={12} />{s.duration}m</div></div>))}</div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Ciclos;\n"
            }
          ]
        },
