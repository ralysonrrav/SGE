            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic, PredefinedEdital } from '../types';\nimport { supabase } from '../lib/supabase';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  X, \n  Layers,\n  ArrowRight,\n  Loader2,\n  Sparkles,\n  Edit3,\n  Save,\n  AlignLeft,\n  Check\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  predefinedEditais: PredefinedEdital[];\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, predefinedEditais, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [isCatalogOpen, setIsCatalogOpen] = useState(false);\n  \n  // Estados para edição\n  const [bulkEditId, setBulkEditId] = useState<string | null>(null);\n  const [bulkText, setBulkText] = useState('');\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editTopicValue, setEditTopicValue] = useState('');\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editSubjectValue, setEditSubjectValue] = useState('');\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = async (name: string, topics: Topic[] = []) => {\n    if (!name.trim() || !supabase) return;\n    setLoading(true);\n    try {\n      const { data, error } = await supabase.from('subjects').insert([{ name: name.trim(), topics }]).select().single();\n      if (error) alert(\"Erro ao salvar: \" + error.message);\n      else if (data) {\n        setSubjects(prev => [...prev, { ...data, id: data.id.toString(), color: colors[subjects.length % colors.length] }]);\n        setNewSubjectName('');\n      }\n    } finally { setLoading(false); }\n  };\n\n  const deleteSubject = async (id: string) => {\n    if (!supabase || !confirm(\"Excluir disciplina e todos os tópicos?\")) return;\n    const { error } = await supabase.from('subjects').delete().eq('id', id);\n    if (!error) setSubjects(prev => prev.filter(s => s.id !== id));\n  };\n\n  const updateSubjectData = async (subjectId: string, payload: any) => {\n    if (!supabase) return;\n    const { error } = await supabase.from('subjects').update(payload).eq('id', subjectId);\n    if (error) console.error(error);\n    else {\n      setSubjects(prev => prev.map(s => s.id === subjectId ? { ...s, ...payload } : s));\n    }\n  };\n\n  const renameSubject = async (id: string) => {\n    if (!editSubjectValue.trim()) return;\n    await updateSubjectData(id, { name: editSubjectValue.trim() });\n    setEditingSubjectId(null);\n  };\n\n  const deleteTopic = async (subjectId: string, topicId: string) => {\n    const subject = subjects.find(s => s.id === subjectId);\n    if (!subject) return;\n    const updated = subject.topics.filter(t => t.id !== topicId);\n    await updateSubjectData(subjectId, { topics: updated });\n  };\n\n  const renameTopic = async (subjectId: string, topicId: string) => {\n    const subject = subjects.find(s => s.id === subjectId);\n    if (!subject || !editTopicValue.trim()) return;\n    const updated = subject.topics.map(t => t.id === topicId ? { ...t, title: editTopicValue.trim() } : t);\n    await updateSubjectData(subjectId, { topics: updated });\n    setEditingTopicId(null);\n  };\n\n  const addTopic = async (subjectId: string) => {\n    if (!newTopicTitle.trim()) return;\n    const subject = subjects.find(s => s.id === subjectId);\n    if (!subject) return;\n    const newTopic = { id: Math.random().toString(36).substr(2, 9), title: newTopicTitle, completed: false, importance: 3 };\n    await updateSubjectData(subjectId, { topics: [...subject.topics, newTopic] });\n    setNewTopicTitle('');\n  };\n\n  const saveBulkTopics = async (subjectId: string) => {\n    const subject = subjects.find(s => s.id === subjectId);\n    if (!subject) return;\n    const lines = bulkText.split('\\n').filter(l => l.trim() !== '');\n    const newTopics = lines.map(line => {\n      const existing = subject.topics.find(t => t.title === line.trim());\n      return existing || { id: Math.random().toString(36).substr(2, 9), title: line.trim(), completed: false, importance: 3 };\n    });\n    await updateSubjectData(subjectId, { topics: newTopics });\n    setBulkEditId(null);\n  };\n\n  const toggleTopic = async (subjectId: string, topicId: string) => {\n    const subject = subjects.find(s => s.id === subjectId);\n    if (!subject) return;\n    const updated = subject.topics.map(t => t.id === topicId ? { ...t, completed: !t.completed } : t);\n    await updateSubjectData(subjectId, { topics: updated });\n  };\n\n  const importEdital = async (edital: PredefinedEdital) => {\n    setLoading(true);\n    setIsCatalogOpen(false);\n    for (const sub of edital.subjects) await addSubject(sub.name, sub.topics);\n    setLoading(false);\n  };\n\n  return (\n    <div className=\"space-y-6 pb-24 animate-in fade-in duration-500\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Suas Disciplinas</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle total e ajustes rápidos.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <button onClick={() => setIsCatalogOpen(true)} className=\"flex items-center gap-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-5 py-3 rounded-2xl font-bold hover:bg-slate-200 transition-all\">\n            <Layers size={20} /> <span className=\"hidden md:inline\">Catálogo</span>\n          </button>\n          <div className=\"flex gap-1\">\n            <input type=\"text\" placeholder=\"Nova matéria...\" className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-l-2xl outline-none w-full md:w-48 bg-white dark:bg-slate-900 font-bold text-slate-900 dark:text-white\" value={newSubjectName} onChange={(e) => setNewSubjectName(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && addSubject(newSubjectName)} />\n            <button onClick={() => addSubject(newSubjectName)} disabled={loading || !newSubjectName.trim()} className=\"bg-indigo-600 text-white px-5 rounded-r-2xl hover:bg-indigo-700 disabled:opacity-50\">\n              {loading ? <Loader2 className=\"animate-spin\" size={20} /> : <Plus size={20} />}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 gap-4\">\n        {subjects.map((subject) => {\n          const completedCount = subject.topics.filter(t => t.completed).length;\n          const progress = subject.topics.length > 0 ? (completedCount / subject.topics.length) * 100 : 0;\n          const isBulk = bulkEditId === subject.id;\n          \n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden\">\n              <div className=\"p-5 flex items-center justify-between cursor-pointer\" onClick={() => !isBulk && setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}>\n                <div className=\"flex items-center gap-4 flex-1\">\n                  <div className=\"w-1.5 h-10 rounded-full\" style={{ backgroundColor: subject.color }} />\n                  <div className=\"flex-1\">\n                    {editingSubjectId === subject.id ? (\n                      <div className=\"flex items-center gap-2\" onClick={(e) => e.stopPropagation()}>\n                        <input autoFocus className=\"bg-transparent border-b-2 border-indigo-500 font-black text-slate-800 dark:text-white outline-none\" value={editSubjectValue} onChange={(e) => setEditSubjectValue(e.target.value)} onBlur={() => renameSubject(subject.id)} onKeyPress={(e) => e.key === 'Enter' && renameSubject(subject.id)} />\n                        <Check size={16} className=\"text-emerald-500\" onClick={() => renameSubject(subject.id)} />\n                      </div>\n                    ) : (\n                      <div className=\"flex items-center gap-2 group/title\">\n                        <h3 className=\"font-black text-slate-800 dark:text-slate-100\">{subject.name}</h3>\n                        <Edit3 size={14} className=\"text-slate-300 opacity-0 group-hover/title:opacity-100 transition-opacity\" onClick={(e) => { e.stopPropagation(); setEditingSubjectId(subject.id); setEditSubjectValue(subject.name); }} />\n                      </div>\n                    )}\n                    <div className=\"flex items-center gap-2 mt-1\">\n                      <div className=\"w-24 h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\"><div className=\"h-full bg-indigo-500 transition-all\" style={{ width: `${progress}%` }} /></div>\n                      <span className=\"text-[10px] font-black text-slate-400 uppercase\">{completedCount}/{subject.topics.length} tópicos</span>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <button onClick={(e) => { e.stopPropagation(); deleteSubject(subject.id); }} className=\"p-2 text-rose-500 hover:bg-rose-50 rounded-xl transition-all\"><Trash2 size={18} /></button>\n                  <div className={`p-2 rounded-xl ${expandedSubject === subject.id ? 'bg-slate-800 text-white' : 'text-slate-400'}`}>\n                    {expandedSubject === subject.id ? <ChevronUp size={18} /> : <ChevronDown size={18} />}\n                  </div>\n                </div>\n              </div>\n\n              {expandedSubject === subject.id && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800\">\n                  <div className=\"flex items-center justify-between mt-4 mb-4\">\n                    <h4 className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest\">Conteúdo Programático</h4>\n                    <button onClick={() => isBulk ? saveBulkTopics(subject.id) : (setBulkEditId(subject.id), setBulkText(subject.topics.map(t => t.title).join('\\n')))} className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-[10px] font-black transition-all ${isBulk ? 'bg-emerald-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}`}>\n                      {isBulk ? <><Save size={12} /> SALVAR</> : <><AlignLeft size={12} /> EDIÇÃO EM MASSA</>}\n                    </button>\n                  </div>\n\n                  {isBulk ? (\n                    <div className=\"space-y-3\">\n                      <textarea className=\"w-full h-48 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-sm font-bold outline-none\" value={bulkText} onChange={(e) => setBulkText(e.target.value)} />\n                      <div className=\"flex gap-2\"><button onClick={() => setBulkEditId(null)} className=\"flex-1 py-3 text-xs font-bold text-slate-400 hover:bg-slate-100 rounded-xl\">CANCELAR</button><button onClick={() => saveBulkTopics(subject.id)} className=\"flex-[2] py-3 bg-indigo-600 text-white font-black text-xs rounded-xl shadow-lg\">ATUALIZAR TUDO</button></div>\n                    </div>\n                  ) : (\n                    <>\n                      <div className=\"flex gap-2 mb-4\">\n                        <input type=\"text\" placeholder=\"Adicionar tópico...\" className=\"flex-1 px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-sm font-bold outline-none\" value={newTopicTitle} onChange={(e) => setNewTopicTitle(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && addTopic(subject.id)} />\n                        <button onClick={() => addTopic(subject.id)} className=\"bg-slate-800 text-white px-6 rounded-xl font-black text-xs\">ADD</button>\n                      </div>\n                      <div className=\"space-y-1\">\n                        {subject.topics.map(topic => (\n                          <div key={topic.id} className=\"flex items-center gap-3 p-2 hover:bg-slate-50 dark:hover:bg-slate-800/50 rounded-xl group transition-all\">\n                            <button onClick={() => toggleTopic(subject.id, topic.id)} className={`transition-all ${topic.completed ? 'text-emerald-500' : 'text-slate-300'}`}><CheckCircle size={20} /></button>\n                            {editingTopicId === topic.id ? (\n                              <input autoFocus className=\"flex-1 bg-transparent border-b border-indigo-400 text-sm font-bold outline-none\" value={editTopicValue} onChange={(e) => setEditTopicValue(e.target.value)} onBlur={() => renameTopic(subject.id, topic.id)} onKeyPress={(e) => e.key === 'Enter' && renameTopic(subject.id, topic.id)} />\n                            ) : (\n                              <span className={`text-sm font-bold flex-1 ${topic.completed ? 'text-slate-400 line-through' : 'text-slate-700 dark:text-slate-200'}`}>{topic.title}</span>\n                            )}\n                            <div className=\"flex items-center opacity-0 group-hover:opacity-100 transition-opacity gap-1\">\n                               <button onClick={() => { setEditingTopicId(topic.id); setEditTopicValue(topic.title); }} className=\"p-1.5 text-slate-400 hover:text-indigo-500\"><Edit3 size={14} /></button>\n                               <button onClick={() => deleteTopic(subject.id, topic.id)} className=\"p-1.5 text-slate-400 hover:text-rose-500\"><Trash2 size={14} /></button>\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    </>\n                  )}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {isCatalogOpen && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md animate-in fade-in\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-2xl rounded-[3rem] p-10 shadow-2xl overflow-hidden max-h-[80vh] flex flex-col\">\n            <div className=\"flex items-center justify-between mb-8\">\n              <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100\">Catálogo de Editais</h3>\n              <button onClick={() => setIsCatalogOpen(false)} className=\"p-2 text-slate-400 hover:bg-slate-100 rounded-xl\"><X size={24} /></button>\n            </div>\n            <div className=\"flex-1 overflow-y-auto space-y-4 pr-2\">\n              {predefinedEditais.map(edital => (\n                <div key={edital.id} className=\"p-6 bg-slate-50 dark:bg-slate-800/50 rounded-[2rem] border border-slate-100 dark:border-slate-800 flex items-center justify-between group\">\n                  <div>\n                    <h4 className=\"font-black text-slate-800 dark:text-white text-lg\">{edital.name}</h4>\n                    <p className=\"text-[10px] font-black text-indigo-600 uppercase mt-1\">{edital.organization}</p>\n                  </div>\n                  <button onClick={() => importEdital(edital)} className=\"bg-indigo-600 text-white px-6 py-3 rounded-xl font-black text-xs flex items-center gap-2\">IMPORTAR <ArrowRight size={14} /></button>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        },
        {
          "path": "components/Admin.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Inclusão de controles individuais de edição e exclusão de tópicos no painel de gestão de editais.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User, PredefinedEdital, Subject, Topic } from '../types';\nimport { \n  Users, Database, Plus, Trash2, Edit3, X, Save, \n  Lock, Unlock, AlignLeft, BookOpen, Check\n} from 'lucide-react';\n\ninterface AdminProps {\n  users: User[];\n  setUsers: React.Dispatch<React.SetStateAction<User[]>>;\n  editais: PredefinedEdital[];\n  setEditais: React.Dispatch<React.SetStateAction<PredefinedEdital[]>>;\n  view: 'users' | 'editais';\n}\n\nconst Admin: React.FC<AdminProps> = ({ users, setUsers, editais, setEditais, view }) => {\n  const [isCreatingEdital, setIsCreatingEdital] = useState(false);\n  const [editingEdital, setEditingEdital] = useState<PredefinedEdital | null>(null);\n  const [newEditalName, setNewEditalName] = useState('');\n  const [newEditalOrg, setNewEditalOrg] = useState('');\n  const [newEditalExamDate, setNewEditalExamDate] = useState('');\n  const [editalSubjects, setEditalSubjects] = useState<Subject[]>([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  \n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubjectToEdital = () => {\n    setEditalSubjects([...editalSubjects, { id: Date.now().toString(), name: 'Nova Disciplina', topics: [], color: colors[editalSubjects.length % colors.length] }]);\n  };\n\n  const handleTopicsChange = (sIdx: number, text: string) => {\n    const lines = text.split('\\n').filter(l => l.trim() !== '');\n    const newTopics = lines.map(line => ({ id: Math.random().toString(36).substr(2, 9), title: line.trim(), completed: false, importance: 3 }));\n    const n = [...editalSubjects];\n    n[sIdx].topics = newTopics;\n    setEditalSubjects(n);\n  };\n\n  const deleteTopicFromEdital = (sIdx: number, tIdx: number) => {\n    const n = [...editalSubjects];\n    n[sIdx].topics = n[sIdx].topics.filter((_, i) => i !== tIdx);\n    setEditalSubjects(n);\n  };\n\n  const saveEdital = () => {\n    if (!newEditalName || !newEditalOrg) return;\n    const edital: PredefinedEdital = { id: editingEdital?.id || Date.now().toString(), name: newEditalName, organization: newEditalOrg, examDate: newEditalExamDate, subjects: editalSubjects, lastUpdated: new Date().toISOString() };\n    if (editingEdital) setEditais(prev => prev.map(e => e.id === editingEdital.id ? edital : e));\n    else setEditais([...editais, edital]);\n    setIsCreatingEdital(false);\n  };\n\n  if (view === 'users') {\n    return (\n      <div className=\"space-y-8 animate-in fade-in duration-500\">\n        <header className=\"flex items-center justify-between\">\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100\">Gestão de Alunos</h2>\n        </header>\n        <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden overflow-x-auto\">\n          <table className=\"w-full text-left min-w-[600px]\">\n            <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800\">\n              <tr><th className=\"px-8 py-5 text-[10px] font-black uppercase\">Aluno</th><th className=\"px-8 py-5 text-[10px] font-black uppercase text-center\">Status</th><th className=\"px-8 py-5 text-[10px] font-black uppercase text-right\">Ações</th></tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n              {users.map(u => (\n                <tr key={u.id} className=\"hover:bg-slate-50/50\">\n                  <td className=\"px-8 py-6\"><div className=\"font-bold text-slate-800 dark:text-slate-100\">{u.name}</div><div className=\"text-xs text-slate-500\">{u.email}</div></td>\n                  <td className=\"px-8 py-6 text-center\"><span className={`inline-flex px-3 py-1 rounded-full text-[10px] font-black uppercase ${u.status === 'active' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600'}`}>{u.status === 'active' ? 'Ativo' : 'Bloqueado'}</span></td>\n                  <td className=\"px-8 py-6 text-right\"><button onClick={() => setUsers(users.map(usr => usr.id === u.id ? {...usr, status: usr.status === 'active' ? 'blocked' : 'active'} : usr))} className=\"p-2 text-amber-500 hover:bg-amber-50 rounded-xl\">{u.status === 'active' ? <Lock size={18} /> : <Unlock size={18} />}</button></td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <header className=\"flex items-center justify-between\">\n        <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100\">Catálogo de Editais</h2>\n        <button onClick={() => { setIsCreatingEdital(true); setEditingEdital(null); setNewEditalName(''); setNewEditalOrg(''); setEditalSubjects([]); }} className=\"bg-rose-600 text-white px-8 py-3 rounded-2xl font-black shadow-xl hover:bg-rose-700 transition-all flex items-center gap-2\"><Plus size={20} /> Novo Edital</button>\n      </header>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {editais.map(edital => (\n          <div key={edital.id} className=\"bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm relative group\">\n            <div className=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2\">\n              <button onClick={() => { setEditingEdital(edital); setNewEditalName(edital.name); setNewEditalOrg(edital.organization); setEditalSubjects(edital.subjects); setIsCreatingEdital(true); }} className=\"p-2 text-indigo-500 hover:bg-indigo-50 rounded-xl\"><Edit3 size={18} /></button>\n              <button onClick={() => setEditais(editais.filter(e => e.id !== edital.id))} className=\"p-2 text-rose-500 hover:bg-rose-50 rounded-xl\"><Trash2 size={18} /></button>\n            </div>\n            <div className=\"w-14 h-14 bg-rose-50 dark:bg-rose-900/20 text-rose-600 rounded-2xl flex items-center justify-center mb-6\"><Database size={28} /></div>\n            <h3 className=\"text-xl font-black text-slate-900 dark:text-slate-100 leading-tight\">{edital.name}</h3>\n            <p className=\"text-xs font-black text-rose-600 uppercase mt-1\">{edital.organization}</p>\n          </div>\n        ))}\n      </div>\n\n      {isCreatingEdital && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-5xl rounded-[3rem] shadow-2xl overflow-hidden border border-slate-100 dark:border-slate-800 h-[85vh] flex flex-col\">\n             <div className=\"flex flex-1 overflow-hidden flex-col md:flex-row\">\n               <div className=\"w-full md:w-1/3 p-10 bg-slate-50 dark:bg-slate-950 border-r border-slate-100 space-y-6 overflow-y-auto\">\n                 <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100\">Configurar Edital</h3>\n                 <div className=\"space-y-4\">\n                   <input type=\"text\" placeholder=\"Nome do Concurso\" className=\"w-full px-5 py-3 rounded-xl border border-slate-200 outline-none font-bold bg-white dark:bg-slate-900 dark:text-white\" value={newEditalName} onChange={(e) => setNewEditalName(e.target.value)} />\n                   <input type=\"text\" placeholder=\"Banca\" className=\"w-full px-5 py-3 rounded-xl border border-slate-200 outline-none font-bold bg-white dark:bg-slate-900 dark:text-white\" value={newEditalOrg} onChange={(e) => setNewEditalOrg(e.target.value)} />\n                 </div>\n                 <div className=\"pt-6 space-y-3\">\n                   <button onClick={saveEdital} className=\"w-full bg-rose-600 text-white font-black py-4 rounded-2xl shadow-xl hover:bg-rose-700 transition-all flex items-center justify-center gap-2\"><Save size={18} /> PUBLICAR AGORA</button>\n                   <button onClick={() => setIsCreatingEdital(false)} className=\"w-full text-slate-500 font-bold py-4 hover:bg-slate-200 rounded-2xl\">CANCELAR</button>\n                 </div>\n               </div>\n               <div className=\"flex-1 p-10 overflow-y-auto\">\n                  <div className=\"flex items-center justify-between mb-8 pb-4 border-b\">\n                    <h4 className=\"font-black text-xl flex items-center gap-2 dark:text-white\"><BookOpen className=\"text-rose-600\" /> Grade Curricular</h4>\n                    <button onClick={addSubjectToEdital} className=\"text-[10px] font-black bg-rose-600 text-white px-5 py-2 rounded-xl hover:bg-rose-700 shadow-lg transition-all\">+ ADD MATÉRIA</button>\n                  </div>\n                  <div className=\"space-y-8\">\n                    {editalSubjects.map((sub, sIdx) => (\n                      <div key={sub.id} className=\"p-6 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border border-slate-100 relative group/sub\">\n                        <button onClick={() => setEditalSubjects(editalSubjects.filter(s => s.id !== sub.id))} className=\"absolute top-4 right-4 p-2 text-rose-500 hover:bg-rose-100 rounded-xl opacity-0 group-hover/sub:opacity-100\"><Trash2 size={16} /></button>\n                        <div className=\"flex items-center gap-3 mb-4\">\n                          <div className=\"w-2 h-8 rounded-full\" style={{ backgroundColor: sub.color }} />\n                          <input value={sub.name} onChange={(e) => { const n = [...editalSubjects]; n[sIdx].name = e.target.value; setEditalSubjects(n); }} className=\"bg-transparent font-black text-lg outline-none border-b border-rose-100 focus:border-rose-500 w-full dark:text-white\" />\n                        </div>\n                        <div className=\"space-y-4\">\n                           <div>\n                             <p className=\"text-[10px] font-black text-slate-400 uppercase mb-2 flex items-center gap-1\"><AlignLeft size={10} /> Editar em Massa (Cole abaixo)</p>\n                             <textarea defaultValue={sub.topics.map(t => t.title).join('\\n')} onBlur={(e) => handleTopicsChange(sIdx, e.target.value)} className=\"w-full h-32 bg-white dark:bg-slate-900 rounded-2xl p-4 outline-none border border-slate-200 focus:border-rose-500 dark:text-slate-200 text-sm font-bold\" />\n                           </div>\n                           {sub.topics.length > 0 && (\n                             <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2\">\n                               {sub.topics.map((t, tIdx) => (\n                                 <div key={t.id} className=\"flex items-center justify-between p-2 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-800 group/topic\">\n                                   <input className=\"bg-transparent text-xs font-bold outline-none flex-1 dark:text-slate-300\" value={t.title} onChange={(e) => { const n = [...editalSubjects]; n[sIdx].topics[tIdx].title = e.target.value; setEditalSubjects(n); }} />\n                                   <button onClick={() => deleteTopicFromEdital(sIdx, tIdx)} className=\"p-1 text-rose-400 hover:text-rose-600 opacity-0 group-hover/topic:opacity-100\"><Trash2 size={12} /></button>\n                                 </div>\n                               ))}\n                             </div>\n                           )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n               </div>\n             </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Admin;\n"
            }
          ]
        }
      ]
    },
