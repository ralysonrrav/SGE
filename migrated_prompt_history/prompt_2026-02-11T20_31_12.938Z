          "path": "vite.config.ts",
          "generationType": 1,
          "isDone": true,
          "description": "Configuração do Vite para definir process.env no lado do cliente e evitar erros de referência durante o build de produção.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\n\n// https://vitejs.dev/config/\nexport default defineConfig({\n  plugins: [react()],\n  root: './',\n  define: {\n    // Garante que process.env.API_KEY esteja disponível no navegador\n    'process.env.API_KEY': JSON.stringify(process.env.API_KEY),\n    'process.env': {}\n  },\n  build: {\n    outDir: 'dist',\n    emptyOutDir: true,\n    rollupOptions: {\n      input: {\n        main: './index.html',\n      },\n    },\n  },\n  server: {\n    fs: {\n      allow: ['.'],\n    },\n  },\n})\n"
