          "diffs": [
            {
              "target": "",
              "replacement": "\nimport { createClient } from '@supabase/supabase-js';\n\nconst DEFAULT_URL = 'https://kubyooesnofaswpfexla.supabase.co';\nconst DEFAULT_KEY = 'sb_publishable_YIs9MLAF0rI3i7jDZBlllQ_SVrkY6N6';\n\nconst supabaseUrl = process.env.SUPABASE_URL || process.env.VITE_SUPABASE_URL || DEFAULT_URL;\nconst supabaseAnonKey = process.env.SUPABASE_ANON_KEY || process.env.VITE_SUPABASE_ANON_KEY || DEFAULT_KEY;\n\nconst isValidUrl = (url: string) => {\n  try {\n    const u = new URL(url);\n    return u.protocol === 'http:' || u.protocol === 'https:';\n  } catch {\n    return false;\n  }\n};\n\nexport const supabase = (isValidUrl(supabaseUrl) && supabaseAnonKey) \n  ? createClient(supabaseUrl, supabaseAnonKey, {\n      auth: {\n        autoRefreshToken: true,\n        persistSession: true,\n        detectSessionInUrl: true,\n        flowType: 'pkce',\n        storage: window.localStorage,\n        storageKey: 'sb-studyflow-auth'\n      },\n      global: {\n        headers: { 'x-application-name': 'studyflow' }\n      }\n    }) \n  : null;\n\n/**\n * Utilitário sênior para verificar erros de rede.\n * Captura especificamente 'Failed to fetch' que ocorre em sandboxes ou bloqueios de rede.\n */\nexport const isNetworkError = (error: any): boolean => {\n  if (!error) return false;\n  const message = error.message?.toLowerCase() || \"\";\n  const name = error.name || \"\";\n  const code = error.code || \"\";\n  \n  return (\n    name === 'TypeError' || \n    message.includes('fetch') || \n    message.includes('network') || \n    message.includes('failed to fetch') ||\n    message.includes('load failed') ||\n    message.includes('failed to connect') ||\n    code === 'PGRST301' || \n    !navigator.onLine\n  );\n};\n"
            }
          ]
        },
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação de persistência local híbrida para mitigar falhas de conexão com o Supabase.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect, useCallback, useRef } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon,\n  Users,\n  Database,\n  Loader2,\n  ShieldCheck,\n  Eye,\n  Settings,\n  WifiOff\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession, PredefinedEdital } from './types';\nimport { supabase, isNetworkError } from './lib/supabase';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\nimport Admin from './components/Admin';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [allUsers, setAllUsers] = useState<User[]>([]);\n  const [isLoaded, setIsLoaded] = useState(false);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isLoggingOut, setIsLoggingOut] = useState(false);\n  const [isOffline, setIsOffline] = useState(false);\n  const loggingOutRef = useRef(false);\n  \n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    return saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;\n  });\n\n  const [editais, setEditais] = useState<PredefinedEdital[]>([\n    {\n      id: 'edital-pf-agente',\n      name: 'Agente da Polícia Federal',\n      organization: 'PF / Cebraspe',\n      lastUpdated: new Date().toISOString(),\n      subjects: [\n        { id: 'pf-1', name: 'Português', color: '#6366f1', topics: [{ id: 't1', title: 'Compreensão de textos', completed: false, importance: 5, studyTimeMinutes: 0 }] },\n        { id: 'pf-2', name: 'Informática', color: '#10b981', topics: [{ id: 't3', title: 'Segurança da Informação', completed: false, importance: 5, studyTimeMinutes: 0 }] }\n      ]\n    }\n  ]);\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  // Cache Local Persistence\n  const saveToLocal = (key: string, data: any) => {\n    localStorage.setItem(`sf_cache_${key}`, JSON.stringify(data));\n  };\n\n  const loadFromLocal = (key: string) => {\n    const data = localStorage.getItem(`sf_cache_${key}`);\n    return data ? JSON.parse(data) : null;\n  };\n\n  const fetchUserData = useCallback(async (userId: string) => {\n    // Tenta carregar do local primeiro para velocidade e resiliência\n    const cachedSubjects = loadFromLocal('subjects');\n    const cachedMocks = loadFromLocal('mocks');\n    const cachedLogs = loadFromLocal('logs');\n\n    if (cachedSubjects) setSubjects(cachedSubjects);\n    if (cachedMocks) setMocks(cachedMocks);\n    if (cachedLogs) setStudyLogs(cachedLogs);\n\n    if (!supabase || loggingOutRef.current) return;\n\n    try {\n      const { data: subData, error: subError } = await supabase.from('subjects').select('*').order('created_at', { ascending: true });\n      if (subError) throw subError;\n      if (subData) {\n        const mappedSubjects = subData.map((s, index) => ({\n          ...s,\n          id: String(s.id),\n          topics: s.topics || [],\n          color: colors[index % colors.length]\n        }));\n        setSubjects(mappedSubjects);\n        saveToLocal('subjects', mappedSubjects);\n      }\n\n      const { data: mockData, error: mockError } = await supabase.from('mocks').select('*').order('date', { ascending: false });\n      if (mockError) throw mockError;\n      if (mockData) {\n        const mappedMocks = mockData.map(m => ({ ...m, id: String(m.id) }));\n        setMocks(mappedMocks);\n        saveToLocal('mocks', mappedMocks);\n      }\n\n      const { data: logData, error: logError } = await supabase.from('study_logs').select('*').order('date', { ascending: false });\n      if (logError) throw logError;\n      if (logData) {\n        const mappedLogs = logData.map(l => ({ ...l, id: String(l.id) }));\n        setStudyLogs(mappedLogs);\n        saveToLocal('logs', mappedLogs);\n      }\n      setIsOffline(false);\n    } catch (e: any) {\n      if (isNetworkError(e)) {\n        setIsOffline(true);\n        console.warn(\"Iniciando em modo Offline devido a falha de conexão.\");\n      } else {\n        console.error(\"Erro ao buscar dados do usuário:\", e);\n      }\n    }\n  }, []);\n\n  const fetchAllUsers = useCallback(async () => {\n     if (!supabase || user?.role !== 'administrator') return;\n     try {\n       const { data, error } = await supabase.from('profiles').select('*');\n       if (error) throw error;\n       if (data) setAllUsers(data as User[]);\n     } catch (e) {\n       console.error(\"Erro ao buscar catálogo de usuários:\", e);\n     }\n  }, [user]);\n\n  const addStudyLog = async (minutes: number, topicId: string, subjectId: string) => {\n    const newLogEntry: StudySession = { \n      id: `local-${Date.now()}`, \n      minutes, \n      topicId, \n      subjectId, \n      date: new Date().toISOString(), \n      type: 'estudo' \n    };\n\n    // Atualização otimista\n    setStudyLogs(prev => [newLogEntry, ...prev]);\n\n    if (user?.role === 'visitor') return;\n\n    if (supabase && !loggingOutRef.current) {\n      try {\n        const { data, error } = await supabase.from('study_logs').insert([{\n          minutes, topicId, subjectId, date: newLogEntry.date, type: 'estudo'\n        }]).select().single();\n        \n        if (error) throw error;\n        if (data) {\n          setStudyLogs(prev => prev.map(l => l.id === newLogEntry.id ? { ...data, id: String(data.id) } : l));\n        }\n      } catch (e) {\n        if (isNetworkError(e)) setIsOffline(true);\n        console.warn(\"Log salvo apenas localmente.\");\n      }\n    }\n  };\n\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (isDarkMode) root.classList.add('dark');\n    else root.classList.remove('dark');\n    localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');\n  }, [isDarkMode]);\n\n  useEffect(() => {\n    let isMounted = true;\n    const initializeAuth = async () => {\n      if (!supabase) { setIsLoaded(true); return; }\n      try {\n        const { data: { session }, error } = await supabase.auth.getSession();\n        if (error) throw error;\n        \n        if (isMounted && session?.user) {\n          const isAdmin = session.user.email === 'ralysonriccelli@gmail.com';\n          const isVisitor = session.user.email?.includes('demo') || session.user.user_metadata?.role === 'visitor';\n          \n          const newUser: User = {\n            id: session.user.id,\n            name: session.user.user_metadata?.full_name || 'Usuário',\n            email: session.user.email!,\n            role: isAdmin ? 'administrator' : isVisitor ? 'visitor' : 'student',\n            status: 'active',\n            isOnline: true,\n            weeklyGoal: session.user.user_metadata?.weekly_goal || 20\n          };\n          \n          setUser(newUser);\n          fetchUserData(session.user.id);\n          if (isAdmin) fetchAllUsers();\n        }\n      } catch (e) {\n        console.warn(\"Sessão não encontrada ou erro de rede.\");\n      } finally { \n        if (isMounted) setIsLoaded(true); \n      }\n    };\n    initializeAuth();\n  }, [fetchUserData, fetchAllUsers]);\n\n  const handleLogout = async () => {\n    loggingOutRef.current = true;\n    setIsLoggingOut(true);\n    if (supabase) await supabase.auth.signOut();\n    localStorage.clear(); // Limpa cache ao sair\n    setUser(null);\n    setSubjects([]);\n    setMocks([]);\n    setIsLoggingOut(false);\n    loggingOutRef.current = false;\n  };\n\n  if (!isLoaded || isLoggingOut) {\n    return (\n      <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex flex-col items-center justify-center\">\n        <Loader2 className=\"animate-spin text-indigo-600 mb-4\" size={48} />\n        <p className=\"text-slate-500 font-black uppercase text-[10px] tracking-widest animate-pulse\">Sincronizando Sistema...</p>\n      </div>\n    );\n  }\n\n  if (!user) {\n    return <Login users={allUsers} onLogin={(u) => { setUser(u); fetchUserData(u.id); }} onRegister={(u) => { setUser(u); fetchUserData(u.id); }} />;\n  }\n\n  return (\n    <div className=\"flex h-screen bg-white dark:bg-slate-950 overflow-hidden\">\n      {/* Banner de Modo Visitante ou Offline */}\n      {isOffline && (\n        <div className=\"fixed top-0 left-0 right-0 z-[100] bg-rose-600 text-white text-[10px] font-black uppercase tracking-[0.3em] py-1 text-center flex items-center justify-center gap-2\">\n          <WifiOff size={12} /> CONEXÃO LIMITADA: TRABALHANDO EM MODO LOCAL\n        </div>\n      )}\n      {user.role === 'visitor' && !isOffline && (\n        <div className=\"fixed top-0 left-0 right-0 z-[100] bg-amber-500 text-white text-[10px] font-black uppercase tracking-[0.3em] py-1 text-center flex items-center justify-center gap-2\">\n          <Eye size={12} /> MODO VISITANTE: ACESSO DE DEMONSTRAÇÃO\n        </div>\n      )}\n\n      <button className={`md:hidden fixed z-50 p-3 bg-indigo-600 text-white rounded-2xl shadow-xl transition-all ${(user.role === 'visitor' || isOffline) ? 'top-10 left-6' : 'top-6 left-6'}`} onClick={() => setIsSidebarOpen(!isSidebarOpen)}>\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      <aside className={`fixed inset-y-0 left-0 z-40 w-72 bg-slate-50 dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 md:translate-x-0 ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-8 pt-12 flex items-center gap-4\">\n            <div className=\"w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-200 dark:shadow-none\"><Award size={28} /></div>\n            <div>\n              <h1 className=\"text-xl font-black text-slate-900 dark:text-slate-100 leading-none\">StudyFlow</h1>\n              <p className=\"text-[10px] font-black uppercase tracking-widest mt-1 text-indigo-600\">\n                {user.role === 'administrator' ? 'Admin Master' : user.role === 'visitor' ? 'Demo Access' : 'Student Pro'}\n              </p>\n            </div>\n          </div>\n          \n          <nav className=\"flex-1 px-4 py-4 space-y-1.5 overflow-y-auto\">\n            {[\n              { id: 'inicio', label: 'Início', icon: <Home size={18} />, roles: ['administrator', 'student', 'visitor'] },\n              { id: 'disciplinas', label: 'Edital Vertical', icon: <BookOpen size={18} />, roles: ['administrator', 'student', 'visitor'] },\n              { id: 'ciclos', label: 'Ciclos IA', icon: <BrainCircuit size={18} />, roles: ['administrator', 'student', 'visitor'] },\n              { id: 'revisao', label: 'Revisões 7/15/30', icon: <RefreshCcw size={18} />, roles: ['administrator', 'student', 'visitor'] },\n              { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={18} />, roles: ['administrator', 'student', 'visitor'] },\n              { id: 'admin_users', label: 'Gestão de Alunos', icon: <Users size={18} />, roles: ['administrator'] },\n              { id: 'admin_editais', label: 'Catálogo de Editais', icon: <Settings size={18} />, roles: ['administrator'] },\n            ].filter(item => item.roles.includes(user.role)).map((item) => (\n              <button key={item.id} onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }} className={`w-full flex items-center gap-3 px-4 py-3.5 rounded-2xl text-xs font-bold transition-all ${currentPage === item.id ? 'bg-indigo-600 text-white shadow-xl shadow-indigo-100 dark:shadow-none translate-x-1' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800'}`}>\n                <div className={`${currentPage === item.id ? 'text-white' : 'text-indigo-500'}`}>{item.icon}</div> \n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-6 border-t border-slate-200 dark:border-slate-800 space-y-4\">\n             <div className=\"bg-slate-200 dark:bg-slate-950 p-1 rounded-2xl flex items-center\">\n                <button onClick={() => setIsDarkMode(false)} className={`flex-1 flex items-center justify-center py-2 rounded-xl transition-all ${!isDarkMode ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-400'}`}><Sun size={16} /></button>\n                <button onClick={() => setIsDarkMode(true)} className={`flex-1 flex items-center justify-center py-2 rounded-xl transition-all ${isDarkMode ? 'bg-slate-800 text-indigo-400' : 'text-slate-400'}`}><Moon size={16} /></button>\n             </div>\n             \n             <div className=\"p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700\">\n               <div className=\"flex items-center gap-3\">\n                 <div className=\"w-8 h-8 rounded-lg bg-indigo-50 dark:bg-slate-900 flex items-center justify-center text-indigo-600 font-black text-xs\">\n                   {user.name.charAt(0)}\n                 </div>\n                 <div className=\"min-w-0\">\n                   <p className=\"text-[10px] font-bold text-slate-800 dark:text-slate-200 truncate leading-none\">{user.name}</p>\n                   <p className=\"text-[8px] font-black text-slate-400 uppercase tracking-tighter truncate mt-1\">{user.email}</p>\n                 </div>\n               </div>\n             </div>\n\n             <button onClick={handleLogout} className=\"w-full flex items-center justify-center gap-2 text-rose-500 font-black text-xs p-3 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-xl transition-all\">\n               <LogOut size={16} /> Encerrar Sessão\n             </button>\n          </div>\n        </div>\n      </aside>\n\n      <main className={`flex-1 md:ml-72 overflow-y-auto bg-white dark:bg-slate-950 transition-all ${(user.role === 'visitor' || isOffline) ? 'pt-8' : ''}`}>\n        <div className=\"max-w-6xl mx-auto p-6 md:p-12\">\n          {currentPage === 'inicio' && <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={() => {}} isDarkMode={isDarkMode} />}\n          {currentPage === 'disciplinas' && <Disciplinas subjects={subjects} setSubjects={setSubjects} predefinedEditais={editais} onAddLog={addStudyLog} />}\n          {currentPage === 'ciclos' && <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />}\n          {currentPage === 'revisao' && <Revisao subjects={subjects} setSubjects={setSubjects} onAddLog={addStudyLog} />}\n          {currentPage === 'simulados' && <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />}\n          {currentPage === 'admin_users' && <Admin users={allUsers} setUsers={setAllUsers} editais={editais} setEditais={setEditais} view=\"users\" />}\n          {currentPage === 'admin_editais' && <Admin users={allUsers} setUsers={setAllUsers} editais={editais} setEditais={setEditais} view=\"editais\" />}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Otimização da sincronização de tópicos com tratamento silencioso para falhas de rede 'Failed to fetch'.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useCallback } from 'react';\nimport { Subject, Topic, PredefinedEdital } from '../types';\nimport { supabase, isNetworkError } from '../lib/supabase';\nimport { \n  Plus, Trash2, ChevronDown, ChevronUp, CheckCircle, X, Layers,\n  BookOpen, TrendingUp, Save, Check, Database, ArrowRight, Target, Clock, Calendar, BarChart2\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  predefinedEditais: PredefinedEdital[];\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, predefinedEditais, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [isCatalogOpen, setIsCatalogOpen] = useState(false);\n  const [isBulkModalOpen, setIsBulkModalOpen] = useState(false);\n  const [bulkText, setBulkText] = useState('');\n  const [activeSubjectForBulk, setActiveSubjectForBulk] = useState<string | null>(null);\n  \n  const [activeProgressTopic, setActiveProgressTopic] = useState<string | null>(null);\n  const [progDate, setProgDate] = useState<string>(new Date().toISOString().split('T')[0]);\n  const [progHours, setProgHours] = useState<number>(0);\n  const [progMinutes, setProgMinutes] = useState<number>(0);\n  const [progAttempted, setProgAttempted] = useState<number>(0);\n  const [progCorrect, setProgCorrect] = useState<number>(0);\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const handleSubjectUpdate = useCallback(async (subjectId: string, updatedTopics: Topic[]) => {\n    const sId = String(subjectId);\n    // 1. Atualização imediata no estado local (UI reativa)\n    setSubjects(prev => {\n      const newState = prev.map(s => String(s.id) === sId ? { ...s, topics: updatedTopics } : s);\n      // Persistência de emergência no localStorage\n      localStorage.setItem('sf_cache_subjects', JSON.stringify(newState));\n      return newState;\n    });\n\n    // 2. Tenta sincronizar com Supabase se estiver disponível\n    if (supabase && !sId.startsWith('local-')) {\n      try { \n        const { error } = await supabase.from('subjects').update({ topics: updatedTopics }).eq('id', sId);\n        if (error) throw error;\n      } catch (err: any) { \n        // Se for erro de rede/fetch, silenciamos para não travar a experiência do usuário\n        if (isNetworkError(err)) {\n          console.warn(\"Sincronização pendente: Sistema operando em modo local.\");\n        } else {\n          console.error(\"Erro inesperado ao sincronizar:\", err);\n        }\n      }\n    }\n  }, [setSubjects]);\n\n  const addSubject = async (name: string, topics: Topic[] = []) => {\n    if (!name.trim()) return;\n    let finalId = `local-${Date.now()}`;\n    \n    // UI otimista\n    const newSubject: Subject = { \n      id: finalId, \n      name: name.trim(), \n      topics, \n      color: colors[subjects.length % colors.length] \n    };\n    \n    setSubjects(prev => [...prev, newSubject]);\n    setNewSubjectName('');\n\n    if (supabase) {\n      try {\n        const { data, error } = await supabase.from('subjects').insert([{ name: name.trim(), topics }]).select().single();\n        if (!error && data) {\n           setSubjects(prev => prev.map(s => s.id === finalId ? { ...s, id: String(data.id) } : s));\n        }\n      } catch (err) {\n        console.warn(\"Matéria salva apenas localmente.\");\n      }\n    }\n  };\n\n  const deleteSubject = async (id: string) => {\n    if (!window.confirm(\"Deseja realmente excluir esta disciplina?\")) return;\n    const sId = String(id);\n    setSubjects(prev => prev.filter(s => String(s.id) !== sId));\n    \n    if (supabase && !sId.startsWith('local-')) {\n      try {\n        await supabase.from('subjects').delete().eq('id', sId);\n      } catch (err) {\n        console.warn(\"Exclusão feita apenas localmente.\");\n      }\n    }\n  };\n\n  const toggleTopic = async (subjectId: string, topicId: string) => {\n    const subject = subjects.find(s => String(s.id) === String(subjectId));\n    if (!subject) return;\n    const updatedTopics = subject.topics.map(t => {\n      if (String(t.id) === String(topicId)) {\n        const isFinishing = !t.completed;\n        const targetDate = t.lastStudiedAt || new Date().toISOString();\n        return { \n          ...t, \n          completed: isFinishing, \n          lastStudiedAt: targetDate,\n          concludedAt: isFinishing ? targetDate : t.concludedAt\n        };\n      }\n      return t;\n    });\n    await handleSubjectUpdate(subjectId, updatedTopics);\n  };\n\n  const saveTopicProgress = async (subjectId: string, topicId: string) => {\n    const subject = subjects.find(s => String(s.id) === String(subjectId));\n    if (!subject) return;\n    const totalMinutes = (progHours * 60) + (progMinutes || 0);\n    \n    const updatedTopics = subject.topics.map(t => String(t.id) === String(topicId) ? {\n      ...t,\n      studyTimeMinutes: totalMinutes,\n      questionsAttempted: progAttempted,\n      questionsCorrect: progCorrect,\n      lastStudiedAt: new Date(`${progDate}T12:00:00`).toISOString()\n    } : t);\n\n    if (totalMinutes > 0) onAddLog(totalMinutes, topicId, String(subjectId));\n    await handleSubjectUpdate(subjectId, updatedTopics);\n    setActiveProgressTopic(null);\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle atômico com persistência offline-first.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <button onClick={() => setIsCatalogOpen(true)} className=\"px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-2xl font-black text-xs flex items-center gap-2 hover:bg-indigo-600 hover:text-white transition-all\"><Database size={16} /> CATÁLOGO</button>\n          <input type=\"text\" placeholder=\"Nova disciplina...\" className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-2xl outline-none w-48 text-slate-900 dark:text-white bg-white dark:bg-slate-900 font-bold\" value={newSubjectName} onChange={(e) => setNewSubjectName(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && addSubject(newSubjectName)} />\n          <button onClick={() => addSubject(newSubjectName)} className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all shadow-lg\"><Plus size={24} /></button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.map(subject => {\n          const totalT = subject.topics.length;\n          const completedT = subject.topics.filter(t => t.completed).length;\n          const isExpanded = expandedSubject === String(subject.id);\n          \n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n              <div className=\"p-5 flex items-center justify-between cursor-pointer\" onClick={() => setExpandedSubject(isExpanded ? null : String(subject.id))}>\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"w-3 h-10 rounded-full\" style={{ backgroundColor: subject.color }} />\n                  <div>\n                    <h3 className=\"font-bold text-lg text-slate-800 dark:text-white\">{subject.name}</h3>\n                    <p className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest\">{completedT} / {totalT} tópicos concluídos</p>\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-3\">\n                  <button onClick={(e) => { e.stopPropagation(); setActiveSubjectForBulk(String(subject.id)); setIsBulkModalOpen(true); }} className=\"p-2 text-indigo-500 bg-indigo-50 dark:bg-indigo-900/20 rounded-xl hover:bg-indigo-600 hover:text-white transition-all\"><Layers size={18} /></button>\n                  <button onClick={(e) => { e.stopPropagation(); deleteSubject(String(subject.id)); }} className=\"p-2 text-rose-500 bg-rose-50 dark:bg-rose-900/20 rounded-xl hover:bg-rose-600 hover:text-white transition-all\"><Trash2 size={18} /></button>\n                  <div className={`p-2 rounded-xl transition-colors ${isExpanded ? 'bg-slate-800 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-400'}`}>\n                    {isExpanded ? <ChevronUp size={20} /> : <ChevronDown size={20} />}\n                  </div>\n                </div>\n              </div>\n\n              {isExpanded && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800 space-y-3 animate-in slide-in-from-top-2 duration-300\">\n                   <div className=\"flex gap-2 mb-4\">\n                      <input type=\"text\" placeholder=\"Adicionar tópico manual...\" className=\"flex-1 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 outline-none text-sm dark:text-white font-medium\" value={newTopicTitle} onChange={(e) => setNewTopicTitle(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && (async () => {\n                         const n: Topic = { id: `topic-${Date.now()}`, title: newTopicTitle.trim(), completed: false, importance: 3, studyTimeMinutes: 0 };\n                         await handleSubjectUpdate(String(subject.id), [...subject.topics, n]);\n                         setNewTopicTitle('');\n                      })()} />\n                   </div>\n\n                   {subject.topics.map(topic => {\n                     const hitRate = topic.questionsAttempted && topic.questionsAttempted > 0 \n                      ? Math.round(((topic.questionsCorrect || 0) / topic.questionsAttempted) * 100) \n                      : 0;\n\n                     return (\n                       <div key={topic.id} className=\"flex flex-col md:flex-row md:items-center gap-4 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-800 group transition-all hover:bg-white dark:hover:bg-slate-800\">\n                         <div className=\"flex items-start gap-4 flex-1 min-w-0\">\n                           <button onClick={() => toggleTopic(String(subject.id), topic.id)} className={`mt-1 transition-all ${topic.completed ? 'text-emerald-500' : 'text-slate-300 hover:text-indigo-400'}`}>\n                             <CheckCircle size={22} />\n                           </button>\n                           <div className=\"min-w-0 flex-1\">\n                             <span className={`text-sm font-bold block leading-tight ${topic.completed ? 'text-slate-400 line-through' : 'text-slate-700 dark:text-white'}`}>{topic.title}</span>\n                             \n                             <div className=\"flex flex-wrap items-center gap-x-3 gap-y-2 mt-2\">\n                               <div className=\"flex items-center gap-1.5 text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-900 px-2 py-1 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm\">\n                                 <Calendar size={10} className=\"text-indigo-500\" />\n                                 {topic.lastStudiedAt ? new Date(topic.lastStudiedAt).toLocaleDateString() : 'SEM REGISTRO'}\n                               </div>\n                               \n                               <div className=\"flex items-center gap-1.5 text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-900 px-2 py-1 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm\">\n                                 <Clock size={10} className=\"text-amber-500\" />\n                                 {topic.studyTimeMinutes ? `${Math.floor(topic.studyTimeMinutes / 60)}h${topic.studyTimeMinutes % 60}m` : '0m'}\n                               </div>\n\n                               <div className=\"flex items-center gap-1.5 text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-900 px-2 py-1 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm\">\n                                 <Target size={10} className=\"text-rose-500\" />\n                                 {topic.questionsAttempted || 0}Q / <Check size={10} className=\"text-emerald-500 inline\" /> {topic.questionsCorrect || 0}A\n                               </div>\n\n                               <div className={`px-2 py-1 rounded-lg text-[9px] font-black uppercase shadow-sm border ${\n                                 hitRate >= 80 ? 'bg-emerald-50 text-emerald-600 border-emerald-100 dark:bg-emerald-900/10' : \n                                 hitRate >= 60 ? 'bg-amber-50 text-amber-600 border-amber-100 dark:bg-amber-900/10' : 'bg-rose-50 text-rose-600 border-rose-100 dark:bg-rose-900/10'\n                               }`}>\n                                 {hitRate}% APROVEIT.\n                               </div>\n                             </div>\n                           </div>\n                         </div>\n                         \n                         <div className=\"flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity self-end md:self-center\">\n                           <button onClick={() => { \n                             setActiveProgressTopic(topic.id); \n                             setProgDate(topic.lastStudiedAt ? topic.lastStudiedAt.split('T')[0] : new Date().toISOString().split('T')[0]);\n                             setProgHours(Math.floor((topic.studyTimeMinutes || 0) / 60)); \n                             setProgMinutes((topic.studyTimeMinutes || 0) % 60);\n                             setProgAttempted(topic.questionsAttempted || 0);\n                             setProgCorrect(topic.questionsCorrect || 0);\n                           }} className=\"px-3 py-1.5 bg-white dark:bg-slate-900 text-slate-500 rounded-lg text-[10px] font-black border border-slate-100 dark:border-slate-800 hover:border-indigo-500 hover:text-indigo-600 transition-all shadow-sm flex items-center gap-2 uppercase\"><TrendingUp size={14} /> Registrar</button>\n                           <button onClick={async () => {\n                             const updated = subject.topics.filter(t => t.id !== topic.id);\n                             await handleSubjectUpdate(String(subject.id), updated);\n                           }} className=\"p-2 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-lg transition-all\"><Trash2 size={16} /></button>\n                         </div>\n                       </div>\n                     );\n                   })}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {activeProgressTopic && (\n        <div className=\"fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-300\">\n          <div className=\"bg-white dark:bg-slate-900 w-full max-w-md rounded-[2.5rem] p-10 shadow-2xl border border-slate-100 dark:border-slate-800\">\n            <div className=\"flex items-center gap-3 mb-6\">\n              <div className=\"p-3 bg-indigo-600 text-white rounded-2xl shadow-lg shadow-indigo-200 dark:shadow-none\"><TrendingUp size={24} /></div>\n              <div>\n                <h3 className=\"text-xl font-black dark:text-white leading-none\">Registrar Estudo</h3>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1\">Status de Domínio Atual</p>\n              </div>\n            </div>\n            <div className=\"space-y-5\">\n              <div>\n                <label className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1.5\">Data da Sessão</label>\n                <input type=\"date\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-950 dark:text-white font-bold outline-none focus:ring-2 focus:ring-indigo-500\" value={progDate} onChange={(e) => setProgDate(e.target.value)} />\n              </div>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1.5 flex items-center gap-1\"><Clock size={10}/> Horas</label>\n                  <input type=\"number\" placeholder=\"0\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-950 dark:text-white font-bold outline-none focus:ring-2 focus:ring-indigo-500\" value={progHours || ''} onChange={(e) => setProgHours(parseInt(e.target.value) || 0)} />\n                </div>\n                <div>\n                  <label className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1.5\">Minutos</label>\n                  <input type=\"number\" placeholder=\"0\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-950 dark:text-white font-bold outline-none focus:ring-2 focus:ring-indigo-500\" value={progMinutes || ''} onChange={(e) => setProgMinutes(parseInt(e.target.value) || 0)} />\n                </div>\n              </div>\n              <div className=\"grid grid-cols-2 gap-4 pt-2\">\n                <div>\n                  <label className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1.5 flex items-center gap-1\"><Target size={10}/> Q. Feitas</label>\n                  <input type=\"number\" placeholder=\"0\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-950 dark:text-white font-bold outline-none focus:ring-2 focus:ring-indigo-500\" value={progAttempted || ''} onChange={(e) => setProgAttempted(parseInt(e.target.value) || 0)} />\n                </div>\n                <div>\n                  <label className=\"text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1.5 flex items-center gap-1\"><Check size={10}/> Q. Acertos</label>\n                  <input type=\"number\" placeholder=\"0\" className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 dark:bg-slate-950 dark:text-white font-bold outline-none focus:ring-2 focus:ring-indigo-500\" value={progCorrect || ''} onChange={(e) => setProgCorrect(parseInt(e.target.value) || 0)} />\n                </div>\n              </div>\n            </div>\n            <div className=\"mt-10 flex gap-3\">\n              <button onClick={() => {\n                const subId = subjects.find(s => s.topics.some(t => t.id === activeProgressTopic))?.id;\n                if(subId) saveTopicProgress(subId, activeProgressTopic);\n              }} className=\"flex-1 bg-indigo-600 text-white font-black py-4 rounded-2xl shadow-xl hover:bg-indigo-700 transition-all flex items-center justify-center gap-2\">\n                <Save size={18} /> ATUALIZAR STATUS\n              </button>\n              <button onClick={() => setActiveProgressTopic(null)} className=\"flex-1 text-slate-500 font-bold py-4 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-2xl transition-all\">FECHAR</button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        }
      ]
    },
