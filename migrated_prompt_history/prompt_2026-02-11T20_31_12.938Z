  {
    "id": 61,
    "author": "model",
    "payload": {
      "type": "generationTable",
      "entries": [
        {
          "path": "App.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Implementação do estado de Dark Mode, lógica de persistência e seletor de tema na Sidebar.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Home, \n  BookOpen, \n  RefreshCcw, \n  Calendar, \n  BarChart2, \n  LogOut, \n  Menu, \n  X,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  BrainCircuit,\n  Award,\n  Sun,\n  Moon\n} from 'lucide-react';\nimport { User, Subject, MockExam, StudyCycle, StudySession } from './types';\nimport Login from './components/Login';\nimport Disciplinas from './components/Disciplinas';\nimport Ciclos from './components/Ciclos';\nimport Revisao from './components/Revisao';\nimport Simulados from './components/Simulados';\nimport Dashboard from './components/Dashboard';\n\nconst App: React.FC = () => {\n  const [user, setUser] = useState<User | null>(null);\n  const [currentPage, setCurrentPage] = useState('inicio');\n  const [subjects, setSubjects] = useState<Subject[]>([]);\n  const [mocks, setMocks] = useState<MockExam[]>([]);\n  const [cycle, setCycle] = useState<StudyCycle | null>(null);\n  const [studyLogs, setStudyLogs] = useState<StudySession[]>([]);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [isDarkMode, setIsDarkMode] = useState(() => {\n    const saved = localStorage.getItem('theme');\n    return saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);\n  });\n\n  // Theme synchronization\n  useEffect(() => {\n    if (isDarkMode) {\n      document.documentElement.classList.add('dark');\n      localStorage.setItem('theme', 'dark');\n    } else {\n      document.documentElement.classList.remove('dark');\n      localStorage.setItem('theme', 'light');\n    }\n  }, [isDarkMode]);\n\n  // Persistence\n  useEffect(() => {\n    const savedUser = localStorage.getItem('user');\n    if (savedUser) {\n      const parsedUser = JSON.parse(savedUser);\n      setUser(parsedUser);\n      const savedSubjects = localStorage.getItem(`subjects_${parsedUser.id}`);\n      if (savedSubjects) setSubjects(JSON.parse(savedSubjects));\n      const savedMocks = localStorage.getItem(`mocks_${parsedUser.id}`);\n      if (savedMocks) setMocks(JSON.parse(savedMocks));\n      const savedCycle = localStorage.getItem(`cycle_${parsedUser.id}`);\n      if (savedCycle) setCycle(JSON.parse(savedCycle));\n      const savedLogs = localStorage.getItem(`logs_${parsedUser.id}`);\n      if (savedLogs) setStudyLogs(JSON.parse(savedLogs));\n    }\n  }, []);\n\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem('user', JSON.stringify(user));\n      localStorage.setItem(`subjects_${user.id}`, JSON.stringify(subjects));\n      localStorage.setItem(`mocks_${user.id}`, JSON.stringify(mocks));\n      localStorage.setItem(`logs_${user.id}`, JSON.stringify(studyLogs));\n      if (cycle) localStorage.setItem(`cycle_${user.id}`, JSON.stringify(cycle));\n    }\n  }, [subjects, mocks, cycle, user, studyLogs]);\n\n  if (!user) {\n    return <Login onLogin={(u) => { setUser(u); localStorage.setItem('user', JSON.stringify(u)); }} />;\n  }\n\n  const navItems = [\n    { id: 'inicio', label: 'Início', icon: <Home size={20} /> },\n    { id: 'disciplinas', label: 'Disciplinas', icon: <BookOpen size={20} /> },\n    { id: 'ciclos', label: 'Ciclos AI', icon: <BrainCircuit size={20} /> },\n    { id: 'revisao', label: 'Revisão', icon: <RefreshCcw size={20} /> },\n    { id: 'simulados', label: 'Simulados', icon: <BarChart2 size={20} /> },\n  ];\n\n  const handleLogout = () => {\n    setUser(null);\n    localStorage.removeItem('user');\n  };\n\n  const addStudyLog = (log: Omit<StudySession, 'id'>) => {\n    const newLog: StudySession = { ...log, id: Date.now().toString() };\n    setStudyLogs(prev => [...prev, newLog]);\n  };\n\n  const updateWeeklyGoal = (hours: number) => {\n    setUser(prev => prev ? { ...prev, weeklyGoal: hours } : null);\n  };\n\n  const renderPage = () => {\n    switch (currentPage) {\n      case 'inicio': return (\n        <Dashboard \n          subjects={subjects} \n          mocks={mocks} \n          cycle={cycle} \n          studyLogs={studyLogs} \n          weeklyGoal={user.weeklyGoal || 20}\n          onUpdateGoal={updateWeeklyGoal}\n          isDarkMode={isDarkMode}\n        />\n      );\n      case 'disciplinas': return (\n        <Disciplinas \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'estudo' })}\n        />\n      );\n      case 'ciclos': return <Ciclos subjects={subjects} setCycle={setCycle} cycle={cycle} />;\n      case 'revisao': return (\n        <Revisao \n          subjects={subjects} \n          setSubjects={setSubjects} \n          onAddLog={(minutes, topicId, subjectId) => addStudyLog({ minutes, topicId, subjectId, date: new Date().toISOString(), type: 'revisao' })}\n        />\n      );\n      case 'simulados': return <Simulados mocks={mocks} setMocks={setMocks} subjects={subjects} />;\n      default: return <Dashboard subjects={subjects} mocks={mocks} cycle={cycle} studyLogs={studyLogs} weeklyGoal={user.weeklyGoal || 20} onUpdateGoal={updateWeeklyGoal} isDarkMode={isDarkMode} />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-slate-50 dark:bg-slate-950 overflow-hidden transition-colors duration-300\">\n      {/* Mobile Sidebar Toggle */}\n      <button \n        className=\"md:hidden fixed top-4 left-4 z-50 p-2 bg-indigo-600 text-white rounded-md shadow-lg\"\n        onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n      >\n        {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}\n      </button>\n\n      {/* Sidebar */}\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transform transition-transform duration-300 ease-in-out md:translate-x-0\n        ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}\n      `}>\n        <div className=\"flex flex-col h-full\">\n          <div className=\"p-6 flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-indigo-200 dark:shadow-indigo-900/20 shadow-lg\">\n              <Award size={24} />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-slate-800 dark:text-slate-100\">Concurseiro</h1>\n              <p className=\"text-xs text-indigo-600 dark:text-indigo-400 font-semibold uppercase tracking-widest\">Premium AI</p>\n            </div>\n          </div>\n\n          <nav className=\"flex-1 px-4 py-4 space-y-1\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => { setCurrentPage(item.id); setIsSidebarOpen(false); }}\n                className={`\n                  w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-all\n                  ${currentPage === item.id \n                    ? 'bg-indigo-50 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-400' \n                    : 'text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100'}\n                `}\n              >\n                {item.icon}\n                {item.label}\n              </button>\n            ))}\n          </nav>\n\n          <div className=\"p-4 border-t border-slate-100 dark:border-slate-800\">\n            {/* Theme Toggle Button */}\n            <button\n              onClick={() => setIsDarkMode(!isDarkMode)}\n              className=\"w-full flex items-center gap-3 px-4 py-3 mb-2 text-sm font-medium text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-all\"\n            >\n              {isDarkMode ? <Sun size={20} className=\"text-amber-500\" /> : <Moon size={20} className=\"text-indigo-500\" />}\n              {isDarkMode ? 'Modo Claro' : 'Modo Escuro'}\n            </button>\n\n            <div className=\"flex items-center gap-3 px-4 py-3 mb-4\">\n              <div className=\"w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-700 dark:text-indigo-400 text-xs font-bold\">\n                {user.name.charAt(0)}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-semibold text-slate-900 dark:text-slate-100 truncate\">{user.name}</p>\n                <p className=\"text-xs text-slate-500 dark:text-slate-500 truncate\">{user.email}</p>\n              </div>\n            </div>\n            <button\n              onClick={handleLogout}\n              className=\"w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 rounded-lg transition-all\"\n            >\n              <LogOut size={20} />\n              Sair\n            </button>\n          </div>\n        </div>\n      </aside>\n\n      {/* Main Content */}\n      <main className=\"flex-1 md:ml-64 overflow-y-auto p-4 md:p-8\">\n        <div className=\"max-w-6xl mx-auto\">\n          {renderPage()}\n        </div>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
            }
          ]
        },
        {
          "path": "components/Dashboard.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Ajuste nas cores dos gráficos e estilização dark mode para os cards estatísticos.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, MockExam, StudyCycle, StudySession } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell\n} from 'recharts';\nimport { CheckCircle2, TrendingUp, Clock, BookOpen, BarChart2, Zap, Settings, Target } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n  studyLogs: StudySession[];\n  weeklyGoal: number;\n  onUpdateGoal: (hours: number) => void;\n  isDarkMode: boolean;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, cycle, studyLogs, weeklyGoal, onUpdateGoal, isDarkMode }) => {\n  const [isEditingGoal, setIsEditingGoal] = useState(false);\n  const [tempGoal, setTempGoal] = useState(weeklyGoal);\n\n  // Totais\n  const totalMinutes = subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.studyTimeMinutes || 0), 0), 0);\n  const totalHours = Math.floor(totalMinutes / 60);\n  const totalTopics = subjects.reduce((acc, s) => acc + s.topics.length, 0);\n  const completedTopics = subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  // Unificação de Questões\n  const qTopics = subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.questionsAttempted || 0), 0), 0);\n  const hTopics = subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.questionsCorrect || 0), 0), 0);\n  const qMocks = mocks.reduce((acc, m) => acc + m.totalQuestions, 0);\n  const hMocks = mocks.reduce((acc, m) => acc + m.score, 0);\n  const totalQ = qTopics + qMocks;\n  const totalH = hTopics + hMocks;\n  const globalHitRate = totalQ > 0 ? Math.round((totalH / totalQ) * 100) : 0;\n\n  const getThisWeekMinutes = () => {\n    const now = new Date();\n    const lastSunday = new Date(now);\n    lastSunday.setDate(now.getDate() - now.getDay());\n    lastSunday.setHours(0, 0, 0, 0);\n    return studyLogs.reduce((acc, log) => new Date(log.date) >= lastSunday ? acc + log.minutes : acc, 0);\n  };\n\n  const thisWeekHours = parseFloat((getThisWeekMinutes() / 60).toFixed(1));\n  const weeklyGoalPercent = Math.min(100, Math.round((thisWeekHours / weeklyGoal) * 100));\n\n  const mockData = mocks.map(m => ({ name: m.title, acerto: Math.round((m.score / m.totalQuestions) * 100) })).slice(-5);\n  const subjectProgressData = subjects.map(s => ({ name: s.name, total: s.topics.length, concluido: s.topics.filter(t => t.completed).length, color: s.color }));\n\n  const chartThemeColors = {\n    grid: isDarkMode ? '#1e293b' : '#f1f5f9',\n    text: isDarkMode ? '#94a3b8' : '#64748b',\n    tooltipBg: isDarkMode ? '#0f172a' : '#ffffff',\n    tooltipBorder: isDarkMode ? '#1e293b' : '#f1f5f9',\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">QG de Performance</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle absoluto da sua jornada de estudos.</p>\n        </div>\n        <div className=\"flex items-center gap-3 bg-white dark:bg-slate-900 px-4 py-2 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm\">\n          <div className=\"p-2 bg-indigo-50 dark:bg-indigo-900/20 text-indigo-600 dark:text-indigo-400 rounded-lg\">\n            <Zap size={18} />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase leading-none\">Total Estudado</p>\n            <p className=\"text-sm font-bold text-slate-800 dark:text-slate-100\">{totalHours} Horas</p>\n          </div>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-xl shadow-slate-100/50 dark:shadow-none p-8 relative overflow-hidden group\">\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-indigo-50 dark:bg-indigo-900/10 rounded-full blur-3xl -mr-32 -mt-32 opacity-50 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900/20 transition-colors\" />\n          \n          <div className=\"relative flex flex-col md:flex-row items-center gap-8\">\n            <div className=\"relative w-48 h-48 shrink-0 flex items-center justify-center\">\n               <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 192 192\">\n                 <circle cx=\"96\" cy=\"96\" r=\"78\" className=\"stroke-slate-100 dark:stroke-slate-800 fill-none\" strokeWidth=\"12\" />\n                 <circle \n                   cx=\"96\" cy=\"96\" r=\"78\" \n                   className=\"stroke-indigo-600 dark:stroke-indigo-500 fill-none transition-all duration-1000 ease-out\" \n                   strokeWidth=\"12\"\n                   strokeDasharray={2 * Math.PI * 78}\n                   strokeDashoffset={(2 * Math.PI * 78) * (1 - weeklyGoalPercent / 100)}\n                   strokeLinecap=\"round\"\n                 />\n               </svg>\n               <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n                 <span className=\"text-4xl font-black text-slate-900 dark:text-slate-100\">{weeklyGoalPercent}%</span>\n                 <span className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Da Meta</span>\n               </div>\n            </div>\n\n            <div className=\"flex-1 space-y-6\">\n               <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <h3 className=\"text-2xl font-black text-slate-800 dark:text-slate-100 flex items-center gap-2\">\n                      <Target className=\"text-indigo-600 dark:text-indigo-500\" /> Meta da Semana\n                    </h3>\n                    <button onClick={() => setIsEditingGoal(!isEditingGoal)} className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-xl transition-all\">\n                      <Settings size={20} />\n                    </button>\n                  </div>\n                  <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Você estudou <span className=\"text-indigo-600 dark:text-indigo-400 font-bold\">{thisWeekHours}h</span> das <span className=\"text-slate-800 dark:text-slate-200 font-bold\">{weeklyGoal}h</span> planejadas.</p>\n               </div>\n               {isEditingGoal && (\n                 <div className=\"flex gap-2 animate-in slide-in-from-top-2 duration-200\">\n                    <input type=\"number\" className=\"flex-1 px-4 py-2 border-2 border-slate-200 dark:border-slate-700 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-800 dark:text-white\" value={tempGoal} onChange={(e) => setTempGoal(parseInt(e.target.value) || 0)} />\n                    <button onClick={() => { onUpdateGoal(tempGoal); setIsEditingGoal(false); }} className=\"bg-indigo-600 text-white px-6 py-2 rounded-xl font-bold\">Salvar</button>\n                 </div>\n               )}\n               <div className=\"grid grid-cols-2 gap-4 pt-4\">\n                  <div className=\"p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800\">\n                    <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase mb-1\">Status</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{weeklyGoalPercent >= 100 ? 'Meta Batida! 🎉' : 'Foco Total 🚀'}</p>\n                  </div>\n                  <div className=\"p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-slate-800\">\n                    <p className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase mb-1\">Reinicia em</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">Próximo Domingo</p>\n                  </div>\n               </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col items-center justify-center text-center\">\n            <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Progresso do Edital</h3>\n            <div className=\"h-[180px] w-full\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <PieChart>\n                  <Pie\n                    data={[{ name: 'Concluído', value: completedTopics }, { name: 'Pendente', value: Math.max(0, totalTopics - completedTopics) }]}\n                    cx=\"50%\" cy=\"50%\" innerRadius={60} outerRadius={80} paddingAngle={5} dataKey=\"value\"\n                  >\n                    <Cell fill=\"#4f46e5\" />\n                    <Cell fill={isDarkMode ? '#1e293b' : '#f1f5f9'} />\n                  </Pie>\n                  <Tooltip contentStyle={{ backgroundColor: chartThemeColors.tooltipBg, border: `1px solid ${chartThemeColors.tooltipBorder}`, borderRadius: '12px' }} itemStyle={{ color: chartThemeColors.text }} />\n                </PieChart>\n              </ResponsiveContainer>\n            </div>\n            <p className=\"text-2xl font-black text-slate-900 dark:text-slate-100 mt-4\">{progressPercent}%</p>\n            <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-1\">Geral Concluído</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        {[\n          { label: 'Tópicos', val: `${completedTopics} / ${totalTopics}`, icon: <CheckCircle2 size={24} />, bg: 'bg-indigo-50 dark:bg-indigo-900/20', color: 'text-indigo-600 dark:text-indigo-400' },\n          { label: 'Aproveitamento', val: `${globalHitRate}%`, icon: <TrendingUp size={24} />, bg: 'bg-emerald-50 dark:bg-emerald-900/20', color: 'text-emerald-600 dark:text-emerald-400', sub: `${totalQ} Questões Feitas` },\n          { label: 'Disciplinas', val: subjects.length, icon: <BookOpen size={24} />, bg: 'bg-amber-50 dark:bg-amber-900/20', color: 'text-amber-600 dark:text-amber-400' },\n          { label: 'Prova em', val: cycle ? new Date(cycle.examDate).toLocaleDateString('pt-BR') : 'Sem data', icon: <Clock size={24} />, bg: 'bg-purple-50 dark:bg-purple-900/20', color: 'text-purple-600 dark:text-purple-400' },\n        ].map((c, i) => (\n          <div key={i} className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-all\">\n            <div className={`p-3 ${c.bg} ${c.color} rounded-xl`}>{c.icon}</div>\n            <div>\n              <p className=\"text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">{c.label}</p>\n              <h3 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">{c.val}</h3>\n              {c.sub && <p className={`text-[10px] font-bold ${c.color} uppercase mt-0.5`}>{c.sub}</p>}\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm\">\n          <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Desempenho nos Simulados (%)</h3>\n          <div className=\"h-[300px]\">\n            {mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={mockData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke={chartThemeColors.grid} />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{ fill: chartThemeColors.text, fontSize: 12 }} />\n                  <YAxis axisLine={false} tickLine={false} tick={{ fill: chartThemeColors.text, fontSize: 12 }} />\n                  <Tooltip contentStyle={{ borderRadius: '12px', border: `1px solid ${chartThemeColors.tooltipBorder}`, backgroundColor: chartThemeColors.tooltipBg, color: chartThemeColors.text }} cursor={{ fill: isDarkMode ? '#1e293b' : '#f8fafc' }} />\n                  <Bar dataKey=\"acerto\" fill=\"#4f46e5\" radius={[6, 6, 0, 0]} barSize={40} />\n                </BarChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-400 dark:text-slate-600 gap-2\">\n                <BarChart2 size={48} className=\"opacity-20\" />\n                <p>Nenhum simulado cadastrado ainda.</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm\">\n          <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 mb-6\">Progresso por Disciplina</h3>\n          <div className=\"space-y-6\">\n            {subjectProgressData.length > 0 ? subjectProgressData.map((s) => (\n              <div key={s.name} className=\"space-y-2\">\n                <div className=\"flex justify-between text-sm\">\n                  <span className=\"font-semibold text-slate-700 dark:text-slate-300\">{s.name}</span>\n                  <span className=\"text-slate-500 dark:text-slate-500\">{s.concluido} / {s.total} tópicos</span>\n                </div>\n                <div className=\"h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                  <div className=\"h-full transition-all duration-1000\" style={{ width: `${s.total > 0 ? (s.concluido / s.total) * 100 : 0}%`, backgroundColor: s.color }} />\n                </div>\n              </div>\n            )) : <p className=\"text-slate-400 dark:text-slate-600 text-center py-10\">Cadastre disciplinas para ver o progresso.</p>}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        },
        {
          "path": "components/Disciplinas.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Suporte para dark mode nas listas de tópicos, modais e formulários de disciplinas.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { Subject, Topic } from '../types';\nimport { \n  Plus, \n  Trash2, \n  ChevronDown, \n  ChevronUp, \n  CheckCircle, \n  Circle, \n  BookOpen, \n  AlertTriangle, \n  X, \n  Edit3, \n  Check,\n  Activity,\n  Clock,\n  Target,\n  Calendar\n} from 'lucide-react';\n\ninterface DisciplinasProps {\n  subjects: Subject[];\n  setSubjects: React.Dispatch<React.SetStateAction<Subject[]>>;\n  onAddLog: (minutes: number, topicId: string, subjectId: string) => void;\n}\n\nconst Disciplinas: React.FC<DisciplinasProps> = ({ subjects, setSubjects, onAddLog }) => {\n  const [newSubjectName, setNewSubjectName] = useState('');\n  const [expandedSubject, setExpandedSubject] = useState<string | null>(null);\n  const [newTopicTitle, setNewTopicTitle] = useState('');\n  const [subjectToDelete, setSubjectToDelete] = useState<Subject | null>(null);\n  const [topicToDelete, setTopicToDelete] = useState<{subjectId: string, topicId: string, title: string} | null>(null);\n  const [editingSubjectId, setEditingSubjectId] = useState<string | null>(null);\n  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);\n  const [editingStatsId, setEditingStatsId] = useState<string | null>(null);\n  const [editValue, setEditValue] = useState('');\n  const [editMinutes, setEditMinutes] = useState(0);\n  const [editAttempted, setEditAttempted] = useState(0);\n  const [editCorrect, setEditCorrect] = useState(0);\n  const [editDate, setEditDate] = useState(() => {\n    const today = new Date();\n    return `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;\n  });\n\n  const colors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#3b82f6'];\n\n  const addSubject = () => {\n    if (!newSubjectName.trim()) return;\n    setSubjects([...subjects, { id: Date.now().toString(), name: newSubjectName, topics: [], color: colors[subjects.length % colors.length] }]);\n    setNewSubjectName('');\n  };\n\n  const saveTopicStats = (subjectId: string, topicId: string) => {\n    setSubjects(subjects.map(s => s.id === subjectId ? { ...s, topics: s.topics.map(t => t.id === topicId ? { ...t, studyTimeMinutes: (t.studyTimeMinutes || 0) + editMinutes, questionsAttempted: (t.questionsAttempted || 0) + editAttempted, questionsCorrect: (t.questionsCorrect || 0) + editCorrect, lastStudiedAt: new Date(`${editDate}T12:00:00`).toISOString() } : t) } : s));\n    if (editMinutes > 0) onAddLog(editMinutes, topicId, subjectId);\n    setEditingStatsId(null);\n  };\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-500 pb-24\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">Edital Verticalizado</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Controle total sobre seu conteúdo programático e métricas.</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <input type=\"text\" placeholder=\"Nova disciplina...\" className=\"px-5 py-3 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-72 shadow-sm text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-900\" value={newSubjectName} onChange={(e) => setNewSubjectName(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && addSubject()} />\n          <button onClick={addSubject} className=\"bg-indigo-600 text-white p-3 rounded-2xl hover:bg-indigo-700 transition-all shadow-lg shrink-0\"><Plus size={24} /></button>\n        </div>\n      </header>\n\n      <div className=\"space-y-4\">\n        {subjects.length === 0 ? (\n          <div className=\"text-center py-24 bg-white dark:bg-slate-900 rounded-[2rem] border-2 border-dashed border-slate-200 dark:border-slate-800\">\n            <div className=\"w-20 h-20 bg-slate-50 dark:bg-slate-800 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-300 dark:text-slate-700\"><BookOpen size={40} /></div>\n            <h3 className=\"text-xl font-bold text-slate-400 dark:text-slate-600\">Nenhuma disciplina cadastrada</h3>\n          </div>\n        ) : subjects.map(subject => {\n          const totalT = subject.topics.length;\n          const completedT = subject.topics.filter(t => t.completed).length;\n          const perc = totalT > 0 ? Math.round((completedT / totalT) * 100) : 0;\n          return (\n            <div key={subject.id} className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden transition-all hover:shadow-md\">\n              <div className=\"p-5 flex flex-col cursor-pointer\" onClick={() => setExpandedSubject(expandedSubject === subject.id ? null : subject.id)}>\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                    <div className=\"w-4 h-12 rounded-full shrink-0\" style={{ backgroundColor: subject.color }} />\n                    <div className=\"flex flex-col min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2\">\n                        <h3 className=\"font-bold text-xl text-slate-800 dark:text-slate-100 truncate\">{subject.name}</h3>\n                        {perc > 0 && <span className=\"text-[10px] font-black px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400\">{perc}%</span>}\n                      </div>\n                      <p className=\"text-xs text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider\">{completedT} de {totalT} tópicos</p>\n                      <div className=\"mt-2 h-1 w-full max-w-[200px] bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                        <div className=\"h-full transition-all duration-700\" style={{ width: `${perc}%`, backgroundColor: subject.color }} />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 ml-4\">\n                    <button onClick={(e) => { e.stopPropagation(); setSubjectToDelete(subject); }} className=\"p-2.5 text-rose-500 bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-600 hover:text-white rounded-xl transition-all shadow-sm\"><Trash2 size={18} /></button>\n                    <div className={`p-2 rounded-xl ${expandedSubject === subject.id ? 'bg-slate-800 dark:bg-slate-700 text-white' : 'bg-slate-50 dark:bg-slate-800 text-slate-400'}`}>{expandedSubject === subject.id ? <ChevronUp size={20} /> : <ChevronDown size={20} />}</div>\n                  </div>\n                </div>\n              </div>\n              {expandedSubject === subject.id && (\n                <div className=\"px-6 pb-6 pt-2 border-t border-slate-50 dark:border-slate-800 bg-slate-50/20 dark:bg-slate-800/20\">\n                  <div className=\"flex gap-2 mb-6 mt-2\">\n                    <input type=\"text\" placeholder=\"Adicionar tópico...\" className=\"flex-1 px-4 py-3 border border-slate-200 dark:border-slate-800 rounded-xl text-sm outline-none text-slate-900 dark:text-slate-100 bg-white dark:bg-slate-900\" value={newTopicTitle} onChange={(e) => setNewTopicTitle(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && (setSubjects(subjects.map(s => s.id === subject.id ? { ...s, topics: [...s.topics, { id: Date.now().toString(), title: newTopicTitle, completed: false, importance: 3, studyTimeMinutes: 0, questionsAttempted: 0, questionsCorrect: 0 }] } : s)), setNewTopicTitle(''))} />\n                    <button className=\"bg-slate-800 dark:bg-slate-700 text-white px-6 py-3 rounded-xl text-sm font-bold\">Add</button>\n                  </div>\n                  <div className=\"space-y-3\">\n                    {subject.topics.map(topic => (\n                      <div key={topic.id} className=\"flex flex-col p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-sm\">\n                        <div className=\"flex items-center justify-between\">\n                          <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n                            <button onClick={() => setSubjects(subjects.map(s => s.id === subject.id ? { ...s, topics: s.topics.map(t => t.id === topic.id ? { ...t, completed: !t.completed, lastStudiedAt: !t.completed ? new Date().toISOString() : t.lastStudiedAt } : t) } : s))} className={`transition-all ${topic.completed ? 'text-emerald-500' : 'text-slate-200 dark:text-slate-700'}`}>{topic.completed ? <CheckCircle size={24} /> : <Circle size={24} />}</button>\n                            <div className=\"flex flex-col truncate flex-1\">\n                              <span className={`text-sm font-bold ${topic.completed ? 'text-slate-300 dark:text-slate-600 line-through' : 'text-slate-700 dark:text-slate-200'}`}>{topic.title}</span>\n                              {topic.completed && topic.lastStudiedAt && <p className=\"text-[10px] text-slate-400 flex items-center gap-1 mt-1\"><Calendar size={10} /> {new Date(topic.lastStudiedAt).toLocaleDateString()}</p>}\n                            </div>\n                          </div>\n                          <button onClick={() => { setEditingStatsId(topic.id); setEditMinutes(0); setEditAttempted(0); setEditCorrect(0); }} className=\"p-2 text-indigo-400 dark:text-indigo-500 bg-indigo-50 dark:bg-indigo-900/20 rounded-lg hover:bg-indigo-600 hover:text-white transition-all\"><Activity size={15} /></button>\n                        </div>\n                        {editingStatsId === topic.id && (\n                          <div className=\"mt-4 p-4 bg-slate-50 dark:bg-slate-800/50 border border-indigo-100 dark:border-indigo-900/20 rounded-xl animate-in slide-in-from-top-2\">\n                            <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                              <div><label className=\"text-[10px] font-black text-slate-500 uppercase\">Minutos</label><input type=\"number\" className=\"w-full px-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 dark:text-white\" value={editMinutes} onChange={(e) => setEditMinutes(parseInt(e.target.value) || 0)} /></div>\n                              <div><label className=\"text-[10px] font-black text-slate-500 uppercase\">Data</label><input type=\"date\" className=\"w-full px-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 dark:text-white\" value={editDate} onChange={(e) => setEditDate(e.target.value)} /></div>\n                              <div><label className=\"text-[10px] font-black text-slate-500 uppercase\">Questões</label><input type=\"number\" className=\"w-full px-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 dark:text-white\" value={editAttempted} onChange={(e) => setEditAttempted(parseInt(e.target.value) || 0)} /></div>\n                              <div><label className=\"text-[10px] font-black text-slate-500 uppercase\">Acertos</label><input type=\"number\" className=\"w-full px-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 dark:text-white\" value={editCorrect} onChange={(e) => setEditCorrect(parseInt(e.target.value) || 0)} /></div>\n                            </div>\n                            <div className=\"flex justify-end gap-2 mt-4 pt-4 border-t dark:border-slate-700\"><button onClick={() => setEditingStatsId(null)} className=\"px-4 py-2 text-xs font-bold text-slate-500 dark:text-slate-400\">Cancel</button><button onClick={() => saveTopicStats(subject.id, topic.id)} className=\"px-6 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold\">Salvar</button></div>\n                          </div>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n      {/* Modals in Dark Mode */}\n      {subjectToDelete && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md\">\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden p-10 text-center\">\n            <AlertTriangle size={40} className=\"mx-auto mb-6 text-rose-500\" />\n            <h3 className=\"text-2xl font-black text-slate-900 dark:text-slate-100 mb-4\">Excluir Disciplina?</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 mb-8\">Esta ação removerá permanentemente \"{subjectToDelete.name}\".</p>\n            <div className=\"flex flex-col gap-3\">\n              <button onClick={() => { setSubjects(subjects.filter(s => s.id !== subjectToDelete.id)); setSubjectToDelete(null); }} className=\"w-full bg-rose-500 text-white font-bold py-4 rounded-2xl\">EXCLUIR</button>\n              <button onClick={() => setSubjectToDelete(null)} className=\"w-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold py-4 rounded-2xl\">CANCELAR</button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Disciplinas;\n"
            }
          ]
        },
        {
          "path": "components/Simulados.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Suporte para dark mode na tabela de simulados e formulário de cadastro.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { MockExam, Subject } from '../types';\nimport { BarChart2, Plus, Trash2, TrendingUp, Award, FileText, X } from 'lucide-react';\n\ninterface SimuladosProps {\n  mocks: MockExam[];\n  setMocks: React.Dispatch<React.SetStateAction<MockExam[]>>;\n  subjects: Subject[];\n}\n\nconst Simulados: React.FC<SimuladosProps> = ({ mocks, setMocks, subjects }) => {\n  const [showAddForm, setShowAddForm] = useState(false);\n  const [title, setTitle] = useState('');\n  const [score, setScore] = useState(0);\n  const [total, setTotal] = useState(100);\n  const [date, setDate] = useState(new Date().toISOString().split('T')[0]);\n\n  const addMock = () => {\n    if (!title.trim()) return;\n    setMocks([...mocks, { id: Date.now().toString(), title, date, score, totalQuestions: total, subjectPerformance: {} }]);\n    setShowAddForm(false);\n    setTitle('');\n  };\n\n  const averageScore = mocks.length > 0 ? Math.round(mocks.reduce((acc, m) => acc + (m.score / m.totalQuestions), 0) / mocks.length * 100) : 0;\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500 pb-20\">\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight\">Estatísticas de Simulados</h2>\n          <p className=\"text-slate-500 dark:text-slate-400 font-medium\">Mensure seu desempenho e identifique gargalos.</p>\n        </div>\n        <button onClick={() => setShowAddForm(true)} className=\"bg-indigo-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-indigo-700 transition-all flex items-center justify-center gap-2 shadow-lg\"><Plus size={20} /> Novo Simulado</button>\n      </header>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {[\n          { label: 'Média Geral', val: `${averageScore}%`, icon: <TrendingUp size={24} className=\"text-emerald-500\" /> },\n          { label: 'Total Realizados', val: mocks.length, icon: <BarChart2 size={24} className=\"text-indigo-500\" /> },\n          { label: 'Melhor Score', val: `${mocks.length > 0 ? Math.max(...mocks.map(m => Math.round((m.score / m.totalQuestions) * 100))) : 0}%`, icon: <Award size={24} className=\"text-amber-500\" /> },\n        ].map((c, i) => (\n          <div key={i} className=\"bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm\">\n            <p className=\"text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1\">{c.label}</p>\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-3xl font-extrabold text-slate-800 dark:text-slate-100\">{c.val}</h3>\n              {c.icon}\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {showAddForm && (\n        <div className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-indigo-100 dark:border-indigo-900/30 shadow-xl animate-in zoom-in-95 duration-200\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100\">Cadastrar Simulado</h3>\n            <button onClick={() => setShowAddForm(false)} className=\"text-slate-400 dark:text-slate-600 hover:text-slate-600 dark:hover:text-slate-400\"><X size={24} /></button>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            <div className=\"space-y-1\"><label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400\">Título</label><input type=\"text\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white\" value={title} onChange={(e) => setTitle(e.target.value)} /></div>\n            <div className=\"space-y-1\"><label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400\">Acertos</label><input type=\"number\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white\" value={score} onChange={(e) => setScore(parseInt(e.target.value) || 0)} /></div>\n            <div className=\"space-y-1\"><label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400\">Total Questões</label><input type=\"number\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white\" value={total} onChange={(e) => setTotal(parseInt(e.target.value) || 0)} /></div>\n            <div className=\"space-y-1\"><label className=\"text-sm font-semibold text-slate-600 dark:text-slate-400\">Data</label><input type=\"date\" className=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 dark:text-white\" value={date} onChange={(e) => setDate(e.target.value)} /></div>\n          </div>\n          <button onClick={addMock} className=\"mt-8 bg-indigo-600 text-white px-8 py-3 rounded-xl font-bold w-full md:w-auto\">Salvar Dados</button>\n        </div>\n      )}\n\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden\">\n        <table className=\"w-full text-left\">\n          <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n            <tr>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Simulado</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center\">Data</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center\">Score</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-center\">Perc.</th>\n              <th className=\"px-6 py-4 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest text-right\">Ação</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n            {mocks.map(mock => {\n              const perc = Math.round((mock.score / mock.totalQuestions) * 100);\n              return (\n                <tr key={mock.id} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors\">\n                  <td className=\"px-6 py-5\"><div className=\"flex items-center gap-3\"><div className=\"p-2 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 rounded-lg\"><FileText size={18} /></div><span className=\"font-bold text-slate-700 dark:text-slate-300\">{mock.title}</span></div></td>\n                  <td className=\"px-6 py-5 text-center text-sm text-slate-500 dark:text-slate-500\">{new Date(mock.date).toLocaleDateString('pt-BR')}</td>\n                  <td className=\"px-6 py-5 text-center text-sm font-bold text-slate-600 dark:text-slate-400\">{mock.score} / {mock.totalQuestions}</td>\n                  <td className=\"px-6 py-5 text-center\"><span className={`px-3 py-1 rounded-full text-xs font-bold ${perc >= 80 ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400' : perc >= 60 ? 'bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400' : 'bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400'}`}>{perc}%</span></td>\n                  <td className=\"px-6 py-5 text-right\"><button onClick={() => setMocks(mocks.filter(m => m.id !== mock.id))} className=\"text-slate-300 dark:text-slate-700 hover:text-red-500 transition-colors p-2\"><Trash2 size={18} /></button></td>\n                </tr>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n};\n\nexport default Simulados;\n"
            }
          ]
        },
        {
          "path": "components/Login.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Suporte para dark mode na tela de login.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState } from 'react';\nimport { User } from '../types';\nimport { ShieldCheck, Award } from 'lucide-react';\n\ninterface LoginProps {\n  onLogin: (user: User) => void;\n}\n\nconst Login: React.FC<LoginProps> = ({ onLogin }) => {\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [password, setPassword] = useState('');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (email && password) {\n      onLogin({ id: 'user_' + Date.now(), name: name || 'Estudante', email });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-4 transition-colors duration-300\">\n      <div className=\"max-w-md w-full bg-white dark:bg-slate-900 rounded-2xl shadow-xl shadow-slate-200 dark:shadow-none border border-slate-100 dark:border-slate-800 p-8\">\n        <div className=\"text-center mb-10\">\n          <div className=\"mx-auto w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-indigo-100 dark:shadow-indigo-900/20 mb-6 rotate-3 hover:rotate-0 transition-transform cursor-pointer\">\n            <Award size={32} />\n          </div>\n          <h1 className=\"text-3xl font-extrabold text-slate-900 dark:text-slate-100\">Concurseiro Pro AI</h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-2 font-medium\">Sua jornada para a aprovação começa aqui.</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2\">Seu Nome</label>\n            <input\n              type=\"text\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-all outline-none\"\n              placeholder=\"Ex: João Silva\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2\">E-mail</label>\n            <input\n              type=\"email\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-all outline-none\"\n              placeholder=\"seu@email.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2\">Senha</label>\n            <input\n              type=\"password\"\n              required\n              className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-indigo-500 bg-white dark:bg-slate-950 dark:text-white transition-all outline-none\"\n              placeholder=\"••••••••\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-indigo-600 text-white font-bold py-4 rounded-xl hover:bg-indigo-700 transition-colors shadow-lg flex items-center justify-center gap-2\"\n          >\n            <ShieldCheck size={20} />\n            Acessar Plataforma\n          </button>\n        </form>\n\n        <p className=\"text-center text-slate-400 dark:text-slate-600 text-xs mt-8\">\n          Ambiente de alta performance para controle de estudos.\n        </p>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n"
            }
          ]
