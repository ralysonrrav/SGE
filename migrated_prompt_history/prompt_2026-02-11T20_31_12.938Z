          "diffs": [
            {
              "target": "",
              "replacement": "import React, { useState, useEffect, useMemo } from 'react';\nimport { Subject, MockExam, StudyCycle, StudySession } from '../types';\nimport { \n  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell, AreaChart, Area\n} from 'recharts';\n// Add BarChart2 to the imports from lucide-react to fix the error on line 170\nimport { TrendingUp, Clock, Settings, Target, Zap, Calendar, ArrowUpRight, BarChart2 } from 'lucide-react';\n\ninterface DashboardProps {\n  subjects: Subject[];\n  mocks: MockExam[];\n  cycle: StudyCycle | null;\n  studyLogs: StudySession[];\n  weeklyGoal: number;\n  onUpdateGoal: (hours: number) => void;\n  isDarkMode: boolean;\n}\n\nconst Dashboard: React.FC<DashboardProps> = ({ subjects, mocks, studyLogs, weeklyGoal, onUpdateGoal }) => {\n  const [isEditingGoal, setIsEditingGoal] = useState(false);\n  const [tempGoal, setTempGoal] = useState(weeklyGoal);\n  const [isMounted, setIsMounted] = useState(false);\n\n  useEffect(() => { setIsMounted(true); }, []);\n\n  const totalMinutes = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.reduce((tAcc, t) => tAcc + (t.studyTimeMinutes || 0), 0), 0), [subjects]);\n  const totalHours = Math.floor(totalMinutes / 60);\n  const totalTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.length, 0), [subjects]);\n  const completedTopics = useMemo(() => subjects.reduce((acc, s) => acc + s.topics.filter(t => t.completed).length, 0), [subjects]);\n  const progressPercent = totalTopics > 0 ? Math.round((completedTopics / totalTopics) * 100) : 0;\n\n  const thisWeekHours = useMemo(() => {\n    const now = new Date();\n    const lastSun = new Date(now);\n    lastSun.setDate(now.getDate() - now.getDay());\n    lastSun.setHours(0, 0, 0, 0);\n    const mins = studyLogs.reduce((acc, log) => new Date(log.date) >= lastSun ? acc + log.minutes : acc, 0);\n    return parseFloat((mins / 60).toFixed(1));\n  }, [studyLogs]);\n\n  const weeklyGoalPercent = Math.min(100, Math.round((thisWeekHours / weeklyGoal) * 100));\n  const mockData = useMemo(() => mocks.map(m => ({ name: m.title.substring(0, 8), acerto: Math.round((m.score / m.totalQuestions) * 100) })).slice(-5).reverse(), [mocks]);\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-700\">\n      \n      {/* Dynamic Wide Grid for Desktop */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        {[\n          { label: 'Foco Total', value: `${totalHours}h ${totalMinutes % 60}m`, icon: <Clock size={16}/>, color: 'text-indigo-400', bg: 'bg-indigo-500/5' },\n          { label: 'Matriz Vencida', value: `${progressPercent}%`, icon: <Zap size={16}/>, color: 'text-amber-400', bg: 'bg-amber-500/5' },\n          { label: 'Assertividade', value: mocks.length > 0 ? `${Math.round(mocks[0].score / mocks[0].totalQuestions * 100)}%` : '0%', icon: <Target size={16}/>, color: 'text-emerald-400', bg: 'bg-emerald-500/5' },\n          { label: 'Aproveitamento', value: `${weeklyGoalPercent}%`, icon: <TrendingUp size={16}/>, color: 'text-sky-400', bg: 'bg-sky-500/5' },\n        ].map((stat, i) => (\n          <div key={i} className=\"glass-card p-8 rounded-xl border-l-2 border-indigo-500/20 hover:border-indigo-500 transition-all\">\n            <div className=\"flex items-center gap-3 mb-6\">\n               <div className={`p-2 rounded ${stat.bg} ${stat.color}`}>{stat.icon}</div>\n               <span className=\"text-[9px] font-black uppercase text-slate-500 tracking-[0.2em]\">{stat.label}</span>\n            </div>\n            <p className=\"text-4xl font-black text-white tracking-tighter text-glow\">{stat.value}</p>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Expanded Statistics Center */}\n        <div className=\"lg:col-span-2 glass-card rounded-xl p-10 relative overflow-hidden\">\n          <div className=\"flex justify-between items-center mb-10\">\n            <div>\n              <h3 className=\"text-xl font-black text-white tracking-tight\">Ritmo Semanal</h3>\n              <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mt-1\">Produtividade de Alta Performance</p>\n            </div>\n            <button onClick={() => setIsEditingGoal(!isEditingGoal)} className=\"p-3 bg-white/5 text-slate-400 hover:text-indigo-400 rounded transition-all\"><Settings size={16} /></button>\n          </div>\n\n          <div className=\"flex flex-col md:flex-row items-center gap-16\">\n            <div className=\"w-64 h-64 shrink-0 relative flex items-center justify-center\">\n              <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n                <circle cx=\"50\" cy=\"50\" r=\"45\" className=\"stroke-white/5 fill-none\" strokeWidth=\"6\" />\n                <circle \n                  cx=\"50\" cy=\"50\" r=\"45\" \n                  className=\"stroke-indigo-600 fill-none transition-all duration-1000 ease-out\" \n                  strokeWidth=\"6\"\n                  strokeDasharray={2 * Math.PI * 45}\n                  strokeDashoffset={(2 * Math.PI * 45) * (1 - weeklyGoalPercent / 100)}\n                  strokeLinecap=\"round\"\n                />\n              </svg>\n              <div className=\"absolute flex flex-col items-center\">\n                <span className=\"text-5xl font-black text-white tracking-tighter\">{weeklyGoalPercent}%</span>\n                <span className=\"text-[8px] font-black text-indigo-400 uppercase tracking-widest\">Comprometimento</span>\n              </div>\n            </div>\n\n            <div className=\"flex-1 space-y-8\">\n              <div className=\"space-y-4\">\n                <p className=\"text-slate-400 text-base font-medium leading-relaxed\">\n                  Consistência estratégica detectada. Você acumulou <span className=\"text-white font-black\">{thisWeekHours} horas</span>. \n                  Sua meta atual é de <span className=\"text-indigo-400 font-black\">{weeklyGoal}h</span> semanais. \n                </p>\n              </div>\n\n              {isEditingGoal && (\n                <div className=\"flex gap-2 p-3 bg-black/40 rounded-lg border border-white/5\">\n                  <input type=\"number\" className=\"flex-1 bg-transparent px-4 py-2 font-black text-white outline-none\" value={tempGoal} onChange={(e) => setTempGoal(parseInt(e.target.value) || 0)} />\n                  <button onClick={() => { onUpdateGoal(tempGoal); setIsEditingGoal(false); }} className=\"bg-indigo-600 px-8 py-2 rounded font-black uppercase text-[9px] tracking-widest text-white transition-all\">Definir</button>\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"p-6 bg-white/5 rounded-xl border border-white/5\">\n                   <p className=\"text-[8px] font-black text-slate-500 uppercase mb-2\">Ponto de Equilíbrio</p>\n                   <p className=\"text-xl font-black text-white\">{(weeklyGoal/7).toFixed(1)}h<span className=\"text-xs text-slate-500\">/dia</span></p>\n                </div>\n                <div className=\"p-6 bg-white/5 rounded-xl border border-white/5\">\n                   <p className=\"text-[8px] font-black text-slate-500 uppercase mb-2\">Faltam</p>\n                   <p className=\"text-xl font-black text-emerald-400\">{Math.max(0, weeklyGoal - thisWeekHours)}h</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Vertical Edital Breakdown */}\n        <div className=\"lg:col-span-1 glass-card rounded-xl p-10 flex flex-col justify-between\">\n          <div className=\"mb-10\">\n            <h3 className=\"text-xl font-black text-white tracking-tight\">Status do Edital</h3>\n            <p className=\"text-[9px] font-black text-slate-500 uppercase tracking-widest mt-1\">Conclusão Analítica</p>\n          </div>\n          <div className=\"flex-1 flex flex-col justify-center py-10\">\n            <p className=\"text-7xl font-black text-white tracking-tighter text-glow\">{progressPercent}%</p>\n            <div className=\"h-1 bg-white/5 rounded-full mt-8 overflow-hidden\">\n               <div className=\"h-full bg-indigo-500 transition-all duration-1000 shadow-[0_0_20px_rgba(99,102,241,0.5)]\" style={{ width: `${progressPercent}%` }} />\n            </div>\n          </div>\n          <div className=\"pt-6 border-t border-white/5 flex justify-between items-center text-[10px] font-black uppercase tracking-widest text-slate-500\">\n             <span>{completedTopics} Tópicos</span>\n             <span className=\"text-indigo-400\">Total {totalTopics}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Chart Section */}\n      <div className=\"glass-card rounded-xl p-10\">\n          <div className=\"flex items-center justify-between mb-12\">\n            <h3 className=\"text-xl font-black text-white flex items-center gap-3 tracking-tight\">\n               <ArrowUpRight className=\"text-indigo-500\" /> Curva de Performance em Simulados\n            </h3>\n          </div>\n          <div className=\"h-80 w-full\">\n            {isMounted && mockData.length > 0 ? (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <AreaChart data={mockData}>\n                  <defs>\n                    <linearGradient id=\"colorScore\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                      <stop offset=\"5%\" stopColor=\"#6366f1\" stopOpacity={0.4}/>\n                      <stop offset=\"95%\" stopColor=\"#6366f1\" stopOpacity={0}/>\n                    </linearGradient>\n                  </defs>\n                  <CartesianGrid strokeDasharray=\"10 10\" vertical={false} stroke=\"rgba(255,255,255,0.02)\" />\n                  <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{ fill: '#475569', fontSize: 10, fontWeight: '900' }} dy={15} />\n                  <YAxis axisLine={false} tickLine={false} tick={{ fill: '#475569', fontSize: 10, fontWeight: '900' }} unit=\"%\" />\n                  <Tooltip contentStyle={{ background: '#020617', border: '1px solid rgba(255,255,255,0.08)', borderRadius: '8px' }} />\n                  <Area type=\"monotone\" dataKey=\"acerto\" stroke=\"#6366f1\" strokeWidth={4} fillOpacity={1} fill=\"url(#colorScore)\" />\n                </AreaChart>\n              </ResponsiveContainer>\n            ) : (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-800 gap-4\">\n                <BarChart2 size={64} />\n                <p className=\"font-black text-[10px] uppercase tracking-[0.5em]\">Aguardando Dados Analíticos</p>\n              </div>\n            )}\n          </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n"
            }
          ]
        }
      ]
