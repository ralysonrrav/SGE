              "replacement": "\n{\n  \"name\": \"KRONOS Pro AI\",\n  \"description\": \"Uma plataforma inteligente de planejamento e controle de estudos para concursos públicos, com ciclos baseados em IA e revisões espaçadas.\",\n  \"requestFramePermissions\": [\n    \"camera\",\n    \"microphone\"\n  ]\n}\n"
